        <string name="Name">Server</string>
      </Properties>
      <Item class="Script" referent="30">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--!nonstrict
-- Point d'entrée serveur : construit la carte puis démarre les services.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")

-- Crée les RemoteEvents avant tout (le client les attend)
require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Net"))

local Services = script.Parent:WaitForChild("Services")
local Registry = require(Services.Registry)
local MapBuilder = require(script.Parent.World.MapBuilder)

local map = MapBuilder.Build()

local order = {
	"DataService",
	"Router",
	"Notify",
	"ShopService",
	"PlotService",
	"KaijuService",
	"MeteorService",
	"StealService",
	"EventService",
	"RewardService",
	"ProgressionService",
	"LeaderboardService",
}

for _, name in order do
	Registry[name] = require(Services:WaitForChild(name)) :: any
end

Registry.PlotService.SetMap(map)
Registry.MeteorService.SetPads(map.MeteorPads)

-- Init dans l'ordre inverse des dépendances de données : DataService en
-- dernier pour que tous les services soient abonnés à Loaded avant le 1er joueur.
for _, name in order do
	local service = Registry[name]
	if name ~= "DataService" and service.Init then
		service.Init()
	end
end
Registry.DataService.Init()

Registry.MeteorService.Start()
Registry.EventService.Start()
Registry.LeaderboardService.Start(map.Boards)

Players.CharacterAutoLoads = true
print(("[Steal a Kaiju] serveur prêt — %d services"):format(#order))
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="31">
        <Properties>
          <string name="Name">Services</string>
        </Properties>
        <Item class="ModuleScript" referent="32">
          <Properties>
            <string name="Name">DataService</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Sauvegarde des joueurs (ProfileStore, verrou de session anti-duplication)
-- et réplication des données vers le client.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)
local Signal = require(Shared.Util.Signal)
local DataTemplate = require(Shared.Logic.DataTemplate)
local ProfileStore = require(script.Parent.Parent.Vendor.ProfileStore)

local DataService = {}

DataService.Loaded = Signal.new() :: Signal.Signal<Player, any>
DataService.Releasing = Signal.new() :: Signal.Signal<Player, any>

local STORE_NAME = "StealAKaiju_v1"

local store = ProfileStore.New(STORE_NAME, DataTemplate)
-- Dans Studio sans accès API, ProfileStore bascule tout seul en mode simulé.
-- On force le mode simulé si l'attribut UseMockData est coché sur le script serveur.
local useMock = RunService:IsStudio() and (script.Parent.Parent:GetAttribute("UseMockData") == true)
local activeStore = if useMock then store.Mock else store

local profiles: { [Player]: any } = {}
local dataEvent = Net.Event("Data")

local function deepCopy<T>(t: T): T
	if type(t) ~= "table" then
		return t
	end
	local copy = {}
	for k, v in t :: any do
		copy[k] = deepCopy(v)
	end
	return copy :: any
end

local function onPlayerAdded(player: Player)
	local profile = activeStore:StartSessionAsync("Player_" .. player.UserId, {
		Cancel = function()
			return player.Parent ~= Players
		end,
	})
	if profile == nil then
		player:Kick("Your data could not be loaded. Please rejoin!")
		return
	end
	profile:AddUserId(player.UserId)
	profile:Reconcile()
	profile.OnSessionEnd:Connect(function()
		profiles[player] = nil
		player:Kick("Your save was opened on another server. Please rejoin!")
	end)
	if player.Parent ~= Players then
		profile:EndSession()
		return
	end
	profiles[player] = profile
	-- Envoi complet initial
	dataEvent:FireClient(player, deepCopy(profile.Data), true)
	DataService.Loaded:Fire(player, profile.Data)
end

local function onPlayerRemoving(player: Player)
	local profile = profiles[player]
	if profile then
		DataService.Releasing:Fire(player, profile.Data)
		-- Laisse les services écrire leurs dernières valeurs
		task.wait()
		profile.Data.LastOnline = os.time()
		profile:EndSession()
		profiles[player] = nil
	end
end

function DataService.Init()
	Players.PlayerAdded:Connect(onPlayerAdded)
	Players.PlayerRemoving:Connect(onPlayerRemoving)
	for _, player in Players:GetPlayers() do
		task.spawn(onPlayerAdded, player)
	end
end

-- Données du joueur (nil tant que pas chargées).
function DataService.Get(player: Player): any
	local profile = profiles[player]
	return if profile then profile.Data else nil
end

function DataService.Profile(player: Player): any
	return profiles[player]
end

function DataService.WaitFor(player: Player, timeout: number?): any
	local deadline = os.clock() + (timeout or 30)
	while player.Parent == Players and os.clock() < deadline do
		local data = DataService.Get(player)
		if data then
			return data
		end
		task.wait(0.1)
	end
	return nil
end

-- Réplique les champs de premier niveau indiqués vers le client.
function DataService.Replicate(player: Player, ...: string)
	local data = DataService.Get(player)
	if not data then
		return
	end
	local patch = {}
	for _, key in { ... } do
		patch[key] = deepCopy(data[key])
	end
	dataEvent:FireClient(player, patch, false)
end

-- Envoie une valeur calculée (non sauvegardée) au client, ex. Income.
function DataService.SendDerived(player: Player, key: string, value: any)
	dataEvent:FireClient(player, { [key] = value }, false)
end

function DataService.AddCash(player: Player, amount: number, countsAsEarned: boolean?)
	local data = DataService.Get(player)
	if not data then
		return
	end
	data.Cash += amount
	if countsAsEarned ~= false and amount > 0 then
		data.TotalEarned += amount
	end
	DataService.Replicate(player, "Cash", "TotalEarned")
end

function DataService.Spend(player: Player, currency: string, amount: number): boolean
	local data = DataService.Get(player)
	if not data or amount < 0 or data[currency] == nil or data[currency] < amount then
		return false
	end
	data[currency] -= amount
	DataService.Replicate(player, currency)
	return true
end

function DataService.AddGems(player: Player, amount: number)
	local data = DataService.Get(player)
	if not data then
		return
	end
	data.Gems += amount
	DataService.Replicate(player, "Gems")
end

function DataService.Save(player: Player)
	local profile = profiles[player]
	if profile and profile:IsActive() then
		profile:Save()
	end
end

return DataService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="33">
          <Properties>
            <string name="Name">EventService</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Événements mondiaux : rotation automatique, déclenchement payant,
-- mutations contagieuses, Stampede (orbes de cash) et Raid du Colosse (boss).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Events = require(Shared.Config.Events)
local Kaijus = require(Shared.Config.Kaijus)
local Mutations = require(Shared.Config.Mutations)
local Layout = require(Shared.Config.Layout)
local Roll = require(Shared.Logic.Roll)
local Calc = require(Shared.Logic.Calc)

local Registry = require(script.Parent.Registry)
local DataService = require(script.Parent.DataService)
local Notify = require(script.Parent.Notify)
local Router = require(script.Parent.Router)

local EventService = {}

local current: Events.WorldEvent? = nil
local endsAt = 0
local queue: { { Id: string, By: Player? } } = {}
local orbsFolder: Folder
local orbs: { [string]: { Part: BasePart, Value: number } } = {}
local orbId = 0

-- Boss
local boss: BasePart? = nil
local bossDamage: { [Player]: number } = {}
local bossHitCooldown: { [Player]: number } = {}

local function now(): number
	return Workspace:GetServerTimeNow()
end

function EventService.Current(): Events.WorldEvent?
	return current
end

----------------------------------------------------------------------------
-- Stampede : orbes de cash
----------------------------------------------------------------------------

local function spawnOrbWave()
	local cfg = Events.Stampede
	for _ = 1, cfg.OrbsPerWave do
		orbId += 1
		local id = "O" .. orbId
		local a = math.random() * math.pi * 2
		local r = math.random() * (Layout.CraterRadius - 12) + 6
		local p = Instance.new("Part")
		p.Name = id
		p.Shape = Enum.PartType.Ball
		p.Size = Vector3.new(2.4, 2.4, 2.4)
		p.Anchored = true
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
		p.Transparency = 1
		p.CFrame = CFrame.new(math.cos(a) * r, 2.5, math.sin(a) * r)
		p:SetAttribute("Id", id)
		p.Parent = orbsFolder
		orbs[id] = { Part = p, Value = 1 }
		task.delay(20, function()
			if orbs[id] then
				orbs[id] = nil
				p:Destroy()
			end
		end)
	end
	Notify.FxAll("StampedeWave", {})
end

local function grabOrb(player: Player, payload: any)
	local id = if type(payload) == "table" then Router.String(payload.Id) else nil
	local orb = id and orbs[id]
	if not orb or not id then
		return
	end
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not root or (root.Position - orb.Part.Position).Magnitude > 14 then
		return
	end
	orbs[id] = nil
	orb.Part:Destroy()
	local cfg = Events.Stampede
	local amount = Calc.CashReward(cfg.OrbCashSeconds, Registry.KaijuService.IncomePerSecond(player), cfg.OrbMinCash)
	DataService.AddCash(player, amount)
	Notify.Fx(player, "OrbGrabbed", { Id = id, Amount = amount })
	Notify.FxAll("OrbGone", { Id = id })
	Registry.RewardService.Track(player, "Orbs", 1)
end

----------------------------------------------------------------------------
-- Raid du Colosse
----------------------------------------------------------------------------

local function spawnBoss()
	local players = #Players:GetPlayers()
	local hp = math.max(Events.Boss.MinHealth, Events.Boss.Health * players)
	local b = Instance.new("Part")
	b.Name = "Boss"
	b.Anchored = true
	b.CanCollide = false
	b.CanQuery = false
	b.CanTouch = false
	b.Transparency = 1
	b.Size = Vector3.new(4, 4, 4)
	b.CFrame = CFrame.new(0, 0, 0)
	b:SetAttribute("Species", "KingKaiju")
	b:SetAttribute("Mutation", "Shadow")
	b:SetAttribute("MaxHP", hp)
	b:SetAttribute("HP", hp)
	b:SetAttribute("Scale", 7)
	b.Parent = Workspace:WaitForChild("Effects")
	boss = b
	table.clear(bossDamage)
	Notify.FxAll("BossSpawn", {})
end

local function finishBoss(defeated: boolean)
	local b = boss
	if not b then
		return
	end
	boss = nil
	Notify.FxAll("BossEnd", { Defeated = defeated })
	if defeated then
		local total = 0
		local best: Player? = nil
		local bestDamage = 0
		for p, d in bossDamage do
			total += d
			if d > bestDamage then
				best, bestDamage = p, d
			end
		end
		for p, d in bossDamage do
			if p.Parent == Players then
				local share = d / math.max(total, 1)
				local gems = math.max(5, math.floor(Events.Boss.RewardGems * (0.5 + share * 3)))
				DataService.AddGems(p, gems)
				Notify.Fx(p, "BossReward", { Gems = gems, Top = p == best })
				if math.random() < Events.Boss.EggChance then
					Registry.KaijuService.GiveEgg(p, "Legendary", "Raid")
				end
			end
		end
		if best and best.Parent == Players then
			Registry.KaijuService.GiveEgg(best, Events.Boss.TopEggRarity, "Raid MVP")
			Notify.Feed(("👑 %s dealt the most damage to the COLOSSUS and wins a MYTHIC egg!"):format(best.DisplayName), "Boss")
		end
	else
		Notify.Feed("The Colossus escaped... next time!", "Boss")
	end
	task.delay(2, function()
		b:Destroy()
	end)
end

function EventService.TryBossHit(player: Player, position: Vector3, range: number)
	local b = boss
	if not b or (bossHitCooldown[player] or 0) > os.clock() then
		return
	end
	local flat = Vector3.new(position.X - b.Position.X, 0, position.Z - b.Position.Z)
	-- le boss est immense : on peut frapper ses pieds de loin
	if flat.Magnitude > 30 + range then
		return
	end
	bossHitCooldown[player] = os.clock() + 0.35
	local data = DataService.Get(player)
	local dmg = Events.Boss.DamagePerBonk * (1 + (if data then data.Upgrades.Bonker else 0) * 0.25)
	if Registry.ShopService.HasPass(player, "SuperBonk") then
		dmg *= 1.5
	end
	bossDamage[player] = (bossDamage[player] or 0) + dmg
	if data then
		data.Stats.BossDamage += dmg
	end
	local hp = math.max(0, (b:GetAttribute("HP") or 0) - dmg)
	b:SetAttribute("HP", hp)
	Notify.FxAll("BossHit", { UserId = player.UserId, Damage = dmg })
	if hp <= 0 then
		finishBoss(true)
	end
end

local function bossStomp()
	local b = boss
	if not b then
		return
	end
	Notify.FxAll("BossStomp", {})
	task.wait(0.8)
	for _, p in Players:GetPlayers() do
		local character = p.Character
		local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
		if root then
			local offset = root.Position - b.Position
			local flat = Vector3.new(offset.X, 0, offset.Z)
			if flat.Magnitude < 45 and root.Position.Y < 8 then
				local dir = if flat.Magnitude > 0.1 then flat.Unit else Vector3.new(1, 0, 0)
				Notify.Fx(p, "Knockback", { Velocity = dir * 90 + Vector3.new(0, 55, 0), From = "the Colossus" })
			end
		end
	end
end

----------------------------------------------------------------------------
-- Cycle de vie des événements
----------------------------------------------------------------------------

local function infect()
	local event = current
	if not event or not event.Mutation or not event.InfectChance then
		return
	end
	for _, player in Players:GetPlayers() do
		local data = DataService.Get(player)
		if data then
			for _, rec in data.Kaijus do
				if not rec.Egg and rec.Mutation == nil and math.random() < event.InfectChance * 10 then
					rec.Mutation = event.Mutation
					Registry.KaijuService.SyncAnchor(player, rec)
					local species = Kaijus.Get(rec.Species or "")
					local mutation = Mutations.Get(event.Mutation)
					Notify.FxAll("Infected", { Uid = rec.Uid, Mutation = event.Mutation })
					Notify.Toast(player, ("Your %s mutated into %s! (x%d)"):format(if species then species.Name else "kaiju", if mutation then mutation.Name else event.Mutation, if mutation then mutation.Mult else 1), "Rare")
					if species then
						Registry.RewardService.Discover(player, species.Id, rec.Mutation)
					end
					DataService.Replicate(player, "Kaijus")
					Registry.KaijuService.RefreshPlayer(player)
					break -- une mutation par joueur et par vague
				end
			end
		end
	end
end

local function stop()
	local event = current
	if not event then
		return
	end
	current = nil
	Workspace:SetAttribute("EventId", nil)
	Workspace:SetAttribute("EventEnds", nil)
	Notify.FxAll("EventEnd", { Id = event.Id })
	if event.Id == "BossRaid" then
		finishBoss(false)
	elseif event.Id == "Stampede" then
		for id, orb in orbs do
			orb.Part:Destroy()
			orbs[id] = nil
		end
	end
	for _, player in Players:GetPlayers() do
		Registry.KaijuService.RefreshPlayer(player)
	end
end

local function start(id: string, by: Player?)
	local event = Events.ById[id]
	if not event then
		return
	end
	if current then
		stop()
	end
	current = event
	endsAt = now() + event.Duration
	Workspace:SetAttribute("EventId", event.Id)
	Workspace:SetAttribute("EventEnds", endsAt)
	Notify.FxAll("EventStart", { Id = event.Id, By = if by then by.DisplayName else nil })
	if by then
		Notify.Feed(("%s %s summoned a %s!"):format(event.Icon, by.DisplayName, event.Name), "Event", event.Color)
	else
		Notify.Feed(("%s %s — %s"):format(event.Icon, event.Name, event.Tagline), "Event", event.Color)
	end
	for _, player in Players:GetPlayers() do
		Registry.KaijuService.RefreshPlayer(player)
	end

	task.spawn(function()
		local thisEvent = event
		local tick = 0
		while current == thisEvent and now() < endsAt do
			task.wait(1)
			tick += 1
			if tick % 10 == 0 then
				infect()
			end
			if thisEvent.Id == "Stampede" and tick % Events.Stampede.WaveEvery == 1 then
				spawnOrbWave()
			end
			if thisEvent.Id == "BossRaid" then
				if tick == 1 then
					spawnBoss()
				elseif boss and tick % 9 == 0 then
					task.spawn(bossStomp)
				elseif not boss and tick > 2 then
					break -- vaincu
				end
			end
		end
		if current == thisEvent then
			stop()
		end
	end)
end

-- Arrête l'événement en cours (admin / tests).
function EventService.Stop()
	stop()
end

function EventService.Force(id: string, by: Player?)
	if current and current.Id ~= id then
		table.insert(queue, { Id = id, By = by })
		if by then
			Notify.Toast(by, "Your event is queued and will start right after the current one!", "Good")
		end
		return
	end
	if current and current.Id == id then
		endsAt += Events.ById[id].Duration -- prolonge
		Workspace:SetAttribute("EventEnds", endsAt)
		if by then
			Notify.Feed(("%s %s extended the %s!"):format(Events.ById[id].Icon, by.DisplayName, Events.ById[id].Name), "Event", Events.ById[id].Color)
		end
		return
	end
	start(id, by)
end

local function pickRandom(): string
	local weights = {}
	for i, e in Events.List do
		weights[i] = e.Weight
		if e.Id == "BossRaid" and #Players:GetPlayers() < 2 then
			weights[i] = 0
		end
	end
	return Events.List[Roll.Weighted(weights)].Id
end

function EventService.Init()
	orbsFolder = Workspace:WaitForChild("Orbs") :: Folder
	Router.OnInput("Orb", grabOrb)
	Players.PlayerRemoving:Connect(function(p)
		bossDamage[p] = nil
		bossHitCooldown[p] = nil
	end)
end

function EventService.Start()
	task.spawn(function()
		task.wait(Events.FirstDelay)
		while true do
			if not current then
				local nextEvent = table.remove(queue, 1)
				if nextEvent then
					start(nextEvent.Id, nextEvent.By)
				else
					start(pickRandom())
				end
			end
			-- attend la fin, puis une pause (sauf si un événement payant attend)
			while current do
				task.wait(1)
			end
			local gap = math.random(Events.Gap[1], Events.Gap[2])
			local waited = 0
			while waited < gap and #queue == 0 do
				task.wait(1)
				waited += 1
			end
		end
	end)
end

return EventService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="34">
          <Properties>
            <string name="Name">KaijuService</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Kaijus possédés : œufs, éclosion, croissance, revenus, collecteur, vente,
-- nourriture, transfert (vol). Chaque kaiju a une « ancre » invisible dans
-- workspace.Kaijus : le client en lit les attributs et fabrique le modèle 3D.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Kaijus = require(Shared.Config.Kaijus)
local Rarities = require(Shared.Config.Rarities)
local Growth = require(Shared.Config.Growth)
local Economy = require(Shared.Config.Economy)
local Calc = require(Shared.Logic.Calc)
local Roll = require(Shared.Logic.Roll)
local Format = require(Shared.Logic.Format)

local Registry = require(script.Parent.Registry)
local DataService = require(script.Parent.DataService)
local Router = require(script.Parent.Router)
local Notify = require(script.Parent.Notify)

local KaijuService = {}

type Record = Calc.KaijuRecord

local folder: Folder
local anchors: { [string]: BasePart } = {} -- Uid -> ancre
local ownerFolders: { [Player]: Folder } = {}
local multCache: { [Player]: number } = {}
local friendCount: { [Player]: number } = {}
local inGroup: { [Player]: boolean } = {}
local lastIncome: { [Player]: number } = {}

local function serverNow(): number
	return Workspace:GetServerTimeNow()
end

local function findRecord(data: any, uid: string): (Record?, number?)
	for i, rec in data.Kaijus do
		if rec.Uid == uid then
			return rec, i
		end
	end
	return nil, nil
end

KaijuService.FindRecord = findRecord

function KaijuService.Anchor(uid: string): BasePart?
	return anchors[uid]
end

-- Propriétaire d'une ancre.
function KaijuService.OwnerOf(uid: string): Player?
	local anchor = anchors[uid]
	if not anchor then
		return nil
	end
	return Players:GetPlayerByUserId(anchor:GetAttribute("Owner") or 0)
end

----------------------------------------------------------------------------
-- Multiplicateurs
----------------------------------------------------------------------------

local function indexCount(data: any): number
	local n = 0
	for _ in data.Index do
		n += 1
	end
	return n
end

function KaijuService.Multiplier(player: Player): number
	local data = DataService.Get(player)
	if not data then
		return 1
	end
	local Shop = Registry.ShopService
	local event = Registry.EventService.Current()
	local m: Calc.Multipliers = {
		Rebirths = data.Rebirths,
		Reactor = data.Upgrades.Reactor,
		VIP = Shop.HasPass(player, "VIP"),
		DoubleCash = Shop.HasPass(player, "DoubleCash"),
		Friends = friendCount[player] or 0,
		Premium = player.MembershipType == Enum.MembershipType.Premium,
		Group = inGroup[player] == true,
		IndexCount = indexCount(data),
		CashPotion = data.Boosts.Cash > os.time(),
		EventCash = if event then event.CashMult else 1,
	}
	return Calc.CashMultiplier(m)
end

function KaijuService.GrowthRate(player: Player): number
	local data = DataService.Get(player)
	local rate = 1
	if Registry.ShopService.HasPass(player, "FastGrowth") then
		rate *= 1.5
	end
	if data and data.Boosts.Growth > os.time() then
		rate *= 2
	end
	return rate
end

function KaijuService.PersonalLuck(player: Player): number
	local data = DataService.Get(player)
	local luck = 1
	if data then
		luck *= Calc.RebirthLuck(data.Rebirths)
		if data.Boosts.Luck > os.time() then
			luck *= 2
		end
	end
	if Registry.ShopService.HasPass(player, "LuckyAura") then
		luck *= 2
	end
	return luck
end

function KaijuService.IncomePerSecond(player: Player): number
	local data = DataService.Get(player)
	if not data then
		return 0
	end
	local total = 0
	for _, rec in data.Kaijus do
		local anchor = anchors[rec.Uid]
		if not (anchor and (anchor:GetAttribute("CarriedBy") or 0) ~= 0) then
			total += Calc.BaseIncome(rec)
		end
	end
	return total * (multCache[player] or KaijuService.Multiplier(player))
end

function KaijuService.RefreshPlayer(player: Player)
	multCache[player] = KaijuService.Multiplier(player)
	local data = DataService.Get(player)
	if not data then
		return
	end
	local rate = KaijuService.GrowthRate(player)
	for _, rec in data.Kaijus do
		local anchor = anchors[rec.Uid]
		if anchor then
			anchor:SetAttribute("Income", Calc.BaseIncome(rec) * multCache[player])
			anchor:SetAttribute("GrowthRate", rate)
		end
	end
	DataService.SendDerived(player, "Multiplier", multCache[player])
	DataService.SendDerived(player, "Luck", KaijuService.PersonalLuck(player))
	DataService.SendDerived(player, "GrowthRate", rate)
end

----------------------------------------------------------------------------
-- Ancres
----------------------------------------------------------------------------

local function syncAnchor(player: Player, rec: Record)
	local plot = Registry.PlotService.Get(player)
	if not plot then
		return
	end
	local anchor = anchors[rec.Uid]
	if not anchor then
		local p = Instance.new("Part")
		p.Name = rec.Uid
		p.Anchored = true
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
		p.Transparency = 1
		p.Size = Vector3.new(2, 2, 2)
		p.Parent = ownerFolders[player]
		anchors[rec.Uid] = p
		anchor = p
	end
	assert(anchor)
	anchor.CFrame = Registry.PlotService.NestCFrame(plot, rec.Nest)
	anchor:SetAttribute("Uid", rec.Uid)
	anchor:SetAttribute("Owner", player.UserId)
	anchor:SetAttribute("OwnerName", player.DisplayName)
	anchor:SetAttribute("Plot", plot.Index)
	anchor:SetAttribute("Nest", rec.Nest)
	anchor:SetAttribute("Rarity", rec.Rarity)
	anchor:SetAttribute("Egg", rec.Egg == true)
	anchor:SetAttribute("HatchAt", rec.HatchAt or 0)
	anchor:SetAttribute("Species", rec.Species or "")
	anchor:SetAttribute("Mutation", rec.Mutation or "")
	anchor:SetAttribute("Stage", Calc.Stage(rec))
	anchor:SetAttribute("Growth", rec.Growth)
	anchor:SetAttribute("GrowthStamp", serverNow())
	anchor:SetAttribute("GrowthRate", KaijuService.GrowthRate(player))
	anchor:SetAttribute("Income", Calc.BaseIncome(rec) * (multCache[player] or 1))
	anchor:SetAttribute("SellValue", Calc.SellValue(rec))
	if anchor:GetAttribute("CarriedBy") == nil then
		anchor:SetAttribute("CarriedBy", 0)
	end
end

local function destroyAnchor(uid: string)
	local anchor = anchors[uid]
	if anchor then
		anchors[uid] = nil
		anchor:Destroy()
	end
end

KaijuService.SyncAnchor = syncAnchor

----------------------------------------------------------------------------
-- Nids et œufs
----------------------------------------------------------------------------

function KaijuService.FreeNest(player: Player): number?
	local data = DataService.Get(player)
	if not data then
		return nil
	end
	local used = {}
	for _, rec in data.Kaijus do
		used[rec.Nest] = true
	end
	for slot = 1, Registry.PlotService.UnlockedNests(player) do
		if not used[slot] then
			return slot
		end
	end
	return nil
end

local function newUid(data: any): string
	local uid = string.format("%x-%x", data.NextUid, math.random(0, 0xFFFF))
	data.NextUid += 1
	return uid
end

-- Ajoute un œuf dans un nid libre. Renvoie le record ou nil si plein.
function KaijuService.AddEgg(player: Player, rarity: string, hatchSeconds: number?): Record?
	local data = DataService.Get(player)
	local slot = KaijuService.FreeNest(player)
	if not data or not slot then
		return nil
	end
	local r = Rarities.Get(rarity)
	local rec: Record = {
		Uid = newUid(data),
		Rarity = r.Id,
		Growth = 0,
		Nest = slot,
		Egg = true,
		HatchAt = os.time() + (hatchSeconds or r.HatchTime),
		Born = os.time(),
	}
	table.insert(data.Kaijus, rec)
	syncAnchor(player, rec)
	DataService.Replicate(player, "Kaijus")
	return rec
end

-- Œuf offert (récompenses, rebirth…) : mis en attente si aucun nid libre.
function KaijuService.GiveEgg(player: Player, rarity: string, source: string?)
	local data = DataService.Get(player)
	if not data then
		return
	end
	local rec = KaijuService.AddEgg(player, rarity)
	local r = Rarities.Get(rarity)
	if rec then
		Notify.Fx(player, "EggGift", { Rarity = rarity, Source = source, Uid = rec.Uid })
	else
		table.insert(data.PendingEggs, rarity)
		DataService.Replicate(player, "PendingEggs")
		Notify.Toast(player, ("%s egg saved! Free a nest to place it."):format(r.Name), "Info")
	end
end

function KaijuService.PlacePending(player: Player)
	local data = DataService.Get(player)
	if not data then
		return
	end
	local changed = false
	while #data.PendingEggs > 0 and KaijuService.FreeNest(player) do
		local rarity = table.remove(data.PendingEggs, 1) :: string
		KaijuService.AddEgg(player, rarity)
		changed = true
	end
	if changed then
		DataService.Replicate(player, "PendingEggs")
	end
end

local function hatch(player: Player, data: any, rec: Record)
	local event = Registry.EventService.Current()
	local luck = KaijuService.PersonalLuck(player)
	local bonus = nil
	if event and event.Mutation and event.MutationChance then
		bonus = { Id = event.Mutation, Chance = event.MutationChance }
	end
	rec.Species = rec.Species or Roll.Species(rec.Rarity)
	if rec.Mutation == nil then
		rec.Mutation = Roll.Mutation(luck, bonus)
	end
	rec.Egg = nil
	rec.HatchAt = nil
	rec.Growth = 0
	syncAnchor(player, rec)
	DataService.Replicate(player, "Kaijus")

	local species = Kaijus.Get(rec.Species :: string)
	local rarity = Rarities.Get(rec.Rarity)
	Notify.Fx(player, "Hatch", { Uid = rec.Uid, Species = rec.Species, Mutation = rec.Mutation, Rarity = rec.Rarity })
	Notify.FxAll("HatchWorld", { Uid = rec.Uid, Rarity = rec.Rarity })
	Registry.RewardService.Discover(player, rec.Species :: string, rec.Mutation)
	Registry.RewardService.Track(player, "Hatches", 1)
	if rarity.Announce and species then
		local mut = if rec.Mutation then rec.Mutation .. " " else ""
		Notify.Feed(("%s hatched a %s%s %s!"):format(player.DisplayName, mut, string.upper(rarity.Name), species.Name), "Rare", rarity.Color)
	end
	KaijuService.RefreshPlayer(player)
end

function KaijuService.HatchAll(player: Player): boolean
	local data = DataService.Get(player)
	if not data then
		return false
	end
	local any = false
	for _, rec in data.Kaijus do
		if rec.Egg then
			rec.HatchAt = os.time()
			any = true
		end
	end
	if not any then
		-- Aucun œuf : on compense pour que l'achat ne soit jamais perdu
		DataService.AddGems(player, 20)
		Notify.Toast(player, "No eggs to hatch: +20 gems instead!", "Gem")
	end
	return true
end

-- Crée directement un kaiju éclos (fusion, admin).
function KaijuService.AddHatched(player: Player, speciesId: string, mutation: string?, growth: number?): Record?
	local data = DataService.Get(player)
	local slot = KaijuService.FreeNest(player)
	local species = Kaijus.Get(speciesId)
	if not data or not slot or not species then
		return nil
	end
	local rec: Record = {
		Uid = newUid(data),
		Species = species.Id,
		Rarity = species.Rarity,
		Mutation = mutation,
		Growth = growth or 0,
		Nest = slot,
		Born = os.time(),
	}
	table.insert(data.Kaijus, rec)
	syncAnchor(player, rec)
	DataService.Replicate(player, "Kaijus")
	Registry.RewardService.Discover(player, species.Id, mutation)
	KaijuService.RefreshPlayer(player)
	return rec
end

function KaijuService.RemoveRecord(player: Player, uid: string): Record?
	local data = DataService.Get(player)
	if not data then
		return nil
	end
	local rec, index = findRecord(data, uid)
	if not rec or not index then
		return nil
	end
	table.remove(data.Kaijus, index)
	destroyAnchor(uid)
	DataService.Replicate(player, "Kaijus")
	return rec
end

-- Transfert (vol réussi) : garde croissance et mutation, nouveau nid.
function KaijuService.Transfer(from: Player, uid: string, to: Player): Record?
	local toData = DataService.Get(to)
	local slot = KaijuService.FreeNest(to)
	if not toData or not slot then
		return nil
	end
	local rec = KaijuService.RemoveRecord(from, uid)
	if not rec then
		return nil
	end
	rec.Nest = slot
	rec.Uid = newUid(toData)
	table.insert(toData.Kaijus, rec)
	syncAnchor(to, rec)
	DataService.Replicate(to, "Kaijus")
	if rec.Species then
		Registry.RewardService.Discover(to, rec.Species, rec.Mutation)
	end
	KaijuService.RefreshPlayer(from)
	KaijuService.RefreshPlayer(to)
	KaijuService.PlacePending(from)
	return rec
end

function KaijuService.InstantGrow(player: Player, uid: string?): boolean
	local data = DataService.Get(player)
	if not data then
		return false
	end
	local target: Record? = nil
	if uid then
		target = findRecord(data, uid)
	end
	if not target or target.Egg or Calc.Stage(target) >= Growth.MaxStage then
		-- sinon : le plus petit kaiju non adulte
		for _, rec in data.Kaijus do
			if not rec.Egg and Calc.Stage(rec) < Growth.MaxStage then
				if not target or Calc.BaseIncome(rec) > Calc.BaseIncome(target) then
					target = rec
				end
			end
		end
	end
	if not target or target.Egg or Calc.Stage(target) >= Growth.MaxStage then
		-- Rien à faire grandir : compensation
		DataService.AddGems(player, 25)
		Notify.Toast(player, "Nothing to grow: +25 gems instead!", "Gem")
		return true
	end
	local stage = Calc.Stage(target)
	target.Growth = Growth.Threshold(stage + 1, target.Rarity) + 0.5
	return true -- la boucle détecte le changement de stade
end

----------------------------------------------------------------------------
-- Collecteur
----------------------------------------------------------------------------

function KaijuService.Collect(player: Player)
	local data = DataService.Get(player)
	if not data or data.Stored < 1 then
		return
	end
	local amount = math.floor(data.Stored)
	data.Stored -= amount
	DataService.AddCash(player, amount)
	DataService.Replicate(player, "Stored")
	Notify.Fx(player, "Collect", { Amount = amount })
	Registry.RewardService.Track(player, "Collects", 1)
end

----------------------------------------------------------------------------
-- Actions
----------------------------------------------------------------------------

local function sell(player: Player, payload: any): Router.Result
	local uid = Router.String(payload.Uid)
	local data = DataService.Get(player)
	if not uid or not data then
		return { ok = false }
	end
	local rec = findRecord(data, uid)
	local anchor = anchors[uid]
	if not rec or rec.Egg then
		return { ok = false, msg = "Can't sell this" }
	end
	if anchor and (anchor:GetAttribute("CarriedBy") or 0) ~= 0 then
		return { ok = false, msg = "It's being stolen!" }
	end
	local value = Calc.SellValue(rec)
	KaijuService.RemoveRecord(player, uid)
	DataService.AddCash(player, value, false)
	Notify.Fx(player, "Sold", { Amount = value, Species = rec.Species })
	KaijuService.RefreshPlayer(player)
	KaijuService.PlacePending(player)
	return { ok = true, amount = value }
end

local function feed(player: Player, payload: any): Router.Result
	local uid = Router.String(payload.Uid)
	local foodId = Router.String(payload.Food)
	local data = DataService.Get(player)
	if not uid or not foodId or not data or not Economy.FoodsById[foodId] then
		return { ok = false }
	end
	local rec = findRecord(data, uid)
	if not rec or rec.Egg then
		return { ok = false, msg = "Can't feed this" }
	end
	if Calc.Stage(rec) >= Growth.MaxStage then
		return { ok = false, msg = "Already fully grown!" }
	end
	local price = Calc.FoodPrice(rec, foodId)
	if not DataService.Spend(player, "Cash", price) then
		return { ok = false, msg = "Not enough cash (" .. Format.Cash(price) .. ")" }
	end
	rec.Growth += Calc.FoodGrowth(rec, foodId)
	local anchor = anchors[uid]
	if anchor then
		anchor:SetAttribute("Growth", rec.Growth)
		anchor:SetAttribute("GrowthStamp", serverNow())
	end
	Notify.FxAll("Fed", { Uid = uid, Food = foodId })
	Registry.RewardService.Track(player, "Feeds", 1)
	return { ok = true }
end

----------------------------------------------------------------------------
-- Boucle principale
----------------------------------------------------------------------------

local function tickPlayer(player: Player, dt: number)
	local data = DataService.Get(player)
	local plot = Registry.PlotService.Get(player)
	if not data or not plot then
		return
	end
	local now = os.time()
	local rate = KaijuService.GrowthRate(player)
	local mult = multCache[player] or KaijuService.Multiplier(player)
	local income = 0
	local changed = false

	for _, rec in table.clone(data.Kaijus) do
		local anchor = anchors[rec.Uid]
		if rec.Egg then
			if rec.HatchAt and now >= rec.HatchAt then
				hatch(player, data, rec)
			end
		else
			local carried = anchor and (anchor:GetAttribute("CarriedBy") or 0) ~= 0
			if not carried then
				local before = Calc.Stage(rec)
				rec.Growth += dt * rate
				local after = Calc.Stage(rec)
				if after > before then
					changed = true
					if anchor then
						syncAnchor(player, rec)
					end
					Notify.FxAll("StageUp", { Uid = rec.Uid, Stage = after })
					local stage = Growth.Get(after)
					local species = Kaijus.Get(rec.Species or "")
					Notify.Toast(player, ("%s grew into a %s!"):format(if species then species.Name else "Kaiju", string.upper(stage.Name)), "Good")
					Registry.RewardService.Track(player, "StageUps", after - before)
				end
				income += Calc.BaseIncome(rec)
			end
		end
	end

	if changed then
		DataService.Replicate(player, "Kaijus")
		KaijuService.RefreshPlayer(player)
		mult = multCache[player]
	end

	local earned = income * mult * dt
	if earned > 0 then
		if Registry.ShopService.HasPass(player, "AutoCollect") then
			data.Cash += earned
			data.TotalEarned += earned
			DataService.Replicate(player, "Cash", "TotalEarned")
		else
			data.Stored += earned
			DataService.Replicate(player, "Stored")
		end
	end
	plot.Model:SetAttribute("Stored", data.Stored)
	local label = plot.CollectorGui:FindFirstChild("Amount") :: TextLabel?
	if label then
		label.Text = Format.Cash(data.Stored)
	end

	local perSecond = income * mult
	if lastIncome[player] ~= perSecond then
		lastIncome[player] = perSecond
		DataService.SendDerived(player, "Income", perSecond)
	end
end

-- Gains et croissance hors ligne au chargement.
local function applyOffline(player: Player, data: any)
	if data.LastOnline <= 0 then
		return
	end
	local elapsed = math.max(0, os.time() - data.LastOnline)
	if elapsed < 60 then
		return
	end
	local maxHours = if Registry.ShopService.HasPass(player, "Offline") then Economy.OfflineMaxHoursPass else Economy.OfflineMaxHours
	local capped = math.min(elapsed, maxHours * 3600)
	local income = 0
	for _, rec in data.Kaijus do
		if not rec.Egg then
			rec.Growth += elapsed
			income += Calc.BaseIncome(rec)
		end
	end
	local amount = math.floor(income * KaijuService.Multiplier(player) * capped * Economy.OfflineRate)
	if amount > 0 then
		data.Stored += amount
		Notify.Fx(player, "WelcomeBack", { Amount = amount, Seconds = elapsed, Capped = capped < elapsed, MaxHours = maxHours })
	end
end

local function onLoaded(player: Player, data: any)
	local f = Instance.new("Folder")
	f.Name = tostring(player.UserId)
	f.Parent = folder
	ownerFolders[player] = f

	-- Nettoyage : nids hors limites (ex. pass expiré) -> œufs en attente
	-- Attend que l'île soit attribuée
	local t0 = os.clock()
	while not Registry.PlotService.Get(player) and os.clock() - t0 < 10 do
		task.wait()
	end
	-- Attend que les pass soient connus (1re fois)
	task.wait(0.5)
	applyOffline(player, data)
	local limit = Registry.PlotService.UnlockedNests(player)
	local used: { [number]: boolean } = {}
	for _, rec in table.clone(data.Kaijus) do
		if rec.Nest > limit or used[rec.Nest] then
			local slot = nil
			for s = 1, limit do
				if not used[s] then
					slot = s
					break
				end
			end
			if slot then
				rec.Nest = slot
			else
				local i = table.find(data.Kaijus, rec)
				if i then
					table.remove(data.Kaijus, i)
				end
				if rec.Egg then
					table.insert(data.PendingEggs, rec.Rarity)
				elseif rec.Species then
					-- revendu automatiquement plutôt que perdu
					data.Cash += Calc.SellValue(rec)
				end
				continue
			end
		end
		used[rec.Nest] = true
	end
	multCache[player] = KaijuService.Multiplier(player)
	for _, rec in data.Kaijus do
		syncAnchor(player, rec)
	end

	-- Premier œuf offert (éclosion rapide) pour accrocher dès la 1re minute
	if data.Tutorial == 0 and #data.Kaijus == 0 and data.TotalEarned == 0 then
		KaijuService.AddEgg(player, "Common", 6)
	end
	DataService.Replicate(player, "Kaijus", "Stored", "Cash", "PendingEggs")
	KaijuService.RefreshPlayer(player)
	KaijuService.PlacePending(player)
end

local function refreshFriends()
	local list = Players:GetPlayers()
	for _, player in list do
		task.spawn(function()
			local n = 0
			for _, other in list do
				if other ~= player then
					local ok, isFriend = pcall(player.IsFriendsWith, player, other.UserId)
					if ok and isFriend then
						n += 1
					end
				end
			end
			if friendCount[player] ~= n then
				friendCount[player] = n
				DataService.SendDerived(player, "Friends", n)
				KaijuService.RefreshPlayer(player)
			end
		end)
	end
end

function KaijuService.SetInGroup(player: Player, value: boolean)
	inGroup[player] = value
	KaijuService.RefreshPlayer(player)
end

function KaijuService.Init()
	folder = Workspace:WaitForChild("Kaijus") :: Folder

	Router.On("Sell", sell, 4)
	Router.On("Feed", feed, 6)

	DataService.Loaded:Connect(onLoaded)
	DataService.Releasing:Connect(function(player)
		-- Un kaiju en cours de vol revient chez son propriétaire (rien à faire :
		-- les records ne quittent la sauvegarde qu'à la livraison).
		local f = ownerFolders[player]
		if f then
			for _, child in f:GetChildren() do
				anchors[child.Name] = nil
			end
			f:Destroy()
		end
		ownerFolders[player] = nil
		multCache[player] = nil
		friendCount[player] = nil
		inGroup[player] = nil
		lastIncome[player] = nil
	end)

	Players.PlayerAdded:Connect(function()
		task.delay(2, refreshFriends)
	end)
	Players.PlayerRemoving:Connect(function()
		task.delay(1, refreshFriends)
	end)

	-- Boucle d'une seconde
	task.spawn(function()
		local last = os.clock()
		while true do
			task.wait(1)
			local now = os.clock()
			local dt = math.min(now - last, 5)
			last = now
			for player in ownerFolders do
				local ok, err = pcall(tickPlayer, player, dt)
				if not ok then
					warn("[KaijuService] tick : " .. tostring(err))
				end
			end
		end
	end)

	-- Rafraîchit les multiplicateurs (potions qui expirent, événements…)
	task.spawn(function()
		while true do
			task.wait(10)
			for player in ownerFolders do
				KaijuService.RefreshPlayer(player)
			end
		end
	end)
end

return KaijuService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="35">
          <Properties>
            <string name="Name">LeaderboardService</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Classements : leaderstats (liste des joueurs) + tableaux mondiaux
-- (OrderedDataStore) affichés autour du cratère.

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Format = require(Shared.Logic.Format)
local Theme = require(Shared.Config.Theme)

local DataService = require(script.Parent.DataService)

local LeaderboardService = {}

local BOARDS = {
	{ Key = "TotalEarned", Title = "💰 RICHEST TYCOONS", Store = "LB_Earned_v1", Format = Format.Cash, Color = Theme.Colors.Cash },
	{ Key = "Steals", Title = "🦹 MASTER THIEVES", Store = "LB_Steals_v1", Format = Format.Short, Color = Theme.Colors.Pink },
	{ Key = "Rebirths", Title = "🧬 TOP EVOLVERS", Store = "LB_Rebirths_v1", Format = Format.Short, Color = Theme.Colors.Radioactive },
}

local stores: { [string]: OrderedDataStore? } = {}
local boardGuis: { [string]: Frame } = {}

local function statOf(data: any, key: string): number
	if key == "Steals" then
		return data.Stats.Steals
	end
	return data[key] or 0
end

function LeaderboardService.Update(player: Player)
	local data = DataService.Get(player)
	local stats = player:FindFirstChild("leaderstats")
	if not data or not stats then
		return
	end
	local cash = stats:FindFirstChild("Cash") :: StringValue?
	local steals = stats:FindFirstChild("Steals") :: IntValue?
	local rebirths = stats:FindFirstChild("Evolution") :: IntValue?
	if cash then
		cash.Value = Format.Cash(data.Cash)
	end
	if steals then
		steals.Value = data.Stats.Steals
	end
	if rebirths then
		rebirths.Value = data.Rebirths
	end
end

local function buildBoard(cf: CFrame, board: typeof(BOARDS[1]), parent: Instance)
	local part = Instance.new("Part")
	part.Name = "Board_" .. board.Key
	part.Anchored = true
	part.Size = Vector3.new(26, 32, 1.4)
	part.CFrame = cf * CFrame.new(0, 17, 0)
	part.Color = Theme.Colors.Ink
	part.Material = Enum.Material.SmoothPlastic
	part.Parent = parent
	-- cadre lumineux aux couleurs du tableau
	for _, edge in {
		{ Vector3.new(27.6, 1.2, 1.8), CFrame.new(0, 16.6, 0) },
		{ Vector3.new(27.6, 1.2, 1.8), CFrame.new(0, -16.6, 0) },
		{ Vector3.new(1.2, 34.4, 1.8), CFrame.new(13.4, 0, 0) },
		{ Vector3.new(1.2, 34.4, 1.8), CFrame.new(-13.4, 0, 0) },
	} do
		local trim = Instance.new("Part")
		trim.Anchored = true
		trim.CanCollide = false
		trim.Size = edge[1]
		trim.CFrame = part.CFrame * edge[2]
		trim.Color = board.Color
		trim.Material = Enum.Material.Neon
		trim.Parent = parent
	end
	for _, side in { -1, 1 } do
		local leg = Instance.new("Part")
		leg.Anchored = true
		leg.Size = Vector3.new(1.6, 18, 1.6)
		leg.CFrame = cf * CFrame.new(side * 10, 1, 0.9)
		leg.Color = board.Color
		leg.Material = Enum.Material.Metal
		leg.Parent = parent
	end
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Front
	gui.CanvasSize = Vector2.new(520, 640)
	gui.LightInfluence = 0
	gui.Brightness = 1.4
	gui.Parent = part
	local title = Instance.new("TextLabel")
	title.Size = UDim2.new(1, 0, 0, 80)
	title.BackgroundColor3 = board.Color
	title.FontFace = Theme.Fonts.Title
	title.TextScaled = true
	title.TextColor3 = Theme.Colors.Ink
	title.Text = board.Title
	title.Parent = gui
	local list = Instance.new("Frame")
	list.Name = "List"
	list.Position = UDim2.fromOffset(0, 90)
	list.Size = UDim2.new(1, 0, 1, -90)
	list.BackgroundTransparency = 1
	list.Parent = gui
	local layout = Instance.new("UIListLayout")
	layout.Padding = UDim.new(0, 4)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = list
	boardGuis[board.Key] = list
end

local function renderBoard(board: typeof(BOARDS[1]), entries: { { name: string, value: number } })
	local list = boardGuis[board.Key]
	if not list then
		return
	end
	for _, child in list:GetChildren() do
		if child:IsA("TextLabel") then
			child:Destroy()
		end
	end
	for rank, entry in entries do
		local row = Instance.new("TextLabel")
		row.LayoutOrder = rank
		row.Size = UDim2.new(1, -16, 0, 50)
		row.BackgroundTransparency = if rank % 2 == 0 then 0.85 else 0.92
		row.BackgroundColor3 = Theme.Colors.Paper
		row.FontFace = Theme.Fonts.Body
		row.TextScaled = true
		row.TextXAlignment = Enum.TextXAlignment.Left
		local medal = if rank == 1 then "🥇" elseif rank == 2 then "🥈" elseif rank == 3 then "🥉" else "#" .. rank
		row.Text = ("  %s  %s — %s"):format(medal, entry.name, board.Format(entry.value))
		row.TextColor3 = if rank <= 3 then board.Color else Theme.Colors.Paper
		row.Parent = list
	end
	if #entries == 0 then
		local row = Instance.new("TextLabel")
		row.Size = UDim2.new(1, 0, 0, 50)
		row.BackgroundTransparency = 1
		row.FontFace = Theme.Fonts.Body
		row.TextScaled = true
		row.TextColor3 = Theme.Colors.Paper
		row.Text = "Be the first!"
		row.Parent = list
	end
end

local nameCache: { [number]: string } = {}
local function nameOf(userId: number): string
	if nameCache[userId] then
		return nameCache[userId]
	end
	local ok, name = pcall(Players.GetNameFromUserIdAsync, Players, userId)
	local result = if ok and name then name else "???"
	nameCache[userId] = result
	return result
end

local function refreshGlobal()
	for _, board in BOARDS do
		local store = stores[board.Key]
		if store then
			for _, player in Players:GetPlayers() do
				local data = DataService.Get(player)
				if data then
					-- les OrderedDataStore n'acceptent que des entiers 64 bits
					local value = math.clamp(math.floor(statOf(data, board.Key)), 0, 9e18)
					pcall(store.SetAsync, store, tostring(player.UserId), value)
				end
			end
			local ok, pages = pcall(store.GetSortedAsync, store, false, 10)
			if ok and pages then
				local entries = {}
				for _, item in (pages :: DataStorePages):GetCurrentPage() do
					local userId = tonumber(item.key) or 0
					table.insert(entries, { name = nameOf(userId), value = item.value })
				end
				renderBoard(board, entries)
			end
		end
	end
end

function LeaderboardService.Init()
	Players.PlayerAdded:Connect(function(player)
		local stats = Instance.new("Folder")
		stats.Name = "leaderstats"
		local cash = Instance.new("StringValue")
		cash.Name = "Cash"
		cash.Value = "$0"
		cash.Parent = stats
		local steals = Instance.new("IntValue")
		steals.Name = "Steals"
		steals.Parent = stats
		local rebirths = Instance.new("IntValue")
		rebirths.Name = "Evolution"
		rebirths.Parent = stats
		stats.Parent = player
	end)
	DataService.Loaded:Connect(function(player)
		LeaderboardService.Update(player)
	end)
	task.spawn(function()
		while true do
			task.wait(2)
			for _, player in Players:GetPlayers() do
				LeaderboardService.Update(player)
			end
		end
	end)
end

function LeaderboardService.Start(boardCFrames: { CFrame })
	local folder = Instance.new("Folder")
	folder.Name = "Leaderboards"
	folder.Parent = Workspace:WaitForChild("Map")
	for i, board in BOARDS do
		local cf = boardCFrames[i]
		if cf then
			buildBoard(cf, board, folder)
		end
		local ok, store = pcall(DataStoreService.GetOrderedDataStore, DataStoreService, board.Store)
		stores[board.Key] = if ok then store else nil
		renderBoard(board, {})
	end
	task.spawn(function()
		task.wait(10)
		while true do
			pcall(refreshGlobal)
			task.wait(120)
		end
	end)
end

return LeaderboardService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="36">
          <Properties>
            <string name="Name">MeteorService</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Pluie de météores : des œufs tombent dans le cratère (achetables par tous,
-- premier arrivé premier servi) et sur l'île de chaque joueur (météore perso,
-- tiré avec sa chance personnelle).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Kaijus = require(Shared.Config.Kaijus)
local Rarities = require(Shared.Config.Rarities)
local Economy = require(Shared.Config.Economy)
local Layout = require(Shared.Config.Layout)
local Roll = require(Shared.Logic.Roll)
local Format = require(Shared.Logic.Format)

local Registry = require(script.Parent.Registry)
local DataService = require(script.Parent.DataService)
local Router = require(script.Parent.Router)
local Notify = require(script.Parent.Notify)

local MeteorService = {}

local FALL_TIME = 2.6 -- secondes entre l'apparition et l'impact

local folder: Folder
local pads: { BasePart } = {}
local padUsed: { [number]: string } = {}
local meteors: { [string]: BasePart } = {}
local nextId = 0
local serverLuck = 1
local serverLuckUntil = 0
local personalNext: { [Player]: number } = {}

local function now(): number
	return Workspace:GetServerTimeNow()
end

-- Prix d'un œuf d'une rareté : moyenne des espèces achetables.
local eggPrices: { [string]: number } = {}
for _, r in Rarities.List do
	local total, n = 0, 0
	local pool: { any } = Kaijus.ByRarity[r.Id] or {}
	for _, s in pool do
		if s.Price > 0 then
			total += s.Price
			n += 1
		end
	end
	if n > 0 then
		eggPrices[r.Id] = math.floor(total / n)
	end
end

function MeteorService.EggPrice(rarity: string): number
	return eggPrices[rarity] or 100
end

function MeteorService.CraterLuck(): number
	local luck = 1
	if serverLuckUntil > now() then
		luck *= serverLuck
	end
	local event = Registry.EventService.Current()
	if event then
		luck *= event.Luck
	end
	return luck
end

local function publishLuck()
	Workspace:SetAttribute("CraterLuck", MeteorService.CraterLuck())
	Workspace:SetAttribute("ServerLuck", if serverLuckUntil > now() then serverLuck else 1)
	Workspace:SetAttribute("ServerLuckUntil", serverLuckUntil)
end

function MeteorService.AddServerLuck(mult: number, seconds: number)
	local t = now()
	serverLuck = math.max(serverLuck, mult)
	serverLuckUntil = math.max(serverLuckUntil, t) + seconds
	publishLuck()
end

local function spawnMeteor(position: Vector3, rarity: string, price: number, owner: Player?, pad: number?, lifetime: number): BasePart
	nextId += 1
	local id = "M" .. nextId
	local p = Instance.new("Part")
	p.Name = id
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Transparency = 1
	p.Size = Vector3.new(2, 2, 2)
	p.CFrame = CFrame.new(position)
	local t = now()
	p:SetAttribute("Id", id)
	p:SetAttribute("Rarity", rarity)
	p:SetAttribute("Price", price)
	p:SetAttribute("LandAt", t + FALL_TIME)
	p:SetAttribute("ExpireAt", t + FALL_TIME + lifetime)
	p:SetAttribute("Owner", if owner then owner.UserId else 0)
	p:SetAttribute("Pad", pad or 0)
	p.Parent = folder
	meteors[id] = p
	local r = Rarities.Get(rarity)
	if r.Announce and not owner then
		Notify.Feed(("%s %s METEOR INCOMING!"):format("☄️", string.upper(r.Name)), "Meteor", r.Color)
	end
	return p
end

local function removeMeteor(id: string)
	local m = meteors[id]
	if not m then
		return
	end
	meteors[id] = nil
	local pad = m:GetAttribute("Pad") or 0
	if pad > 0 and padUsed[pad] == id then
		padUsed[pad] = nil
	end
	m:Destroy()
end

local function craterStep()
	local free = {}
	for i = 1, #pads do
		if not padUsed[i] then
			table.insert(free, i)
		end
	end
	if #free == 0 then
		return
	end
	local pad = free[math.random(1, #free)]
	local rarity = Roll.Rarity(MeteorService.CraterLuck())
	local pos = pads[pad].Position + Vector3.new(0, 1.2, 0)
	local m = spawnMeteor(pos, rarity, MeteorService.EggPrice(rarity), nil, pad, Economy.MeteorLifetime)
	padUsed[pad] = m.Name
end

local function personalStep(player: Player)
	local plot = Registry.PlotService.Get(player)
	if not plot then
		return
	end
	-- Un seul météore perso à la fois
	for _, m in meteors do
		if m:GetAttribute("Owner") == player.UserId then
			return
		end
	end
	local luck = Registry.KaijuService.PersonalLuck(player)
	local rarity = Roll.Rarity(luck)
	local price = math.floor(MeteorService.EggPrice(rarity) * 0.8)
	local pos = (plot.CFrame * CFrame.new(Layout.PersonalPad.X, 1.2, Layout.PersonalPad.Z)).Position
	spawnMeteor(pos, rarity, price, player, nil, Economy.PersonalMeteorLifetime)
	Notify.Fx(player, "PersonalMeteor", { Rarity = rarity })
end

local function buy(player: Player, payload: any): Router.Result
	local id = Router.String(payload.Id)
	local m = id and meteors[id]
	local data = DataService.Get(player)
	if not m or not data or not id then
		return { ok = false, msg = "Too late!" }
	end
	local t = now()
	if (m:GetAttribute("LandAt") or 0) > t then
		return { ok = false, msg = "Wait for it to land!" }
	end
	local owner = m:GetAttribute("Owner") or 0
	if owner ~= 0 and owner ~= player.UserId then
		return { ok = false, msg = "This meteor belongs to someone else" }
	end
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not root or (root.Position - m.Position).Magnitude > 22 then
		return { ok = false, msg = "Get closer!" }
	end
	if not Registry.KaijuService.FreeNest(player) then
		return { ok = false, msg = "Your nests are full! Sell or unlock more." }
	end
	local price = m:GetAttribute("Price") or 0
	local isFree = data.Stats.EggsBought == 0 and Rarities.Get(m:GetAttribute("Rarity") or "Common").Order <= Economy.FreeFirstEggMaxOrder
	if not isFree and not DataService.Spend(player, "Cash", price) then
		return { ok = false, msg = "Need " .. Format.Cash(price) }
	end
	local rarity = m:GetAttribute("Rarity") :: string
	local from = m.Position
	removeMeteor(id)
	Notify.FxAll("MeteorBought", { Id = id, Buyer = player.UserId, Rarity = rarity, From = from })
	-- l'œuf s'envole vers la base : il arrive après l'animation
	task.delay(1.2, function()
		if player.Parent == Players then
			local rec = Registry.KaijuService.AddEgg(player, rarity)
			if not rec then
				Registry.KaijuService.GiveEgg(player, rarity, "Meteor")
			end
		end
	end)
	Registry.RewardService.Track(player, "EggsBought", 1)
	local r = Rarities.Get(rarity)
	if r.Order >= 4 then
		Notify.FeedExcept(player, ("%s grabbed the %s egg!"):format(player.DisplayName, string.upper(r.Name)), "Rare", r.Color)
	end
	return { ok = true, free = isFree }
end

function MeteorService.Init()
	folder = Workspace:WaitForChild("Meteors") :: Folder
	Router.On("BuyMeteor", buy, 4)

	Players.PlayerRemoving:Connect(function(player)
		personalNext[player] = nil
		for id, m in meteors do
			if m:GetAttribute("Owner") == player.UserId then
				removeMeteor(id)
			end
		end
	end)
end

function MeteorService.SetPads(list: { BasePart })
	pads = list
end

function MeteorService.Start()
	-- Pluie du cratère
	task.spawn(function()
		local timer = 3
		while true do
			task.wait(0.5)
			local event = Registry.EventService.Current()
			local rate = if event then event.MeteorRate else 1
			if rate > 0 then
				timer -= 0.5 * rate
			end
			if timer <= 0 then
				timer = Economy.MeteorInterval * (0.8 + math.random() * 0.4)
				craterStep()
			end
			-- expiration
			local t = now()
			for id, m in meteors do
				if (m:GetAttribute("ExpireAt") or 0) < t then
					Notify.FxAll("MeteorExpired", { Id = id })
					removeMeteor(id)
				end
			end
			publishLuck()
		end
	end)

	-- Météores personnels
	task.spawn(function()
		while true do
			task.wait(1)
			local t = os.clock()
			for _, player in Players:GetPlayers() do
				if DataService.Get(player) then
					if not personalNext[player] then
						personalNext[player] = t + 40
					elseif t >= personalNext[player] then
						personalNext[player] = t + Economy.PersonalMeteorInterval
						personalStep(player)
					end
				end
			end
		end
	end)
end

return MeteorService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="37">
          <Properties>
            <string name="Name">Notify</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Envoi de messages et d'effets aux clients.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)

local Notify = {}

local notifyEvent = Net.Event("Notify")
local fxEvent = Net.Event("Fx")
local feedEvent = Net.Event("Feed")

-- Toast pour un joueur. kind : Info | Good | Bad | Cash | Gem | Rare
function Notify.Toast(player: Player, text: string, kind: string?)
	notifyEvent:FireClient(player, text, kind or "Info")
end

-- Effet pour un joueur.
function Notify.Fx(player: Player, name: string, args: any?)
	fxEvent:FireClient(player, name, args)
end

-- Effet pour tous.
function Notify.FxAll(name: string, args: any?)
	fxEvent:FireAllClients(name, args)
end

-- Annonce serveur (bandeau + fil d'actualité). style : Heist | Rare | Event | Boss | Purchase
function Notify.Feed(text: string, style: string?, color: Color3?)
	feedEvent:FireAllClients(text, style or "Info", color)
end

function Notify.FeedExcept(except: Player, text: string, style: string?, color: Color3?)
	for _, p in Players:GetPlayers() do
		if p ~= except then
			feedEvent:FireClient(p, text, style or "Info", color)
		end
	end
end

return Notify
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="38">
          <Properties>
            <string name="Name">PlotService</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Îles des joueurs : attribution, apparition, bouclier (verrou), collecteur,
-- nids débloqués, protection des nouveaux joueurs.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Layout = require(Shared.Config.Layout)
local Economy = require(Shared.Config.Economy)

local Registry = require(script.Parent.Registry)
local DataService = require(script.Parent.DataService)
local Router = require(script.Parent.Router)
local Notify = require(script.Parent.Notify)

local MapBuilder = require(script.Parent.Parent.World.MapBuilder)

local PlotService = {}

local plots: { MapBuilder.PlotInfo } = {}
local ownerOf: { [number]: Player } = {} -- index d'île -> joueur
local plotOf: { [Player]: MapBuilder.PlotInfo } = {}

local function now(): number
	return Workspace:GetServerTimeNow()
end

function PlotService.SetMap(map: MapBuilder.MapInfo)
	plots = map.Plots
end

function PlotService.Get(player: Player): MapBuilder.PlotInfo?
	return plotOf[player]
end

function PlotService.Owner(index: number): Player?
	return ownerOf[index]
end

function PlotService.All(): { MapBuilder.PlotInfo }
	return plots
end

-- Position monde d'un nid.
function PlotService.NestCFrame(plot: MapBuilder.PlotInfo, slot: number): CFrame
	local local_ = Layout.Nests[slot]
	return plot.CFrame * CFrame.new(local_.X, 0.5, local_.Z)
end

function PlotService.UnlockedNests(player: Player): number
	local data = DataService.Get(player)
	if not data then
		return 0
	end
	local extra = if Registry.ShopService.HasPass(player, "ExtraNests") then Economy.PassBonusNests else 0
	return math.min(#Layout.Nests, data.Nests + extra)
end

function PlotService.RefreshNests(player: Player)
	local plot = plotOf[player]
	if plot then
		plot.Model:SetAttribute("Nests", PlotService.UnlockedNests(player))
	end
end

function PlotService.IsShielded(plot: MapBuilder.PlotInfo): boolean
	local t = now()
	return (plot.Model:GetAttribute("ShieldUntil") or 0) > t or (plot.Model:GetAttribute("ProtectedUntil") or 0) > t
end

function PlotService.ShieldDuration(player: Player): number
	local data = DataService.Get(player)
	local level = if data then data.Upgrades.Shield else 0
	local duration = Economy.ShieldBase + level * Economy.UpgradesById.Shield.PerLevel
	if Registry.ShopService.HasPass(player, "MegaShield") then
		duration *= 2
	end
	return duration
end

local function lock(player: Player): Router.Result
	local plot = plotOf[player]
	if not plot then
		return { ok = false }
	end
	local t = now()
	local model = plot.Model
	if (model:GetAttribute("ShieldUntil") or 0) > t then
		return { ok = false, msg = "Shield already active!" }
	end
	local cooldown = model:GetAttribute("ShieldCooldown") or 0
	if cooldown > t then
		return { ok = false, msg = ("Shield recharging (%ds)"):format(math.ceil(cooldown - t)) }
	end
	local duration = PlotService.ShieldDuration(player)
	model:SetAttribute("ShieldUntil", t + duration)
	model:SetAttribute("ShieldCooldown", t + duration + Economy.ShieldCooldown)
	Notify.FxAll("ShieldUp", { Plot = plot.Index })
	Registry.RewardService.Track(player, "Locks", 1)
	return { ok = true }
end

function PlotService.ForceShield(player: Player, seconds: number): boolean
	local plot = plotOf[player]
	if not plot then
		return false
	end
	local t = now()
	local current = math.max(t, plot.Model:GetAttribute("ShieldUntil") or 0)
	plot.Model:SetAttribute("ShieldUntil", current + seconds)
	plot.Model:SetAttribute("ShieldCooldown", current + seconds)
	Notify.FxAll("ShieldUp", { Plot = plot.Index })
	return true
end

-- Téléporte le personnage sur son île.
function PlotService.SpawnAt(player: Player)
	local plot = plotOf[player]
	local character = player.Character
	if not plot or not character then
		return
	end
	local spawnCf = plot.CFrame * CFrame.new(Layout.Spawn)
	character:PivotTo(CFrame.lookAt(spawnCf.Position, spawnCf.Position + plot.CFrame.LookVector))
end

local function assign(player: Player)
	for _, plot in plots do
		if not ownerOf[plot.Index] then
			ownerOf[plot.Index] = player
			plotOf[player] = plot
			local model = plot.Model
			model:SetAttribute("OwnerId", player.UserId)
			model:SetAttribute("OwnerName", player.DisplayName)
			model:SetAttribute("ShieldUntil", 0)
			model:SetAttribute("ShieldCooldown", 0)
			model:SetAttribute("ProtectedUntil", now() + Economy.NewPlayerProtection)
			model:SetAttribute("Stored", 0)
			player:SetAttribute("Plot", plot.Index)
			local title = plot.Sign:FindFirstChild("Title") :: TextLabel?
			if title then
				title.Text = string.upper(player.DisplayName) .. "'S ISLAND"
				title.TextColor3 = plot.Color
			end
			PlotService.RefreshNests(player)
			return plot
		end
	end
	return nil
end

local function release(player: Player)
	local plot = plotOf[player]
	if not plot then
		return
	end
	plotOf[player] = nil
	ownerOf[plot.Index] = nil
	local model = plot.Model
	for _, attr in { "OwnerId", "OwnerName", "ShieldUntil", "ShieldCooldown", "ProtectedUntil", "Nests", "Stored" } do
		model:SetAttribute(attr, nil)
	end
	local title = plot.Sign:FindFirstChild("Title") :: TextLabel?
	if title then
		title.Text = "EMPTY ISLAND"
		title.TextColor3 = Color3.fromRGB(255, 246, 222)
	end
	local amount = plot.CollectorGui:FindFirstChild("Amount") :: TextLabel?
	if amount then
		amount.Text = "$0"
	end
end

-- Pousse hors de l'île les intrus quand le bouclier est actif.
local function enforceShields()
	local t = now()
	for _, plot in plots do
		local owner = ownerOf[plot.Index]
		if owner and PlotService.IsShielded(plot) then
			local shieldActive = (plot.Model:GetAttribute("ShieldUntil") or 0) > t
			for _, other in Players:GetPlayers() do
				if other ~= owner then
					local character = other.Character
					local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
					if root and Layout.InPlot(plot.CFrame, root.Position, 1) then
						-- Hors de l'île, devant la porte
						local out = plot.CFrame * CFrame.new(math.clamp(plot.CFrame:PointToObjectSpace(root.Position).X, -8, 8), 3, -Layout.PlotDepth / 2 - 12)
						character:PivotTo(CFrame.lookAt(out.Position, out.Position + plot.CFrame.LookVector))
						Notify.Fx(other, "ShieldZap", { Plot = plot.Index, Protected = not shieldActive })
					end
				end
			end
		end
	end
end

function PlotService.Init()
	Router.On("Lock", lock, 2)

	DataService.Loaded:Connect(function(player)
		local plot = assign(player)
		if not plot then
			player:Kick("This server is full, please join another one!")
			return
		end
		if player.Character then
			PlotService.SpawnAt(player)
		end
	end)

	Players.PlayerAdded:Connect(function(player)
		player.CharacterAdded:Connect(function()
			task.defer(function()
				if plotOf[player] then
					PlotService.SpawnAt(player)
				end
			end)
		end)
	end)

	Players.PlayerRemoving:Connect(release)

	-- Contacts : collecteur et bouton de verrouillage (propriétaire uniquement)
	local debounce: { [Player]: number } = {}
	for _, plot in plots do
		plot.Collector.CanTouch = true
		plot.Collector.Touched:Connect(function(hit)
			local player = Players:GetPlayerFromCharacter(hit.Parent)
			if player and ownerOf[plot.Index] == player and (debounce[player] or 0) < os.clock() then
				debounce[player] = os.clock() + 0.6
				Registry.KaijuService.Collect(player)
			end
		end)
		plot.LockButton.CanTouch = true
		plot.LockButton.Touched:Connect(function(hit)
			local player = Players:GetPlayerFromCharacter(hit.Parent)
			if player and ownerOf[plot.Index] == player and (debounce[player] or 0) < os.clock() then
				debounce[player] = os.clock() + 1
				local result = lock(player)
				if not result.ok and result.msg then
					Notify.Toast(player, result.msg, "Bad")
				end
			end
		end)
	end

	task.spawn(function()
		while true do
			task.wait(0.2)
			enforceShields()
		end
	end)
end

return PlotService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="39">
          <Properties>
            <string name="Name">ProgressionService</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Évolution (rebirth) et Labo de fusion.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Kaijus = require(Shared.Config.Kaijus)
local Rarities = require(Shared.Config.Rarities)
local Economy = require(Shared.Config.Economy)
local Calc = require(Shared.Logic.Calc)
local Roll = require(Shared.Logic.Roll)
local Format = require(Shared.Logic.Format)

local Registry = require(script.Parent.Registry)
local DataService = require(script.Parent.DataService)
local Router = require(script.Parent.Router)
local Notify = require(script.Parent.Notify)

local ProgressionService = {}

ProgressionService.FuseMinStage = 3 -- Adulte
ProgressionService.FuseUpgradeChance = 0.5

local function isBusy(uid: string): boolean
	local anchor = Registry.KaijuService.Anchor(uid)
	return anchor ~= nil and (anchor:GetAttribute("CarriedBy") or 0) ~= 0
end

----------------------------------------------------------------------------
-- Rebirth
----------------------------------------------------------------------------

-- Trouve le kaiju sacrifié : rareté >= requise, stade Adulte ou plus, le moins précieux.
local function findSacrifice(data: any, needRarity: string): Calc.KaijuRecord?
	local need = Rarities.Get(needRarity).Order
	local best: Calc.KaijuRecord? = nil
	for _, rec in data.Kaijus do
		if not rec.Egg and rec.Species and Rarities.Get(rec.Rarity).Order >= need and Calc.Stage(rec) >= 3 and not isBusy(rec.Uid) then
			if not best or Calc.BaseIncome(rec) < Calc.BaseIncome(best) then
				best = rec
			end
		end
	end
	return best
end

local function rebirth(player: Player): Router.Result
	local data = DataService.Get(player)
	if not data then
		return { ok = false }
	end
	local nextRebirth = Calc.NextRebirth(data.Rebirths)
	if not nextRebirth then
		return { ok = false, msg = "Max evolution reached!" }
	end
	if data.Cash < nextRebirth.Cost then
		return { ok = false, msg = "Need " .. Format.Cash(nextRebirth.Cost) }
	end
	local sacrifice = findSacrifice(data, nextRebirth.NeedRarity)
	if not sacrifice then
		return { ok = false, msg = ("Need an ADULT %s kaiju (or better)"):format(string.upper(Rarities.Get(nextRebirth.NeedRarity).Name)) }
	end
	for _, rec in data.Kaijus do
		if isBusy(rec.Uid) then
			return { ok = false, msg = "One of your kaijus is being stolen!" }
		end
	end

	-- Réinitialisation
	for _, rec in table.clone(data.Kaijus) do
		Registry.KaijuService.RemoveRecord(player, rec.Uid)
	end
	data.Cash = Economy.StartCash
	data.Stored = 0
	data.Nests = Economy.StartNests
	data.PendingEggs = {}
	data.Rebirths += 1
	data.Gems += nextRebirth.Gems
	DataService.Replicate(player, "Cash", "Stored", "Nests", "PendingEggs", "Rebirths", "Gems", "Kaijus")
	Registry.PlotService.RefreshNests(player)
	Registry.KaijuService.RefreshPlayer(player)
	Registry.KaijuService.GiveEgg(player, nextRebirth.EggRarity, "Evolution")
	Registry.LeaderboardService.Update(player)

	Notify.FxAll("Rebirth", { UserId = player.UserId, Level = data.Rebirths })
	Notify.Feed(("🧬 %s EVOLVED to level %d!"):format(player.DisplayName, data.Rebirths), "Rebirth")
	return { ok = true, level = data.Rebirths }
end

----------------------------------------------------------------------------
-- Fusion
----------------------------------------------------------------------------

-- Probabilités d'une fusion (affichées au joueur avant de fusionner).
function ProgressionService.FuseOdds(a: Calc.KaijuRecord, b: Calc.KaijuRecord): { { Label: string, Chance: number } }
	local recipe = Kaijus.FindRecipe(a.Species or "", b.Species or "")
	if recipe then
		return { { Label = recipe.Name .. " (SECRET)", Chance = 1 } }
	end
	local ra, rb = Rarities.Get(a.Rarity), Rarities.Get(b.Rarity)
	local top = if ra.Order >= rb.Order then ra else rb
	local nextR = Rarities.Next(top.Id)
	if a.Species == b.Species then
		return {
			{ Label = "Same kaiju + guaranteed mutation", Chance = 1 },
		}
	end
	if nextR then
		return {
			{ Label = "Random " .. nextR.Name .. " kaiju", Chance = ProgressionService.FuseUpgradeChance },
			{ Label = "Random " .. top.Name .. " kaiju", Chance = 1 - ProgressionService.FuseUpgradeChance },
		}
	end
	return { { Label = "Random " .. top.Name .. " kaiju", Chance = 1 } }
end

local function fuse(player: Player, payload: any): Router.Result
	local ua, ub = Router.String(payload.A), Router.String(payload.B)
	local data = DataService.Get(player)
	if not ua or not ub or ua == ub or not data then
		return { ok = false, msg = "Pick two kaijus" }
	end
	local a = Registry.KaijuService.FindRecord(data, ua)
	local b = Registry.KaijuService.FindRecord(data, ub)
	if not a or not b or a.Egg or b.Egg or not a.Species or not b.Species then
		return { ok = false, msg = "Pick two hatched kaijus" }
	end
	if Calc.Stage(a) < ProgressionService.FuseMinStage or Calc.Stage(b) < ProgressionService.FuseMinStage then
		return { ok = false, msg = "Both kaijus must be ADULT or bigger" }
	end
	if isBusy(ua) or isBusy(ub) then
		return { ok = false, msg = "One of them is being stolen!" }
	end

	local resultSpecies: string
	local resultMutation: string? = nil
	local recipe = Kaijus.FindRecipe(a.Species, b.Species)
	if recipe then
		resultSpecies = recipe.Id
		resultMutation = a.Mutation or b.Mutation
	elseif a.Species == b.Species then
		resultSpecies = a.Species
		-- Mutation garantie : tire avec une grosse chance, sinon Or au minimum
		resultMutation = Roll.Mutation(Registry.KaijuService.PersonalLuck(player) * 8) or "Gold"
	else
		local ra, rb = Rarities.Get(a.Rarity), Rarities.Get(b.Rarity)
		local top = if ra.Order >= rb.Order then ra else rb
		local nextR = Rarities.Next(top.Id)
		local rarity = if nextR and math.random() < ProgressionService.FuseUpgradeChance then nextR.Id else top.Id
		resultSpecies = Roll.Species(rarity)
	end

	Registry.KaijuService.RemoveRecord(player, ua)
	Registry.KaijuService.RemoveRecord(player, ub)
	local rec = Registry.KaijuService.AddHatched(player, resultSpecies, resultMutation, 0)
	Registry.RewardService.Track(player, "Fusions", 1)
	local species = Kaijus.Get(resultSpecies)
	if rec and species then
		Notify.Fx(player, "Fused", { Uid = rec.Uid, Species = resultSpecies, Mutation = resultMutation, Secret = recipe ~= nil })
		if recipe then
			Notify.Feed(("🧪 %s DISCOVERED the SECRET kaiju %s!"):format(player.DisplayName, species.Name), "Rare", Rarities.Get("Secret").Glow)
		end
	end
	return { ok = true, species = resultSpecies, mutation = resultMutation }
end

local function fuseOdds(player: Player, payload: any): Router.Result
	local ua, ub = Router.String(payload.A), Router.String(payload.B)
	local data = DataService.Get(player)
	if not ua or not ub or not data then
		return { ok = false }
	end
	local a = Registry.KaijuService.FindRecord(data, ua)
	local b = Registry.KaijuService.FindRecord(data, ub)
	if not a or not b then
		return { ok = false }
	end
	return { ok = true, odds = ProgressionService.FuseOdds(a, b) }
end

function ProgressionService.Init()
	Router.On("Rebirth", rebirth, 1)
	Router.On("Fuse", fuse, 1)
	Router.On("FuseOdds", fuseOdds, 6)
end

return ProgressionService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="40">
          <Properties>
            <string name="Name">Registry</string>
            <string name="Source"><![CDATA[--!nocheck
-- Registre des services (rempli par Main) : évite les require circulaires.
-- Usage : local Registry = require(script.Parent.Registry) ; Registry.<Service>.<Fonction>()
return ({} :: any)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="41">
          <Properties>
            <string name="Name">RewardService</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Récompenses et rétention : série quotidienne, cadeaux de temps de jeu,
-- quêtes du jour, codes, groupe, roue de la fortune, Kaijudex, statistiques.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Rewards = require(Shared.Config.Rewards)
local Economy = require(Shared.Config.Economy)
local Kaijus = require(Shared.Config.Kaijus)
local Rarities = require(Shared.Config.Rarities)
local Progress = require(Shared.Logic.Progress)
local Calc = require(Shared.Logic.Calc)
local Roll = require(Shared.Logic.Roll)
local Format = require(Shared.Logic.Format)

local Registry = require(script.Parent.Registry)
local DataService = require(script.Parent.DataService)
local Router = require(script.Parent.Router)
local Notify = require(script.Parent.Notify)

local RewardService = {}

local sessionStart: { [Player]: number } = {}
local playtimeClaimed: { [Player]: { [number]: boolean } } = {}

----------------------------------------------------------------------------
-- Attribution générique
----------------------------------------------------------------------------

-- Donne une récompense ; renvoie une description courte.
function RewardService.Grant(player: Player, reward: Rewards.Reward, source: string?): string
	local data = DataService.Get(player)
	if not data then
		return ""
	end
	if reward.Kind == "Cash" then
		local amount = Calc.CashReward(reward.Amount or 60, Registry.KaijuService.IncomePerSecond(player), reward.MinCash)
		DataService.AddCash(player, amount)
		return Format.Cash(amount)
	elseif reward.Kind == "Gems" then
		DataService.AddGems(player, reward.Amount or 0)
		return (reward.Amount or 0) .. " Gems"
	elseif reward.Kind == "Potion" then
		local id = reward.Id or "Luck"
		data.Potions[id] = (data.Potions[id] or 0) + (reward.Amount or 1)
		DataService.Replicate(player, "Potions")
		local potion = Economy.PotionsById[id]
		return (reward.Amount or 1) .. "x " .. (if potion then potion.Name else id)
	elseif reward.Kind == "Egg" then
		local rarity = reward.Rarity or "Common"
		Registry.KaijuService.GiveEgg(player, rarity, source)
		return Rarities.Get(rarity).Name .. " Egg"
	elseif reward.Kind == "Spins" then
		data.Spins += reward.Amount or 1
		DataService.Replicate(player, "Spins")
		return (reward.Amount or 1) .. " Spins"
	end
	return ""
end

----------------------------------------------------------------------------
-- Statistiques et quêtes
----------------------------------------------------------------------------

local function ensureQuests(player: Player, data: any)
	local today = Progress.DayNumber(os.time())
	if data.Quests.Day ~= today then
		local list = {}
		for _, id in Progress.PickQuests(player.UserId, today) do
			table.insert(list, { Id = id, Progress = 0, Claimed = false })
		end
		data.Quests = { Day = today, List = list, BonusClaimed = false }
		DataService.Replicate(player, "Quests")
	end
end

function RewardService.Track(player: Player, stat: string, amount: number)
	local data = DataService.Get(player)
	if not data then
		return
	end
	data.Stats[stat] = (data.Stats[stat] or 0) + amount
	ensureQuests(player, data)
	local changed = false
	for _, q in data.Quests.List do
		local def = Progress.QuestDef(q.Id)
		if def and def.Stat == stat and not q.Claimed and q.Progress < def.Goal then
			q.Progress = math.min(def.Goal, q.Progress + amount)
			changed = true
			if q.Progress >= def.Goal then
				Notify.Fx(player, "QuestReady", { Id = q.Id, Text = def.Text:format(def.Goal) })
			end
		end
	end
	if changed then
		DataService.Replicate(player, "Quests")
	end
	DataService.Replicate(player, "Stats")
	Registry.LeaderboardService.Update(player)
end

local function claimQuest(player: Player, payload: any): Router.Result
	local id = Router.String(payload.Id)
	local data = DataService.Get(player)
	if not id or not data then
		return { ok = false }
	end
	ensureQuests(player, data)
	for _, q in data.Quests.List do
		if q.Id == id then
			local def = Progress.QuestDef(id)
			if not def or q.Claimed or q.Progress < def.Goal then
				return { ok = false, msg = "Not finished yet!" }
			end
			q.Claimed = true
			local text = RewardService.Grant(player, def.Reward, "Quest")
			DataService.Replicate(player, "Quests")
			Notify.Fx(player, "RewardClaimed", { Text = text, Source = "Quest" })
			return { ok = true, text = text }
		end
	end
	return { ok = false }
end

local function claimQuestBonus(player: Player): Router.Result
	local data = DataService.Get(player)
	if not data then
		return { ok = false }
	end
	ensureQuests(player, data)
	if data.Quests.BonusClaimed then
		return { ok = false, msg = "Already claimed today!" }
	end
	for _, q in data.Quests.List do
		if not q.Claimed then
			return { ok = false, msg = "Claim all quests first!" }
		end
	end
	data.Quests.BonusClaimed = true
	local text = RewardService.Grant(player, Rewards.AllQuestsBonus, "Daily Quests")
	DataService.Replicate(player, "Quests")
	Notify.Fx(player, "RewardClaimed", { Text = text, Source = "All quests" })
	return { ok = true, text = text }
end

----------------------------------------------------------------------------
-- Kaijudex
----------------------------------------------------------------------------

function RewardService.Discover(player: Player, speciesId: string, mutation: string?)
	local data = DataService.Get(player)
	if not data or not Kaijus.Get(speciesId) then
		return
	end
	local entry = data.Index[speciesId]
	local key = mutation or "Normal"
	local isNewSpecies = entry == nil
	if not entry then
		entry = {}
		data.Index[speciesId] = entry
	end
	if not entry[key] then
		entry[key] = true
		DataService.Replicate(player, "Index")
		Notify.Fx(player, "Discovered", { Species = speciesId, Mutation = mutation, NewSpecies = isNewSpecies })
		if isNewSpecies then
			Registry.KaijuService.RefreshPlayer(player)
		end
	end
end

----------------------------------------------------------------------------
-- Quotidien, temps de jeu, codes, groupe
----------------------------------------------------------------------------

local function claimDaily(player: Player): Router.Result
	local data = DataService.Get(player)
	if not data then
		return { ok = false }
	end
	local can, streak, cycle = Progress.DailyState(data.Daily, os.time())
	if not can then
		return { ok = false, msg = "Come back tomorrow!" }
	end
	local reward = Progress.DailyReward(streak, cycle)
	data.Daily = { Streak = streak, LastDay = Progress.DayNumber(os.time()), Cycle = cycle }
	local text = RewardService.Grant(player, reward, "Daily")
	DataService.Replicate(player, "Daily")
	Notify.Fx(player, "RewardClaimed", { Text = text, Source = "Day " .. streak })
	return { ok = true, text = text, streak = streak }
end

local function claimPlaytime(player: Player, payload: any): Router.Result
	local index = Router.Int(payload.Index, 1, #Rewards.Playtime)
	local started = sessionStart[player]
	if not index or not started then
		return { ok = false }
	end
	local claimed = playtimeClaimed[player]
	if claimed[index] then
		return { ok = false, msg = "Already claimed!" }
	end
	local entry = Rewards.Playtime[index]
	if (Workspace:GetServerTimeNow() - started) < entry.Minutes * 60 - 1 then
		return { ok = false, msg = "Not yet!" }
	end
	claimed[index] = true
	local text = RewardService.Grant(player, entry.Reward, "Gift")
	DataService.SendDerived(player, "PlaytimeClaimed", claimed)
	Notify.Fx(player, "RewardClaimed", { Text = text, Source = "Gift" })
	return { ok = true, text = text }
end

local function redeem(player: Player, payload: any): Router.Result
	local raw = Router.String(payload.Code, 32)
	local data = DataService.Get(player)
	if not raw or not data then
		return { ok = false, msg = "Invalid code" }
	end
	local code = string.upper((raw:gsub("%s", "")))
	local list = Rewards.Codes[code]
	if not list then
		return { ok = false, msg = "Invalid code" }
	end
	if data.Codes[code] then
		return { ok = false, msg = "Already redeemed!" }
	end
	data.Codes[code] = true
	local parts = {}
	for _, reward in list do
		table.insert(parts, RewardService.Grant(player, reward, "Code"))
	end
	DataService.Replicate(player, "Codes")
	local text = table.concat(parts, " + ")
	Notify.Fx(player, "RewardClaimed", { Text = text, Source = "Code " .. code })
	return { ok = true, text = text }
end

local function checkGroup(player: Player): boolean
	if Rewards.GroupId == 0 then
		return false
	end
	local ok, result = pcall(function()
		return player:IsInGroupAsync(Rewards.GroupId)
	end)
	return ok and result == true
end

local function claimGroup(player: Player): Router.Result
	local data = DataService.Get(player)
	if not data then
		return { ok = false }
	end
	if Rewards.GroupId == 0 then
		return { ok = false, msg = "Group rewards coming soon!" }
	end
	if data.GroupClaimed then
		return { ok = false, msg = "Already claimed!" }
	end
	if not checkGroup(player) then
		return { ok = false, msg = "Join the group first!" }
	end
	data.GroupClaimed = true
	local parts = {}
	for _, reward in Rewards.GroupReward do
		table.insert(parts, RewardService.Grant(player, reward, "Group"))
	end
	DataService.Replicate(player, "GroupClaimed")
	Registry.KaijuService.SetInGroup(player, true)
	local text = table.concat(parts, " + ")
	Notify.Fx(player, "RewardClaimed", { Text = text, Source = "Group" })
	return { ok = true, text = text }
end

----------------------------------------------------------------------------
-- Roue
----------------------------------------------------------------------------

local function spin(player: Player, payload: any): Router.Result
	local data = DataService.Get(player)
	if not data then
		return { ok = false }
	end
	local t = os.time()
	local cooldown = Economy.FreeSpinCooldown
	if Registry.ShopService.HasPass(player, "VIP") then
		cooldown = math.floor(cooldown * 0.5)
	end
	local source
	if data.FreeSpinAt <= t then
		data.FreeSpinAt = t + cooldown
		source = "Free"
	elseif data.Spins > 0 then
		data.Spins -= 1
		source = "Spin"
	elseif payload.UseGems == true then
		if Registry.ShopService.IsRandomRestricted(player) then
			return { ok = false, msg = "Not available in your region" }
		end
		if not DataService.Spend(player, "Gems", Economy.SpinGemPrice) then
			return { ok = false, msg = "Not enough gems" }
		end
		source = "Gems"
	else
		return { ok = false, msg = "No spins left!" }
	end
	local weights = {}
	for i, slot in Rewards.Wheel do
		weights[i] = slot.Weight
	end
	local index = Roll.Weighted(weights)
	local slot = Rewards.Wheel[index]
	DataService.Replicate(player, "Spins", "FreeSpinAt")
	-- La récompense arrive après l'animation de la roue
	task.delay(4.2, function()
		if player.Parent == Players then
			local text = RewardService.Grant(player, slot.Reward, "Wheel")
			Notify.Fx(player, "RewardClaimed", { Text = text, Source = "Wheel" })
			if slot.Reward.Kind == "Egg" and (slot.Reward.Rarity == "Mythic" or slot.Reward.Rarity == "Celestial") then
				Notify.Feed(("🎡 %s won a %s EGG on the wheel!"):format(player.DisplayName, string.upper(slot.Reward.Rarity or "")), "Rare")
			end
		end
	end)
	return { ok = true, index = index, source = source }
end

local function tutorial(player: Player, payload: any): Router.Result
	local step = Router.Int(payload.Step, 0, 10)
	local data = DataService.Get(player)
	if not step or not data then
		return { ok = false }
	end
	if step > data.Tutorial then
		data.Tutorial = step
		DataService.Replicate(player, "Tutorial")
	end
	return { ok = true }
end

local function saveSettings(player: Player, payload: any): Router.Result
	local data = DataService.Get(player)
	if not data then
		return { ok = false }
	end
	for _, key in { "Music", "Sfx", "LowFx" } do
		if type(payload[key]) == "boolean" then
			data.Settings[key] = payload[key]
		end
	end
	DataService.Replicate(player, "Settings")
	return { ok = true }
end

function RewardService.Init()
	Router.On("ClaimDaily", claimDaily, 2)
	Router.On("ClaimPlaytime", claimPlaytime, 4)
	Router.On("ClaimQuest", claimQuest, 4)
	Router.On("ClaimQuestBonus", claimQuestBonus, 2)
	Router.On("Redeem", redeem, 1)
	Router.On("ClaimGroup", claimGroup, 1)
	Router.On("Spin", spin, 1)
	Router.On("Tutorial", tutorial, 4)
	Router.On("Settings", saveSettings, 2)

	DataService.Loaded:Connect(function(player, data)
		sessionStart[player] = Workspace:GetServerTimeNow()
		playtimeClaimed[player] = {}
		DataService.SendDerived(player, "SessionStart", sessionStart[player])
		DataService.SendDerived(player, "PlaytimeClaimed", {})
		ensureQuests(player, data)
		local can = Progress.DailyState(data.Daily, os.time())
		if can then
			Notify.Fx(player, "DailyReady", {})
		end
		task.spawn(function()
			if checkGroup(player) then
				Registry.KaijuService.SetInGroup(player, true)
			end
		end)
	end)

	Players.PlayerRemoving:Connect(function(player)
		local data = DataService.Get(player)
		local started = sessionStart[player]
		if data and started then
			data.Stats.PlaySeconds += math.floor(Workspace:GetServerTimeNow() - started)
		end
		sessionStart[player] = nil
		playtimeClaimed[player] = nil
	end)
end

return RewardService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="42">
          <Properties>
            <string name="Name">Router</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Aiguillage des requêtes client. Chaque service enregistre ses actions ;
-- toutes les entrées sont validées ici (type) et limitées en débit.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)

local Router = {}

export type Result = { ok: boolean, msg: string?, [string]: any }
type Handler = (player: Player, payload: any) -> Result?

local handlers: { [string]: { fn: Handler, perSecond: number } } = {}
local buckets: { [Player]: { [string]: { tokens: number, last: number } } } = {}
local inputHandlers: { [string]: (player: Player, payload: any) -> () } = {}

-- `perSecond` : nombre maximal d'appels par seconde (seau à jetons).
function Router.On(action: string, fn: Handler, perSecond: number?)
	assert(handlers[action] == nil, "Action déjà enregistrée : " .. action)
	handlers[action] = { fn = fn, perSecond = perSecond or 4 }
end

function Router.OnInput(kind: string, fn: (player: Player, payload: any) -> ())
	inputHandlers[kind] = fn
end

local function allow(player: Player, action: string, perSecond: number): boolean
	local b = buckets[player]
	if not b then
		b = {}
		buckets[player] = b
	end
	local now = os.clock()
	local bucket = b[action]
	if not bucket then
		bucket = { tokens = perSecond * 2, last = now }
		b[action] = bucket
	end
	bucket.tokens = math.min(perSecond * 2, bucket.tokens + (now - bucket.last) * perSecond)
	bucket.last = now
	if bucket.tokens < 1 then
		return false
	end
	bucket.tokens -= 1
	return true
end

function Router.Init()
	local remote = Net.Function("Action")
	remote.OnServerInvoke = function(player: Player, action: any, payload: any): Result
		if type(action) ~= "string" then
			return { ok = false, msg = "Bad request" }
		end
		local h = handlers[action]
		if not h then
			return { ok = false, msg = "Unknown action" }
		end
		if not allow(player, action, h.perSecond) then
			return { ok = false, msg = "Slow down!" }
		end
		if payload ~= nil and type(payload) ~= "table" then
			return { ok = false, msg = "Bad payload" }
		end
		local ok, result = pcall(h.fn, player, payload or {})
		if not ok then
			warn("[Router] " .. action .. " : " .. tostring(result))
			return { ok = false, msg = "Something went wrong" }
		end
		return result or { ok = true }
	end

	Net.Event("Input").OnServerEvent:Connect(function(player: Player, kind: any, payload: any)
		if type(kind) ~= "string" then
			return
		end
		local fn = inputHandlers[kind]
		if not fn or not allow(player, "input:" .. kind, 12) then
			return
		end
		local ok, err = pcall(function()
			fn(player, payload)
		end)
		if not ok then
			warn("[Router] input " .. kind .. " : " .. tostring(err))
		end
	end)

	Players.PlayerRemoving:Connect(function(player)
		buckets[player] = nil
	end)
end

-- Aides de validation
function Router.String(v: any, maxLen: number?): string?
	if type(v) == "string" and #v <= (maxLen or 64) then
		return v
	end
	return nil
end

function Router.Int(v: any, min: number, max: number): number?
	if type(v) == "number" and v == v and v % 1 == 0 and v >= min and v <= max then
		return v
	end
	return nil
end

return Router
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="43">
          <Properties>
            <string name="Name">ShopService</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Boutique : Game Passes, Developer Products (Robux), améliorations, nids et
-- potions (monnaie du jeu). Respecte PolicyService pour le hasard payant.

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local PolicyService = game:GetService("PolicyService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Monetization = require(Shared.Config.Monetization)
local Economy = require(Shared.Config.Economy)
local Format = require(Shared.Logic.Format)

local Registry = require(script.Parent.Registry)
local DataService = require(script.Parent.DataService)
local Router = require(script.Parent.Router)
local Notify = require(script.Parent.Notify)

local ShopService = {}

local owned: { [Player]: { [string]: boolean } } = {}
local restricted: { [Player]: boolean } = {}
local pendingTarget: { [Player]: string } = {} -- kaiju ciblé par « Instant Grow »

local IS_STUDIO = RunService:IsStudio()

function ShopService.HasPass(player: Player, key: string): boolean
	local o = owned[player]
	if o and o[key] then
		return true
	end
	local data = DataService.Get(player)
	return data ~= nil and data.StudioPasses[key] == true
end

function ShopService.IsRandomRestricted(player: Player): boolean
	return restricted[player] == true
end

local function sendPasses(player: Player)
	local list = {}
	for _, pass in Monetization.Passes do
		if ShopService.HasPass(player, pass.Key) then
			list[pass.Key] = true
		end
	end
	DataService.SendDerived(player, "Passes", list)
	DataService.SendDerived(player, "RandomRestricted", restricted[player] == true)
end

-- Effets à appliquer quand un pass devient actif.
local function onPassGranted(player: Player, key: string)
	sendPasses(player)
	local pass = Monetization.PassByKey[key]
	Notify.Fx(player, "PassUnlocked", { Key = key, Name = pass and pass.Name or key })
	Registry.KaijuService.RefreshPlayer(player)
	Registry.StealService.RefreshSpeed(player)
end

local function loadOwnership(player: Player)
	local o = {}
	for _, pass in Monetization.Passes do
		if pass.Id ~= 0 then
			local ok, has = pcall(function()
				return MarketplaceService:UserOwnsGamePassAsync(player.UserId, pass.Id)
			end)
			if ok and has then
				o[pass.Key] = true
			end
		end
	end
	owned[player] = o
	local ok, info = pcall(function()
		return PolicyService:GetPolicyInfoForPlayerAsync(player)
	end)
	restricted[player] = ok and info and (info :: any).ArePaidRandomItemsRestricted == true or false
	sendPasses(player)
end

----------------------------------------------------------------------------
-- Produits : effets
----------------------------------------------------------------------------

local ProductHandlers: { [string]: (player: Player, data: any, product: Monetization.Product) -> boolean } = {}

local function income(player: Player): number
	return Registry.KaijuService.IncomePerSecond(player)
end

ProductHandlers.StarterPack = function(player, data)
	if data.StarterPack then
		-- déjà acheté : on rembourse en gemmes pour ne rien perdre
		DataService.AddGems(player, 150)
		return true
	end
	data.StarterPack = true
	DataService.AddGems(player, 150)
	data.Potions.Luck += 2
	DataService.Replicate(player, "Potions", "StarterPack")
	Registry.KaijuService.GiveEgg(player, "Legendary", "Starter Pack")
	return true
end

local function cash(player: Player, _data: any, product: Monetization.Product): boolean
	local amount = math.max(1000, math.floor(income(player) * (product.Amount or 600)))
	DataService.AddCash(player, amount)
	Notify.Fx(player, "CashBurst", { Amount = amount })
	return true
end
ProductHandlers.CashS = cash
ProductHandlers.CashM = cash
ProductHandlers.CashL = cash

local function gems(player: Player, _data: any, product: Monetization.Product): boolean
	DataService.AddGems(player, product.Amount or 0)
	Notify.Fx(player, "GemBurst", { Amount = product.Amount })
	return true
end
ProductHandlers.Gems100 = gems
ProductHandlers.Gems550 = gems
ProductHandlers.Gems1400 = gems
ProductHandlers.Gems3500 = gems

ProductHandlers.InstantGrow = function(player)
	return Registry.KaijuService.InstantGrow(player, pendingTarget[player])
end

ProductHandlers.InstantHatch = function(player)
	return Registry.KaijuService.HatchAll(player)
end

ProductHandlers.ShieldNow = function(player)
	return Registry.PlotService.ForceShield(player, 180)
end

ProductHandlers.Spins3 = function(player, data, product)
	data.Spins += product.Amount or 3
	DataService.Replicate(player, "Spins")
	return true
end

ProductHandlers.ServerLuck = function(player)
	Registry.MeteorService.AddServerLuck(2, 900)
	Registry.Notify.Feed(("🍀 %s activated SERVER LUCK x2 for everyone!"):format(player.DisplayName), "Purchase")
	return true
end

ProductHandlers.MeteorShower = function(player)
	Registry.EventService.Force("MeteorShower", player)
	return true
end

ProductHandlers.BloodMoon = function(player)
	Registry.EventService.Force("BloodMoon", player)
	return true
end

local function grantProduct(player: Player, product: Monetization.Product): boolean
	local data = DataService.Get(player)
	if not data then
		return false
	end
	local handler = ProductHandlers[product.Key]
	if not handler then
		warn("[Shop] Produit sans effet : " .. product.Key)
		return false
	end
	local ok = handler(player, data, product)
	if ok then
		Notify.Fx(player, "Purchased", { Key = product.Key, Name = product.Name })
	end
	return ok
end

local function processReceipt(receipt: any): Enum.ProductPurchaseDecision
	local player = Players:GetPlayerByUserId(receipt.PlayerId)
	if not player then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local data = DataService.WaitFor(player, 10)
	if not data then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local purchaseId = tostring(receipt.PurchaseId)
	if table.find(data.Receipts, purchaseId) then
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end
	local product = Monetization.ProductById[receipt.ProductId]
	if not product then
		warn("[Shop] Produit inconnu : " .. tostring(receipt.ProductId))
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local ok, granted = pcall(grantProduct, player, product)
	if not ok or not granted then
		warn("[Shop] Échec d'attribution : " .. tostring(granted))
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	table.insert(data.Receipts, purchaseId)
	while #data.Receipts > 50 do
		table.remove(data.Receipts, 1)
	end
	DataService.Save(player)
	return Enum.ProductPurchaseDecision.PurchaseGranted
end

----------------------------------------------------------------------------
-- Actions
----------------------------------------------------------------------------

local function buy(player: Player, payload: any): Router.Result
	local kind = Router.String(payload.Kind)
	local key = Router.String(payload.Key)
	if not kind or not key then
		return { ok = false, msg = "Bad request" }
	end
	if kind == "Pass" then
		local pass = Monetization.PassByKey[key]
		if not pass then
			return { ok = false, msg = "Unknown pass" }
		end
		if ShopService.HasPass(player, key) then
			return { ok = false, msg = "You already own this!" }
		end
		if pass.Random and restricted[player] then
			return { ok = false, msg = "Not available in your region" }
		end
		if pass.Id == 0 then
			if IS_STUDIO then
				local data = DataService.Get(player)
				data.StudioPasses[key] = true
				onPassGranted(player, key)
				return { ok = true, msg = "[Studio] Pass granted for testing" }
			end
			return { ok = false, msg = "Coming soon!" }
		end
		MarketplaceService:PromptGamePassPurchase(player, pass.Id)
		return { ok = true }
	elseif kind == "Product" then
		local product = Monetization.ProductByKey[key]
		if not product then
			return { ok = false, msg = "Unknown product" }
		end
		if product.Random and restricted[player] then
			return { ok = false, msg = "Not available in your region" }
		end
		local data = DataService.Get(player)
		if product.OneTime and data and data.StarterPack and product.Key == "StarterPack" then
			return { ok = false, msg = "Already claimed!" }
		end
		if type(payload.Target) == "string" then
			pendingTarget[player] = payload.Target
		end
		if product.Id == 0 then
			if IS_STUDIO then
				local ok = grantProduct(player, product)
				return { ok = ok, msg = if ok then "[Studio] Purchase simulated" else "Could not apply" }
			end
			return { ok = false, msg = "Coming soon!" }
		end
		MarketplaceService:PromptProductPurchase(player, product.Id)
		return { ok = true }
	end
	return { ok = false, msg = "Bad request" }
end

local function buyUpgrade(player: Player, payload: any): Router.Result
	local id = Router.String(payload.Id)
	local upgrade = id and Economy.UpgradesById[id]
	local data = DataService.Get(player)
	if not upgrade or not data then
		return { ok = false, msg = "Unknown upgrade" }
	end
	local level = data.Upgrades[upgrade.Id] or 0
	if level >= upgrade.MaxLevel then
		return { ok = false, msg = "Max level!" }
	end
	local price = Economy.UpgradePrice(upgrade.Id, level)
	if not DataService.Spend(player, "Cash", price) then
		return { ok = false, msg = "Not enough cash (" .. Format.Cash(price) .. ")" }
	end
	data.Upgrades[upgrade.Id] = level + 1
	DataService.Replicate(player, "Upgrades")
	Notify.Fx(player, "Upgraded", { Id = upgrade.Id, Level = level + 1 })
	Registry.StealService.RefreshSpeed(player)
	Registry.KaijuService.RefreshPlayer(player)
	return { ok = true }
end

local function buyNest(player: Player): Router.Result
	local data = DataService.Get(player)
	if not data then
		return { ok = false }
	end
	if data.Nests >= Economy.MaxNests then
		return { ok = false, msg = "All nests unlocked!" }
	end
	local price = Economy.NestPrice(data.Nests)
	if not DataService.Spend(player, "Cash", price) then
		return { ok = false, msg = "Not enough cash (" .. Format.Cash(price) .. ")" }
	end
	data.Nests += 1
	DataService.Replicate(player, "Nests")
	Registry.PlotService.RefreshNests(player)
	Registry.KaijuService.PlacePending(player)
	Notify.Fx(player, "NestUnlocked", { Count = data.Nests })
	return { ok = true }
end

local function buyPotion(player: Player, payload: any): Router.Result
	local id = Router.String(payload.Id)
	local potion = id and Economy.PotionsById[id]
	local data = DataService.Get(player)
	if not potion or not data then
		return { ok = false, msg = "Unknown potion" }
	end
	if not DataService.Spend(player, "Gems", potion.GemPrice) then
		return { ok = false, msg = "Not enough gems" }
	end
	data.Potions[potion.Id] += 1
	DataService.Replicate(player, "Potions")
	return { ok = true }
end

local function usePotion(player: Player, payload: any): Router.Result
	local id = Router.String(payload.Id)
	local potion = id and Economy.PotionsById[id]
	local data = DataService.Get(player)
	if not potion or not data then
		return { ok = false, msg = "Unknown potion" }
	end
	if data.Potions[potion.Id] <= 0 then
		return { ok = false, msg = "You don't have this potion" }
	end
	data.Potions[potion.Id] -= 1
	local now = os.time()
	data.Boosts[potion.Id] = math.max(data.Boosts[potion.Id], now) + potion.Duration
	DataService.Replicate(player, "Potions", "Boosts")
	Notify.Fx(player, "PotionUsed", { Id = potion.Id })
	Registry.KaijuService.RefreshPlayer(player)
	return { ok = true }
end

function ShopService.Init()
	MarketplaceService.ProcessReceipt = processReceipt
	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
		if not purchased then
			return
		end
		local pass = Monetization.PassById[passId]
		if pass then
			owned[player] = owned[player] or {}
			owned[player][pass.Key] = true
			onPassGranted(player, pass.Key)
		end
	end)

	Router.On("Buy", buy, 2)
	Router.On("BuyUpgrade", buyUpgrade, 6)
	Router.On("BuyNest", buyNest, 3)
	Router.On("BuyPotion", buyPotion, 4)
	Router.On("UsePotion", usePotion, 4)

	DataService.Loaded:Connect(function(player)
		loadOwnership(player)
	end)
	Players.PlayerRemoving:Connect(function(player)
		owned[player] = nil
		restricted[player] = nil
		pendingTarget[player] = nil
	end)
end

return ShopService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="44">
          <Properties>
            <string name="Name">StealService</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Le vol : attraper un kaiju chez un autre joueur, le ramener sur son île.
-- Plus il est gros, plus on est lent ; les Titans et Colosses se portent à deux.
-- Le « Bonker » (marteau gonflable) fait lâcher prise aux voleurs.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Kaijus = require(Shared.Config.Kaijus)
local Rarities = require(Shared.Config.Rarities)
local Growth = require(Shared.Config.Growth)
local Economy = require(Shared.Config.Economy)
local Layout = require(Shared.Config.Layout)
local Theme = require(Shared.Config.Theme)
local Calc = require(Shared.Logic.Calc)

local Registry = require(script.Parent.Registry)
local DataService = require(script.Parent.DataService)
local Router = require(script.Parent.Router)
local Notify = require(script.Parent.Notify)

local StealService = {}

type Carry = {
	Uid: string,
	Victim: Player,
	Lead: Player,
	Helper: Player?,
	Stage: number,
	Started: number,
	Lifting: boolean,
	LiftUntil: number,
	LastPos: Vector3?,
	LastCheck: number,
	Strikes: number,
}

local carries: { [string]: Carry } = {} -- Uid -> vol en cours
local carrying: { [Player]: string } = {} -- joueur -> Uid porté (chef ou aide)
local bonkCooldown: { [Player]: number } = {}
local stealCooldown: { [Player]: number } = {}

local BASE_SPEED = 22

local function rootOf(player: Player): BasePart?
	local character = player.Character
	return character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
end

local function humanoidOf(player: Player): Humanoid?
	local character = player.Character
	return character and character:FindFirstChildOfClass("Humanoid")
end

function StealService.IsCarrying(player: Player): boolean
	return carrying[player] ~= nil
end

function StealService.RefreshSpeed(player: Player)
	local humanoid = humanoidOf(player)
	local data = DataService.Get(player)
	if not humanoid or not data then
		return
	end
	local speed = BASE_SPEED + data.Upgrades.Sneakers * Economy.UpgradesById.Sneakers.PerLevel
	local uid = carrying[player]
	local carry = uid and carries[uid]
	if carry then
		local stage = Growth.Get(carry.Stage)
		local strength = 1 + data.Upgrades.Muscles * Economy.UpgradesById.Muscles.PerLevel
		speed = math.min(speed, BASE_SPEED * stage.CarrySpeed * strength)
		if carry.Lifting then
			speed = 4
		end
	end
	humanoid.WalkSpeed = speed
	player:SetAttribute("Carrying", uid or "")
end

local function setAnchorState(carry: Carry)
	local anchor = Registry.KaijuService.Anchor(carry.Uid)
	if not anchor then
		return
	end
	anchor:SetAttribute("CarriedBy", carry.Lead.UserId)
	anchor:SetAttribute("Helper", if carry.Helper then carry.Helper.UserId else 0)
	anchor:SetAttribute("Lifting", carry.Lifting)
	anchor:SetAttribute("LiftUntil", carry.LiftUntil)
end

-- Termine un vol. reason : Delivered | Dropped | Timeout | Left
local function endCarry(uid: string, reason: string, by: Player?)
	local carry = carries[uid]
	if not carry then
		return
	end
	carries[uid] = nil
	carrying[carry.Lead] = nil
	if carry.Helper then
		carrying[carry.Helper] = nil
	end
	local anchor = Registry.KaijuService.Anchor(uid)
	if anchor then
		anchor:SetAttribute("CarriedBy", 0)
		anchor:SetAttribute("Helper", 0)
		anchor:SetAttribute("Lifting", false)
	end
	for _, p in { carry.Lead, carry.Helper } do
		if p and p.Parent == Players then
			StealService.RefreshSpeed(p)
		end
	end
	if reason ~= "Delivered" then
		Notify.FxAll("KaijuReturned", { Uid = uid, Reason = reason })
		if carry.Victim.Parent == Players then
			if reason == "Dropped" and by == carry.Victim then
				Notify.Toast(carry.Victim, "You saved your kaiju! 💪", "Good")
				Registry.RewardService.Track(carry.Victim, "Saves", 1)
			else
				Notify.Toast(carry.Victim, "Your kaiju came back home!", "Good")
			end
			Notify.Fx(carry.Victim, "AlarmStop", { Uid = uid })
			Registry.KaijuService.RefreshPlayer(carry.Victim)
		end
		if carry.Lead.Parent == Players then
			local msg = if reason == "Timeout" then "Too slow! The kaiju escaped." elseif reason == "HelperLost" then "Your partner let go!" else "You dropped the kaiju!"
			Notify.Toast(carry.Lead, msg, "Bad")
		end
	end
end

local function startCarry(player: Player, uid: string, victim: Player, stage: number): Carry
	local needed = Growth.Get(stage).Carriers
	local carry: Carry = {
		Uid = uid,
		Victim = victim,
		Lead = player,
		Helper = nil,
		Stage = stage,
		Started = os.clock(),
		Lifting = needed > 1,
		LiftUntil = if needed > 1 then Workspace:GetServerTimeNow() + Economy.LiftWaitTime else 0,
		LastPos = nil,
		LastCheck = os.clock(),
		Strikes = 0,
	}
	carries[uid] = carry
	carrying[player] = uid
	setAnchorState(carry)
	StealService.RefreshSpeed(player)
	return carry
end

local function steal(player: Player, payload: any): Router.Result
	local uid = Router.String(payload.Uid)
	local data = DataService.Get(player)
	if not uid or not data then
		return { ok = false }
	end
	if carrying[player] then
		return { ok = false, msg = "Your hands are full!" }
	end
	if (stealCooldown[player] or 0) > os.clock() then
		return { ok = false, msg = "Catch your breath..." }
	end
	local anchor = Registry.KaijuService.Anchor(uid)
	local victim = Registry.KaijuService.OwnerOf(uid)
	if not anchor or not victim then
		return { ok = false, msg = "It's gone!" }
	end
	if victim == player then
		return { ok = false, msg = "That's yours!" }
	end
	if anchor:GetAttribute("Egg") then
		return { ok = false, msg = "Eggs are too fragile to steal!" }
	end
	if carries[uid] then
		local carry = carries[uid]
		if carry.Lifting and not carry.Helper then
			return StealService.Help(player, uid)
		end
		return { ok = false, msg = "Someone is already stealing it!" }
	end
	local plot = Registry.PlotService.Get(victim)
	if not plot or Registry.PlotService.IsShielded(plot) then
		return { ok = false, msg = "Their base is shielded!" }
	end
	local root = rootOf(player)
	local stage = anchor:GetAttribute("Stage") or 1
	local reach = 10 + Growth.Get(stage).Scale * 3
	if not root or (root.Position - anchor.Position).Magnitude > reach + 6 then
		return { ok = false, msg = "Get closer!" }
	end
	if not Registry.KaijuService.FreeNest(player) then
		return { ok = false, msg = "Your nests are full!" }
	end
	stealCooldown[player] = os.clock() + Economy.StealCooldown
	local carry = startCarry(player, uid, victim, stage)

	local species = Kaijus.Get(anchor:GetAttribute("Species") or "")
	Notify.Fx(victim, "Alarm", {
		Uid = uid,
		Thief = player.DisplayName,
		Species = if species then species.Name else "kaiju",
	})
	Notify.Fx(player, "Grabbed", { Uid = uid, Lifting = carry.Lifting })
	if carry.Lifting then
		Notify.FeedExcept(player, ("🆘 %s needs a hand lifting a %s! Help them!"):format(player.DisplayName, string.upper(Growth.Get(stage).Name)), "Help", Theme.Colors.Magma)
	end
	return { ok = true, lifting = carry.Lifting }
end

function StealService.Help(player: Player, uid: string): Router.Result
	local carry = carries[uid]
	if not carry or not carry.Lifting or carry.Helper then
		return { ok = false, msg = "No one needs help" }
	end
	if carrying[player] then
		return { ok = false, msg = "Your hands are full!" }
	end
	if player == carry.Victim then
		return { ok = false, msg = "Bonk them instead!" }
	end
	local root, leadRoot = rootOf(player), rootOf(carry.Lead)
	if not root or not leadRoot or (root.Position - leadRoot.Position).Magnitude > Economy.HelperMaxDistance then
		return { ok = false, msg = "Get closer to the thief!" }
	end
	carry.Helper = player
	carry.Lifting = false
	carry.Started = os.clock()
	carrying[player] = uid
	setAnchorState(carry)
	StealService.RefreshSpeed(carry.Lead)
	StealService.RefreshSpeed(player)
	Notify.Fx(carry.Lead, "HelperJoined", { Name = player.DisplayName })
	Notify.Fx(player, "Grabbed", { Uid = uid, Helper = true })
	return { ok = true }
end

local function deliver(carry: Carry)
	local lead, victim = carry.Lead, carry.Victim
	local anchor = Registry.KaijuService.Anchor(carry.Uid)
	local speciesId = anchor and anchor:GetAttribute("Species") or ""
	local victimData = DataService.Get(victim)
	local rec = victimData and Registry.KaijuService.FindRecord(victimData, carry.Uid)
	local baseIncome = if rec then Calc.BaseIncome(rec) else 0
	endCarry(carry.Uid, "Delivered")
	local moved = Registry.KaijuService.Transfer(victim, carry.Uid, lead)
	if not moved then
		Notify.Toast(lead, "No free nest! The kaiju ran home.", "Bad")
		Notify.FxAll("KaijuReturned", { Uid = carry.Uid, Reason = "Full" })
		return
	end
	local species = Kaijus.Get(speciesId)
	local rarity = Rarities.Get(moved.Rarity)
	local stageName = Growth.Get(Calc.Stage(moved)).Name
	Notify.Fx(lead, "HeistSuccess", { Uid = moved.Uid, Species = speciesId, Mutation = moved.Mutation, Stage = Calc.Stage(moved) })
	Notify.Fx(victim, "Robbed", { Thief = lead.DisplayName, Species = speciesId })
	Registry.RewardService.Track(lead, "Steals", 1)
	Registry.RewardService.Track(victim, "Stolen", 1)
	if carry.Helper and carry.Helper.Parent == Players then
		local cut = math.max(50, math.floor(baseIncome * 60 * Economy.HelperCut * Registry.KaijuService.Multiplier(carry.Helper)))
		DataService.AddCash(carry.Helper, cut)
		Notify.Fx(carry.Helper, "HeistCut", { Amount = cut, Leader = lead.DisplayName })
		Registry.RewardService.Track(carry.Helper, "Steals", 1)
	end
	local who = if carry.Helper then ("%s & %s"):format(lead.DisplayName, carry.Helper.DisplayName) else lead.DisplayName
	Notify.Feed(("🦹 %s stole %s's %s %s!"):format(who, victim.DisplayName, stageName, if species then species.Name else "kaiju"), "Heist", rarity.Color)
end

----------------------------------------------------------------------------
-- Bonk
----------------------------------------------------------------------------

local function bonk(player: Player)
	local data = DataService.Get(player)
	local root = rootOf(player)
	local humanoid = humanoidOf(player)
	if not data or not root or not humanoid or humanoid.Health <= 0 then
		return
	end
	if carrying[player] then
		return -- mains prises
	end
	local level = data.Upgrades.Bonker
	local cooldown = math.max(0.4, Economy.BonkCooldown - level * 0.08)
	if (bonkCooldown[player] or 0) > os.clock() then
		return
	end
	bonkCooldown[player] = os.clock() + cooldown
	local superBonk = Registry.ShopService.HasPass(player, "SuperBonk")
	local range = Economy.BonkRange + level * Economy.UpgradesById.Bonker.PerLevel
	local power = Economy.BonkKnockback
	if superBonk then
		range *= 1.5
		power *= 1.6
	end
	Notify.FxAll("BonkSwing", { UserId = player.UserId, Super = superBonk })

	local look = root.CFrame.LookVector
	local hitAny = false
	for _, other in Players:GetPlayers() do
		if other ~= player then
			local otherRoot = rootOf(other)
			if otherRoot then
				local offset = otherRoot.Position - root.Position
				local flat = Vector3.new(offset.X, 0, offset.Z)
				if flat.Magnitude <= range and math.abs(offset.Y) < 8 and (flat.Magnitude < 3 or flat.Unit:Dot(look) > 0.2) then
					hitAny = true
					local dir = if flat.Magnitude > 0.1 then flat.Unit else look
					Notify.Fx(other, "Knockback", { Velocity = dir * power + Vector3.new(0, power * 0.55, 0), From = player.DisplayName })
					Notify.FxAll("BonkHit", { UserId = other.UserId, Position = otherRoot.Position })
					local uid = carrying[other]
					if uid then
						endCarry(uid, "Dropped", player)
					end
				end
			end
		end
	end
	if hitAny then
		Registry.RewardService.Track(player, "Bonks", 1)
	end
	Registry.EventService.TryBossHit(player, root.Position, range)
end

----------------------------------------------------------------------------
-- Outil « Bonker »
----------------------------------------------------------------------------

local function makeBonker(super: boolean): Tool
	local tool = Instance.new("Tool")
	tool.Name = "Bonker"
	tool.ToolTip = "Bonk thieves to make them drop your kaiju!"
	tool.CanBeDropped = false
	tool.RequiresHandle = true
	tool.Grip = CFrame.new(0, -1.6, 0) * CFrame.Angles(0, math.rad(90), 0)

	local handle = Instance.new("Part")
	handle.Name = "Handle"
	handle.Size = Vector3.new(0.5, 4, 0.5)
	handle.Color = Theme.Colors.Ink
	handle.Material = Enum.Material.SmoothPlastic
	handle.CanCollide = false
	handle.Massless = true
	handle.Parent = tool

	local head = Instance.new("Part")
	head.Name = "Head"
	head.Shape = Enum.PartType.Cylinder
	head.Size = Vector3.new(3.4, 2.4, 2.4)
	head.Color = if super then Theme.Colors.Gold else Theme.Colors.Pink
	head.Material = if super then Enum.Material.Foil else Enum.Material.SmoothPlastic
	head.CanCollide = false
	head.Massless = true
	head.CFrame = handle.CFrame * CFrame.new(0, 2.2, 0) * CFrame.Angles(0, math.rad(90), 0)
	head.Parent = tool
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = handle
	weld.Part1 = head
	weld.Parent = head

	for _, side in { -1, 1 } do
		local cap = Instance.new("Part")
		cap.Name = "Cap"
		cap.Shape = Enum.PartType.Cylinder
		cap.Size = Vector3.new(0.3, 2.6, 2.6)
		cap.Color = Theme.Colors.White
		cap.CanCollide = false
		cap.Massless = true
		cap.CFrame = head.CFrame * CFrame.new(side * 1.7, 0, 0)
		cap.Parent = tool
		local w = Instance.new("WeldConstraint")
		w.Part0 = head
		w.Part1 = cap
		w.Parent = cap
	end
	return tool
end

local function giveTool(player: Player)
	local backpack = player:FindFirstChildOfClass("Backpack")
	if not backpack then
		return
	end
	for _, container in { backpack, player.Character } do
		if container then
			local existing = container:FindFirstChild("Bonker")
			if existing then
				existing:Destroy()
			end
		end
	end
	local tool = makeBonker(Registry.ShopService.HasPass(player, "SuperBonk"))
	tool.Parent = backpack
end

----------------------------------------------------------------------------
-- Boucle des vols
----------------------------------------------------------------------------

local function step()
	local t = Workspace:GetServerTimeNow()
	for uid, carry in carries do
		local lead = carry.Lead
		local leadRoot = rootOf(lead)
		local humanoid = humanoidOf(lead)
		if lead.Parent ~= Players or not leadRoot or not humanoid or humanoid.Health <= 0 then
			endCarry(uid, "Left")
		elseif carry.Victim.Parent ~= Players then
			endCarry(uid, "Left")
		elseif carry.Lifting then
			if t > carry.LiftUntil then
				endCarry(uid, "Timeout")
			end
		elseif os.clock() - carry.Started > Economy.StealMaxCarryTime then
			endCarry(uid, "Timeout")
		else
			local helper = carry.Helper
			if helper then
				local helperRoot = rootOf(helper)
				if helper.Parent ~= Players or not helperRoot or (helperRoot.Position - leadRoot.Position).Magnitude > Economy.HelperMaxDistance then
					endCarry(uid, "HelperLost")
					continue
				end
			end
			-- Anti-téléportation : un porteur ne peut pas dépasser sa vitesse de marche
			local now = os.clock()
			local dt = now - carry.LastCheck
			local pos = leadRoot.Position
			if carry.LastPos and dt > 0 then
				local flat = Vector3.new(pos.X - carry.LastPos.X, 0, pos.Z - carry.LastPos.Z).Magnitude
				-- marge large : sauts, chutes, latence réseau
				local allowed = (humanoid.WalkSpeed * 1.5 + 16) * dt + 8
				if flat > allowed then
					carry.Strikes += 1
					warn(("[StealService] déplacement suspect de %s (%.0f studs en %.2fs)"):format(lead.Name, flat, dt))
					endCarry(uid, "Dropped")
					continue
				end
			end
			carry.LastPos = pos
			carry.LastCheck = now
			local plot = Registry.PlotService.Get(lead)
			if plot and Layout.InPlot(plot.CFrame, pos, -2) then
				deliver(carry)
			end
		end
	end
end

function StealService.Init()
	Router.On("Steal", steal, 3)
	Router.On("Help", function(player, payload)
		local uid = Router.String(payload.Uid)
		if not uid then
			return { ok = false }
		end
		return StealService.Help(player, uid)
	end, 3)
	Router.On("Drop", function(player)
		local uid = carrying[player]
		if uid then
			endCarry(uid, "Dropped", player)
		end
		return { ok = true }
	end, 2)
	Router.OnInput("Bonk", function(player)
		bonk(player)
	end)

	Players.PlayerAdded:Connect(function(player)
		player.CharacterAdded:Connect(function(character)
			local uid = carrying[player]
			if uid then
				endCarry(uid, "Left")
			end
			local humanoid = character:WaitForChild("Humanoid", 10) :: Humanoid?
			if humanoid then
				StealService.RefreshSpeed(player)
				humanoid.Died:Connect(function()
					local current = carrying[player]
					if current then
						endCarry(current, "Left")
					end
				end)
			end
			task.wait(0.2)
			giveTool(player)
		end)
	end)

	DataService.Loaded:Connect(function(player)
		StealService.RefreshSpeed(player)
	end)

	Players.PlayerRemoving:Connect(function(player)
		for uid, carry in carries do
			if carry.Lead == player or carry.Helper == player or carry.Victim == player then
				endCarry(uid, "Left")
			end
		end
		bonkCooldown[player] = nil
		stealCooldown[player] = nil
	end)

	task.spawn(function()
		while true do
			task.wait(0.1)
			local ok, err = pcall(step)
			if not ok then
				warn("[StealService] " .. tostring(err))
			end
		end
	end)
end

function StealService.GiveTool(player: Player)
	giveTool(player)
end

return StealService
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="45">
        <Properties>
          <string name="Name">Vendor</string>
        </Properties>
        <Item class="StringValue" referent="46">
          <Properties>
            <string name="Name">ProfileStore.LICENSE</string>
            <string name="Value"><![CDATA[                                 Apache License
                           Version 2.0, January 2004
                        http://www.apache.org/licenses/

   TERMS AND CONDITIONS FOR USE, REPRODUCTION, AND DISTRIBUTION

   1. Definitions.

      "License" shall mean the terms and conditions for use, reproduction,
      and distribution as defined by Sections 1 through 9 of this document.

      "Licensor" shall mean the copyright owner or entity authorized by
      the copyright owner that is granting the License.

      "Legal Entity" shall mean the union of the acting entity and all
      other entities that control, are controlled by, or are under common
      control with that entity. For the purposes of this definition,
      "control" means (i) the power, direct or indirect, to cause the
      direction or management of such entity, whether by contract or
      otherwise, or (ii) ownership of fifty percent (50%) or more of the
      outstanding shares, or (iii) beneficial ownership of such entity.

      "You" (or "Your") shall mean an individual or Legal Entity
