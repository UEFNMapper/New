          <Item class="ModuleScript" referent="55">
            <Properties>
              <string name="Name">Audio</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Sons et musique. Utilise la version uploadée du pack original si configurée,
-- sinon le son public par défaut. Légère variation de hauteur à chaque lecture.

local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Sounds = require(Shared.Config.Sounds)

local State = require(script.Parent.State)

local Audio = {}

local sfxGroup = Instance.new("SoundGroup")
sfxGroup.Name = "SFX"
sfxGroup.Volume = 1
sfxGroup.Parent = SoundService
local musicGroup = Instance.new("SoundGroup")
musicGroup.Name = "Music"
musicGroup.Volume = 1
musicGroup.Parent = SoundService

local templates: { [string]: Sound } = {}
local currentMusic: Sound? = nil
local currentMusicKey: string? = nil
local lastPlayed: { [string]: number } = {}

local function idFor(key: string): string?
	local def = Sounds[key]
	if not def then
		return nil
	end
	if def.Uploaded and def.Uploaded ~= 0 then
		return "rbxassetid://" .. def.Uploaded
	end
	return def.Default
end

local function template(key: string): Sound?
	if templates[key] then
		return templates[key]
	end
	local def = Sounds[key]
	local id = idFor(key)
	if not def or not id then
		return nil
	end
	local s = Instance.new("Sound")
	s.Name = key
	s.SoundId = id
	s.Volume = def.Volume
	s.PlaybackSpeed = def.Speed or 1
	s.Looped = def.Looped == true
	templates[key] = s
	return s
end

-- Joue un effet. opts : { Pitch, Volume, Parent (3D), NoVary, Cooldown }
function Audio.Play(key: string, options: { [string]: any }?): Sound?
	local opts: { [string]: any } = options or {}
	local t = template(key)
	if not t then
		return nil
	end
	local cooldown = opts.Cooldown or 0.03
	local now = os.clock()
	if (lastPlayed[key] or 0) + cooldown > now then
		return nil
	end
	lastPlayed[key] = now
	local s = t:Clone()
	local vary = if opts.NoVary then 1 else (0.94 + math.random() * 0.12)
	s.PlaybackSpeed = t.PlaybackSpeed * (opts.Pitch or 1) * vary
	s.Volume = t.Volume * (opts.Volume or 1)
	s.SoundGroup = sfxGroup
	if opts.Parent then
		s.RollOffMaxDistance = opts.MaxDistance or 180
		s.RollOffMinDistance = 12
		s.Parent = opts.Parent
	else
		s.Parent = SoundService
	end
	s:Play()
	if not s.Looped then
		s.Ended:Once(function()
			s:Destroy()
		end)
		task.delay(12, function()
			if s.Parent then
				s:Destroy()
			end
		end)
	end
	return s
end

-- Son en boucle (alarme…) : renvoie le Sound à arrêter soi-même.
function Audio.Loop(key: string, opts: { [string]: any }?): Sound?
	local t = template(key)
	if not t then
		return nil
	end
	local s = t:Clone()
	s.Looped = true
	s.Volume = t.Volume * ((opts and opts.Volume) or 1)
	s.SoundGroup = sfxGroup
	s.Parent = (opts and opts.Parent) or SoundService
	s:Play()
	return s
end

function Audio.Music(key: string?)
	if key == currentMusicKey then
		return
	end
	currentMusicKey = key
	local old = currentMusic
	if old then
		TweenService:Create(old, TweenInfo.new(1.5), { Volume = 0 }):Play()
		task.delay(1.6, function()
			old:Destroy()
		end)
	end
	currentMusic = nil
	if not key then
		return
	end
	local t = template(key)
	if not t then
		return
	end
	local s = t:Clone()
	s.Looped = true
	s.SoundGroup = musicGroup
	local target = t.Volume
	s.Volume = 0
	s.Parent = SoundService
	s:Play()
	TweenService:Create(s, TweenInfo.new(2), { Volume = target }):Play()
	currentMusic = s
end

function Audio.Init()
	State.Observe("Settings", function(settings)
		if not settings then
			return
		end
		sfxGroup.Volume = if settings.Sfx then 1 else 0
		musicGroup.Volume = if settings.Music then 1 else 0
	end)
	-- Pré-chargement léger des sons les plus fréquents
	task.defer(function()
		local ContentProvider = game:GetService("ContentProvider")
		local list = {}
		for _, key in { "ui_click", "ui_hover", "cash_collect", "coin_tick", "meteor_impact", "egg_crack", "bonk" } do
			local t = template(key)
			if t then
				table.insert(list, t)
			end
		end
		pcall(ContentProvider.PreloadAsync, ContentProvider, list)
	end)
end

return Audio
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="56">
            <Properties>
              <string name="Name">CameraFx</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Secousses de caméra et coups de zoom (FOV).

local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local TweenService = game:GetService("TweenService")

local CameraFx = {}

local shakes: { { t0: number, d: number, a: number, f: number } } = {}
local baseFov = 70
local fovTween: Tween? = nil

-- intensité en studs, durée en s
function CameraFx.Shake(intensity: number, duration: number?, frequency: number?)
	table.insert(shakes, { t0 = os.clock(), d = duration or 0.4, a = intensity, f = frequency or 22 })
end

-- Secousse selon la distance à une position monde.
function CameraFx.ShakeAt(position: Vector3, intensity: number, radius: number, duration: number?)
	local camera = Workspace.CurrentCamera
	if not camera then
		return
	end
	local d = (camera.CFrame.Position - position).Magnitude
	if d < radius then
		CameraFx.Shake(intensity * (1 - d / radius), duration)
	end
end

function CameraFx.FovPunch(amount: number, duration: number?)
	local camera = Workspace.CurrentCamera
	if not camera then
		return
	end
	if fovTween then
		fovTween:Cancel()
	end
	camera.FieldOfView = baseFov + amount
	local tween = TweenService:Create(camera, TweenInfo.new(duration or 0.5, Enum.EasingStyle.Back), { FieldOfView = baseFov })
	tween:Play()
	fovTween = tween
end

function CameraFx.Init()
	RunService:BindToRenderStep("KaijuCameraShake", Enum.RenderPriority.Camera.Value + 1, function()
		if #shakes == 0 then
			return
		end
		local camera = Workspace.CurrentCamera
		if not camera then
			return
		end
		local now = os.clock()
		local offset = Vector3.zero
		local rot = 0
		for i = #shakes, 1, -1 do
			local s = shakes[i]
			local t = now - s.t0
			if t > s.d then
				table.remove(shakes, i)
			else
				local k = s.a * (1 - t / s.d) ^ 2
				offset += Vector3.new(math.noise(t * s.f, 0.3) * k, math.noise(0.7, t * s.f) * k, 0)
				rot += math.noise(t * s.f, 5.1) * k * 0.02
			end
		end
		camera.CFrame *= CFrame.new(offset) * CFrame.Angles(0, 0, rot)
	end)
end

return CameraFx
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="57">
            <Properties>
              <string name="Name">FxBus</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Distribue les événements « Fx » du serveur à tous les abonnés du client.
-- FxBus.On("Hatch", function(args) ... end)

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)

local FxBus = {}

local handlers: { [string]: { (any) -> () } } = {}

function FxBus.On(name: string, fn: (any) -> ())
	handlers[name] = handlers[name] or {}
	table.insert(handlers[name], fn)
end

-- Déclenche localement (ex. effets purement client).
function FxBus.Emit(name: string, args: any?)
	local list: { (any) -> () } = handlers[name] or {}
	for _, fn in list do
		task.spawn(fn, args or {})
	end
end

function FxBus.Init()
	Net.Event("Fx").OnClientEvent:Connect(function(name, args)
		FxBus.Emit(name, args)
	end)
end

return FxBus
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="58">
            <Properties>
              <string name="Name">Remote</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Appels au serveur. Remote.Call affiche l'erreur en toast (sauf silent).

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)

local Remote = {}

local action = Net.Function("Action")
local input = Net.Event("Input")

Remote.OnError = nil :: ((msg: string) -> ())?

function Remote.Call(name: string, payload: { [string]: any }?, silent: boolean?): { ok: boolean, msg: string?, [string]: any }
	local ok, result = pcall(action.InvokeServer, action, name, payload or {})
	if not ok or type(result) ~= "table" then
		result = { ok = false, msg = "Connection problem" }
	end
	if not result.ok and result.msg and not silent and Remote.OnError then
		Remote.OnError(result.msg)
	end
	return result
end

function Remote.Input(kind: string, payload: any?)
	input:FireServer(kind, payload)
end

return Remote
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="59">
            <Properties>
              <string name="Name">State</string>
              <string name="Source"><![CDATA[--!nonstrict
-- État local : copie des données du joueur reçues du serveur + valeurs dérivées.
-- State.Observe(clé, fn) appelle fn tout de suite puis à chaque changement.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)
local Signal = require(Shared.Util.Signal)

local State = {}

local values: { [string]: any } = {}
local signals: { [string]: any } = {}
State.Loaded = false
State.LoadedSignal = Signal.new()
State.AnyChanged = Signal.new()

local function signalFor(key: string)
	local s = signals[key]
	if not s then
		s = Signal.new()
		signals[key] = s
	end
	return s
end

function State.Get(key: string): any
	return values[key]
end

function State.Set(key: string, value: any)
	values[key] = value
	signalFor(key):Fire(value)
	State.AnyChanged:Fire(key, value)
end

function State.Changed(key: string)
	return signalFor(key)
end

function State.Observe(key: string, fn: (any) -> ())
	if values[key] ~= nil then
		task.spawn(fn, values[key])
	end
	return signalFor(key):Connect(fn)
end

function State.WaitLoaded()
	if not State.Loaded then
		State.LoadedSignal:Wait()
	end
end

function State.Init()
	Net.Event("Data").OnClientEvent:Connect(function(patch, full)
		for key, value in patch do
			State.Set(key, value)
		end
		if full and not State.Loaded then
			State.Loaded = true
			State.LoadedSignal:Fire()
		end
	end)
end

return State
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="60">
            <Properties>
              <string name="Name">UIRegistry</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Registre côté client (rempli par Main.client) : écrans et services d'UI
-- partagés, pour éviter les require circulaires.
--   UIRegistry.Screens.Shop.Open("Upgrades")
--   UIRegistry.Toast("Hello", "Good")
--   UIRegistry.OpenKaiju(uid)
local UIRegistry = {
	Screens = {},
	Toast = function(_text: string, _kind: string?) end,
	Announce = function(_text: string, _color: Color3?, _subtitle: string?, _sound: string?) end,
	OpenKaiju = function(_uid: string) end,
	ShowOdds = function(_title: string, _rows: { { Label: string, Chance: number, Color: Color3? } }) end,
}
return UIRegistry
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="LocalScript" referent="61">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Point d'entrée client : fondations, attente des données, UI, monde, effets.

local Players = game:GetService("Players")
local StarterGui = game:GetService("StarterGui")

local player = Players.LocalPlayer
local Controllers = script.Parent:WaitForChild("Controllers")
local UI = script.Parent:WaitForChild("UI")
local World = script.Parent:WaitForChild("World")

local State = require(Controllers.State)
local Audio = require(Controllers.Audio)
local CameraFx = require(Controllers.CameraFx)
local FxBus = require(Controllers.FxBus)
local UIRegistry = require(Controllers.UIRegistry)

State.Init()
Audio.Init()
CameraFx.Init()

State.WaitLoaded()

local function safeInit(name: string, module: any)
	local ok, err = pcall(function()
		if module.Init then
			module.Init()
		end
	end)
	if not ok then
		warn(("[Client] %s.Init a échoué : %s"):format(name, tostring(err)))
	end
end

-- Interface
local Kit = require(UI.Kit)
Kit.Root()
safeInit("Notifications", require(UI.Notifications))
safeInit("PromptStyle", require(UI.PromptStyle))
safeInit("Hud", require(UI.Hud))
safeInit("Cinematics", require(UI.Cinematics))

-- Fenêtres
local screensFolder = UI:WaitForChild("Screens")
for _, module in screensFolder:GetChildren() do
	if module:IsA("ModuleScript") then
		local ok, screen = pcall(require, module)
		if ok then
			UIRegistry.Screens[module.Name] = screen
			safeInit(module.Name, screen)
		else
			warn(("[Client] écran %s : %s"):format(module.Name, tostring(screen)))
		end
	end
end

-- Monde
for _, name in { "KaijuRenderer", "MeteorRenderer", "PlotVisuals", "EventVisuals", "CharacterFx", "Tutorial" } do
	safeInit(name, require(World:WaitForChild(name)))
end

-- Les effets serveur n'arrivent qu'une fois tout le monde abonné
FxBus.Init()

pcall(function()
	StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, true)
end)
player:SetAttribute("ClientReady", true)
print("[Steal a Kaiju] client prêt")
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="62">
          <Properties>
            <string name="Name">UI</string>
          </Properties>
          <Item class="ModuleScript" referent="63">
            <Properties>
              <string name="Name">Cinematics</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Cinématiques plein écran : révélation d'éclosion (dramaturgie selon la
-- rareté), casse réussie, vol subi, évolution, pass débloqué, récompenses,
-- découvertes du Kaijudex. Une file d'attente évite les chevauchements.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Kaijus = require(Shared.Config.Kaijus)
local Rarities = require(Shared.Config.Rarities)
local Mutations = require(Shared.Config.Mutations)
local Growth = require(Shared.Config.Growth)
local Format = require(Shared.Logic.Format)

local Kit = require(script.Parent.Kit)
local Viewport = require(script.Parent.Viewport)
local Controllers = script.Parent.Parent.Controllers
local Audio = require(Controllers.Audio)
local FxBus = require(Controllers.FxBus)
local CameraFx = require(Controllers.CameraFx)
local UIRegistry = require(Controllers.UIRegistry)

local C = Kit.Colors
local F = Kit.Fonts

local Cinematics = {}

local layer: ScreenGui
local smallLayer: ScreenGui
local queue: { () -> () } = {}
local running = false

local function enqueue(fn: () -> ())
	table.insert(queue, fn)
	if running then
		return
	end
	running = true
	task.spawn(function()
		while #queue > 0 do
			local job = table.remove(queue, 1)
			local ok, err = pcall(job)
			if not ok then
				warn("[Cinematics] " .. tostring(err))
			end
		end
		running = false
	end)
end

-- Scène vide plein écran ; renvoie le cadre, le fond et une fonction de fermeture.
local function stage(backdropColor: Color3?): (Frame, Frame, (number?) -> ())
	layer.Enabled = true
	local root = Kit.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Parent = layer })
	local backdrop = Kit.new("TextButton", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = backdropColor or C.Ink,
		BackgroundTransparency = 1,
		Text = "",
		AutoButtonColor = false,
		Parent = root,
	})
	Kit.Tween(backdrop, 0.3, { BackgroundTransparency = 0.12 })
	local center = Kit.new("Frame", {
		Size = UDim2.fromOffset(1000, 640),
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundTransparency = 1,
		Parent = root,
	})
	Kit.AutoScale(center)
	local closed = false
	local function close(delay: number?)
		if closed then
			return
		end
		closed = true
		task.wait(delay or 0)
		Kit.Tween(backdrop, 0.3, { BackgroundTransparency = 1 })
		Kit.Tween(Kit.ScaleOf(center), 0.25, { Scale = 0 }, Enum.EasingStyle.Back, Enum.EasingDirection.In)
		task.wait(0.32)
		root:Destroy()
		if #layer:GetChildren() == 0 then
			layer.Enabled = false
		end
	end
	return center, backdrop, close
end

local function flash(color: Color3?, duration: number?)
	local f = Kit.new("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = color or C.White,
		BackgroundTransparency = 0,
		ZIndex = 100,
		Parent = layer,
	})
	Kit.Tween(f, duration or 0.6, { BackgroundTransparency = 1 })
	task.delay((duration or 0.6) + 0.05, function()
		f:Destroy()
	end)
end

local function slamText(parent: Instance, props): TextLabel
	local label = Kit.Text({
		Size = props.Size or UDim2.fromOffset(900, 110),
		Position = props.Position or UDim2.fromScale(0.5, 0.78),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Text = props.Text,
		FontFace = props.Font or F.Impact,
		TextColor3 = props.Color or C.White,
		Stroke = props.Stroke or 6,
		MaxTextSize = props.MaxTextSize or 110,
		Rotation = props.Rotation or -3,
		ZIndex = props.ZIndex or 20,
		Parent = parent,
	})
	Kit.Pop(label, props.From or 3, 0.4)
	return label
end

-- Texte arc-en-ciel animé.
local function rainbow(label: TextLabel)
	local g = Kit.new("UIGradient", {
		Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 80, 80)),
			ColorSequenceKeypoint.new(0.25, Color3.fromRGB(255, 220, 60)),
			ColorSequenceKeypoint.new(0.5, Color3.fromRGB(90, 255, 120)),
			ColorSequenceKeypoint.new(0.75, Color3.fromRGB(80, 180, 255)),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(220, 90, 255)),
		}),
		Parent = label,
	})
	label.TextColor3 = C.White
	local conn
	conn = RunService.RenderStepped:Connect(function()
		if not label.Parent then
			conn:Disconnect()
			return
		end
		g.Offset = Vector2.new(math.sin(os.clock() * 2) * 0.5, 0)
	end)
end

----------------------------------------------------------------------------
-- Éclosion
----------------------------------------------------------------------------

local HATCH_SOUND = { Common = "hatch_common", Rare = "hatch_common", Epic = "hatch_epic", Legendary = "hatch_legendary", Mythic = "hatch_legendary", Celestial = "hatch_secret", Secret = "hatch_secret" }

local function hatchReveal(args)
	local species = Kaijus.Get(args.Species or "")
	if not species then
		return
	end
	local rarity = Rarities.Get(args.Rarity or species.Rarity)
	local mutation = Mutations.Get(args.Mutation)
	local order = rarity.Order
	local center, backdrop, close = stage()

	local burst = Kit.Starburst({
		Size = UDim2.fromOffset(700 + order * 90, 700 + order * 90),
		Position = UDim2.fromScale(0.5, 0.42),
		Color = rarity.Color,
		Rays = 10 + order * 3,
		Transparency = 0.7,
		Period = 14 - order,
		Parent = center,
	})
	burst.Visible = false

	-- L'œuf tremble de plus en plus
	local eggVp = Viewport.new({ Egg = rarity.Id, Size = UDim2.fromOffset(340, 340), Position = UDim2.fromScale(0.5, 0.42), AnchorPoint = Vector2.new(0.5, 0.5), Spin = false, ZIndex = 10, Parent = center })
	eggVp.Angle = 0.4
	eggVp:_update()
	Kit.Pop(eggVp.Frame, 0.2, 0.5)
	local wobbles = 3 + math.min(order, 4)
	for i = 1, wobbles do
		local amp = 6 + i * 3
		Audio.Play("egg_wobble", { Pitch = 1 + i * 0.05 })
		Kit.Tween(eggVp.Frame, 0.09, { Rotation = amp }, Enum.EasingStyle.Sine)
		task.wait(0.09)
		Kit.Tween(eggVp.Frame, 0.12, { Rotation = -amp }, Enum.EasingStyle.Sine)
		task.wait(0.12)
		Kit.Tween(eggVp.Frame, 0.09, { Rotation = 0 }, Enum.EasingStyle.Sine)
		task.wait(math.max(0.12, 0.45 - i * 0.06))
	end
	if order >= 4 then
		-- Suspense : le fond vire à la couleur de la rareté
		Kit.Tween(backdrop, 0.6, { BackgroundColor3 = rarity.Color:Lerp(C.Ink, 0.82) })
		Audio.Play("meteor_rare_alarm")
		task.wait(0.7)
	end

	Audio.Play("egg_crack")
	Audio.Play(HATCH_SOUND[rarity.Id] or "hatch_common")
	flash(rarity.Glow, 0.7)
	CameraFx.Shake(0.3 + order * 0.25, 0.6)
	eggVp:Destroy()
	burst.Visible = true
	Kit.Pop(burst, 0.2, 0.6)

	local vp = Viewport.new({ Species = species.Id, Mutation = args.Mutation, Size = UDim2.fromOffset(420, 420), Position = UDim2.fromScale(0.5, 0.4), AnchorPoint = Vector2.new(0.5, 0.5), Speed = 1.2, ZIndex = 10, Parent = center })
	Kit.Pop(vp.Frame, 0.1, 0.6)

	local title = slamText(center, { Text = string.upper(species.Name), Color = rarity.Color, Position = UDim2.fromScale(0.5, 0.78) })
	if rarity.Id == "Secret" then
		title.TextColor3 = C.White
		rainbow(title)
	end
	Kit.Shake(title, 10, 0.4)
	local chips = Kit.new("Frame", {
		Size = UDim2.fromOffset(700, 40),
		Position = UDim2.fromScale(0.5, 0.9),
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundTransparency = 1,
		ZIndex = 20,
		Parent = center,
	}, { Kit.List(Enum.FillDirection.Horizontal, 12, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Center) })
	local rChip = Kit.Chip({ Text = string.upper(rarity.Name), Color = rarity.Color, AutoWidth = true, Size = UDim2.fromOffset(0, 38), TextSize = 26, LayoutOrder = 1, ZIndex = 21, Parent = chips })
	Kit.Pop(rChip, 0.2)
	if mutation then
		task.wait(0.35)
		local mChip = Kit.Chip({ Text = ("%s  x%d"):format(string.upper(mutation.Name), mutation.Mult), Color = mutation.Color, AutoWidth = true, Size = UDim2.fromOffset(0, 38), TextSize = 26, LayoutOrder = 2, ZIndex = 21, Parent = chips })
		if mutation.Id == "Rainbow" then
			rainbow(mChip:FindFirstChild("Text") :: TextLabel)
		end
		Kit.Pop(mChip, 2.5, 0.4)
		Audio.Play("stage_up")
		CameraFx.Shake(0.4, 0.3)
	end
	local income = species.Income * (if mutation then mutation.Mult else 1)
	local incomeChip = Kit.Chip({ Text = ("+%s/s"):format(Format.Cash(income)), Color = C.RadioactiveDark, AutoWidth = true, Size = UDim2.fromOffset(0, 38), TextSize = 26, LayoutOrder = 3, ZIndex = 21, Parent = chips })
	Kit.Pop(incomeChip, 0.2)
	Kit.Text({
		Size = UDim2.fromOffset(600, 26),
		Position = UDim2.fromScale(0.5, 0.97),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Text = '"' .. species.Flavor .. '"',
		FontFace = F.Body,
		TextColor3 = C.Paper,
		Stroke = 2,
		ZIndex = 20,
		Parent = center,
	})

	local done = false
	backdrop.Activated:Connect(function()
		done = true
	end)
	local t0 = os.clock()
	while not done and os.clock() - t0 < 2.6 + order * 0.35 do
		task.wait(0.05)
	end
	close()
end

----------------------------------------------------------------------------
-- Casse / vol
----------------------------------------------------------------------------

local function heistSuccess(args)
	local species = Kaijus.Get(args.Species or "")
	local center, _backdrop, close = stage()
	Kit.Starburst({ Size = UDim2.fromOffset(900, 900), Position = UDim2.fromScale(0.5, 0.45), Color = C.Gold, Parent = center })
	Kit.Hazard({ Size = UDim2.new(1.2, 0, 0, 22), Position = UDim2.fromScale(0.5, 0.08), AnchorPoint = Vector2.new(0.5, 0.5), Parent = center }).Rotation = -3
	Kit.Hazard({ Size = UDim2.new(1.2, 0, 0, 22), Position = UDim2.fromScale(0.5, 0.98), AnchorPoint = Vector2.new(0.5, 0.5), Parent = center }).Rotation = 2
	if species then
		local vp = Viewport.new({ Species = species.Id, Mutation = args.Mutation, Size = UDim2.fromOffset(360, 360), Position = UDim2.fromScale(0.5, 0.45), AnchorPoint = Vector2.new(0.5, 0.5), Speed = 1.4, ZIndex = 10, Parent = center })
		Kit.Pop(vp.Frame, 0.2, 0.5)
	end
	Audio.Play("heist_success")
	slamText(center, { Text = "HEIST COMPLETE!", Color = C.Gold, Position = UDim2.fromScale(0.5, 0.16), Rotation = -4 })
	local stage_ = Growth.Get(args.Stage or 1)
	slamText(center, {
		Text = ("You stole a %s %s!"):format(stage_.Name, if species then species.Name else "kaiju"),
		Font = F.Title,
		Color = C.White,
		Size = UDim2.fromOffset(800, 50),
		Position = UDim2.fromScale(0.5, 0.82),
		Stroke = 3,
		MaxTextSize = 44,
		Rotation = 1,
		From = 0.4,
	})
	CameraFx.Shake(0.8, 0.5)
	task.wait(3)
	close()
end

local function robbed(args)
	local species = Kaijus.Get(args.Species or "")
	local center, _backdrop, close = stage(C.Red:Lerp(C.Ink, 0.5))
	slamText(center, { Text = "YOU GOT ROBBED!", Color = C.Red, Position = UDim2.fromScale(0.5, 0.35), Rotation = 3 })
	slamText(center, {
		Text = ("%s stole your %s 😤"):format(args.Thief or "Someone", if species then species.Name else "kaiju"),
		Font = F.Title,
		Size = UDim2.fromOffset(800, 50),
		Position = UDim2.fromScale(0.5, 0.52),
		Stroke = 3,
		MaxTextSize = 44,
		Rotation = -1,
		From = 0.4,
	})
	slamText(center, {
		Text = "Lock your base 🛡️ — or steal it back!",
		Font = F.Body,
		Size = UDim2.fromOffset(700, 36),
		Position = UDim2.fromScale(0.5, 0.64),
		Stroke = 2,
		MaxTextSize = 30,
		Rotation = 0,
		From = 0.6,
	})
	Audio.Play("ui_error")
	Audio.Play("roar_small")
	CameraFx.Shake(1, 0.6)
	task.wait(2.6)
	close()
end

----------------------------------------------------------------------------
-- Évolution, pass, récompenses
----------------------------------------------------------------------------

local function rebirthCinematic(args)
	local center, _backdrop, close = stage(C.RadioactiveDark:Lerp(C.Ink, 0.6))
	Kit.Starburst({ Size = UDim2.fromOffset(1100, 1100), Position = UDim2.fromScale(0.5, 0.45), Color = C.Radioactive, Rays = 22, Period = 6, Parent = center })
	Audio.Play("rebirth")
	flash(C.Radioactive, 1)
	CameraFx.Shake(1.2, 1)
	local dna = Kit.Text({ Size = UDim2.fromOffset(220, 220), Position = UDim2.fromScale(0.5, 0.36), AnchorPoint = Vector2.new(0.5, 0.5), Text = "🧬", FontFace = F.Body, Stroke = false, ZIndex = 12, Parent = center })
	Kit.Pop(dna, 0.1, 0.8)
	Kit.Tween(dna, 3, { Rotation = 360 }, Enum.EasingStyle.Quad)
	slamText(center, { Text = "EVOLVED!", Color = C.Radioactive, Position = UDim2.fromScale(0.5, 0.66) })
	slamText(center, { Text = ("LEVEL %d"):format(args.Level or 1), Color = C.Gold, Size = UDim2.fromOffset(600, 70), Position = UDim2.fromScale(0.5, 0.8), MaxTextSize = 70, Rotation = 2, From = 0.3 })
	task.wait(3.2)
	close()
end

local function passUnlocked(args)
	local center, _backdrop, close = stage()
	Kit.Starburst({ Size = UDim2.fromOffset(900, 900), Position = UDim2.fromScale(0.5, 0.45), Color = C.Gold, Parent = center })
	Audio.Play("hatch_legendary")
	flash(C.Gold, 0.6)
	slamText(center, { Text = string.upper(args.Name or "PASS") .. " UNLOCKED!", Color = C.Gold, Position = UDim2.fromScale(0.5, 0.45) })
	slamText(center, { Text = "Thank you for supporting the game! 💛", Font = F.Body, Size = UDim2.fromOffset(700, 40), Position = UDim2.fromScale(0.5, 0.6), MaxTextSize = 34, Stroke = 2, Rotation = 0, From = 0.5 })
	task.wait(2.6)
	close()
end

-- Petite carte de récompense (non bloquante), au centre-haut.
local function rewardCard(icon: string, title: string, subtitle: string?, color: Color3?)
	local holder = Kit.new("Frame", {
		Size = UDim2.fromOffset(460, 110),
		Position = UDim2.new(0.5, 0, 0, 150),
		AnchorPoint = Vector2.new(0.5, 0),
		BackgroundTransparency = 1,
		Parent = smallLayer,
	})
	Kit.AutoScale(holder)
	Kit.Starburst({ Size = UDim2.fromOffset(300, 300), Position = UDim2.fromOffset(60, 55), Color = color or C.Gold, Rays = 10, Transparency = 0.6, Parent = holder })
	local _, body = Kit.Panel({ Size = UDim2.fromScale(1, 1), Rotation = -2, Gradient = "Ink", Parent = holder })
	Kit.Text({ Size = UDim2.fromOffset(80, 80), Position = UDim2.fromOffset(12, 15), Text = icon, FontFace = F.Body, Stroke = false, ZIndex = 4, Parent = body })
	Kit.Text({ Size = UDim2.new(1, -110, 0, 46), Position = UDim2.fromOffset(100, 14), Text = title, FontFace = F.Impact, TextColor3 = color or C.Gold, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 4, Stroke = 3, Parent = body })
	if subtitle then
		Kit.Text({ Size = UDim2.new(1, -110, 0, 28), Position = UDim2.fromOffset(100, 62), Text = subtitle, FontFace = F.Body, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 4, Parent = body })
	end
	Kit.Pop(holder, 0.3, 0.45)
	task.delay(3, function()
		Kit.Tween(Kit.ScaleOf(holder), 0.25, { Scale = 0 }, Enum.EasingStyle.Back, Enum.EasingDirection.In)
		task.wait(0.3)
		holder:Destroy()
	end)
end

function Cinematics.Init()
	layer = Kit.Layer("Cinematics", 30)
	layer.Enabled = false
	smallLayer = Kit.Layer("RewardCards", 35)

	FxBus.On("Hatch", function(args)
		enqueue(function()
			hatchReveal(args)
		end)
	end)
	FxBus.On("Fused", function(args)
		-- la fenêtre Fusion joue sa propre animation ; carte de rappel
		local species = Kaijus.Get(args.Species or "")
		if species then
			rewardCard("🧪", string.upper(species.Name), if args.Secret then "SECRET KAIJU CREATED!" else "Fusion complete!", Rarities.Get(species.Rarity).Color)
		end
	end)
	FxBus.On("HeistSuccess", function(args)
		enqueue(function()
			heistSuccess(args)
		end)
	end)
	FxBus.On("Robbed", function(args)
		enqueue(function()
			robbed(args)
		end)
	end)
	FxBus.On("Rebirth", function(args)
		if args.UserId == game:GetService("Players").LocalPlayer.UserId then
			enqueue(function()
				rebirthCinematic(args)
			end)
		end
	end)
	FxBus.On("PassUnlocked", function(args)
		enqueue(function()
			passUnlocked(args)
		end)
	end)
	FxBus.On("RewardClaimed", function(args)
		Audio.Play("reward_claim")
		rewardCard("🎁", args.Text or "Reward!", args.Source, C.Gold)
	end)
	FxBus.On("Discovered", function(args)
		local species = Kaijus.Get(args.Species or "")
		if not species then
			return
		end
		local mutation = Mutations.Get(args.Mutation)
		if args.NewSpecies then
			Audio.Play("quest_complete")
			rewardCard("📖", "NEW KAIJU DISCOVERED!", species.Name .. " — +1% cash forever", Rarities.Get(species.Rarity).Color)
		elseif mutation then
			rewardCard("✨", "NEW MUTATION!", mutation.Name .. " " .. species.Name, mutation.Color)
		end
	end)
	FxBus.On("EggGift", function(args)
		local rarity = Rarities.Get(args.Rarity or "Common")
		rewardCard("🥚", rarity.Name:upper() .. " EGG!", (args.Source or "Gift") .. " — placed in your nest", rarity.Color)
	end)
	FxBus.On("BossReward", function(args)
		rewardCard("👹", ("+%d 💎"):format(args.Gems or 0), if args.Top then "MVP of the raid!" else "Raid reward", C.Pink)
	end)
	FxBus.On("QuestReady", function(args)
		Audio.Play("quest_complete")
		UIRegistry.Toast("Quest complete: " .. (args.Text or ""), "Good")
	end)
	FxBus.On("DailyReady", function()
		task.delay(4, function()
			UIRegistry.Toast("Your daily reward is ready! 📅", "Good")
		end)
	end)
	FxBus.On("NestUnlocked", function(args)
		Audio.Play("level_jingle")
		rewardCard("🪺", "NEW NEST!", ("You now have %d nests"):format(args.Count or 0), C.Magma)
	end)
	FxBus.On("PersonalMeteor", function(args)
		local rarity = Rarities.Get(args.Rarity or "Common")
		UIRegistry.Toast(("☄️ A %s meteor is landing on YOUR island!"):format(rarity.Name), if rarity.Order >= 4 then "Rare" else "Info")
	end)
	FxBus.On("HelperJoined", function(args)
		Audio.Play("steal_grab")
		UIRegistry.Toast((args.Name or "Someone") .. " is helping you carry it! GO GO GO!", "Good")
	end)
	FxBus.On("Grabbed", function(args)
		Audio.Play("steal_grab")
		if args.Lifting then
			UIRegistry.Announce("TOO HEAVY!", C.Magma, "Titans need 2 thieves — someone must help you lift it!", "ui_error")
		elseif args.Helper then
			UIRegistry.Toast("Team heist! Stay close to the leader!", "Good")
		end
	end)
end

return Cinematics
]]></string>
            </Properties>
          </Item>
          <Item class="Folder" referent="64">
            <Properties>
              <string name="Name">Components</string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="65">
            <Properties>
              <string name="Name">Hud</string>
              <string name="Source"><![CDATA[--!nonstrict
-- HUD principal : compteurs (cash, gemmes, $/s), menus latéraux, bouton de
-- verrouillage, bannière d'événement, boosts actifs, indicateur de vol,
-- alarme de vol (vignette rouge), pièces volantes vers le compteur.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Format = require(Shared.Logic.Format)
local Events = require(Shared.Config.Events)
local Economy = require(Shared.Config.Economy)
local Kaijus = require(Shared.Config.Kaijus)
local Growth = require(Shared.Config.Growth)

local Kit = require(script.Parent.Kit)
local Controllers = script.Parent.Parent.Controllers
local State = require(Controllers.State)
local Remote = require(Controllers.Remote)
local Audio = require(Controllers.Audio)
local FxBus = require(Controllers.FxBus)
local UIRegistry = require(Controllers.UIRegistry)
local CameraFx = require(Controllers.CameraFx)

local C = Kit.Colors
local F = Kit.Fonts
local player = Players.LocalPlayer

local Hud = {}

local layer: ScreenGui
local cashLabel: TextLabel
local incomeLabel: TextLabel
local gemLabel: TextLabel
local cashPanel: Frame
local storedChip: Frame
local lockButton: TextButton
local eventBanner: Frame
local boostRow: Frame
local carryPanel: Frame
local alarm: Frame
local menuButtons: { [string]: GuiObject } = {}
local alarmSound: Sound? = nil
local alarmUntil = 0

local function now(): number
	return Workspace:GetServerTimeNow()
end

----------------------------------------------------------------------------
-- Compteurs
----------------------------------------------------------------------------

local function currencyPanel(props): (Frame, TextLabel)
	local container, body = Kit.Panel({
		Name = props.Name,
		Size = props.Size,
		Position = props.Position,
		AnchorPoint = props.AnchorPoint,
		Rotation = props.Rotation,
		Gradient = "Ink",
		Parent = props.Parent,
	})
	local icon = Kit.Text({
		Size = UDim2.new(0, props.IconSize or 52, 1, 6),
		Position = UDim2.fromOffset(-14, -3),
		Text = props.Icon,
		FontFace = F.Body,
		Stroke = false,
		ZIndex = 4,
		Parent = body,
	})
	Kit.Wobble(icon, 6, 1.4)
	local label = Kit.Text({
		Name = "Value",
		Size = UDim2.new(1, -(props.IconSize or 52), props.ValueHeight or 1, -8),
		Position = UDim2.fromOffset((props.IconSize or 52) - 6, 4),
		Text = "0",
		FontFace = F.Impact,
		TextColor3 = props.Color,
		TextXAlignment = Enum.TextXAlignment.Left,
		Stroke = 3,
		MaxTextSize = props.MaxTextSize or 46,
		ZIndex = 4,
		Parent = body,
	})
	return container, label
end

local function buildCurrencies()
	local top = Kit.new("Frame", {
		Name = "Top",
		Size = UDim2.fromOffset(560, 110),
		Position = UDim2.new(0.5, 0, 0, 12),
		AnchorPoint = Vector2.new(0.5, 0),
		BackgroundTransparency = 1,
		Parent = layer,
	})
	Kit.AutoScale(top)
	local panel
	panel, cashLabel = currencyPanel({
		Name = "Cash",
		Icon = "💵",
		Size = UDim2.fromOffset(300, 74),
		Position = UDim2.fromOffset(40, 0),
		Rotation = -1.5,
		Color = C.Cash,
		ValueHeight = 0.72,
		Parent = top,
	})
	cashPanel = panel
	incomeLabel = Kit.Text({
		Size = UDim2.new(1, -60, 0.32, 0),
		Position = UDim2.new(0, 46, 0.66, -4),
		Text = "+$0/s",
		FontFace = F.Body,
		TextColor3 = C.Radioactive,
		TextXAlignment = Enum.TextXAlignment.Left,
		Stroke = 2,
		ZIndex = 4,
		Parent = panel:FindFirstChild("Body"),
	})
	local gemPanel
	gemPanel, gemLabel = currencyPanel({
		Name = "Gems",
		Icon = "💎",
		IconSize = 44,
		Size = UDim2.fromOffset(170, 58),
		Position = UDim2.fromOffset(362, 8),
		Rotation = 1.5,
		Color = C.Gem,
		MaxTextSize = 36,
		Parent = top,
	})

	-- Cash en attente dans le réacteur
	storedChip = Kit.Chip({
		Name = "Stored",
		Text = "⚛️ $0 in reactor",
		Color = C.RadioactiveDark,
		Size = UDim2.fromOffset(250, 30),
		Position = UDim2.fromOffset(64, 80),
		Parent = top,
	})
	storedChip.Visible = false

	State.Observe("Cash", function(value)
		local previous = cashLabel:GetAttribute("Value") or value
		Kit.CountTo(cashLabel, value, Format.Cash, 0.7)
		if value > previous then
			Kit.Punch(cashPanel, 0.08)
		end
	end)
	State.Observe("Gems", function(value)
		local previous = gemLabel:GetAttribute("Value") or value
		Kit.CountTo(gemLabel, value, Format.Short, 0.6)
		if value ~= previous then
			Kit.Punch(gemPanel, 0.12)
		end
	end)
	State.Observe("Income", function(value)
		local mult = State.Get("Multiplier") or 1
		local multText = if mult < 10 then (("%.2f"):format(mult):gsub("0+$", ""):gsub("%.$", "")) else Format.Short(mult)
		incomeLabel.Text = ("+%s/s"):format(Format.Cash(value)) .. (if mult > 1.001 then ("  <font color=\"#FFC828\">x%s</font>"):format(multText) else "")
	end)
	State.Observe("Stored", function(value)
		local auto = (State.Get("Passes") or {}).AutoCollect
		storedChip.Visible = value >= 1 and not auto
		local text = storedChip:FindFirstChild("Text") :: TextLabel
		text.Text = ("⚛️ %s in reactor"):format(Format.Cash(value))
	end)
	Kit.Breathe(storedChip, 0.05, 0.7)
end

-- Pièces qui volent jusqu'au compteur.
function Hud.FlyCoins(icon: string, count: number, from: Vector2?)
	local camera = Workspace.CurrentCamera
	local viewport = if camera then camera.ViewportSize else Vector2.new(1280, 720)
	local start = from or Vector2.new(viewport.X / 2, viewport.Y * 0.62)
	local target = cashPanel.AbsolutePosition + cashPanel.AbsoluteSize / 2
	for i = 1, count do
		task.delay(i * 0.035, function()
			local coin = Kit.Text({
				Size = UDim2.fromOffset(40, 40),
				Position = UDim2.fromOffset(start.X, start.Y),
				AnchorPoint = Vector2.new(0.5, 0.5),
				Text = icon,
				FontFace = F.Body,
				Stroke = false,
				ZIndex = 60,
				Parent = layer,
			})
			local mid = start + Vector2.new(math.random(-220, 220), math.random(-260, -80))
			local t0 = os.clock()
			local d = 0.55 + math.random() * 0.25
			local conn
			conn = RunService.RenderStepped:Connect(function()
				local a = math.clamp((os.clock() - t0) / d, 0, 1)
				local e = a * a
				local p = start:Lerp(mid, e):Lerp(mid:Lerp(target, e), e)
				coin.Position = UDim2.fromOffset(p.X, p.Y)
				coin.Rotation = a * 360
				if a >= 1 then
					conn:Disconnect()
					coin:Destroy()
					Audio.Play("coin_tick", { Cooldown = 0.02, Volume = 0.5 })
					Kit.Punch(cashPanel, 0.05)
				end
			end)
		end)
	end
end

-- Nombre flottant (+$1.2K) près du compteur.
function Hud.FloatText(text: string, color: Color3)
	local label = Kit.Text({
		Size = UDim2.fromOffset(260, 44),
		Position = UDim2.new(0.5, math.random(-60, 60), 0, 118),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Text = text,
		FontFace = F.Impact,
		TextColor3 = color,
		Stroke = 3,
		ZIndex = 61,
		Parent = layer,
	})
	Kit.Pop(label, 1.8, 0.3)
	Kit.Tween(label, 1.2, { Position = label.Position - UDim2.fromOffset(0, 60), TextTransparency = 1 }, Enum.EasingStyle.Quad)
	local stroke = label:FindFirstChildOfClass("UIStroke")
	if stroke then
		Kit.Tween(stroke, 1.2, { Transparency = 1 })
	end
	task.delay(1.3, function()
		label:Destroy()
	end)
end

----------------------------------------------------------------------------
-- Menus latéraux
----------------------------------------------------------------------------

local function menuButton(parent: Instance, props): TextButton
	local button = Kit.Button({
		Name = props.Id,
		Text = "",
		Color = props.Color,
		Size = UDim2.fromOffset(84, 84),
		LayoutOrder = props.Order,
		Rotation = props.Rotation,
		HoverTilt = -props.Rotation * 2 + 3,
		Corner = 18,
		Parent = parent,
		OnClick = props.OnClick,
	})
	local face = button:FindFirstChild("Face")
	Kit.Text({
		Name = "Emoji",
		Size = UDim2.fromScale(0.62, 0.62),
		Position = UDim2.fromScale(0.5, 0.4),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Text = props.Icon,
		FontFace = F.Body,
		Stroke = false,
		ZIndex = 12,
		Parent = face,
	})
	Kit.Text({
		Name = "Caption",
		Size = UDim2.new(1, 12, 0, 22),
		Position = UDim2.new(0.5, 0, 1, -4),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Text = props.Text,
		FontFace = F.Title,
		MaxTextSize = 20,
		Stroke = 2.5,
		ZIndex = 13,
		Parent = button,
	})
	menuButtons[props.Id] = button
	return button
end

local function openScreen(name: string, args: any?)
	local screen = UIRegistry.Screens[name]
	if screen and screen.Open then
		screen.Open(args)
	end
end

local function buildMenus()
	local left = Kit.new("Frame", {
		Name = "LeftMenu",
		Size = UDim2.fromOffset(200, 440),
		Position = UDim2.new(0, 16, 0.5, 30),
		AnchorPoint = Vector2.new(0, 0.5),
		BackgroundTransparency = 1,
		Parent = layer,
	}, {
		Kit.new("UIGridLayout", {
			CellSize = UDim2.fromOffset(84, 84),
			CellPadding = UDim2.fromOffset(14, 22),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
	Kit.AutoScale(left)
	menuButton(left, { Id = "Shop", Text = "SHOP", Icon = "🛒", Color = "Magma", Order = 1, Rotation = -3, OnClick = function() openScreen("Shop") end })
	menuButton(left, { Id = "Index", Text = "KAIJUDEX", Icon = "📖", Color = "Cyan", Order = 2, Rotation = 2, OnClick = function() openScreen("Index") end })
	menuButton(left, { Id = "Rebirth", Text = "EVOLVE", Icon = "🧬", Color = "Radioactive", Order = 3, Rotation = 2, OnClick = function() openScreen("Rebirth") end })
	menuButton(left, { Id = "Fusion", Text = "FUSION", Icon = "🧪", Color = "Purple", Order = 4, Rotation = -3, OnClick = function() openScreen("Fusion") end })
	menuButton(left, { Id = "Quests", Text = "QUESTS", Icon = "📜", Color = "Gold", Order = 5, Rotation = -2, OnClick = function() openScreen("Quests") end })
	menuButton(left, { Id = "Upgrades", Text = "UPGRADES", Icon = "🔧", Color = "Pink", Order = 6, Rotation = 3, OnClick = function() openScreen("Shop", "Upgrades") end })

	local right = Kit.new("Frame", {
		Name = "RightMenu",
		Size = UDim2.fromOffset(100, 480),
		Position = UDim2.new(1, -16, 0.5, 20),
		AnchorPoint = Vector2.new(1, 0.5),
		BackgroundTransparency = 1,
		Parent = layer,
	}, { Kit.List(Enum.FillDirection.Vertical, 38, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Center) })
	Kit.AutoScale(right)
	menuButton(right, { Id = "Playtime", Text = "GIFTS", Icon = "🎁", Color = "Pink", Order = 1, Rotation = 3, OnClick = function() openScreen("Playtime") end })
	menuButton(right, { Id = "Daily", Text = "DAILY", Icon = "📅", Color = "Gold", Order = 2, Rotation = -2, OnClick = function() openScreen("Daily") end })
	menuButton(right, { Id = "Spin", Text = "SPIN", Icon = "🎡", Color = "Cyan", Order = 3, Rotation = 2, OnClick = function() openScreen("Spin") end })
	menuButton(right, { Id = "Settings", Text = "SETTINGS", Icon = "⚙️", Color = "Ink", Order = 4, Rotation = -2, OnClick = function() openScreen("Settings") end })

	-- Minuteur des cadeaux sous le bouton
	local giftTimer = Kit.Chip({ Name = "GiftTimer", Text = "0:00", Size = UDim2.fromOffset(84, 24), Position = UDim2.new(0.5, 0, 1, 14), AnchorPoint = Vector2.new(0.5, 0), Color = C.Pink, Parent = menuButtons.Playtime })
	giftTimer.ZIndex = 20

	-- Badges : rafraîchis régulièrement
	task.spawn(function()
		while true do
			local screens = UIRegistry.Screens
			local function badge(id: string, count: number)
				local b = menuButtons[id]
				if b then
					Kit.SetBadge(b, count > 0, if count > 1 then tostring(count) else "!")
				end
			end
			if screens.Playtime and screens.Playtime.ClaimableCount then
				badge("Playtime", screens.Playtime.ClaimableCount())
				local wait = if screens.Playtime.NextReadyIn then screens.Playtime.NextReadyIn() else -1
				local text = giftTimer:FindFirstChild("Text") :: TextLabel
				giftTimer.Visible = wait ~= 0
				text.Text = if wait < 0 then "DONE" else Format.Clock(wait)
			end
			if screens.Daily and screens.Daily.CanClaim then
				badge("Daily", if screens.Daily.CanClaim() then 1 else 0)
			end
			if screens.Spin and screens.Spin.CanFreeSpin then
				badge("Spin", if screens.Spin.CanFreeSpin() then 1 else (State.Get("Spins") or 0))
			end
			if screens.Quests and screens.Quests.ClaimableCount then
				badge("Quests", screens.Quests.ClaimableCount())
			end
			-- Évolution disponible ?
			local rebirths = State.Get("Rebirths") or 0
			local nextR = Economy.Rebirths[rebirths + 1]
			badge("Rebirth", if nextR and (State.Get("Cash") or 0) >= nextR.Cost then 1 else 0)
			task.wait(0.5)
		end
	end)
end

----------------------------------------------------------------------------
-- Bouton de verrouillage + boosts + bannière d'événement
----------------------------------------------------------------------------

local function myPlot(): Instance?
	local index = player:GetAttribute("Plot")
	local map = Workspace:FindFirstChild("Map")
	return if index and map then map:FindFirstChild("Plot" .. index) else nil
end

local function buildBottom()
	local bottom = Kit.new("Frame", {
		Name = "Bottom",
		Size = UDim2.fromOffset(700, 90),
		Position = UDim2.new(0.5, 0, 1, -16),
		AnchorPoint = Vector2.new(0.5, 1),
		BackgroundTransparency = 1,
		Parent = layer,
	})
	Kit.AutoScale(bottom)
	lockButton = Kit.Button({
		Name = "Lock",
		Text = "LOCK BASE",
		Icon = "🛡️",
		Color = "Red",
		Size = UDim2.fromOffset(250, 70),
		Position = UDim2.new(0.5, 0, 1, -8),
		AnchorPoint = Vector2.new(0.5, 1),
		TextSize = 28,
		Sound = "shield_on",
		OnClick = function()
			local r = Remote.Call("Lock")
			if r.ok then
				CameraFx.FovPunch(-6, 0.5)
			end
		end,
		Parent = bottom,
	})
	Kit.Text({
		Name = "Key",
		Size = UDim2.fromOffset(34, 22),
		Position = UDim2.new(1, -8, 0, -8),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Text = "[L]",
		FontFace = F.Title,
		MaxTextSize = 18,
		ZIndex = 20,
		Parent = lockButton,
	})

	boostRow = Kit.new("Frame", {
		Name = "Boosts",
		Size = UDim2.fromOffset(600, 34),
		Position = UDim2.new(0.5, 0, 0, -4),
		AnchorPoint = Vector2.new(0.5, 1),
		BackgroundTransparency = 1,
		Parent = bottom,
	}, { Kit.List(Enum.FillDirection.Horizontal, 8, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Bottom) })

	-- Mise à jour du bouclier et des boosts
	local chips: { [string]: Frame } = {}
	local function chip(id: string, text: string, color: Color3)
		local c = chips[id]
		if not c then
			c = Kit.Chip({ Name = id, Text = text, Color = color, AutoWidth = true, Size = UDim2.fromOffset(0, 30), TextSize = 18, Parent = boostRow })
			chips[id] = c
			Kit.Pop(c)
		end
		local chipText = c:FindFirstChild("Text") :: TextLabel
		chipText.Text = text
		c:SetAttribute("Seen", true)
	end
	RunService.Heartbeat:Connect(function()
		local t = now()
		local plot = myPlot()
		if plot then
			local shield = (plot:GetAttribute("ShieldUntil") or 0) - t
			local protected = (plot:GetAttribute("ProtectedUntil") or 0) - t
			local cooldown = (plot:GetAttribute("ShieldCooldown") or 0) - t
			if shield > 0 then
				Kit.SetButtonText(lockButton, "SHIELD " .. Format.Clock(shield))
				Kit.SetButtonColor(lockButton, "Cyan")
			elseif protected > 0 then
				Kit.SetButtonText(lockButton, "SAFE " .. Format.Clock(protected))
				Kit.SetButtonColor(lockButton, "Radioactive")
			elseif cooldown > 0 then
				Kit.SetButtonText(lockButton, "RECHARGE " .. Format.Clock(cooldown))
				Kit.SetButtonColor(lockButton, "Grey")
			else
				Kit.SetButtonText(lockButton, "LOCK BASE")
				Kit.SetButtonColor(lockButton, "Red")
			end
		end
		for _, c in chips do
			c:SetAttribute("Seen", false)
		end
		local boosts = State.Get("Boosts") or {}
		local unix = os.time()
		if (boosts.Luck or 0) > unix then
			chip("Luck", "🍀 x2 LUCK " .. Format.Clock(boosts.Luck - unix), C.RadioactiveDark)
		end
		if (boosts.Growth or 0) > unix then
			chip("Growth", "🌱 x2 GROWTH " .. Format.Clock(boosts.Growth - unix), Color3.fromRGB(90, 150, 40))
		end
		if (boosts.Cash or 0) > unix then
			chip("Cash", "💸 x2 CASH " .. Format.Clock(boosts.Cash - unix), C.RadioactiveDark)
		end
		local serverLuckUntil = Workspace:GetAttribute("ServerLuckUntil") or 0
		if serverLuckUntil > t then
			chip("ServerLuck", ("🍀 SERVER LUCK x%s %s"):format(Format.Short(Workspace:GetAttribute("ServerLuck") or 2), Format.Clock(serverLuckUntil - t)), C.Purple)
		end
		local friends = State.Get("Friends") or 0
		if friends > 0 then
			chip("Friends", ("👥 +%d%% FRIENDS"):format(math.min(friends * 10, 40)), C.Cyan:Lerp(C.Ink, 0.4))
		end
		for id, c in chips do
			if not c:GetAttribute("Seen") then
				c:Destroy()
				chips[id] = nil
			end
		end
	end)

	UserInputService.InputBegan:Connect(function(input, processed)
		if processed then
			return
		end
		if input.KeyCode == Enum.KeyCode.L then
			Remote.Call("Lock")
		end
	end)
end

local function buildEventBanner()
	eventBanner = Kit.new("Frame", {
		Name = "Event",
		Size = UDim2.fromOffset(330, 92),
		Position = UDim2.new(1, -20, 0, 16),
		AnchorPoint = Vector2.new(1, 0),
		BackgroundTransparency = 1,
		Visible = false,
		Parent = layer,
	})
	Kit.AutoScale(eventBanner)
	local _, body = Kit.Panel({ Size = UDim2.fromScale(1, 1), Rotation = 1.5, Gradient = "Ink", Parent = eventBanner })
	local icon = Kit.Text({ Name = "Icon", Size = UDim2.fromOffset(62, 62), Position = UDim2.fromOffset(8, 8), Text = "🌠", FontFace = F.Body, Stroke = false, ZIndex = 4, Parent = body })
	Kit.Wobble(icon, 10, 0.8)
	Kit.Text({ Name = "Name", Size = UDim2.new(1, -86, 0, 34), Position = UDim2.fromOffset(76, 8), Text = "EVENT", FontFace = F.Impact, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 4, Parent = body })
	Kit.Text({ Name = "Time", Size = UDim2.new(1, -86, 0, 22), Position = UDim2.fromOffset(76, 42), Text = "0:00", FontFace = F.Body, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 4, Parent = body })
	local _, setBar = Kit.ProgressBar({ Size = UDim2.new(1, -24, 0, 12), Position = UDim2.new(0, 12, 1, -18), Color = "Magma", Parent = body })

	local function refresh()
		local id = Workspace:GetAttribute("EventId")
		local event = id and Events.ById[id]
		eventBanner.Visible = event ~= nil
		if event then
			local nameLabel = body:FindFirstChild("Name") :: TextLabel
			local iconLabel = body:FindFirstChild("Icon") :: TextLabel
			nameLabel.Text = event.Name
			nameLabel.TextColor3 = event.Color
			iconLabel.Text = event.Icon
			Kit.Pop(eventBanner, 0.3)
		end
	end
	Workspace:GetAttributeChangedSignal("EventId"):Connect(refresh)
	refresh()
	RunService.Heartbeat:Connect(function()
		if not eventBanner.Visible then
			return
		end
		local id = Workspace:GetAttribute("EventId")
		local event = id and Events.ById[id]
		local left = (Workspace:GetAttribute("EventEnds") or 0) - now()
		local timeLabel = body:FindFirstChild("Time") :: TextLabel
		timeLabel.Text = "⏱️ " .. Format.Clock(left) .. " left"
		if event then
			setBar(left / event.Duration, true)
		end
	end)
end

----------------------------------------------------------------------------
-- Vol : indicateur de portage + alarme
----------------------------------------------------------------------------

local function buildCarry()
	carryPanel = Kit.new("Frame", {
		Name = "Carry",
		Size = UDim2.fromOffset(460, 110),
		Position = UDim2.new(0.5, 0, 1, -130),
		AnchorPoint = Vector2.new(0.5, 1),
		BackgroundTransparency = 1,
		Visible = false,
		Parent = layer,
	})
	Kit.AutoScale(carryPanel)
	local _, body = Kit.Panel({ Size = UDim2.fromScale(1, 1), Rotation = -1, Gradient = "Pink", Parent = carryPanel })
	Kit.Hazard({ Size = UDim2.new(1, -20, 0, 10), Position = UDim2.fromOffset(10, 6), Parent = body })
	Kit.Text({ Name = "Title", Size = UDim2.new(1, -150, 0, 40), Position = UDim2.fromOffset(14, 20), Text = "CARRYING!", FontFace = F.Impact, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 4, Parent = body })
	Kit.Text({ Name = "Hint", Size = UDim2.new(1, -150, 0, 24), Position = UDim2.fromOffset(14, 60), Text = "Run back to your island!", FontFace = F.Body, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 4, Parent = body })
	local _, setBar = Kit.ProgressBar({ Name = "Timer", Size = UDim2.new(1, -150, 0, 12), Position = UDim2.new(0, 14, 1, -22), Color = "Gold", Parent = body })
	Kit.Button({
		Name = "Drop",
		Text = "DROP [Q]",
		Color = "Ink",
		Size = UDim2.fromOffset(120, 56),
		Position = UDim2.new(1, -12, 0.5, 0),
		AnchorPoint = Vector2.new(1, 0.5),
		TextSize = 22,
		OnClick = function()
			Remote.Call("Drop")
		end,
		Parent = body,
	})
	local startedAt = 0
	local current = ""
	RunService.Heartbeat:Connect(function()
		local uid = player:GetAttribute("Carrying") or ""
		if uid ~= current then
			current = uid
			startedAt = os.clock()
			carryPanel.Visible = uid ~= ""
			if uid ~= "" then
				Kit.Pop(carryPanel, 0.5)
			end
		end
		if uid == "" then
			return
		end
		local anchor = nil
		local folder = Workspace:FindFirstChild("Kaijus")
		if folder then
			for _, owner in folder:GetChildren() do
				anchor = owner:FindFirstChild(uid)
				if anchor then
					break
				end
			end
		end
		local title = body:FindFirstChild("Title") :: TextLabel
		local hint = body:FindFirstChild("Hint") :: TextLabel
		if anchor then
			local species = Kaijus.Get(anchor:GetAttribute("Species") or "")
			local stage = Growth.Get(anchor:GetAttribute("Stage") or 1)
			if anchor:GetAttribute("Lifting") then
				local left = (anchor:GetAttribute("LiftUntil") or 0) - now()
				title.Text = "TOO HEAVY! 🆘"
				hint.Text = ("A %s needs 2 thieves — wait for help (%ds)"):format(stage.Name, math.max(0, math.ceil(left)))
				startedAt = os.clock()
			else
				title.Text = ("CARRYING %s!"):format(string.upper(if species then species.Name else "KAIJU"))
				hint.Text = if (anchor:GetAttribute("Helper") or 0) ~= 0 then "Team heist! Stay close to your partner!" else "Run back to your island!"
			end
		end
		setBar(1 - (os.clock() - startedAt) / Economy.StealMaxCarryTime, true)
	end)
	UserInputService.InputBegan:Connect(function(input, processed)
		if not processed and input.KeyCode == Enum.KeyCode.Q and (player:GetAttribute("Carrying") or "") ~= "" then
			Remote.Call("Drop")
		end
	end)
end

local function buildAlarm()
	alarm = Kit.new("Frame", {
		Name = "Alarm",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Visible = false,
		ZIndex = 1,
		Parent = layer,
	})
	-- vignette rouge sur les bords
	for _, side in {
		{ UDim2.new(1, 0, 0.18, 0), UDim2.new(), 90 },
		{ UDim2.new(1, 0, 0.18, 0), UDim2.new(0, 0, 0.82, 0), -90 },
		{ UDim2.new(0.14, 0, 1, 0), UDim2.new(), 0 },
		{ UDim2.new(0.14, 0, 1, 0), UDim2.new(0.86, 0, 0, 0), 180 },
	} do
		Kit.new("Frame", {
			Size = side[1],
			Position = side[2],
			BackgroundColor3 = C.Red,
			BorderSizePixel = 0,
			ZIndex = 1,
			Parent = alarm,
		}, {
			Kit.new("UIGradient", {
				Rotation = side[3],
				Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.3), NumberSequenceKeypoint.new(1, 1) }),
			}),
		})
	end
	local label = Kit.Text({
		Name = "Label",
		Size = UDim2.fromOffset(760, 56),
		Position = UDim2.new(0.5, 0, 0, 126),
		AnchorPoint = Vector2.new(0.5, 0),
		Text = "🚨 THIEF IN YOUR BASE! 🚨",
		FontFace = F.Impact,
		TextColor3 = C.Red,
		Stroke = 4,
		ZIndex = 3,
		Parent = alarm,
	})
	Kit.AutoScale(label)
	Kit.Breathe(label, 0.08, 0.3)
end

local function startAlarm(args)
	alarmUntil = os.clock() + 20
	alarm.Visible = true
	local label = alarm:FindFirstChild("Label") :: TextLabel
	label.Text = ("🚨 %s IS STEALING YOUR %s! BONK THEM! 🚨"):format(string.upper(args.Thief or "SOMEONE"), string.upper(args.Species or "KAIJU"))
	if not alarmSound then
		alarmSound = Audio.Loop("alarm", { Volume = 0.7 })
	end
	CameraFx.Shake(0.4, 0.5)
end

local function stopAlarm()
	alarmUntil = 0
	alarm.Visible = false
	if alarmSound then
		alarmSound:Destroy()
		alarmSound = nil
	end
end

----------------------------------------------------------------------------

function Hud.Init()
	layer = Kit.Root()
	buildCurrencies()
	buildMenus()
	buildBottom()
	buildEventBanner()
	buildCarry()
	buildAlarm()

	FxBus.On("Collect", function(args)
		Audio.Play("cash_collect")
		Hud.FlyCoins("💵", 14)
		Hud.FloatText("+" .. Format.Cash(args.Amount or 0), C.Cash)
		CameraFx.FovPunch(-4, 0.4)
	end)
	FxBus.On("CashBurst", function(args)
		Audio.Play("purchase")
		Hud.FlyCoins("💰", 22)
		Hud.FloatText("+" .. Format.Cash(args.Amount or 0), C.Cash)
	end)
	FxBus.On("GemBurst", function(args)
		Audio.Play("reward_claim")
		Hud.FlyCoins("💎", 18)
		Hud.FloatText("+" .. Format.Short(args.Amount or 0) .. " 💎", C.Gem)
	end)
	FxBus.On("Sold", function(args)
		Audio.Play("sell")
		Hud.FlyCoins("💵", 8)
		Hud.FloatText("+" .. Format.Cash(args.Amount or 0), C.Cash)
	end)
	FxBus.On("OrbGrabbed", function(args)
		Hud.FloatText("+" .. Format.Cash(args.Amount or 0), C.Cash)
		Hud.FlyCoins("💵", 3)
	end)
	FxBus.On("HeistCut", function(args)
		Hud.FlyCoins("💰", 12)
		Hud.FloatText("+" .. Format.Cash(args.Amount or 0) .. " heist cut!", C.Gold)
	end)
	FxBus.On("Alarm", startAlarm)
	FxBus.On("AlarmStop", stopAlarm)
	FxBus.On("Robbed", stopAlarm)
	FxBus.On("Upgraded", function()
		Audio.Play("level_jingle")
	end)
	FxBus.On("PotionUsed", function(args)
		Audio.Play("stage_up")
		UIRegistry.Toast(("%s potion active!"):format(args.Id or ""), "Good")
	end)

	RunService.Heartbeat:Connect(function()
		if alarmUntil > 0 and os.clock() > alarmUntil then
			stopAlarm()
		end
	end)
end

function Hud.Button(id: string): GuiObject?
	return menuButtons[id]
end

function Hud.LockButton(): GuiObject
	return lockButton
end

return Hud
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="66">
            <Properties>
              <string name="Name">Kit</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Kit d'interface « KAIJU ALERT » : panneaux BD encrés, boutons 3D à lèvre,
-- rubans à rayures de danger, fenêtres qui claquent à l'écran, rayons de
-- soleil tournants, compteurs animés. Tout est construit en code.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Lighting = game:GetService("Lighting")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Theme = require(Shared.Config.Theme)
local Signal = require(Shared.Util.Signal)

local Audio = require(script.Parent.Parent.Controllers.Audio)

local C = Theme.Colors
local F = Theme.Fonts

local Kit = {}
Kit.Colors = C
Kit.Fonts = F

----------------------------------------------------------------------------
-- Création
----------------------------------------------------------------------------

function Kit.new(className: string, props: { [string]: any }?, children: { Instance }?): any
	local inst = Instance.new(className)
	local parent = nil
	if props then
		for k, v in props do
			if k == "Parent" then
				parent = v
			else
				(inst :: any)[k] = v
			end
		end
	end
	if children then
		for _, child in children do
			child.Parent = inst
		end
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end

function Kit.Corner(radius: number?): UICorner
	return Kit.new("UICorner", { CornerRadius = UDim.new(0, radius or Theme.Corner) })
end

function Kit.Round(): UICorner
	return Kit.new("UICorner", { CornerRadius = UDim.new(1, 0) })
end

function Kit.Stroke(thickness: number?, color: Color3?, border: boolean?): UIStroke
	return Kit.new("UIStroke", {
		Thickness = thickness or Theme.Stroke,
		Color = color or C.Ink,
		ApplyStrokeMode = if border == false then Enum.ApplyStrokeMode.Contextual else Enum.ApplyStrokeMode.Border,
		LineJoinMode = Enum.LineJoinMode.Round,
	})
end

function Kit.Gradient(name: string | { Color3 }, rotation: number?): UIGradient
	local colors = if type(name) == "string" then Theme.Gradients[name] or Theme.Gradients.Paper else name
	return Kit.new("UIGradient", {
		Color = ColorSequence.new(colors[1], colors[2]),
		Rotation = rotation or 90,
	})
end

function Kit.Padding(px: number, py: number?): UIPadding
	local y = py or px
	return Kit.new("UIPadding", {
		PaddingLeft = UDim.new(0, px),
		PaddingRight = UDim.new(0, px),
		PaddingTop = UDim.new(0, y),
		PaddingBottom = UDim.new(0, y),
	})
end

function Kit.List(direction: Enum.FillDirection?, padding: number?, hAlign: Enum.HorizontalAlignment?, vAlign: Enum.VerticalAlignment?): UIListLayout
	return Kit.new("UIListLayout", {
		FillDirection = direction or Enum.FillDirection.Vertical,
		Padding = UDim.new(0, padding or 8),
		HorizontalAlignment = hAlign or Enum.HorizontalAlignment.Center,
		VerticalAlignment = vAlign or Enum.VerticalAlignment.Top,
		SortOrder = Enum.SortOrder.LayoutOrder,
	})
end

function Kit.Grid(cell: UDim2, padding: number?): UIGridLayout
	return Kit.new("UIGridLayout", {
		CellSize = cell,
		CellPadding = UDim2.fromOffset(padding or 10, padding or 10),
		SortOrder = Enum.SortOrder.LayoutOrder,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
	})
end

-- Texte BD : police, contour encre.
function Kit.Text(props: { [string]: any }): TextLabel
	local stroke = props.Stroke
	local scaled = props.TextScaled ~= false
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.FontFace = F.Title
	label.TextColor3 = C.White
	label.RichText = true
	label.TextScaled = scaled
	for k, v in props do
		if k ~= "Stroke" and k ~= "MaxTextSize" and k ~= "Parent" then
			(label :: any)[k] = v
		end
	end
	if stroke ~= false then
		Kit.new("UIStroke", {
			Thickness = if type(stroke) == "number" then stroke else 2.5,
			Color = C.Ink,
			ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual,
			LineJoinMode = Enum.LineJoinMode.Round,
			Parent = label,
		})
	end
	if scaled then
		Kit.new("UITextSizeConstraint", { MaxTextSize = props.MaxTextSize or 60, Parent = label })
	end
	label.Parent = props.Parent
	return label
end

----------------------------------------------------------------------------
-- Animations
----------------------------------------------------------------------------

function Kit.Tween(inst: Instance, time: number, props: { [string]: any }, style: Enum.EasingStyle?, direction: Enum.EasingDirection?, repeats: number?, reverses: boolean?): Tween
	local tween = TweenService:Create(inst, TweenInfo.new(time, style or Enum.EasingStyle.Quad, direction or Enum.EasingDirection.Out, repeats or 0, reverses or false), props)
	tween:Play()
	return tween
end

function Kit.ScaleOf(inst: GuiObject): UIScale
	local s = inst:FindFirstChild("KitScale") :: UIScale?
	if not s then
		s = Kit.new("UIScale", { Name = "KitScale", Parent = inst })
	end
	return s :: UIScale
end

-- Apparition élastique.
function Kit.Pop(inst: GuiObject, from: number?, time: number?)
	local s = Kit.ScaleOf(inst)
	s.Scale = from or 0.4
	Kit.Tween(s, time or 0.45, { Scale = 1 }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
end

-- Petit coup (feedback).
function Kit.Punch(inst: GuiObject, amount: number?)
	local s = Kit.ScaleOf(inst)
	s.Scale = 1 + (amount or 0.18)
	Kit.Tween(s, 0.35, { Scale = 1 }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
end

function Kit.Shake(inst: GuiObject, intensity: number?, duration: number?)
	-- position d'origine mémorisée une seule fois (secousses qui se chevauchent)
	local saved = inst:GetAttribute("ShakeBase")
	local base = if typeof(saved) == "UDim2" then saved else inst.Position
	inst:SetAttribute("ShakeBase", base)
	local strength = intensity or 6
	local t0 = os.clock()
	local d = duration or 0.35
	local conn
	conn = RunService.RenderStepped:Connect(function()
		local t = os.clock() - t0
		if t > d or not inst.Parent then
			conn:Disconnect()
			inst.Position = base
			inst:SetAttribute("ShakeBase", nil)
			return
		end
		local k = (1 - t / d) * strength
		inst.Position = base + UDim2.fromOffset((math.random() - 0.5) * 2 * k, (math.random() - 0.5) * 2 * k)
	end)
end

-- Respiration continue (boutons importants).
function Kit.Breathe(inst: GuiObject, amount: number?, period: number?)
	local s = Kit.ScaleOf(inst)
	Kit.Tween(s, period or 0.9, { Scale = 1 + (amount or 0.05) }, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true)
end

-- Balancement continu.
function Kit.Wobble(inst: GuiObject, degrees: number?, period: number?)
	local d = degrees or 4
	inst.Rotation = -d
	Kit.Tween(inst, period or 1.2, { Rotation = d }, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true)
end

-- Compteur animé : met à jour label.Text avec fmt(valeur).
local counters: { [Instance]: { from: number, to: number, t0: number, d: number, fmt: (number) -> string } } = {}
function Kit.CountTo(label: TextLabel, value: number, fmt: (number) -> string, duration: number?)
	local current = counters[label]
	local from = value
	if current then
		local a = math.clamp((os.clock() - current.t0) / current.d, 0, 1)
		from = current.from + (current.to - current.from) * (1 - (1 - a) ^ 3)
	elseif label:GetAttribute("Value") then
		from = label:GetAttribute("Value")
	end
	label:SetAttribute("Value", value)
	counters[label] = { from = from, to = value, t0 = os.clock(), d = duration or 0.6, fmt = fmt }
end

RunService.RenderStepped:Connect(function()
	for label, c in counters do
		local a = math.clamp((os.clock() - c.t0) / c.d, 0, 1)
		local eased = 1 - (1 - a) ^ 3
		label.Text = c.fmt(c.from + (c.to - c.from) * eased)
		if a >= 1 or not label.Parent then
			counters[label] = nil
		end
	end
end)

----------------------------------------------------------------------------
-- Échelle globale (mobile ↔ PC)
----------------------------------------------------------------------------

Kit.ScaleChanged = Signal.new()
Kit.UIScale = 1
local scaled: { UIScale } = {}

local function computeScale(): number
	local camera = Workspace.CurrentCamera
	local size = if camera then camera.ViewportSize else Vector2.new(1280, 720)
	return math.clamp(math.min(size.X / 1280, size.Y / 720), 0.55, 1.35)
end

-- Ajoute une échelle automatique à un élément de premier niveau.
function Kit.AutoScale(inst: GuiObject)
	local s = Kit.new("UIScale", { Name = "AutoScale", Scale = Kit.UIScale, Parent = inst })
	table.insert(scaled, s)
	return s
end

local function refreshScale()
	Kit.UIScale = computeScale()
	for _, s in scaled do
		s.Scale = Kit.UIScale
	end
	Kit.ScaleChanged:Fire(Kit.UIScale)
end

task.defer(function()
	local camera = Workspace.CurrentCamera
	if camera then
		camera:GetPropertyChangedSignal("ViewportSize"):Connect(refreshScale)
	end
	refreshScale()
end)

----------------------------------------------------------------------------
-- Composants
----------------------------------------------------------------------------

-- Panneau BD : ombre portée pleine + corps crème encré.
function Kit.Panel(props: { [string]: any }): (Frame, Frame)
	local container = Kit.new("Frame", {
		Name = props.Name or "Panel",
		Size = props.Size or UDim2.fromOffset(300, 200),
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or Vector2.zero,
		Rotation = props.Rotation or 0,
		BackgroundTransparency = 1,
		ZIndex = props.ZIndex or 1,
		Parent = props.Parent,
	})
	local offset = props.ShadowOffset or Theme.ShadowOffset
	Kit.new("Frame", {
		Name = "Shadow",
		Size = UDim2.fromScale(1, 1),
		Position = UDim2.fromOffset(offset, offset),
		BackgroundColor3 = C.Ink,
		BackgroundTransparency = props.ShadowTransparency or 0,
		ZIndex = container.ZIndex,
		Parent = container,
	}, { Kit.Corner(props.Corner) })
	local body = Kit.new("Frame", {
		Name = "Body",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = C.White,
		ZIndex = container.ZIndex,
		ClipsDescendants = props.Clip == true,
		Parent = container,
	}, {
		Kit.Corner(props.Corner),
		Kit.Stroke(props.StrokeThickness or 4),
		Kit.Gradient(props.Gradient or "Paper"),
	})
	return container, body
end

-- Bandes de danger jaune/noir (dans un CanvasGroup pour couper proprement).
function Kit.Hazard(props: { [string]: any }): CanvasGroup
	local group = Kit.new("CanvasGroup", {
		Name = "Hazard",
		Size = props.Size or UDim2.new(1, 0, 0, 14),
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or Vector2.zero,
		BackgroundColor3 = props.ColorA or C.Gold,
		BorderSizePixel = 0,
		ZIndex = props.ZIndex or 1,
		Parent = props.Parent,
	}, { Kit.Corner(props.Corner or 4) })
	local stripes = Kit.new("Frame", {
		Size = UDim2.new(2, 0, 1, 0),
		BackgroundTransparency = 1,
		Parent = group,
	})
	for i = 0, 60 do
		Kit.new("Frame", {
			Size = UDim2.new(0, 10, 3, 0),
			Position = UDim2.new(0, i * 24, -1, 0),
			Rotation = 35,
			BackgroundColor3 = props.ColorB or C.Ink,
			BorderSizePixel = 0,
			ZIndex = group.ZIndex,
			Parent = stripes,
		})
	end
	if props.Animate ~= false then
		Kit.Tween(stripes, 1.6, { Position = UDim2.fromOffset(-48, 0) }, Enum.EasingStyle.Linear, Enum.EasingDirection.InOut, -1)
	end
	return group
end

-- Ruban de titre incliné.
function Kit.Ribbon(props: { [string]: any }): Frame
	local ribbon = Kit.new("Frame", {
		Name = "Ribbon",
		Size = props.Size or UDim2.fromOffset(320, 56),
		Position = props.Position or UDim2.new(0.5, 0, 0, -26),
		AnchorPoint = props.AnchorPoint or Vector2.new(0.5, 0),
		Rotation = props.Rotation or -2.5,
		BackgroundColor3 = C.White,
		ZIndex = (props.ZIndex or 1) + 2,
		Parent = props.Parent,
	}, {
		Kit.Corner(10),
		Kit.Stroke(4),
		Kit.Gradient(props.Color or "Magma"),
	})
	Kit.new("Frame", {
		Name = "Shadow",
		Size = UDim2.fromScale(1, 1),
		Position = UDim2.fromOffset(5, 5),
		BackgroundColor3 = C.Ink,
		ZIndex = ribbon.ZIndex - 1,
		Parent = ribbon,
	}, { Kit.Corner(10) })
	Kit.Text({
		Name = "Title",
		Size = UDim2.new(1, -24, 1, -10),
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Text = props.Text or "",
		FontFace = F.Title,
		ZIndex = ribbon.ZIndex + 1,
		Stroke = 3,
		Parent = ribbon,
	})
	return ribbon
end

-- Bouton 3D à lèvre, avec reflet qui balaie au survol.
function Kit.Button(props: { [string]: any }): TextButton
	local color = props.Color or "Radioactive"
	local colors = Theme.Gradients[color] or Theme.Gradients.Radioactive
	local lipColor = colors[2]:Lerp(C.Ink, 0.45)
	local z = props.ZIndex or 5
	local button = Kit.new("TextButton", {
		Name = props.Name or "Button",
		Size = props.Size or UDim2.fromOffset(200, 64),
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or Vector2.zero,
		LayoutOrder = props.LayoutOrder or 0,
		Rotation = props.Rotation or 0,
		BackgroundTransparency = 1,
		Text = "",
		AutoButtonColor = false,
		ZIndex = z,
		Parent = props.Parent,
	})
	Kit.new("Frame", {
		Name = "Lip",
		Size = UDim2.new(1, 0, 1, 0),
		Position = UDim2.fromOffset(0, 6),
		BackgroundColor3 = lipColor,
		ZIndex = z,
		Parent = button,
	}, { Kit.Corner(props.Corner or 14), Kit.Stroke(3) })
	local face = Kit.new("Frame", {
		Name = "Face",
		Size = UDim2.new(1, 0, 1, 0),
		BackgroundColor3 = C.White,
		ZIndex = z + 1,
		Parent = button,
	}, { Kit.Corner(props.Corner or 14), Kit.Stroke(3), Kit.Gradient(colors) })
	-- reflet haut (volume)
	Kit.new("Frame", {
		Name = "Gloss",
		Size = UDim2.new(1, -12, 0.36, 0),
		Position = UDim2.fromOffset(6, 4),
		BackgroundColor3 = C.White,
		BackgroundTransparency = 0.7,
		ZIndex = z + 2,
		Parent = face,
	}, { Kit.Corner((props.Corner or 14) - 4) })
	-- reflet qui balaie : bande diagonale dessinée par un dégradé (aucun
	-- débordement, même quand le bouton ou sa fenêtre sont inclinés)
	local shineFrame = Kit.new("Frame", {
		Name = "Shine",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = C.White,
		BackgroundTransparency = 0.35,
		ZIndex = z + 3,
		Parent = face,
	}, { Kit.Corner(props.Corner or 14) })
	local shine = Kit.new("UIGradient", {
		Rotation = 20,
		Offset = Vector2.new(-1, 0),
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1),
			NumberSequenceKeypoint.new(0.42, 1),
			NumberSequenceKeypoint.new(0.5, 0.2),
			NumberSequenceKeypoint.new(0.58, 1),
			NumberSequenceKeypoint.new(1, 1),
		}),
		Parent = shineFrame,
	})
	local content = Kit.new("Frame", {
		Name = "Content",
		Size = UDim2.new(1, -16, 1, -8),
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundTransparency = 1,
		ZIndex = z + 4,
		Parent = face,
	}, { Kit.List(Enum.FillDirection.Horizontal, 6, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Center) })
	if props.Icon then
		Kit.Text({
			Name = "Icon",
			Size = UDim2.new(0, props.IconSize or 34, 1, 0),
			Text = props.Icon,
			FontFace = F.Body,
			ZIndex = z + 4,
			LayoutOrder = 1,
			Stroke = false,
			Parent = content,
		})
	end
	local label = Kit.Text({
		Name = "Label",
		Size = UDim2.new(if props.Icon then 0.75 else 1, 0, props.TextHeight or 0.8, 0),
		AutomaticSize = if props.Icon then Enum.AutomaticSize.X else Enum.AutomaticSize.None,
		Text = props.Text or "",
		FontFace = props.Font or F.Title,
		TextColor3 = props.TextColor or C.White,
		ZIndex = z + 4,
		LayoutOrder = 2,
		Stroke = 2.5,
		MaxTextSize = props.MaxTextSize or 34,
		Parent = content,
	})
	if props.Icon then
		label.Size = UDim2.new(0, 0, props.TextHeight or 0.8, 0)
		label.TextScaled = false
		label.TextSize = props.TextSize or 26
	end

	local scale = Kit.ScaleOf(button)
	local hovering = false
	button.MouseEnter:Connect(function()
		if button:GetAttribute("Disabled") then
			return
		end
		hovering = true
		Audio.Play("ui_hover", { Cooldown = 0.06 })
		Kit.Tween(scale, 0.25, { Scale = 1.06 }, Enum.EasingStyle.Back)
		Kit.Tween(button, 0.25, { Rotation = (props.Rotation or 0) + (props.HoverTilt or 1.5) }, Enum.EasingStyle.Back)
		shine.Offset = Vector2.new(-1, 0)
		Kit.Tween(shine, 0.55, { Offset = Vector2.new(1, 0) }, Enum.EasingStyle.Quad)
	end)
	button.MouseLeave:Connect(function()
		hovering = false
		Kit.Tween(scale, 0.2, { Scale = 1 })
		Kit.Tween(button, 0.2, { Rotation = props.Rotation or 0 })
		face.Position = UDim2.new()
	end)
	button.MouseButton1Down:Connect(function()
		if button:GetAttribute("Disabled") then
			return
		end
		face.Position = UDim2.fromOffset(0, 5)
		Kit.Tween(scale, 0.08, { Scale = 0.95 })
	end)
	button.MouseButton1Up:Connect(function()
		face.Position = UDim2.new()
		Kit.Tween(scale, 0.25, { Scale = if hovering then 1.06 else 1 }, Enum.EasingStyle.Back)
	end)
	button.Activated:Connect(function()
		if button:GetAttribute("Disabled") then
			Audio.Play("ui_error")
			Kit.Shake(button, 4, 0.25)
			return
		end
		Audio.Play(props.Sound or "ui_click")
		if props.OnClick then
			task.spawn(props.OnClick, button)
		end
	end)
	return button
end

function Kit.SetButtonText(button: GuiObject, text: string)
	local label = button:FindFirstChild("Label", true) :: TextLabel?
	if label then
		label.Text = text
	end
end

function Kit.SetButtonColor(button: GuiObject, color: string)
	local colors = Theme.Gradients[color]
	local face = button:FindFirstChild("Face")
	local lip = button:FindFirstChild("Lip") :: Frame?
	if colors and face and lip then
		local g = face:FindFirstChildOfClass("UIGradient")
		if g then
			g.Color = ColorSequence.new(colors[1], colors[2])
		end
		lip.BackgroundColor3 = colors[2]:Lerp(C.Ink, 0.45)
	end
end

function Kit.SetDisabled(button: GuiObject, disabled: boolean)
	button:SetAttribute("Disabled", disabled)
	local face = button:FindFirstChild("Face") :: Frame?
	if face then
		local g = face:FindFirstChildOfClass("UIGradient")
		if g then
			if disabled then
				g:SetAttribute("Saved", g:GetAttribute("Saved") or g.Color)
				g.Color = ColorSequence.new(Theme.Gradients.Grey[1], Theme.Gradients.Grey[2])
			elseif g:GetAttribute("Saved") then
				g.Color = g:GetAttribute("Saved")
				g:SetAttribute("Saved", nil)
			end
		end
	end
end

-- Pastille de notification (!) qui rebondit.
function Kit.Badge(parent: GuiObject, text: string?): Frame
	local badge = parent:FindFirstChild("Badge") :: Frame?
	if not badge then
		badge = Kit.new("Frame", {
			Name = "Badge",
			Size = UDim2.fromOffset(28, 28),
			Position = UDim2.new(1, -6, 0, -6),
			AnchorPoint = Vector2.new(0.5, 0.5),
			BackgroundColor3 = C.Red,
			ZIndex = 50,
			Visible = false,
			Parent = parent,
		}, { Kit.Round(), Kit.Stroke(3) })
		Kit.Text({
			Name = "Text",
			Size = UDim2.fromScale(0.8, 0.8),
			Position = UDim2.fromScale(0.5, 0.5),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Text = text or "!",
			ZIndex = 51,
			Stroke = 1.5,
			Parent = badge,
		})
		Kit.Breathe(badge :: Frame, 0.18, 0.45)
	end
	return badge :: Frame
end

function Kit.SetBadge(parent: GuiObject, visible: boolean, text: string?)
	local badge = Kit.Badge(parent, text)
	badge.Visible = visible
	if text then
		local label = badge:FindFirstChild("Text") :: TextLabel?
		if label then
			label.Text = text
		end
	end
end

-- Rayons de soleil tournants (derrière les récompenses).
function Kit.Starburst(props: { [string]: any }): Frame
	local holder = Kit.new("Frame", {
		Name = "Starburst",
		Size = props.Size or UDim2.fromOffset(600, 600),
		Position = props.Position or UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundTransparency = 1,
		ZIndex = props.ZIndex or 1,
		Parent = props.Parent,
	})
	local count = props.Rays or 14
	for i = 1, count do
		Kit.new("Frame", {
			Size = UDim2.new(0.12, 0, 1, 0),
			Position = UDim2.fromScale(0.5, 0.5),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Rotation = i / count * 180,
			BackgroundColor3 = props.Color or C.Gold,
			BackgroundTransparency = props.Transparency or 0.55,
			BorderSizePixel = 0,
			ZIndex = holder.ZIndex,
			Parent = holder,
		}, {
			Kit.new("UIGradient", {
				Transparency = NumberSequence.new({
					NumberSequenceKeypoint.new(0, 1),
					NumberSequenceKeypoint.new(0.35, 0.2),
					NumberSequenceKeypoint.new(0.5, 1),
					NumberSequenceKeypoint.new(0.65, 0.2),
					NumberSequenceKeypoint.new(1, 1),
				}),
				Rotation = 90,
			}),
		})
	end
	Kit.Tween(holder, props.Period or 12, { Rotation = 360 }, Enum.EasingStyle.Linear, Enum.EasingDirection.InOut, -1)
	return holder
end

-- Barre de progression encrée.
function Kit.ProgressBar(props: { [string]: any }): (Frame, (number, boolean?) -> ())
	local bar = Kit.new("Frame", {
		Name = props.Name or "Progress",
		Size = props.Size or UDim2.fromOffset(200, 18),
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or Vector2.zero,
		LayoutOrder = props.LayoutOrder or 0,
		BackgroundColor3 = C.Ink,
		ZIndex = props.ZIndex or 5,
		Parent = props.Parent,
	}, { Kit.Round(), Kit.Stroke(3) })
	local fill = Kit.new("Frame", {
		Name = "Fill",
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = C.White,
		ZIndex = bar.ZIndex + 1,
		Parent = bar,
	}, { Kit.Round(), Kit.Gradient(props.Color or "Radioactive") })
	local function set(alpha: number, instant: boolean?)
		alpha = math.clamp(alpha, 0, 1)
		if instant then
			fill.Size = UDim2.fromScale(alpha, 1)
		else
			Kit.Tween(fill, 0.35, { Size = UDim2.fromScale(alpha, 1) })
		end
		fill.Visible = alpha > 0.01
	end
	set(props.Value or 0, true)
	return bar, set
end

-- Liste défilante stylée.
function Kit.Scroll(props: { [string]: any }): ScrollingFrame
	return Kit.new("ScrollingFrame", {
		Name = props.Name or "Scroll",
		Size = props.Size or UDim2.fromScale(1, 1),
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or Vector2.zero,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 10,
		ScrollBarImageColor3 = C.Ink,
		ScrollBarImageTransparency = 0.2,
		AutomaticCanvasSize = props.Horizontal and Enum.AutomaticSize.X or Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		ScrollingDirection = props.Horizontal and Enum.ScrollingDirection.X or Enum.ScrollingDirection.Y,
		ZIndex = props.ZIndex or 5,
		Parent = props.Parent,
	})
end

-- Pastille arrondie (étiquette de rareté, chips…).
function Kit.Chip(props: { [string]: any }): Frame
	local chip = Kit.new("Frame", {
		Name = props.Name or "Chip",
		Size = props.Size or UDim2.fromOffset(120, 30),
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or Vector2.zero,
		AutomaticSize = props.AutoWidth and Enum.AutomaticSize.X or Enum.AutomaticSize.None,
		LayoutOrder = props.LayoutOrder or 0,
		BackgroundColor3 = props.Color or C.Ink,
		ZIndex = props.ZIndex or 5,
		Parent = props.Parent,
	}, { Kit.Round(), Kit.Stroke(2.5), Kit.Padding(10, 2) })
	Kit.Text({
		Name = "Text",
		Size = UDim2.new(if props.AutoWidth then 0 else 1, 0, 1, 0),
		AutomaticSize = props.AutoWidth and Enum.AutomaticSize.X or Enum.AutomaticSize.None,
		TextScaled = not props.AutoWidth,
		TextSize = props.TextSize or 18,
		Text = props.Text or "",
		FontFace = props.Font or F.Title,
		TextColor3 = props.TextColor or C.White,
		ZIndex = chip.ZIndex + 1,
		Stroke = 2,
		Parent = chip,
	})
	return chip
end

----------------------------------------------------------------------------
-- Fenêtres modales
----------------------------------------------------------------------------

local root: ScreenGui? = nil
local blur: BlurEffect? = nil
local openWindow: any = nil
Kit.WindowOpened = Signal.new()

function Kit.Root(): ScreenGui
	if root then
		return root
	end
	local player = Players.LocalPlayer
	root = Kit.new("ScreenGui", {
		Name = "KaijuUI",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		DisplayOrder = 5,
		Parent = player:WaitForChild("PlayerGui"),
	})
	blur = Kit.new("BlurEffect", { Name = "UIBlur", Size = 0, Parent = Lighting })
	return root :: any
end

-- Crée une couche plein écran (au-dessus du HUD si displayOrder plus grand).
function Kit.Layer(name: string, displayOrder: number): ScreenGui
	local player = Players.LocalPlayer
	return Kit.new("ScreenGui", {
		Name = name,
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		DisplayOrder = displayOrder,
		Parent = player:WaitForChild("PlayerGui"),
	})
end

export type Window = {
	Frame: Frame, -- zone de contenu
	Holder: Frame,
	Open: (self: Window) -> (),
	Close: (self: Window) -> (),
	IsOpen: boolean,
	Opened: any,
	Closed: any,
}

function Kit.Window(props: { [string]: any }): Window
	local layer = Kit.Layer("Window_" .. (props.Name or props.Title or "W"), 20)
	layer.Enabled = false
	local backdrop = Kit.new("TextButton", {
		Name = "Backdrop",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = C.Ink,
		BackgroundTransparency = 1,
		Text = "",
		AutoButtonColor = false,
		Parent = layer,
	})
	local holder = Kit.new("Frame", {
		Name = "Holder",
		Size = props.Size or UDim2.fromOffset(820, 520),
		Position = UDim2.fromScale(0.5, 0.53),
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundTransparency = 1,
		Parent = layer,
	})
	Kit.AutoScale(holder)
	-- Au repos la fenêtre est droite : Roblox ne découpe pas (ClipsDescendants)
	-- le contenu d'un parent incliné. L'inclinaison BD passe par le ruban.
	local restRotation = props.Rotation or 0
	local container, body = Kit.Panel({
		Size = UDim2.fromScale(1, 1),
		Rotation = restRotation,
		Gradient = props.Gradient or "Paper",
		Parent = holder,
	})
	-- bandeau de danger en bas
	Kit.Hazard({
		Size = UDim2.new(1, -40, 0, 12),
		Position = UDim2.new(0.5, 0, 1, -22),
		AnchorPoint = Vector2.new(0.5, 0),
		ZIndex = 3,
		Parent = body,
	})
	Kit.Ribbon({
		Text = (props.Icon and (props.Icon .. " ") or "") .. (props.Title or ""),
		Color = props.Color or "Magma",
		Size = UDim2.fromOffset(props.RibbonWidth or 360, 62),
		Position = UDim2.new(0.5, 0, 0, -34),
		ZIndex = 5,
		Parent = container,
	})
	local close = Kit.Button({
		Name = "Close",
		Text = "X",
		Color = "Red",
		Size = UDim2.fromOffset(56, 56),
		Position = UDim2.new(1, -18, 0, -18),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Corner = 28,
		ZIndex = 30,
		Sound = "ui_close",
		HoverTilt = 12,
		Parent = container,
	})
	local content = Kit.new("Frame", {
		Name = "Content",
		Size = UDim2.new(1, -44, 1, -80),
		Position = UDim2.fromOffset(22, 44),
		BackgroundTransparency = 1,
		ZIndex = 5,
		Parent = body,
	})

	local window = {
		Frame = content,
		Holder = holder,
		IsOpen = false,
		Opened = Signal.new(),
		Closed = Signal.new(),
	}

	function window.Open(self)
		if self.IsOpen then
			return
		end
		if openWindow and openWindow ~= self then
			openWindow:Close(true)
		end
		openWindow = self
		self.IsOpen = true
		layer.Enabled = true
		Audio.Play("ui_open")
		backdrop.BackgroundTransparency = 1
		Kit.Tween(backdrop, 0.25, { BackgroundTransparency = 0.45 })
		if blur then
			Kit.Tween(blur, 0.3, { Size = 14 })
		end
		local s = Kit.ScaleOf(container)
		s.Scale = 0.55
		container.Rotation = restRotation - 9
		Kit.Tween(s, 0.45, { Scale = 1 }, Enum.EasingStyle.Back)
		Kit.Tween(container, 0.5, { Rotation = restRotation }, Enum.EasingStyle.Back)
		self.Opened:Fire()
		Kit.WindowOpened:Fire(self)
	end

	function window.Close(self, silent: boolean?)
		if not self.IsOpen then
			return
		end
		self.IsOpen = false
		if openWindow == self then
			openWindow = nil
		end
		if not silent then
			Audio.Play("ui_close")
		end
		local s = Kit.ScaleOf(container)
		Kit.Tween(s, 0.18, { Scale = 0.7 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		Kit.Tween(backdrop, 0.18, { BackgroundTransparency = 1 })
		if blur and not openWindow then
			Kit.Tween(blur, 0.2, { Size = 0 })
		end
		task.delay(0.18, function()
			if not self.IsOpen then
				layer.Enabled = false
			end
		end)
		self.Closed:Fire()
	end

	function window.Toggle(self)
		if self.IsOpen then
			self:Close()
		else
			self:Open()
		end
	end

	close.Activated:Connect(function()
		window:Close()
	end)
	backdrop.Activated:Connect(function()
		window:Close()
	end)
	return window :: any
end

function Kit.CloseAll()
	if openWindow then
		openWindow:Close()
	end
end

-- Onglets : renvoie la barre et une fonction select(id).
function Kit.Tabs(props: { [string]: any }): (Frame, (string) -> ())
	local bar = Kit.new("Frame", {
		Name = "Tabs",
		Size = props.Size or UDim2.new(1, 0, 0, 52),
		Position = props.Position or UDim2.new(),
		BackgroundTransparency = 1,
		ZIndex = 6,
		Parent = props.Parent,
	}, { Kit.List(Enum.FillDirection.Horizontal, 10, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Center) })
	local buttons = {}
	local function select(id: string)
		for tabId, button in buttons do
			local active = tabId == id
			Kit.SetButtonColor(button, if active then (props.ActiveColor or "Magma") else "Ink")
		end
		if props.OnSelect then
			props.OnSelect(id)
		end
	end
	for i, tab in props.Tabs do
		buttons[tab.Id] = Kit.Button({
			Name = tab.Id,
			Text = tab.Text,
			Icon = tab.Icon,
			IconSize = 26,
			TextSize = 20,
			Color = "Ink",
			Size = UDim2.fromOffset(tab.Width or 140, 46),
			LayoutOrder = i,
			Sound = "ui_tab",
			ZIndex = 6,
			OnClick = function()
				select(tab.Id)
			end,
			Parent = bar,
		})
	end
	return bar, select
end

return Kit
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="67">
            <Properties>
              <string name="Name">Notifications</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Toasts, fil d'annonces du serveur, grandes annonces centrales, popup de
-- probabilités (obligatoire pour le hasard payant) et « Welcome back ».

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TextChatService = game:GetService("TextChatService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)
local Format = require(Shared.Logic.Format)

local Kit = require(script.Parent.Kit)
local Controllers = script.Parent.Parent.Controllers
local Audio = require(Controllers.Audio)
local Remote = require(Controllers.Remote)
local FxBus = require(Controllers.FxBus)
local UIRegistry = require(Controllers.UIRegistry)

local C = Kit.Colors
local F = Kit.Fonts

local Notifications = {}

local layer: ScreenGui
local toastHolder: Frame
local feedHolder: Frame
local announceHolder: Frame

local TOAST_STYLE = {
	Info = { Color = "Ink", Icon = "💬", Sound = "ui_tab" },
	Good = { Color = "Radioactive", Icon = "✅", Sound = "reward_claim" },
	Bad = { Color = "Red", Icon = "⛔", Sound = "ui_error" },
	Cash = { Color = "Radioactive", Icon = "💰", Sound = "cash_collect" },
	Gem = { Color = "Cyan", Icon = "💎", Sound = "reward_claim" },
	Rare = { Color = "Purple", Icon = "✨", Sound = "hatch_epic" },
}

----------------------------------------------------------------------------
-- Toasts (en bas à droite)
----------------------------------------------------------------------------

function Notifications.Toast(text: string, kind: string?)
	local style = TOAST_STYLE[kind or "Info"] or TOAST_STYLE.Info
	local order = -math.floor(os.clock() * 100)
	local holder = Kit.new("Frame", {
		Size = UDim2.fromOffset(420, 58),
		BackgroundTransparency = 1,
		LayoutOrder = order,
		Parent = toastHolder,
	})
	local container, body = Kit.Panel({
		Size = UDim2.fromScale(1, 1),
		Position = UDim2.fromScale(1.2, 0),
		Rotation = math.random(-15, 15) / 10,
		Gradient = style.Color,
		ShadowOffset = 5,
		Parent = holder,
	})
	Kit.Text({
		Size = UDim2.new(0, 40, 1, -10),
		Position = UDim2.fromOffset(8, 5),
		Text = style.Icon,
		FontFace = F.Body,
		Stroke = false,
		Parent = body,
	})
	Kit.Text({
		Size = UDim2.new(1, -60, 1, -12),
		Position = UDim2.fromOffset(52, 6),
		Text = text,
		FontFace = F.Body,
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxTextSize = 24,
		Parent = body,
	})
	Kit.Tween(container, 0.4, { Position = UDim2.fromScale(0, 0) }, Enum.EasingStyle.Back)
	if kind ~= "Info" then
		Audio.Play(style.Sound, { Volume = 0.6, Cooldown = 0.15 })
	end
	task.delay(3.6, function()
		Kit.Tween(container, 0.3, { Position = UDim2.fromScale(1.3, 0) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		task.wait(0.3)
		holder:Destroy()
	end)
	-- limite le nombre de toasts
	local toasts = {}
	for _, child in toastHolder:GetChildren() do
		if child:IsA("Frame") then
			table.insert(toasts, child)
		end
	end
	if #toasts > 5 then
		table.sort(toasts, function(a, b)
			return a.LayoutOrder > b.LayoutOrder
		end)
		toasts[1]:Destroy()
	end
end

----------------------------------------------------------------------------
-- Fil d'annonces (à gauche) + chat
----------------------------------------------------------------------------

local FEED_ICON = {
	Meteor = "☄️",
	Rare = "🌟",
	Heist = "🦹",
	Help = "🆘",
	Event = "⚡",
	Boss = "👹",
	Purchase = "🛒",
	Rebirth = "🧬",
	Info = "📣",
}

local function systemChat(text: string, color: Color3?)
	local ok, channels = pcall(function()
		return TextChatService:WaitForChild("TextChannels", 2)
	end)
	if not ok or not channels then
		return
	end
	local general = channels:FindFirstChild("RBXGeneral") :: TextChannel?
	if general then
		local hex = (color or C.Gold):ToHex()
		pcall(general.DisplaySystemMessage, general, ('<font color="#%s"><b>%s</b></font>'):format(hex, text))
	end
end

function Notifications.Feed(text: string, style: string?, color: Color3?)
	local icon = FEED_ICON[style or "Info"] or "📣"
	local accent = color or C.Magma
	local row = Kit.new("Frame", {
		Size = UDim2.new(1, 0, 0, 40),
		BackgroundColor3 = C.Ink,
		BackgroundTransparency = 0.15,
		LayoutOrder = math.floor(os.clock() * 100),
		Position = UDim2.fromScale(-1, 0),
		Parent = feedHolder,
	}, { Kit.Corner(10), Kit.Stroke(2.5, accent) })
	Kit.new("Frame", {
		Size = UDim2.new(0, 6, 1, -10),
		Position = UDim2.fromOffset(5, 5),
		BackgroundColor3 = accent,
		Parent = row,
	}, { Kit.Round() })
	Kit.Text({
		Size = UDim2.new(1, -24, 1, -8),
		Position = UDim2.fromOffset(16, 4),
		Text = icon .. "  " .. text,
		FontFace = F.Body,
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxTextSize = 20,
		Stroke = 1.5,
		Parent = row,
	})
	Kit.Pop(row, 0.6, 0.35)
	task.delay(8, function()
		Kit.Tween(row, 0.4, { BackgroundTransparency = 1 })
		for _, d in row:GetDescendants() do
			if d:IsA("TextLabel") then
				Kit.Tween(d, 0.4, { TextTransparency = 1 })
			elseif d:IsA("UIStroke") then
				Kit.Tween(d, 0.4, { Transparency = 1 })
			elseif d:IsA("Frame") then
				Kit.Tween(d, 0.4, { BackgroundTransparency = 1 })
			end
		end
		task.wait(0.45)
		row:Destroy()
	end)
	local rows = {}
	for _, child in feedHolder:GetChildren() do
		if child:IsA("Frame") then
			table.insert(rows, child)
		end
	end
	if #rows > 5 then
		table.sort(rows, function(a, b)
			return a.LayoutOrder < b.LayoutOrder
		end)
		rows[1]:Destroy()
	end
	systemChat(text, accent)
end

----------------------------------------------------------------------------
-- Grande annonce centrale (style titre de film)
----------------------------------------------------------------------------

function Notifications.Announce(text: string, color: Color3?, subtitle: string?, sound: string?)
	for _, child in announceHolder:GetChildren() do
		child:Destroy()
	end
	-- le bandeau du tutoriel s'efface le temps de l'annonce (même zone de l'écran)
	local tutorial = layer.Parent and layer.Parent:FindFirstChild("Tutorial") :: ScreenGui?
	if tutorial then
		tutorial.Enabled = false
		local stamp = os.clock()
		layer:SetAttribute("AnnounceStamp", stamp)
		task.delay(3.7, function()
			if layer:GetAttribute("AnnounceStamp") == stamp then
				tutorial.Enabled = true
			end
		end)
	end
	local frame = Kit.new("Frame", {
		Size = UDim2.fromOffset(900, 150),
		Position = UDim2.fromScale(0.5, 0.26),
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundTransparency = 1,
		Parent = announceHolder,
	})
	Kit.AutoScale(frame)
	Kit.Hazard({ Size = UDim2.new(1.1, 0, 0, 16), Position = UDim2.new(0.5, 0, 0, 0), AnchorPoint = Vector2.new(0.5, 0), Parent = frame })
	Kit.Hazard({ Size = UDim2.new(1.1, 0, 0, 16), Position = UDim2.new(0.5, 0, 1, -16), AnchorPoint = Vector2.new(0.5, 0), Parent = frame })
	local title = Kit.Text({
		Size = UDim2.new(1, 0, 0, 90),
		Position = UDim2.fromOffset(0, 18),
		Text = text,
		FontFace = F.Impact,
		TextColor3 = color or C.Gold,
		Stroke = 5,
		MaxTextSize = 84,
		Rotation = -2,
		Parent = frame,
	})
	if subtitle then
		Kit.Text({
			Size = UDim2.new(0.8, 0, 0, 28),
			Position = UDim2.new(0.5, 0, 0, 104),
			AnchorPoint = Vector2.new(0.5, 0),
			Text = subtitle,
			FontFace = F.Body,
			MaxTextSize = 26,
			Parent = frame,
		})
	end
	Kit.Pop(title, 2.2, 0.45)
	Kit.Shake(frame, 8, 0.4)
	if sound then
		Audio.Play(sound)
	end
	task.delay(3.4, function()
		if frame.Parent then
			Kit.Tween(Kit.ScaleOf(title), 0.25, { Scale = 0 }, Enum.EasingStyle.Back, Enum.EasingDirection.In)
			task.wait(0.3)
			frame:Destroy()
		end
	end)
end

----------------------------------------------------------------------------
-- Popup des probabilités
----------------------------------------------------------------------------

local oddsWindow

function Notifications.ShowOdds(title: string, rows: { { Label: string, Chance: number, Color: Color3? } })
	if not oddsWindow then
		oddsWindow = Kit.Window({ Name = "Odds", Title = "ODDS", Icon = "🎲", Color = "Cyan", Size = UDim2.fromOffset(520, 460), RibbonWidth = 240 })
	end
	local content = oddsWindow.Frame
	for _, child in content:GetChildren() do
		child:Destroy()
	end
	Kit.Text({ Size = UDim2.new(1, 0, 0, 36), Text = title, TextColor3 = C.Ink, Stroke = false, FontFace = F.Title, Parent = content })
	local list = Kit.Scroll({ Size = UDim2.new(1, 0, 1, -46), Position = UDim2.fromOffset(0, 44), Parent = content })
	Kit.List(Enum.FillDirection.Vertical, 6).Parent = list
	for i, row in rows do
		local line = Kit.new("Frame", {
			Size = UDim2.new(1, -16, 0, 36),
			BackgroundColor3 = C.Ink,
			BackgroundTransparency = if i % 2 == 0 then 0.9 else 0.8,
			LayoutOrder = i,
			Parent = list,
		}, { Kit.Corner(8) })
		Kit.Text({
			Size = UDim2.new(0.68, 0, 1, -8),
			Position = UDim2.fromOffset(10, 4),
			Text = row.Label,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextColor3 = row.Color or C.Ink,
			FontFace = F.Body,
			Stroke = if row.Color then 1.5 else false,
			Parent = line,
		})
		Kit.Text({
			Size = UDim2.new(0.3, -10, 1, -8),
			Position = UDim2.new(0.7, 0, 0, 4),
			Text = Format.Percent(row.Chance),
			TextXAlignment = Enum.TextXAlignment.Right,
			TextColor3 = C.Ink,
			FontFace = F.Title,
			Stroke = false,
			Parent = line,
		})
	end
	oddsWindow:Open()
end

----------------------------------------------------------------------------
-- Bon retour (gains hors ligne)
----------------------------------------------------------------------------

local function welcomeBack(args)
	local window = Kit.Window({ Name = "WelcomeBack", Title = "WELCOME BACK!", Icon = "🌙", Color = "Purple", Size = UDim2.fromOffset(560, 380), RibbonWidth = 380 })
	local content = window.Frame
	Kit.Starburst({ Size = UDim2.fromOffset(420, 420), Position = UDim2.fromScale(0.5, 0.4), Color = C.Gold, Parent = content })
	Kit.Text({
		Size = UDim2.new(1, 0, 0, 40),
		Position = UDim2.fromOffset(0, 10),
		Text = ("Your kaijus worked for %s while you were away"):format(Format.Duration(args.Seconds or 0)),
		TextColor3 = C.Ink,
		FontFace = F.Body,
		Stroke = false,
		ZIndex = 6,
		Parent = content,
	})
	local amount = Kit.Text({
		Size = UDim2.new(1, 0, 0, 90),
		Position = UDim2.fromOffset(0, 70),
		Text = "$0",
		FontFace = F.Impact,
		TextColor3 = C.Cash,
		Stroke = 5,
		MaxTextSize = 90,
		ZIndex = 6,
		Parent = content,
	})
	if args.Capped then
		Kit.Text({
			Size = UDim2.new(1, 0, 0, 26),
			Position = UDim2.fromOffset(0, 168),
			Text = ("(capped at %dh — get Night Shift for 8h!)"):format(args.MaxHours or 3),
			TextColor3 = C.InkSoft,
			FontFace = F.Body,
			Stroke = false,
			ZIndex = 6,
			Parent = content,
		})
	end
	Kit.Text({
		Size = UDim2.new(1, 0, 0, 26),
		Position = UDim2.fromOffset(0, 200),
		Text = "It's waiting in your Cash Reactor — step on the pad!",
		TextColor3 = C.Ink,
		FontFace = F.Body,
		Stroke = false,
		ZIndex = 6,
		Parent = content,
	})
	local ok = Kit.Button({
		Text = "AWESOME!",
		Color = "Radioactive",
		Size = UDim2.fromOffset(240, 62),
		Position = UDim2.new(0.5, 0, 1, -76),
		AnchorPoint = Vector2.new(0.5, 0),
		ZIndex = 8,
		OnClick = function()
			window:Close()
		end,
		Parent = content,
	})
	Kit.Breathe(ok)
	window:Open()
	task.delay(0.4, function()
		Kit.CountTo(amount, args.Amount or 0, Format.Cash, 1.6)
		Audio.Play("cash_collect")
	end)
end

function Notifications.Init()
	layer = Kit.Layer("Notifications", 40)
	toastHolder = Kit.new("Frame", {
		Name = "Toasts",
		Size = UDim2.fromOffset(440, 420),
		Position = UDim2.new(1, -130, 1, -110),
		AnchorPoint = Vector2.new(1, 1),
		BackgroundTransparency = 1,
		Parent = layer,
	}, { Kit.List(Enum.FillDirection.Vertical, 8, Enum.HorizontalAlignment.Right, Enum.VerticalAlignment.Bottom) })
	Kit.AutoScale(toastHolder)
	-- Le fil vit sous les fenêtres (DisplayOrder 6 < 20) et en bas à gauche,
	-- loin des menus et des annonces centrales.
	local feedLayer = Kit.Layer("Feed", 6)
	feedHolder = Kit.new("Frame", {
		Name = "Feed",
		Size = UDim2.fromOffset(470, 230),
		Position = UDim2.new(0, 20, 1, -24),
		AnchorPoint = Vector2.new(0, 1),
		BackgroundTransparency = 1,
		Parent = feedLayer,
	}, { Kit.List(Enum.FillDirection.Vertical, 6, Enum.HorizontalAlignment.Left, Enum.VerticalAlignment.Bottom) })
	Kit.AutoScale(feedHolder)
	announceHolder = Kit.new("Frame", {
		Name = "Announce",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Parent = layer,
	})

	UIRegistry.Toast = Notifications.Toast
	UIRegistry.Announce = Notifications.Announce
	UIRegistry.ShowOdds = Notifications.ShowOdds
	Remote.OnError = function(msg)
		Notifications.Toast(msg, "Bad")
	end

	Net.Event("Notify").OnClientEvent:Connect(function(text, kind)
		Notifications.Toast(text, kind)
	end)
	Net.Event("Feed").OnClientEvent:Connect(function(text, style, color)
		Notifications.Feed(text, style, color)
	end)
	FxBus.On("WelcomeBack", welcomeBack)
end

return Notifications
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="68">
            <Properties>
              <string name="Name">PromptStyle</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Prompts de proximité au style du jeu (touche dans une pastille encrée,
-- bouton coloré, anneau de maintien). S'applique aux prompts « Custom ».

local ProximityPromptService = game:GetService("ProximityPromptService")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local Players = game:GetService("Players")

local Kit = require(script.Parent.Kit)
local Audio = require(script.Parent.Parent.Controllers.Audio)

local C = Kit.Colors
local F = Kit.Fonts

local PromptStyle = {}

local function keyText(prompt: ProximityPrompt, inputType: Enum.ProximityPromptInputType): string
	if inputType == Enum.ProximityPromptInputType.Touch then
		return "👆"
	elseif inputType == Enum.ProximityPromptInputType.Gamepad then
		return "X"
	end
	return UserInputService:GetStringForKeyCode(prompt.KeyboardKeyCode)
end

local function build(prompt: ProximityPrompt, inputType: Enum.ProximityPromptInputType, gui: ScreenGui)
	local billboard = Kit.new("BillboardGui", {
		Name = "Prompt",
		Size = UDim2.fromOffset(250, 76),
		AlwaysOnTop = true,
		LightInfluence = 0,
		Adornee = prompt.Parent,
		Active = true,
		Parent = gui,
	})
	local colorName = prompt:GetAttribute("Color") or "Radioactive"
	local button = Kit.Button({
		Text = prompt.ActionText,
		Color = colorName,
		Size = UDim2.fromOffset(180, 56),
		Position = UDim2.fromOffset(62, 8),
		TextSize = 24,
		Sound = "ui_click",
		Parent = billboard,
	})
	local key = Kit.new("Frame", {
		Size = UDim2.fromOffset(56, 56),
		Position = UDim2.fromOffset(4, 8),
		BackgroundColor3 = C.Paper,
		ZIndex = 8,
		Parent = billboard,
	}, { Kit.Round(), Kit.Stroke(4) })
	Kit.Text({
		Size = UDim2.fromScale(0.7, 0.7),
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Text = keyText(prompt, inputType),
		TextColor3 = C.Ink,
		Stroke = false,
		ZIndex = 9,
		Parent = key,
	})
	-- anneau de maintien (barre qui se remplit sous la touche)
	local holdBar = Kit.new("Frame", {
		Size = UDim2.new(0, 0, 0, 8),
		Position = UDim2.fromOffset(62, 70),
		BackgroundColor3 = C.Gold,
		ZIndex = 9,
		Parent = billboard,
	}, { Kit.Round(), Kit.Stroke(2) })
	if prompt.ObjectText ~= "" then
		Kit.Text({
			Size = UDim2.fromOffset(240, 22),
			Position = UDim2.fromOffset(4, -16),
			Text = prompt.ObjectText,
			FontFace = F.Body,
			TextXAlignment = Enum.TextXAlignment.Left,
			ZIndex = 9,
			Parent = billboard,
		})
	end
	Kit.Pop(billboard:FindFirstChildWhichIsA("TextButton") :: any, 0.5, 0.3)

	local holdTween: Tween? = nil
	local conns = {}
	table.insert(conns, prompt.PromptButtonHoldBegan:Connect(function()
		if prompt.HoldDuration > 0 then
			holdBar.Size = UDim2.new(0, 0, 0, 8)
			local tween = TweenService:Create(holdBar, TweenInfo.new(prompt.HoldDuration, Enum.EasingStyle.Linear), { Size = UDim2.new(0, 180, 0, 8) })
			tween:Play()
			holdTween = tween
			Audio.Play("steal_grab", { Pitch = 0.7, Volume = 0.4 })
		end
	end))
	table.insert(conns, prompt.PromptButtonHoldEnded:Connect(function()
		if holdTween then
			holdTween:Cancel()
		end
		holdBar.Size = UDim2.new(0, 0, 0, 8)
	end))
	table.insert(conns, prompt.Triggered:Connect(function()
		Kit.Punch(button, 0.2)
	end))
	table.insert(conns, prompt:GetPropertyChangedSignal("ActionText"):Connect(function()
		Kit.SetButtonText(button, prompt.ActionText)
	end))
	table.insert(conns, prompt.AttributeChanged:Connect(function(attr)
		if attr == "Color" then
			Kit.SetButtonColor(button, prompt:GetAttribute("Color") or "Radioactive")
		end
	end))
	-- clic / tap sur le bouton
	button.Activated:Connect(function()
		if prompt.HoldDuration <= 0 then
			prompt:InputHoldBegin()
			prompt:InputHoldEnd()
		end
	end)
	button.MouseButton1Down:Connect(function()
		if prompt.HoldDuration > 0 then
			prompt:InputHoldBegin()
		end
	end)
	button.MouseButton1Up:Connect(function()
		if prompt.HoldDuration > 0 then
			prompt:InputHoldEnd()
		end
	end)
	return function()
		for _, c in conns do
			c:Disconnect()
		end
		billboard:Destroy()
	end
end

function PromptStyle.Init()
	local gui = Kit.new("ScreenGui", {
		Name = "Prompts",
		ResetOnSpawn = false,
		Parent = Players.LocalPlayer:WaitForChild("PlayerGui"),
	})
	ProximityPromptService.PromptShown:Connect(function(prompt, inputType)
		if prompt.Style ~= Enum.ProximityPromptStyle.Custom then
			return
		end
		local cleanup = build(prompt, inputType, gui)
		prompt.PromptHidden:Once(cleanup)
	end)
end

return PromptStyle
]]></string>
            </Properties>
          </Item>
          <Item class="Folder" referent="69">
            <Properties>
              <string name="Name">Screens</string>
            </Properties>
            <Item class="ModuleScript" referent="70">
              <Properties>
                <string name="Name">Daily</string>
                <string name="Source"><![CDATA[--!nonstrict
-- Récompenses quotidiennes : calendrier de 7 jours, jour courant qui respire,
-- jours réclamés tamponnés, jours futurs grisés, grand œuf du jour 7.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Rewards = require(Shared.Config.Rewards)
local Rarities = require(Shared.Config.Rarities)
local Economy = require(Shared.Config.Economy)
local Theme = require(Shared.Config.Theme)
local Format = require(Shared.Logic.Format)
local Progress = require(Shared.Logic.Progress)
local Calc = require(Shared.Logic.Calc)

local Kit = require(script.Parent.Parent.Kit)
local Viewport = require(script.Parent.Parent.Viewport)
local State = require(script.Parent.Parent.Parent.Controllers.State)
local Remote = require(script.Parent.Parent.Parent.Controllers.Remote)
local Audio = require(script.Parent.Parent.Parent.Controllers.Audio)
local UIRegistry = require(script.Parent.Parent.Parent.Controllers.UIRegistry)

local C = Kit.Colors
local F = Kit.Fonts

local Daily = {}

local DAY = 86400

local window
local cards: { any } = {}
local claimSlot: Frame
local claimButton: TextButton
local claimBreather: Frame
local countdownBox: Frame
local countdownLabel: TextLabel
local streakChip: Frame
local statusLabel: TextLabel
local eggView: any = nil
local eggRarity: string? = nil
local eggLabel: TextLabel
local loopToken = 0
local busy = false
local lastDay = -1

----------------------------------------------------------------------------
-- Aides
----------------------------------------------------------------------------

local function now(): number
	return math.floor(Workspace:GetServerTimeNow())
end

local function dailyData(): any
	return State.Get("Daily") or { Streak = 0, LastDay = 0, Cycle = 0 }
end

-- (peutRéclamer, série, cycle, dernierJourRéclamé)
local function compute(): (boolean, number, number, number)
	local can, streak, cycle = Progress.DailyState(dailyData(), now())
	local claimedUpTo = if can then streak - 1 else streak
	return can, streak, cycle, claimedUpTo
end

local function rewardInfo(r: any): (string, string, Color3)
	if r.Kind == "Cash" then
		local amount = Calc.CashReward(r.Amount or 60, State.Get("Income") or 0, r.MinCash)
		return "💵", Format.Cash(amount), C.Cash
	elseif r.Kind == "Gems" then
		return "💎", tostring(r.Amount or 0) .. " GEMS", C.Gem
	elseif r.Kind == "Potion" then
		local p = Economy.PotionsById[r.Id or "Luck"]
		local name = if p then string.upper(p.Id) else "POTION"
		return if p then p.Icon else "🧪", string.format("%dx %s", r.Amount or 1, name), C.Radioactive
	elseif r.Kind == "Egg" then
		local rarity = Rarities.Get(r.Rarity or "Common")
		return "🥚", string.upper(rarity.Id) .. " EGG", rarity.Color
	elseif r.Kind == "Spins" then
		return "🎡", tostring(r.Amount or 1) .. " SPINS", C.Gold
	end
	return "🎁", "GIFT", C.White
end

local function setBreathe(inst: GuiObject, on: boolean)
	if (inst:GetAttribute("Breathing") == true) == on then
		return
	end
	inst:SetAttribute("Breathing", on)
	if on then
		Kit.Breathe(inst, 0.05, 0.75)
	else
		Kit.Tween(Kit.ScaleOf(inst), 0.2, { Scale = 1 })
	end
end

local function setGradient(frame: Frame, name: string)
	local g = frame:FindFirstChildOfClass("UIGradient")
	local colors = Theme.Gradients[name]
	if g and colors then
		g.Color = ColorSequence.new(colors[1], colors[2])
	end
end

----------------------------------------------------------------------------
-- Construction
----------------------------------------------------------------------------

-- Carte d'un jour (petite pour 1..6, grande pour le 7).
local function dayCard(parent: Instance, day: number, big: boolean, props: { [string]: any })
	local holder = Kit.new("Frame", {
		Name = "Day" .. day,
		Size = props.Size,
		Position = props.Position,
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundTransparency = 1,
		ZIndex = 5,
		Parent = parent,
	})
	local box, body = Kit.Panel({
		Size = UDim2.new(1, -8, 1, -8),
		Position = UDim2.new(0.5, -3, 0.5, -3),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Rotation = if big then 1.5 else ((day % 2 == 0) and 1.5 or -1.5),
		Gradient = if big then "Purple" else "Paper",
		Parent = holder,
	})
	-- rayons : dans la carte (jour 7, découpés par un CanvasGroup car la
	-- fenêtre est inclinée) ou derrière elle (jour courant)
	local burstParent: Instance = holder
	if big then
		burstParent = Kit.new("CanvasGroup", {
			Name = "Clip",
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			ZIndex = 2,
			Parent = body,
		}, { Kit.Corner() })
	end
	local burst = Kit.Starburst({
		Size = if big then UDim2.fromOffset(520, 520) else UDim2.fromOffset(215, 215),
		Position = UDim2.fromScale(0.5, 0.5),
		Color = C.Gold,
		Transparency = if big then 0.3 else 0.35,
		ZIndex = if big then 2 else 0,
		Parent = burstParent,
	})
	burst.Visible = big
	if not big then
		box.ZIndex = 2
	end
	-- en-tête « DAY N »
	local header = Kit.new("Frame", {
		Size = UDim2.new(1, -14, 0, if big then 40 else 30),
		Position = UDim2.fromOffset(7, 7),
		BackgroundColor3 = C.White,
		ZIndex = 3,
		Parent = body,
	}, { Kit.Corner(9), Kit.Stroke(3), Kit.Gradient(if big then "Gold" else "Ink") })
	Kit.Text({
		Size = UDim2.new(1, -10, 1, -6),
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Text = if big then "DAY 7 · MEGA EGG" else "DAY " .. day,
		Stroke = 2.5,
		MaxTextSize = if big then 30 else 22,
		ZIndex = 4,
		Parent = header,
	})
	local icon = Kit.Text({
		Name = "Icon",
		Size = if big then UDim2.fromOffset(0, 0) else UDim2.new(1, 0, 0, 62),
		Position = UDim2.new(0.5, 0, 0, if big then 0 else 42),
		AnchorPoint = Vector2.new(0.5, 0),
		Text = "",
		FontFace = F.Body,
		Stroke = false,
		MaxTextSize = 54,
		ZIndex = 4,
		Visible = not big,
		Parent = body,
	})
	local amount = Kit.Text({
		Name = "Amount",
		Size = UDim2.new(1, -12, 0, if big then 40 else 32),
		Position = UDim2.new(0.5, 0, 1, if big then -52 else -40),
		AnchorPoint = Vector2.new(0.5, 0),
		Text = "",
		FontFace = F.Impact,
		Stroke = 2.5,
		MaxTextSize = if big then 40 else 30,
		ZIndex = 4,
		Parent = body,
	})
	-- voile des jours futurs
	local dim = Kit.new("Frame", {
		Name = "Dim",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = C.Paper,
		BackgroundTransparency = 0.35,
		ZIndex = 8,
		Visible = false,
		Parent = body,
	}, { Kit.Corner() })
	-- voile + tampon des jours réclamés
	local done = Kit.new("Frame", {
		Name = "Done",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = C.Ink,
		BackgroundTransparency = 0.5,
		ZIndex = 8,
		Visible = false,
		Parent = body,
	}, { Kit.Corner() })
	local stamp = Kit.new("Frame", {
		Name = "Stamp",
		Size = UDim2.fromOffset(if big then 110 else 70, if big then 110 else 70),
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Rotation = -12,
		BackgroundColor3 = C.White,
		ZIndex = 9,
		Visible = false,
		Parent = body,
	}, { Kit.Round(), Kit.Stroke(4), Kit.Gradient("Radioactive") })
	Kit.Text({
		Size = UDim2.fromScale(0.7, 0.7),
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Text = "✓",
		FontFace = F.Body,
		Stroke = 3,
		MaxTextSize = 80,
		ZIndex = 10,
		Parent = stamp,
	})
	-- pastille TODAY / TOMORROW
	local tag = Kit.Chip({
		Name = "Tag",
		Text = "TODAY!",
		Color = C.Red,
		Size = UDim2.fromOffset(if big then 150 else 110, 28),
		Position = UDim2.new(0.5, 0, 0, -8),
		AnchorPoint = Vector2.new(0.5, 0.5),
		ZIndex = 12,
		Parent = holder,
	})
	tag.Rotation = -6
	tag.Visible = false
	return {
		Day = day,
		Big = big,
		Holder = holder,
		Box = box,
		Body = body,
		Burst = burst,
		Icon = icon,
		Amount = amount,
		Dim = dim,
		Done = done,
		Stamp = stamp,
		Tag = tag,
		Status = "",
	}
end

----------------------------------------------------------------------------
-- Rafraîchissement
----------------------------------------------------------------------------

local function refresh()
	if not window then
		return
	end
	local can, streak, cycle, claimedUpTo = compute()
	local tomorrow = if not can and streak < #Rewards.Daily then streak + 1 else nil
	for _, c in cards do
		local reward = Progress.DailyReward(c.Day, cycle)
		local icon, label, color = rewardInfo(reward)
		c.Icon.Text = icon
		c.Amount.Text = label
		c.Amount.TextColor3 = color
		local status
		if c.Day <= claimedUpTo then
			status = "claimed"
		elseif can and c.Day == streak then
			status = "today"
		elseif c.Day == tomorrow then
			status = "tomorrow"
		else
			status = "future"
		end
		c.Done.Visible = status == "claimed"
		c.Stamp.Visible = status == "claimed"
		c.Dim.Visible = status == "future"
		c.Tag.Visible = status == "today" or status == "tomorrow"
		local tagLabel = c.Tag:FindFirstChild("Text") :: TextLabel?
		if tagLabel then
			tagLabel.Text = if status == "today" then "TODAY!" else "TOMORROW"
		end
		c.Tag.BackgroundColor3 = if status == "today" then C.Red else C.InkSoft
		if not c.Big then
			c.Burst.Visible = status == "today"
			setGradient(c.Body, if status == "today" then "Gold" else "Paper")
		end
		if status ~= c.Status then
			c.Status = status
			c.Holder.ZIndex = if status == "today" then 6 else 5
			setBreathe(c.Holder, status == "today")
		end
		if c.Big then
			local rarity = reward.Rarity or "Epic"
			eggLabel.Text = string.upper(rarity) .. " EGG"
			eggLabel.TextColor3 = Rarities.Get(rarity).Color
			if eggView and eggRarity ~= rarity then
				eggRarity = rarity
				eggView:SetEgg(rarity)
			end
		end
	end
	-- série
	local streakLabel = streakChip:FindFirstChild("Text") :: TextLabel?
	if streakLabel then
		local shown = if can then streak - 1 else streak
		streakLabel.Text = string.format("🔥 STREAK: %d DAY%s", shown, if shown == 1 then "" else "S")
	end
	claimSlot.Visible = can
	countdownBox.Visible = not can
	if can then
		Kit.SetButtonText(claimButton, "CLAIM DAY " .. streak .. "!")
		statusLabel.Text = "Your reward is ready!"
		statusLabel.TextColor3 = C.RadioactiveDark
	else
		statusLabel.Text = if streak >= #Rewards.Daily then "Week complete! A new cycle starts tomorrow." else "Come back tomorrow to keep your streak!"
		statusLabel.TextColor3 = C.InkSoft
	end
	setBreathe(claimBreather, can)
end

local function tick()
	local t = now()
	local left = DAY - (t % DAY)
	countdownLabel.Text = Format.Clock(left)
	local today = t // DAY
	if today ~= lastDay then
		lastDay = today
		refresh()
	end
end

----------------------------------------------------------------------------
-- Réclamation
----------------------------------------------------------------------------

-- Texte qui s'envole depuis une carte.
local function flyText(parentCard: any, str: string, color: Color3)
	local label = Kit.Text({
		Size = UDim2.fromOffset(260, 44),
		Position = parentCard.Holder.Position,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Text = "+" .. str,
		FontFace = F.Impact,
		TextColor3 = color,
		Stroke = 3,
		MaxTextSize = 44,
		ZIndex = 20,
		Parent = parentCard.Holder.Parent,
	})
	Kit.Pop(label, 0.3, 0.4)
	Kit.Tween(label, 1.2, { Position = parentCard.Holder.Position - UDim2.fromOffset(0, 110), Rotation = math.random(-8, 8) }, Enum.EasingStyle.Quint)
	task.delay(0.8, function()
		Kit.Tween(label, 0.4, { TextTransparency = 1 })
		local stroke = label:FindFirstChildOfClass("UIStroke")
		if stroke then
			Kit.Tween(stroke, 0.4, { Transparency = 1 })
		end
	end)
	task.delay(1.3, function()
		label:Destroy()
	end)
end

local function claim()
	if busy then
		return
	end
	local can, streak = compute()
	if not can then
		return
	end
	busy = true
	Kit.SetDisabled(claimButton, true)
	local r = Remote.Call("ClaimDaily")
	busy = false
	Kit.SetDisabled(claimButton, false)
	if not r.ok then
		refresh()
		return
	end
	local day = r.streak or streak
	local c = cards[day]
	Audio.Play("reward_claim")
	UIRegistry.Toast("Day " .. day .. ": " .. tostring(r.text or "Reward claimed!"), "Good")
	if c then
		-- éclair blanc
		local flash = Kit.new("Frame", {
			Size = UDim2.fromScale(1, 1),
			BackgroundColor3 = C.White,
			BackgroundTransparency = 0,
			ZIndex = 11,
			Parent = c.Body,
		}, { Kit.Corner() })
		Kit.Tween(flash, 0.5, { BackgroundTransparency = 1 })
		task.delay(0.55, function()
			flash:Destroy()
		end)
		Kit.Shake(c.Box, 6, 0.3)
		local _, _, color = rewardInfo(Progress.DailyReward(day, (dailyData()).Cycle))
		flyText(c, tostring(r.text or ""), color)
	end
	refresh()
	if c then
		-- tampon qui claque
		local s = Kit.ScaleOf(c.Stamp)
		s.Scale = 3
		c.Stamp.Rotation = -40
		Kit.Tween(s, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
		Kit.Tween(c.Stamp, 0.35, { Rotation = -12 }, Enum.EasingStyle.Back)
		task.delay(0.3, function()
			Audio.Play("ui_click", { Pitch = 0.7 })
		end)
	end
	Kit.Punch(streakChip, 0.25)
end

----------------------------------------------------------------------------
-- Interface publique
----------------------------------------------------------------------------

function Daily.CanClaim(): boolean
	if State.Get("Daily") == nil then
		return false
	end
	local can = compute()
	return can
end

function Daily.Init()
	window = Kit.Window({ Name = "Daily", Title = "DAILY REWARDS", Icon = "📅", Color = "Gold", Size = UDim2.fromOffset(860, 540), RibbonWidth = 420 })
	local content = window.Frame

	-- en-tête
	streakChip = Kit.Chip({
		Text = "🔥 STREAK: 0 DAYS",
		Color = C.Magma,
		Size = UDim2.fromOffset(200, 34),
		Position = UDim2.fromOffset(0, -30),
		TextSize = 20,
		Parent = content,
	})
	streakChip.Rotation = -2
	statusLabel = Kit.Text({
		Size = UDim2.new(1, -270, 0, 30),
		Position = UDim2.new(1, -4, 0, 9),
		AnchorPoint = Vector2.new(1, 0),
		Text = "",
		FontFace = F.Body,
		TextColor3 = C.InkSoft,
		TextXAlignment = Enum.TextXAlignment.Right,
		Stroke = false,
		MaxTextSize = 22,
		Parent = content,
	})

	-- calendrier : jours 1..6 en grille 3x2, jour 7 en grand à droite
	local area = Kit.new("Frame", {
		Name = "Calendar",
		Size = UDim2.new(1, 0, 0, 320),
		Position = UDim2.fromOffset(0, 56),
		BackgroundTransparency = 1,
		Parent = content,
	})
	local cw, ch, gap = 160, 156, 10
	for day = 1, #Rewards.Daily - 1 do
		local col = (day - 1) % 3
		local row = (day - 1) // 3
		cards[day] = dayCard(area, day, false, {
			Size = UDim2.fromOffset(cw, ch),
			Position = UDim2.fromOffset(col * (cw + gap) + cw / 2, row * (ch + gap - 2) + ch / 2),
		})
	end
	local left = 3 * (cw + gap) + 8
	local big = dayCard(area, #Rewards.Daily, true, {
		Size = UDim2.new(1, -left, 0, 318),
		Position = UDim2.new(0.5, left / 2, 0, 159),
	})
	cards[#Rewards.Daily] = big
	eggView = Viewport.new({
		Egg = "Epic",
		Size = UDim2.fromOffset(190, 190),
		Position = UDim2.new(0.5, 0, 0.47, 0),
		AnchorPoint = Vector2.new(0.5, 0.5),
		ZIndex = 5,
		Speed = 1,
		Parent = big.Body,
	})
	eggRarity = "Epic"
	Kit.Wobble(eggView.Frame, 5, 1)
	eggLabel = big.Amount
	eggLabel.TextColor3 = C.Gold

	-- bas : bouton de réclamation ou compte à rebours
	local slot = Kit.new("Frame", {
		Name = "ClaimSlot",
		Size = UDim2.fromOffset(340, 70),
		Position = UDim2.new(0.5, 0, 1, -40),
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundTransparency = 1,
		ZIndex = 6,
		Parent = content,
	})
	claimSlot = slot
	claimBreather = Kit.new("Frame", {
		Size = UDim2.fromScale(1, 1),
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundTransparency = 1,
		ZIndex = 6,
		Parent = slot,
	})
	claimButton = Kit.Button({
		Name = "Claim",
		Text = "CLAIM!",
		Color = "Radioactive",
		Size = UDim2.new(1, 0, 1, -6),
		Position = UDim2.new(0.5, 0, 0.5, -3),
		AnchorPoint = Vector2.new(0.5, 0.5),
		MaxTextSize = 36,
		ZIndex = 6,
		Sound = "ui_click",
		OnClick = claim,
		Parent = claimBreather,
	})
	local cdBox, cdBody = Kit.Panel({
		Name = "Countdown",
		Size = UDim2.fromOffset(380, 64),
		Position = UDim2.new(0.5, 0, 1, -40),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Rotation = 1,
		Gradient = "Ink",
		Parent = content,
	})
	countdownBox = cdBox
	Kit.Text({
		Size = UDim2.new(0.55, 0, 0.6, 0),
		Position = UDim2.new(0, 16, 0.5, 0),
		AnchorPoint = Vector2.new(0, 0.5),
		Text = "NEXT REWARD IN",
		TextXAlignment = Enum.TextXAlignment.Left,
		Stroke = 2,
		MaxTextSize = 24,
		Parent = cdBody,
	})
	countdownLabel = Kit.Text({
		Size = UDim2.new(0.4, 0, 0.8, 0),
		Position = UDim2.new(1, -16, 0.5, 0),
		AnchorPoint = Vector2.new(1, 0.5),
		Text = "0:00:00",
		FontFace = F.Impact,
		TextColor3 = C.Gold,
		TextXAlignment = Enum.TextXAlignment.Right,
		Stroke = 2.5,
		MaxTextSize = 40,
		Parent = cdBody,
	})

	for _, key in { "Daily", "Income" } do
		State.Changed(key):Connect(function()
			if window.IsOpen then
				refresh()
			end
		end)
	end

	window.Opened:Connect(function()
		loopToken += 1
		local token = loopToken
		lastDay = -1
		task.spawn(function()
			while window.IsOpen and token == loopToken do
				tick()
				task.wait(1)
			end
		end)
	end)
	window.Closed:Connect(function()
		loopToken += 1
	end)
end

function Daily.Open(_args: any?)
	window:Open()
	refresh()
	-- cascade d'apparition des jours
	for i, c in cards do
		c.Status = ""
		c.Holder:SetAttribute("Breathing", false)
		local s = Kit.ScaleOf(c.Holder)
		s.Scale = 0
		task.delay(0.05 + i * 0.06, function()
			if not window.IsOpen then
				s.Scale = 1
				return
			end
			Kit.Pop(c.Holder, 0.2, 0.5)
			if i == #cards then
				task.delay(0.5, refresh)
			end
		end)
	end
	Kit.Pop(claimSlot, 0.3, 0.6)
end

function Daily.Close()
	window:Close()
end

return Daily
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="71">
              <Properties>
                <string name="Name">Fusion</string>
                <string name="Source"><![CDATA[--!nonstrict
-- FUSION LAB : deux kaijus ADULTES -> un nouveau kaiju (ou un SECRET avec la
-- bonne recette). Les probabilités (FuseOdds) sont TOUJOURS affichées avant de
-- fusionner. Cinématique complète dans la fenêtre après la fusion.
--   Fusion.Open({ A = uid? })  -- présélectionne l'emplacement A

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Kaijus = require(Shared.Config.Kaijus)
local Rarities = require(Shared.Config.Rarities)
local Mutations = require(Shared.Config.Mutations)
local Growth = require(Shared.Config.Growth)
local Calc = require(Shared.Logic.Calc)
local Format = require(Shared.Logic.Format)

local Kit = require(script.Parent.Parent.Kit)
local Viewport = require(script.Parent.Parent.Viewport)
local Controllers = script.Parent.Parent.Parent.Controllers
local State = require(Controllers.State)
local Remote = require(Controllers.Remote)
local Audio = require(Controllers.Audio)
local UIRegistry = require(Controllers.UIRegistry)

local C = Kit.Colors
local F = Kit.Fonts
local LocalPlayer = Players.LocalPlayer

local Fusion = {}

local MIN_STAGE = 3 -- Adulte
local MAX_ODDS = 3

local RAINBOW = ColorSequence.new({
	ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 70, 90)),
	ColorSequenceKeypoint.new(0.2, Color3.fromRGB(255, 200, 40)),
	ColorSequenceKeypoint.new(0.4, Color3.fromRGB(124, 255, 79)),
	ColorSequenceKeypoint.new(0.6, Color3.fromRGB(61, 224, 255)),
	ColorSequenceKeypoint.new(0.8, Color3.fromRGB(170, 90, 255)),
	ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 61, 139)),
})

----------------------------------------------------------------------------
-- Aides
----------------------------------------------------------------------------

local function rainbow(parent: Instance, period: number?): UIGradient
	local g = parent:FindFirstChild("Rainbow") :: UIGradient?
	if not g then
		g = Kit.new("UIGradient", { Name = "Rainbow", Color = RAINBOW, Parent = parent })
		Kit.Tween(g :: UIGradient, period or 2.5, { Rotation = 360 }, Enum.EasingStyle.Linear, Enum.EasingDirection.InOut, -1)
	end
	return g :: UIGradient
end

local function clearRainbow(parent: Instance)
	local g = parent:FindFirstChild("Rainbow")
	if g then
		g:Destroy()
	end
end

local function inkText(props: { [string]: any }): TextLabel
	props.Stroke = false
	props.FontFace = props.FontFace or F.Body
	props.TextColor3 = props.TextColor3 or C.Ink
	return Kit.Text(props)
end

local function anchorOf(uid: string): any
	local root = Workspace:FindFirstChild("Kaijus")
	local folder = root and root:FindFirstChild(tostring(LocalPlayer.UserId))
	return folder and folder:FindFirstChild(uid)
end

local function stageOf(rec: any): number
	local stage = Calc.Stage(rec)
	local anchor = anchorOf(rec.Uid)
	if anchor then
		stage = math.max(stage, anchor:GetAttribute("Stage") or 1)
	end
	return stage
end

local function isCarried(uid: string): boolean
	local anchor = anchorOf(uid)
	return anchor ~= nil and (anchor:GetAttribute("CarriedBy") or 0) ~= 0
end

local function eligible(rec: any): boolean
	return not rec.Egg and rec.Species ~= nil and stageOf(rec) >= MIN_STAGE and not isCarried(rec.Uid)
end

local function findRecord(uid: string?): any
	if not uid then
		return nil
	end
	for _, rec in State.Get("Kaijus") or {} do
		if rec.Uid == uid then
			return rec
		end
	end
	return nil
end

local function speciesName(id: string?): string
	local s = if id then Kaijus.Get(id) else nil
	return if s then s.Name else "???"
end

local function rarityColor(id: string): Color3
	return if id == "Secret" then C.Ink else Rarities.Get(id).Color
end

local function discovered(id: string): boolean
	local index = State.Get("Index") or {}
	return index[id] ~= nil
end

-- Libellés serveur : noms de rareté localisés -> identifiants anglais.
local function englishLabel(label: string): (string, Color3?)
	local color = nil
	for _, r in Rarities.List do
		if r.Id ~= "Secret" and r.Name ~= r.Id and string.find(label, r.Name, 1, true) then
			label = string.gsub(label, r.Name, r.Id)
		end
		if r.Id ~= "Secret" and string.find(label, r.Id, 1, true) then
			color = r.Color
		end
	end
	if string.find(label, "SECRET", 1, true) then
		color = C.Pink
	end
	return label, color
end

local function setBreathing(button: GuiObject, on: boolean)
	if button:GetAttribute("Breathing") == on then
		return
	end
	button:SetAttribute("Breathing", on)
	if on then
		Kit.Breathe(button, 0.06, 0.7)
	else
		Kit.Tween(Kit.ScaleOf(button), 0.2, { Scale = 1 })
	end
	if not button:GetAttribute("BreatheHooked") then
		button:SetAttribute("BreatheHooked", true)
		button.MouseLeave:Connect(function()
			task.delay(0.25, function()
				if button:GetAttribute("Breathing") then
					Kit.Breathe(button, 0.06, 0.7)
				end
			end)
		end)
	end
end

-- Secousse sans dérive : la position d'origine est mémorisée une fois et une
-- nouvelle secousse remplace la précédente.
local shakeBase: { [Instance]: UDim2 } = {}
local shakeToken: { [Instance]: number } = {}
local function safeShake(inst: GuiObject, intensity: number, duration: number)
	local base = shakeBase[inst]
	if not base then
		base = inst.Position
		shakeBase[inst] = base
	end
	local token = (shakeToken[inst] or 0) + 1
	shakeToken[inst] = token
	local t0 = os.clock()
	local conn
	conn = RunService.RenderStepped:Connect(function()
		local t = os.clock() - t0
		local mine = shakeToken[inst] == token
		if t > duration or not mine or not inst.Parent then
			conn:Disconnect()
			if mine then
				inst.Position = base
			end
			return
		end
		local k = (1 - t / duration) * intensity
		inst.Position = base + UDim2.fromOffset((math.random() - 0.5) * 2 * k, (math.random() - 0.5) * 2 * k)
	end)
end

-- Apparition élastique différée (relance la respiration si besoin).
local function popIn(item: GuiObject, delay: number, from: number?)
	Kit.ScaleOf(item).Scale = 0.01
	task.delay(delay, function()
		Kit.Pop(item, from or 0.3, 0.45)
		if item:GetAttribute("Breathing") then
			task.delay(0.46, function()
				if item:GetAttribute("Breathing") then
					Kit.Breathe(item, 0.06, 0.7)
				end
			end)
		end
	end)
end

local function confetti(parent: GuiObject, count: number, colors: { Color3 }, z: number)
	for i = 1, count do
		local angle = (i / count) * math.pi * 2 + math.random() * 0.4
		local dist = 160 + math.random() * 280
		local piece = Kit.new("Frame", {
			Size = UDim2.fromOffset(math.random(10, 20), math.random(6, 12)),
			Position = UDim2.fromScale(0.5, 0.42),
			AnchorPoint = Vector2.new(0.5, 0.5),
			BackgroundColor3 = colors[(i % #colors) + 1],
			Rotation = math.random(0, 360),
			ZIndex = z,
			Parent = parent,
		}, { Kit.Corner(3), Kit.Stroke(2) })
		local target = UDim2.new(0.5, math.cos(angle) * dist, 0.42, math.sin(angle) * dist * 0.7)
		Kit.Tween(piece, 0.9 + math.random() * 0.5, { Position = target, Rotation = piece.Rotation + math.random(-400, 400) }, Enum.EasingStyle.Quint)
		task.delay(0.9, function()
			Kit.Tween(piece, 0.5, { BackgroundTransparency = 1, Position = target + UDim2.fromOffset(0, 60) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
			local stroke = piece:FindFirstChildOfClass("UIStroke")
			if stroke then
				Kit.Tween(stroke, 0.5, { Transparency = 1 })
			end
		end)
		task.delay(1.6, function()
			piece:Destroy()
		end)
	end
end

----------------------------------------------------------------------------
-- État
----------------------------------------------------------------------------

local win: any = nil
local ui: { [string]: any } = {}
local rows: { [string]: any } = {} -- [uid] = ligne de la liste
local slots = { A = nil :: string?, B = nil :: string? }
local pods: { [string]: any } = {}
local oddsToken = 0
local oddsReady = false
local busy = false
local cinematic = false
local bookOpen = false
local recipeRows: { any } = {}
local pollConn: RBXScriptConnection? = nil
local accum = 0

local refreshAll -- déclarée plus bas

----------------------------------------------------------------------------
-- Emplacements (pods)
----------------------------------------------------------------------------

local function buildPod(root: Instance, key: string, x: number, rotation: number, gradient: string): any
	local holder, body = Kit.Panel({
		Name = "Pod" .. key,
		Size = UDim2.fromOffset(150, 184),
		Position = UDim2.fromOffset(x, 6),
		Rotation = rotation,
		Gradient = gradient,
		Corner = 18,
		Parent = root,
	})
	local halo = Kit.new("Frame", {
		Name = "Halo",
		Size = UDim2.fromOffset(120, 120),
		Position = UDim2.fromScale(0.5, 0.4),
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = if key == "R" then C.Pink else C.Purple,
		BackgroundTransparency = 0.6,
		ZIndex = 3,
		Parent = body,
	}, { Kit.Round() })
	local vpHolder = Kit.new("Frame", {
		Name = "VpHolder",
		Size = UDim2.new(1, -12, 0, 130),
		Position = UDim2.fromOffset(6, 6),
		BackgroundTransparency = 1,
		ZIndex = 4,
		Parent = body,
	})
	local empty = Kit.Text({
		Name = "Empty",
		Size = UDim2.fromOffset(90, 90),
		Position = UDim2.fromScale(0.5, 0.4),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Text = if key == "R" then "?" else "+",
		FontFace = F.Impact,
		TextColor3 = if key == "R" then C.Gold else C.White,
		MaxTextSize = 90,
		Stroke = 4,
		ZIndex = 5,
		Parent = body,
	})
	Kit.Breathe(empty, 0.12, 0.8)
	local name = Kit.Text({
		Name = "PodName",
		Size = UDim2.new(1, -14, 0, 22),
		Position = UDim2.new(0.5, 0, 1, -40),
		AnchorPoint = Vector2.new(0.5, 0),
		Text = if key == "R" then "RESULT" else "PICK A KAIJU",
		MaxTextSize = 20,
		Stroke = 2.5,
		ZIndex = 6,
		Parent = body,
	})
	local sub = Kit.Text({
		Name = "PodSub",
		Size = UDim2.new(1, -14, 0, 14),
		Position = UDim2.new(0.5, 0, 1, -18),
		AnchorPoint = Vector2.new(0.5, 0),
		Text = "",
		FontFace = F.Body,
		TextColor3 = C.Paper,
		MaxTextSize = 14,
		Stroke = 1.5,
		ZIndex = 6,
		Parent = body,
	})
	if key ~= "R" then
		local badge = Kit.new("Frame", {
			Name = "Badge",
			Size = UDim2.fromOffset(40, 40),
			Position = UDim2.fromOffset(-10, -10),
			BackgroundColor3 = if key == "A" then C.Pink else C.Cyan,
			Rotation = -10,
			ZIndex = 12,
			Parent = holder,
		}, { Kit.Round(), Kit.Stroke(3) })
		Kit.Text({
			Size = UDim2.fromScale(0.7, 0.7),
			Position = UDim2.fromScale(0.5, 0.5),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Text = key,
			Stroke = 2.5,
			ZIndex = 13,
			Parent = badge,
		})
	end
	local click = Kit.new("TextButton", {
		Name = "Click",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Text = "",
		ZIndex = 11,
		Parent = holder,
	})
	local pod = {
		Key = key,
		Holder = holder,
		Body = body,
		Halo = halo,
		VpHolder = vpHolder,
		Vp = nil :: any,
		ModelKey = "",
		Empty = empty,
		Name = name,
		Sub = sub,
		Click = click,
	}
	click.MouseEnter:Connect(function()
		if pod.Vp and pod.Vp.Frame.Visible then
			pod.Vp.Speed = 2
		end
		Kit.Tween(Kit.ScaleOf(holder), 0.2, { Scale = 1.04 }, Enum.EasingStyle.Back)
	end)
	click.MouseLeave:Connect(function()
		if pod.Vp then
			pod.Vp.Speed = 0.7
		end
		Kit.Tween(Kit.ScaleOf(holder), 0.2, { Scale = 1 })
	end)
	return pod
end

local function podViewport(pod: any): any
	if not pod.Vp then
		pod.Vp = Viewport.new({ Parent = pod.VpHolder, ZIndex = 5, Speed = 0.7 })
	end
	return pod.Vp
end

local function renderPod(key: string, animate: boolean)
	local pod = pods[key]
	local rec = findRecord(slots[key])
	if rec and rec.Species then
		local vp = podViewport(pod)
		vp.Frame.Visible = true
		local modelKey = rec.Species .. ":" .. (rec.Mutation or "")
		if pod.ModelKey ~= modelKey then
			pod.ModelKey = modelKey
			vp:SetSilhouette(false)
			vp:Set(rec.Species, rec.Mutation)
		end
		vp.Spin = true
		pod.Empty.Visible = false
		pod.Name.Text = speciesName(rec.Species)
		pod.Name.TextColor3 = if rec.Rarity == "Secret" then C.White else Rarities.Get(rec.Rarity).Color:Lerp(C.White, 0.3)
		local m = Mutations.Get(rec.Mutation)
		pod.Sub.Text = string.upper(Growth.Get(stageOf(rec)).Name) .. (if m then " · " .. string.upper(m.Name) else "")
		pod.Halo.BackgroundColor3 = if rec.Rarity == "Secret" then C.Gold else Rarities.Get(rec.Rarity).Glow
		if animate then
			Kit.Pop(pod.Holder, 1.25, 0.45)
			Kit.Pop(vp.Frame, 0.2, 0.5)
		end
	else
		if pod.Vp then
			pod.Vp.Frame.Visible = false
			pod.Vp.Spin = false
		end
		pod.Empty.Visible = true
		pod.Name.Text = "PICK A KAIJU"
		pod.Name.TextColor3 = C.White
		pod.Sub.Text = "from the list"
		pod.Halo.BackgroundColor3 = C.Purple
		if animate then
			Kit.Punch(pod.Holder, -0.1)
		end
	end
end

-- Pod résultat : « ? », ou silhouette du Secret si la recette correspond.
local function renderResult()
	local pod = pods.R
	local a, b = findRecord(slots.A), findRecord(slots.B)
	local recipe = if a and b then Kaijus.FindRecipe(a.Species or "", b.Species or "") else nil
	clearRainbow(pod.Empty)
	clearRainbow(pod.Name)
	if recipe then
		local vp = podViewport(pod)
		vp.Frame.Visible = true
		if pod.ModelKey ~= recipe.Id then
			pod.ModelKey = recipe.Id
			vp:Set(recipe.Id)
		end
		vp:SetSilhouette(not discovered(recipe.Id))
		vp.Spin = true
		pod.Empty.Visible = false
		pod.Name.Text = "SECRET!"
		pod.Name.TextColor3 = C.White
		rainbow(pod.Name, 1.8)
		pod.Sub.Text = if discovered(recipe.Id) then recipe.Name else "Recipe match!"
		pod.Halo.BackgroundColor3 = C.Gold
		Kit.Pop(pod.Holder, 1.3, 0.5)
		Audio.Play("stage_up", { Volume = 0.6 })
	else
		if pod.Vp then
			pod.Vp.Frame.Visible = false
			pod.Vp.Spin = false
		end
		pod.Empty.Visible = true
		pod.Empty.TextColor3 = C.Gold
		pod.Name.Text = "RESULT"
		pod.Name.TextColor3 = C.White
		pod.Halo.BackgroundColor3 = C.Pink
		if a and b and a.Species == b.Species then
			pod.Sub.Text = "Same kaiju + mutation"
		elseif a and b then
			pod.Sub.Text = "Mystery kaiju"
		else
			pod.Sub.Text = "Pick two kaijus"
		end
		if a and b then
			pod.Empty.TextColor3 = C.White
			rainbow(pod.Empty, 1.5)
			Kit.Pop(pod.Holder, 1.15, 0.4)
		end
	end
end

----------------------------------------------------------------------------
-- Probabilités
----------------------------------------------------------------------------

local function setFuseEnabled(on: boolean)
	Kit.SetDisabled(ui.Fuse, not on)
	setBreathing(ui.Fuse, on)
end

local function showOdds(list: { any }?, message: string?)
	for i, row in ui.OddsRows do
		local item = if list then list[i] else nil
		row.Frame.Visible = item ~= nil
		if item then
			local label, color = englishLabel(tostring(item.Label or "?"))
			local chance = tonumber(item.Chance) or 0
			row.Label.Text = label
			row.Pct.Text = Format.Percent(chance)
			row.Fill.BackgroundColor3 = color or C.Purple
			row.Fill.Size = UDim2.fromScale(0, 1)
			Kit.Tween(row.Fill, 0.5, { Size = UDim2.fromScale(math.clamp(chance, 0, 1), 1) }, Enum.EasingStyle.Quart)
			if string.find(label, "SECRET", 1, true) then
				rainbow(row.Fill, 2)
			else
				clearRainbow(row.Fill)
			end
			Kit.ScaleOf(row.Frame).Scale = 0.01
			task.delay(0.06 * i, function()
				Kit.Pop(row.Frame, 0.3, 0.4)
			end)
		end
	end
	ui.OddsMsg.Visible = message ~= nil
	ui.OddsMsg.Text = message or ""
end

local function requestOdds(attempt: number?)
	oddsToken += 1
	oddsReady = false
	setFuseEnabled(false)
	local a, b = slots.A, slots.B
	if not a or not b then
		showOdds(nil, "Pick <b>two ADULT kaijus</b> to see the fusion odds.")
		return
	end
	local token = oddsToken
	showOdds(nil, "Calculating odds...")
	task.spawn(function()
		local res = Remote.Call("FuseOdds", { A = a, B = b }, true)
		if token ~= oddsToken then
			return
		end
		if res.ok and type(res.odds) == "table" and #res.odds > 0 then
			showOdds(res.odds, nil)
			oddsReady = true
			Kit.Punch(ui.OddsHolder, 0.06)
			setFuseEnabled(true)
			popIn(ui.Fuse, 0, 1.25)
		else
			showOdds(nil, "Couldn't load the odds. Retrying...")
			-- nouvel essai limité (limite de débit du serveur)
			local n = (attempt or 0) + 1
			if n <= 3 then
				task.delay(1.2, function()
					if token == oddsToken and win.IsOpen then
						requestOdds(n)
					end
				end)
			else
				showOdds(nil, "Couldn't load the odds. Pick the kaijus again!")
			end
		end
	end)
end

----------------------------------------------------------------------------
-- Liste des kaijus éligibles
----------------------------------------------------------------------------

local function updateRowTags()
	for uid, row in rows do
		local tag = if slots.A == uid then "A" elseif slots.B == uid then "B" else nil
		row.Tag.Visible = tag ~= nil
		if tag then
			row.Tag.BackgroundColor3 = if tag == "A" then C.Pink else C.Cyan
			row.Tag.Text.Text = tag
		end
		row.Body.BackgroundColor3 = if tag then C.Gold else C.White
	end
end

local function slotsChanged(animateKey: string?)
	if animateKey then
		renderPod(animateKey, true)
	end
	updateRowTags()
	renderResult()
	requestOdds()
end

local function setSlot(key: string, uid: string?)
	slots[key] = uid
	slotsChanged(key)
end

local function pick(uid: string)
	if cinematic or busy then
		return
	end
	if slots.A == uid then
		setSlot("A", nil)
	elseif slots.B == uid then
		setSlot("B", nil)
	elseif not slots.A then
		setSlot("A", uid)
	else
		setSlot("B", uid)
	end
end

local function buildRow(rec: any): any
	local button = Kit.new("TextButton", {
		Name = rec.Uid,
		Size = UDim2.new(1, -8, 0, 66),
		BackgroundTransparency = 1,
		Text = "",
		AutoButtonColor = false,
		ZIndex = 6,
		Parent = ui.List,
	})
	Kit.new("Frame", {
		Name = "Shadow",
		Size = UDim2.fromScale(1, 1),
		Position = UDim2.fromOffset(4, 4),
		BackgroundColor3 = C.Ink,
		ZIndex = 6,
		Parent = button,
	}, { Kit.Corner(12) })
	local body = Kit.new("Frame", {
		Name = "Body",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = C.White,
		ZIndex = 7,
		Parent = button,
	}, { Kit.Corner(12), Kit.Stroke(3) })
	Kit.Gradient("Paper").Parent = body
	local thumb = Kit.new("Frame", {
		Name = "Thumb",
		Size = UDim2.fromOffset(54, 54),
		Position = UDim2.new(0, 6, 0.5, 0),
		AnchorPoint = Vector2.new(0, 0.5),
		BackgroundColor3 = C.White,
		ZIndex = 8,
		Parent = body,
	}, { Kit.Corner(10), Kit.Stroke(2) })
	local thumbGrad = Kit.Gradient({ C.White, C.White }, 90)
	thumbGrad.Parent = thumb
	local name = inkText({
		Name = "RName",
		Size = UDim2.new(1, -120, 0, 22),
		Position = UDim2.fromOffset(68, 8),
		Text = "",
		FontFace = F.Title,
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxTextSize = 20,
		ZIndex = 8,
		Parent = body,
	})
	local sub = inkText({
		Name = "RSub",
		Size = UDim2.new(1, -120, 0, 16),
		Position = UDim2.fromOffset(68, 32),
		Text = "",
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxTextSize = 15,
		ZIndex = 8,
		Parent = body,
	})
	local chip = Kit.Chip({
		Name = "Rarity",
		Text = "",
		Size = UDim2.fromOffset(84, 16),
		Position = UDim2.fromOffset(68, 48),
		ZIndex = 8,
		Parent = body,
	})
	local tag = Kit.Chip({
		Name = "Tag",
		Text = "A",
		Size = UDim2.fromOffset(40, 40),
		Position = UDim2.new(1, -10, 0.5, 0),
		AnchorPoint = Vector2.new(1, 0.5),
		ZIndex = 9,
		Parent = body,
	})
	tag.Visible = false
	local row = {
		Uid = rec.Uid,
		Button = button,
		Body = body,
		ThumbGradient = thumbGrad,
		Vp = Viewport.new({ Species = rec.Species, Mutation = rec.Mutation, Parent = thumb, ZIndex = 9, Spin = false }),
		Key = (rec.Species or "") .. ":" .. (rec.Mutation or ""),
		Name = name,
		Sub = sub,
		Chip = chip,
		Tag = tag,
	}
	button.MouseEnter:Connect(function()
		Audio.Play("ui_hover", { Cooldown = 0.06 })
		row.Vp.Spin = true
		row.Vp.Speed = 1.6
		Kit.Tween(Kit.ScaleOf(button), 0.2, { Scale = 1.03 }, Enum.EasingStyle.Back)
		Kit.Tween(button, 0.2, { Rotation = -1.2 }, Enum.EasingStyle.Back)
	end)
	button.MouseLeave:Connect(function()
		row.Vp.Spin = false
		Kit.Tween(Kit.ScaleOf(button), 0.2, { Scale = 1 })
		Kit.Tween(button, 0.2, { Rotation = 0 })
	end)
	button.Activated:Connect(function()
		Audio.Play("ui_click")
		Kit.Punch(button, 0.1)
		pick(row.Uid)
	end)
	return row
end

local function updateRow(row: any, rec: any)
	local key = (rec.Species or "") .. ":" .. (rec.Mutation or "")
	if key ~= row.Key then
		row.Key = key
		row.Vp:Set(rec.Species, rec.Mutation)
	end
	local rarity = Rarities.Get(rec.Rarity)
	local secret = rec.Rarity == "Secret"
	row.Name.Text = speciesName(rec.Species)
	local m = Mutations.Get(rec.Mutation)
	local stage = string.upper(Growth.Get(stageOf(rec)).Name)
	row.Sub.Text = if m
		then ("%s · <font color=\"#%s\"><b>%s x%s</b></font>"):format(stage, m.Color:ToHex(), string.upper(m.Name), tostring(m.Mult))
		else stage
	row.Chip.BackgroundColor3 = rarityColor(rec.Rarity)
	row.Chip.Text.Text = string.upper(rec.Rarity)
	if secret then
		rainbow(row.Chip, 2)
	end
	row.ThumbGradient.Color = if secret
		then ColorSequence.new(C.InkSoft, C.Ink)
		else ColorSequence.new(rarity.Glow, rarity.Color:Lerp(C.Ink, 0.15))
end

-- Synchronise la liste (création / suppression incrémentale des lignes).
local function syncList(animate: boolean)
	local list = {}
	for _, rec in State.Get("Kaijus") or {} do
		if eligible(rec) then
			table.insert(list, rec)
		end
	end
	table.sort(list, function(a, b)
		local ra, rb = Rarities.Get(a.Rarity).Order, Rarities.Get(b.Rarity).Order
		if ra ~= rb then
			return ra > rb
		end
		return Calc.BaseIncome(a) > Calc.BaseIncome(b)
	end)
	local keep = {}
	for i, rec in list do
		keep[rec.Uid] = true
		local row = rows[rec.Uid]
		if not row then
			row = buildRow(rec)
			rows[rec.Uid] = row
			if animate then
				Kit.ScaleOf(row.Button).Scale = 0.01
				task.delay(0.03 * math.min(i, 15), function()
					Kit.Pop(row.Button, 0.3, 0.4)
				end)
			end
		end
		row.Button.LayoutOrder = i
		updateRow(row, rec)
	end
	for uid, row in rows do
		if not keep[uid] then
			row.Vp:Destroy()
			row.Button:Destroy()
			rows[uid] = nil
		end
	end
	ui.ListCount.Text.Text = tostring(#list)
	ui.ListEmpty.Visible = #list == 0

	-- emplacements devenus invalides (vendu, volé, fusionné...)
	local changed = false
	for _, key in { "A", "B" } do
		local uid = slots[key]
		if uid and not keep[uid] then
			slots[key] = nil
			renderPod(key, true)
			changed = true
		end
	end
	if changed then
		slotsChanged(nil)
	else
		updateRowTags()
	end
end

----------------------------------------------------------------------------
-- Livre des recettes
----------------------------------------------------------------------------

local function refreshBook()
	for _, r in recipeRows do
		local s = r.Species
		local found = discovered(s.Id)
		r.Vp:SetSilhouette(not found)
		r.Name.Text = if found then s.Name else "???"
		local recipe = s.Recipe or {}
		if found then
			r.Recipe.Text = ("<b>%s</b>  +  <b>%s</b>"):format(speciesName(recipe[1]), speciesName(recipe[2]))
			r.Hint.Text = "✓ Discovered! Fuse these two ADULTS again anytime."
		else
			r.Recipe.Text = "<b>???  +  ???</b>"
			r.Hint.Text = ('Hint: "%s"'):format(s.Hint or "...")
		end
		r.Lock.Text = if found then "✓" else "🔒"
		r.Lock.TextColor3 = if found then C.Radioactive else C.Gold
	end
end

local function setBook(open: boolean)
	if bookOpen == open then
		return
	end
	bookOpen = open
	Kit.SetButtonText(ui.BookButton, if open then "BACK TO LAB" else "RECIPES")
	Kit.SetButtonColor(ui.BookButton, if open then "Magma" else "Ink")
	local book = ui.Book
	if open then
		refreshBook()
		book.Visible = true
		book.Position = UDim2.new(0, 306, 0, -30)
		Kit.Tween(book, 0.45, { Position = UDim2.fromOffset(306, 0) }, Enum.EasingStyle.Back)
		Kit.Pop(book, 0.7, 0.45)
		for i, r in recipeRows do
			Kit.ScaleOf(r.Frame).Scale = 0.01
			task.delay(0.05 * i, function()
				Kit.Pop(r.Frame, 0.3, 0.4)
			end)
			r.Vp.Spin = true
		end
	else
		Kit.Tween(Kit.ScaleOf(book), 0.18, { Scale = 0.6 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		task.delay(0.18, function()
			if not bookOpen then
				book.Visible = false
			end
		end)
		for _, r in recipeRows do
			r.Vp.Spin = false
		end
	end
end

