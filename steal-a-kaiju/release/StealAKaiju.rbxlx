----------------------------------------------------------------------------
-- Rendu
----------------------------------------------------------------------------

local function disarm()
	armed = false
	armToken += 1
	Kit.SetButtonColor(ui.Evolve, "Radioactive")
	Kit.SetButtonText(ui.Evolve, "EVOLVE!")
end

local function refresh()
	local level = State.Get("Rebirths") or 0
	local cash = State.Get("Cash") or 0
	local nr = Calc.NextRebirth(level)

	ui.Level.Text = tostring(level)
	ui.CurMult.Text.Text = "CASH " .. multText(Calc.RebirthMult(level))
	ui.CurLuck.Text.Text = "LUCK " .. multText(Calc.RebirthLuck(level))

	local isMax = nr == nil
	ui.MaxHolder.Visible = isMax
	ui.ReqHolder.Visible = not isMax
	ui.RewHolder.Visible = not isMax
	ui.WarnHolder.Visible = not isMax
	ui.EvolveWrap.Visible = not isMax
	ui.EvolveHint.Visible = not isMax
	if not nr then
		ui.Next.Text = "MAXED OUT!"
		setBreathing(ui.Evolve, false)
		return
	end
	ui.Next.Text = "NEXT ▶ LEVEL " .. tostring(level + 1)

	-- cash
	local cashOk = cash >= nr.Cost
	ui.CashText.Text = ("<b>%s</b> / %s"):format(Format.Cash(cash), Format.Cash(nr.Cost))
	ui.CashText.TextColor3 = if cashOk then C.RadioactiveDark else C.Ink
	ui.SetCash(cash / nr.Cost)
	setStatus(ui.CashStatus, cashOk, lastReady.Cash)
	lastReady.Cash = cashOk

	-- kaiju à sacrifier
	local needName = string.upper(nr.NeedRarity)
	ui.KTitle.Text = ("🦖 ADULT %s+ KAIJU"):format(needName)
	local sac = findSacrifice(nr.NeedRarity)
	local kaijuOk = sac ~= nil
	if sac then
		local species = Kaijus.Get(sac.Species)
		local stageName = string.upper(Growth.Get(stageOf(sac)).Name)
		ui.SacText.Text = ("<b>%s</b> (%s)\nwill be <font color=\"#d2202a\"><b>SACRIFICED</b></font> to evolve."):format(
			if species then species.Name else "Kaiju",
			stageName
		)
		if sacUid ~= sac.Uid then
			sacUid = sac.Uid
			if not sacVp then
				sacVp = Viewport.new({ Parent = ui.SacFrame, ZIndex = 8, Speed = 0.9 })
			end
			sacVp.Frame.Visible = true
			sacVp:Set(sac.Species, sac.Mutation)
			Kit.Pop(sacVp.Frame, 0.3, 0.45)
		end
		sacVp.Spin = win.IsOpen
		ui.SacEmpty.Visible = false
	else
		sacUid = nil
		if sacVp then
			sacVp.Frame.Visible = false
			sacVp.Spin = false
		end
		ui.SacEmpty.Visible = true
		ui.SacText.Text = ("Grow a <b>%s</b> (or better) kaiju to <b>ADULT</b> stage. It will be sacrificed."):format(needName)
	end
	setStatus(ui.KStatus, kaijuOk, lastReady.Kaiju)
	lastReady.Kaiju = kaijuOk

	-- récompenses
	ui.RMult.Value.Text = ("%s ▶ <font color=\"#28aa3c\">%s</font>"):format(multText(Calc.RebirthMult(level)), multText(nr.Mult))
	ui.RLuck.Value.Text = ("%s ▶ <font color=\"#28aa3c\">%s</font>"):format(multText(Calc.RebirthLuck(level)), multText(nr.Luck))
	ui.RGems.Value.Text = "+" .. Format.Comma(nr.Gems) .. " 💎"
	ui.RGems.Value.TextColor3 = C.Gem
	local eggR = Rarities.Get(nr.EggRarity)
	ui.REgg.Value.Text = string.upper(nr.EggRarity) .. " EGG"
	ui.REgg.Value.TextColor3 = eggR.Color
	if eggRarity ~= nr.EggRarity then
		eggRarity = nr.EggRarity
		if not eggVp then
			eggVp = Viewport.new({ Parent = ui.EggHolder, ZIndex = 9, Speed = 1.2 })
		end
		eggVp:SetEgg(nr.EggRarity)
	end
	if eggVp then
		eggVp.Spin = win.IsOpen
	end

	-- bouton
	local ready = cashOk and kaijuOk
	if not armed then
		Kit.SetDisabled(ui.Evolve, not ready)
	end
	setBreathing(ui.Evolve, ready)
	if ready then
		ui.EvolveHint.Text = "<b>READY!</b> Evolve for a permanent boost."
		ui.EvolveHint.TextColor3 = C.RadioactiveDark
	elseif not cashOk then
		ui.EvolveHint.Text = ("Need <b>%s</b> more cash"):format(Format.Cash(nr.Cost - cash))
		ui.EvolveHint.TextColor3 = C.MagmaDark
	else
		ui.EvolveHint.Text = ("Need an ADULT <b>%s+</b> kaiju"):format(needName)
		ui.EvolveHint.TextColor3 = C.MagmaDark
	end
	if lastReady.All == false and ready then
		Kit.Pop(ui.Evolve, 1.35, 0.5)
		Audio.Play("stage_up", { Volume = 0.7 })
	end
	lastReady.All = ready
end

----------------------------------------------------------------------------
-- Célébration
----------------------------------------------------------------------------

local function celebrate(level: number, reward: any)
	celebrating = true
	local party = ui.Party
	party:ClearAllChildren()
	Kit.Corner(16).Parent = party
	party.Visible = true
	party.BackgroundTransparency = 1
	Kit.Tween(party, 0.25, { BackgroundTransparency = 0.12 })

	local burstA = Kit.Starburst({ Size = UDim2.fromOffset(1100, 1100), Position = UDim2.fromScale(0.5, 0.45), Color = C.Gold, Transparency = 0.45, Rays = 16, Period = 8, ZIndex = 51, Parent = party })
	local burstB = Kit.Starburst({ Size = UDim2.fromOffset(800, 800), Position = UDim2.fromScale(0.5, 0.45), Color = C.Radioactive, Transparency = 0.55, Rays = 10, Period = 6, ZIndex = 51, Parent = party })
	burstB.Rotation = 10
	Kit.Tween(burstB, 6, { Rotation = -350 }, Enum.EasingStyle.Linear)
	Kit.Pop(burstA, 0.1, 0.7)
	Kit.Pop(burstB, 0.1, 0.6)

	-- rubans de danger qui traversent
	local top = Kit.Hazard({ Size = UDim2.new(1.3, 0, 0, 22), Position = UDim2.new(-0.15, 0, 0, 30), ZIndex = 52, Parent = party })
	top.Rotation = -4
	local bottom = Kit.Hazard({ Size = UDim2.new(1.3, 0, 0, 22), Position = UDim2.new(-0.15, 0, 1, -60), ZIndex = 52, Parent = party })
	bottom.Rotation = 3

	local title = Kit.Text({
		Size = UDim2.fromOffset(620, 90),
		Position = UDim2.fromScale(0.5, 0.2),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Text = "EVOLVED!",
		FontFace = F.Impact,
		MaxTextSize = 90,
		Stroke = 6,
		Rotation = -5,
		ZIndex = 56,
		Parent = party,
	})
	Kit.new("UIGradient", { Color = ColorSequence.new(C.Radioactive, C.Gold), Rotation = 90, Parent = title })
	Kit.Pop(title, 3.2, 0.5)

	local disc = Kit.new("Frame", {
		Size = UDim2.fromOffset(190, 190),
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = C.White,
		ZIndex = 54,
		Parent = party,
	}, { Kit.Round(), Kit.Stroke(6), Kit.Gradient("Radioactive") })
	local num = Kit.Text({
		Size = UDim2.fromScale(0.8, 0.72),
		Position = UDim2.fromScale(0.5, 0.52),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Text = tostring(math.max(level - 1, 0)),
		FontFace = F.Impact,
		MaxTextSize = 150,
		Stroke = 6,
		ZIndex = 55,
		Parent = disc,
	})
	Kit.Pop(disc, 0.2, 0.5)
	Audio.Play("rebirth")
	safeShake(win.Holder, 10, 0.4)

	-- le nouveau niveau s'écrase sur l'ancien
	task.delay(0.65, function()
		num.Text = tostring(level)
		Kit.Punch(disc, 0.7)
		safeShake(win.Holder, 16, 0.5)
		Audio.Play("fusion_boom", { Volume = 0.7 })
		confetti(party, 26, { C.Radioactive, C.Gold, C.Pink, C.Cyan, C.Magma })
		local flash = Kit.new("Frame", {
			Size = UDim2.fromScale(1, 1),
			BackgroundColor3 = C.White,
			BackgroundTransparency = 0.1,
			ZIndex = 57,
			Parent = party,
		}, { Kit.Corner(16) })
		Kit.Tween(flash, 0.45, { BackgroundTransparency = 1 })
		task.delay(0.5, function()
			flash:Destroy()
		end)
	end)

	-- récompenses en cascade
	local chips = Kit.new("Frame", {
		Size = UDim2.new(1, -40, 0, 40),
		Position = UDim2.fromScale(0.5, 0.8),
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundTransparency = 1,
		ZIndex = 56,
		Parent = party,
	}, { Kit.List(Enum.FillDirection.Horizontal, 12, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Center) })
	local items = {}
	if reward then
		items = {
			{ "CASH " .. multText(reward.Mult), C.RadioactiveDark },
			{ "LUCK " .. multText(reward.Luck), C.InkSoft },
			{ "+" .. Format.Comma(reward.Gems) .. " 💎", C.Cyan },
			{ string.upper(reward.EggRarity) .. " EGG 🥚", Rarities.Get(reward.EggRarity).Color },
		}
	end
	for i, item in items do
		local chip = Kit.Chip({
			Text = item[1],
			Color = item[2],
			AutoWidth = true,
			TextSize = 22,
			Size = UDim2.fromOffset(0, 36),
			LayoutOrder = i,
			ZIndex = 57,
			Parent = chips,
		})
		chip.Visible = false
		task.delay(1 + i * 0.15, function()
			chip.Visible = true
			Kit.Pop(chip, 0.2, 0.45)
			Audio.Play("coin_tick", { Pitch = 1 + i * 0.1 })
		end)
	end

	local tap = Kit.Text({
		Size = UDim2.fromOffset(400, 20),
		Position = UDim2.new(0.5, 0, 1, -18),
		AnchorPoint = Vector2.new(0.5, 1),
		Text = "tap to continue",
		FontFace = F.Body,
		MaxTextSize = 18,
		Stroke = 1.5,
		ZIndex = 56,
		Parent = party,
	})
	tap.TextTransparency = 1
	task.delay(1.8, function()
		Kit.Tween(tap, 0.3, { TextTransparency = 0 })
	end)

	local done = false
	local function finish()
		if done then
			return
		end
		done = true
		Kit.Tween(party, 0.25, { BackgroundTransparency = 1 })
		Kit.Tween(Kit.ScaleOf(disc), 0.2, { Scale = 0 }, Enum.EasingStyle.Back, Enum.EasingDirection.In)
		Kit.Tween(Kit.ScaleOf(title), 0.2, { Scale = 0 }, Enum.EasingStyle.Back, Enum.EasingDirection.In)
		Kit.Tween(Kit.ScaleOf(burstA), 0.25, { Scale = 0 })
		Kit.Tween(Kit.ScaleOf(burstB), 0.25, { Scale = 0 })
		task.delay(0.26, function()
			party.Visible = false
			party:ClearAllChildren()
			celebrating = false
			refresh()
			Kit.Pop(ui.LevelHolder, 0.5, 0.5)
			Kit.Punch(ui.Level, 0.6)
		end)
	end
	local conn
	conn = party.Activated:Connect(function()
		if conn then
			conn:Disconnect()
		end
		finish()
	end)
	task.delay(4.5, function()
		if conn then
			conn:Disconnect()
		end
		finish()
	end)
end

----------------------------------------------------------------------------
-- Actions
----------------------------------------------------------------------------

function Rebirth._Evolve()
	if busy or celebrating then
		return
	end
	local level = State.Get("Rebirths") or 0
	local nr = Calc.NextRebirth(level)
	if not nr then
		return
	end
	if not armed then
		armed = true
		armToken += 1
		local token = armToken
		Kit.SetButtonColor(ui.Evolve, "Red")
		Kit.SetButtonText(ui.Evolve, "SURE? RESET!")
		Kit.Punch(ui.Evolve, 0.2)
		safeShake(ui.WarnHolder, 8, 0.4)
		Kit.Punch(ui.WarnHolder, 0.08)
		task.delay(3, function()
			if armed and armToken == token then
				disarm()
			end
		end)
		return
	end
	disarm()
	busy = true
	local res = Remote.Call("Rebirth", {})
	busy = false
	if res.ok then
		sacUid = nil
		celebrate(res.level or (level + 1), nr)
		UIRegistry.Toast(("EVOLVED to level %d! Cash %s forever!"):format(res.level or (level + 1), multText(nr.Mult)), "Good")
	else
		refresh()
	end
end

----------------------------------------------------------------------------
-- Interface publique
----------------------------------------------------------------------------

local function onChanged()
	if win and win.IsOpen and not celebrating then
		refresh()
	end
end

function Rebirth.Init()
	build()
	State.Changed("Cash"):Connect(onChanged)
	State.Changed("Kaijus"):Connect(onChanged)
	State.Changed("Rebirths"):Connect(onChanged)

	win.Opened:Connect(function()
		-- vérification périodique (vol en cours, stade des kaijus)
		if heartbeat then
			heartbeat:Disconnect()
		end
		accum = 0
		heartbeat = RunService.Heartbeat:Connect(function(dt)
			accum += dt
			if accum >= 0.5 then
				accum = 0
				onChanged()
			end
		end)
	end)
	win.Closed:Connect(function()
		if heartbeat then
			heartbeat:Disconnect()
			heartbeat = nil
		end
		if sacVp then
			sacVp.Spin = false
		end
		if eggVp then
			eggVp.Spin = false
		end
		if armed then
			disarm()
		end
	end)
end

function Rebirth.Open(_args: any?)
	lastReady.Cash = nil
	lastReady.Kaiju = nil
	lastReady.All = nil
	win:Open()
	refresh()
	-- apparition en cascade
	local items = { ui.LevelHolder, ui.ReqHolder, ui.RewHolder, ui.WarnHolder, ui.Evolve, ui.MaxHolder }
	for i, item in items do
		if item.Visible and (item ~= ui.Evolve or ui.EvolveWrap.Visible) then
			Kit.ScaleOf(item).Scale = 0.01
			task.delay(0.05 * i, function()
				Kit.Pop(item, 0.3, 0.5)
				if item:GetAttribute("Breathing") then
					task.delay(0.5, function()
						if item:GetAttribute("Breathing") then
							Kit.Breathe(item, 0.06, 0.7)
						end
					end)
				end
			end)
		end
	end
	task.delay(0.3, function()
		Kit.Punch(ui.Level, 0.4)
	end)
end

function Rebirth.Close()
	if win then
		win:Close()
	end
end

return Rebirth
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="77">
              <Properties>
                <string name="Name">Settings</string>
                <string name="Source"><![CDATA[--!nonstrict
-- Réglages : interrupteurs animés (musique, effets sonores, effets réduits),
-- saisie de codes, récompense de groupe, crédits.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Rewards = require(Shared.Config.Rewards)
local Theme = require(Shared.Config.Theme)

local Kit = require(script.Parent.Parent.Kit)
local State = require(script.Parent.Parent.Parent.Controllers.State)
local Remote = require(script.Parent.Parent.Parent.Controllers.Remote)
local Audio = require(script.Parent.Parent.Parent.Controllers.Audio)
local UIRegistry = require(script.Parent.Parent.Parent.Controllers.UIRegistry)

local C = Kit.Colors
local F = Kit.Fonts

local Settings = {}

local VERSION = "v1.0"
local TOGGLES = {
	{ Key = "Music", Icon = "🎵", Title = "MUSIC", Sub = "Monster-movie soundtrack" },
	{ Key = "Sfx", Icon = "🔊", Title = "SOUND EFFECTS", Sub = "Stomps, roars and cha-chings" },
	{ Key = "LowFx", Icon = "⚡", Title = "LOW EFFECTS", Sub = "Fewer particles for slower devices" },
}

local window
local rows: { any } = {}
local toggles: { [string]: any } = {}
local codeBox: Frame
local codeStroke: UIStroke
local codeInput: TextBox
local redeemButton: TextButton
local groupSlot: Frame
local groupButton: TextButton
local groupChip: Frame
local groupPanel: Frame
local busy: { [string]: any } = {}

----------------------------------------------------------------------------
-- Interrupteur animé
----------------------------------------------------------------------------

local function makeToggle(parent: Instance, onFlip: (boolean) -> ()): any
	local holder = Kit.new("Frame", {
		Name = "Toggle",
		Size = UDim2.fromOffset(104, 48),
		Position = UDim2.new(1, -66, 0.5, 0),
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundTransparency = 1,
		ZIndex = 5,
		Parent = parent,
	})
	Kit.new("Frame", {
		Name = "Shadow",
		Size = UDim2.fromScale(1, 1),
		Position = UDim2.fromOffset(3, 4),
		BackgroundColor3 = C.Ink,
		ZIndex = 5,
		Parent = holder,
	}, { Kit.Round() })
	local track = Kit.new("TextButton", {
		Name = "Track",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = C.White,
		AutoButtonColor = false,
		Text = "",
		ZIndex = 6,
		Parent = holder,
	}, { Kit.Round(), Kit.Stroke(3) })
	local gradient = Kit.Gradient("Grey")
	gradient.Parent = track
	local label = Kit.Text({
		Size = UDim2.new(0.5, -6, 0.6, 0),
		Position = UDim2.new(0.25, 0, 0.5, 0),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Text = "ON",
		Stroke = 2,
		MaxTextSize = 20,
		ZIndex = 7,
		Parent = track,
	})
	local knob = Kit.new("Frame", {
		Name = "Knob",
		Size = UDim2.fromOffset(38, 38),
		Position = UDim2.new(0, 24, 0.5, 0),
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = C.White,
		ZIndex = 8,
		Parent = track,
	}, { Kit.Round(), Kit.Stroke(3), Kit.Gradient("Paper") })
	-- petit reflet sur le bouton rond
	Kit.new("Frame", {
		Size = UDim2.fromScale(0.4, 0.25),
		Position = UDim2.fromScale(0.28, 0.18),
		BackgroundColor3 = C.White,
		BackgroundTransparency = 0.2,
		ZIndex = 9,
		Parent = knob,
	}, { Kit.Round() })

	local t = { Holder = holder, Track = track, Knob = knob, Value = nil :: boolean? }
	function t.Set(on: boolean, instant: boolean?)
		if t.Value == on then
			return
		end
		t.Value = on
		local colors = if on then Theme.Gradients.Radioactive else Theme.Gradients.Grey
		gradient.Color = ColorSequence.new(colors[1], colors[2])
		label.Text = if on then "ON" else "OFF"
		label.Position = UDim2.new(if on then 0.3 else 0.7, 0, 0.5, 0)
		local target = UDim2.new(if on then 1 else 0, if on then -24 else 24, 0.5, 0)
		if instant then
			knob.Position = target
			knob.Size = UDim2.fromOffset(38, 38)
			return
		end
		-- écrasement élastique pendant la glissade
		knob.Size = UDim2.fromOffset(50, 32)
		Kit.Tween(knob, 0.32, { Position = target }, Enum.EasingStyle.Back)
		Kit.Tween(knob, 0.4, { Size = UDim2.fromOffset(38, 38) }, Enum.EasingStyle.Elastic)
		Kit.Punch(label, 0.3)
	end
	track.Activated:Connect(function()
		Audio.Play("ui_click")
		onFlip(not t.Value)
	end)
	track.MouseEnter:Connect(function()
		Kit.Tween(Kit.ScaleOf(holder), 0.2, { Scale = 1.06 }, Enum.EasingStyle.Back)
	end)
	track.MouseLeave:Connect(function()
		Kit.Tween(Kit.ScaleOf(holder), 0.2, { Scale = 1 })
	end)
	return t
end

----------------------------------------------------------------------------
-- Rangées
----------------------------------------------------------------------------

local function panelRow(parent: Instance, y: number, h: number, rotation: number, gradient: string?): (Frame, Frame)
	local holder = Kit.new("Frame", {
		Size = UDim2.new(1, -8, 0, h),
		Position = UDim2.new(0.5, 0, 0, y + h / 2),
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundTransparency = 1,
		Parent = parent,
	})
	local _, body = Kit.Panel({
		Size = UDim2.new(1, -6, 1, -6),
		Position = UDim2.new(0.5, -3, 0.5, -3),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Rotation = rotation,
		Gradient = gradient,
		Parent = holder,
	})
	table.insert(rows, holder)
	return holder, body
end

local function iconBadge(parent: Instance, icon: string, colorName: string, size: number)
	local badge = Kit.new("Frame", {
		Size = UDim2.fromOffset(size, size),
		Position = UDim2.new(0, 12, 0.5, 0),
		AnchorPoint = Vector2.new(0, 0.5),
		BackgroundColor3 = C.White,
		ZIndex = 3,
		Parent = parent,
	}, { Kit.Round(), Kit.Stroke(3), Kit.Gradient(colorName) })
	Kit.Text({
		Size = UDim2.fromScale(0.66, 0.66),
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Text = icon,
		FontFace = F.Body,
		Stroke = false,
		MaxTextSize = 34,
		ZIndex = 4,
		Parent = badge,
	})
end

local function titleAndSub(parent: Instance, title: string, sub: string, x: number)
	Kit.Text({
		Size = UDim2.new(1, -(x + 140), 0, 26),
		Position = UDim2.new(0, x, 0.5, -2),
		AnchorPoint = Vector2.new(0, 1),
		Text = title,
		TextXAlignment = Enum.TextXAlignment.Left,
		Stroke = 2.5,
		MaxTextSize = 24,
		ZIndex = 3,
		Parent = parent,
	})
	Kit.Text({
		Size = UDim2.new(1, -(x + 140), 0, 20),
		Position = UDim2.new(0, x, 0.5, 2),
		Text = sub,
		FontFace = F.Body,
		TextColor3 = C.InkSoft,
		TextXAlignment = Enum.TextXAlignment.Left,
		Stroke = false,
		MaxTextSize = 17,
		ZIndex = 3,
		Parent = parent,
	})
end

----------------------------------------------------------------------------
-- Actions
----------------------------------------------------------------------------

local function currentSettings(): any
	return State.Get("Settings") or { Music = true, Sfx = true, LowFx = false }
end

local function flip(key: string, value: boolean)
	local t = toggles[key]
	if busy[key] then
		return
	end
	busy[key] = true
	t.Set(value)
	local r = Remote.Call("Settings", { [key] = value })
	busy[key] = nil
	if not r.ok then
		t.Set(currentSettings()[key] == true)
	end
end

local function flashStroke(color: Color3)
	codeStroke.Color = color
	codeStroke.Thickness = 6
	Kit.Tween(codeStroke, 0.6, { Thickness = 4, Color = C.Ink })
end

local function redeem()
	if busy.code then
		return
	end
	local code = string.gsub(codeInput.Text, "%s", "")
	if code == "" then
		Audio.Play("ui_error")
		Kit.Shake(codeBox, 6, 0.3)
		flashStroke(C.Red)
		return
	end
	busy.code = true
	Kit.SetDisabled(redeemButton, true)
	local r = Remote.Call("Redeem", { Code = code })
	busy.code = nil
	Kit.SetDisabled(redeemButton, false)
	if r.ok then
		Audio.Play("reward_claim")
		UIRegistry.Toast("Code redeemed: " .. tostring(r.text or ""), "Good")
		codeInput.Text = ""
		flashStroke(C.RadioactiveDark)
		Kit.Punch(codeBox, 0.12)
		-- éclat de rayons derrière la zone de saisie
		local burst = Kit.Starburst({ Size = UDim2.fromOffset(300, 300), Position = UDim2.fromScale(0.5, 0.5), Color = C.Gold, Transparency = 0.3, ZIndex = 0, Parent = codeBox })
		Kit.Pop(burst, 0.2, 0.4)
		task.delay(0.5, function()
			for _, ray in burst:GetChildren() do
				if ray:IsA("Frame") then
					Kit.Tween(ray, 0.4, { BackgroundTransparency = 1 })
				end
			end
		end)
		task.delay(1, function()
			burst:Destroy()
		end)
	else
		Kit.Shake(codeBox, 7, 0.35)
		flashStroke(C.Red)
	end
end

local function refreshGroup()
	local claimed = State.Get("GroupClaimed") == true
	local soon = Rewards.GroupId == 0
	groupChip.Visible = claimed
	groupSlot.Visible = not claimed
	Kit.SetDisabled(groupButton, false)
	if soon then
		Kit.SetButtonText(groupButton, "COMING SOON")
		Kit.SetButtonColor(groupButton, "Grey")
		Kit.SetDisabled(groupButton, true)
	else
		Kit.SetButtonText(groupButton, "CLAIM")
		Kit.SetButtonColor(groupButton, "Radioactive")
	end
end

local function claimGroup()
	if busy.group or Rewards.GroupId == 0 or State.Get("GroupClaimed") == true then
		return
	end
	busy.group = true
	local r = Remote.Call("ClaimGroup")
	busy.group = nil
	if r.ok then
		Audio.Play("reward_claim")
		UIRegistry.Toast("Group reward: " .. tostring(r.text or ""), "Good")
		Kit.Punch(groupPanel, 0.1)
	end
	refreshGroup()
	if r.ok then
		Kit.Pop(groupChip, 0.3, 0.5)
	end
end

----------------------------------------------------------------------------
-- Interface publique
----------------------------------------------------------------------------

function Settings.Init()
	window = Kit.Window({ Name = "Settings", Title = "SETTINGS", Icon = "⚙️", Color = "Cyan", Size = UDim2.fromOffset(660, 560), RibbonWidth = 320 })
	local content = window.Frame

	-- Interrupteurs
	for i, def in TOGGLES do
		local _, body = panelRow(content, (i - 1) * 70, 66, if i % 2 == 0 then 0.6 else -0.6)
		iconBadge(body, def.Icon, if def.Key == "LowFx" then "Gold" else "Cyan", 44)
		titleAndSub(body, def.Title, def.Sub, 68)
		toggles[def.Key] = makeToggle(body, function(value)
			task.spawn(flip, def.Key, value)
		end)
	end

	-- Codes
	local _, codes = panelRow(content, 214, 100, -0.8, "Pink")
	Kit.Text({
		Size = UDim2.new(0.6, 0, 0, 28),
		Position = UDim2.fromOffset(14, 8),
		Text = "🎟️ CODES",
		TextXAlignment = Enum.TextXAlignment.Left,
		Stroke = 2.5,
		MaxTextSize = 26,
		ZIndex = 3,
		Parent = codes,
	})
	Kit.Text({
		Size = UDim2.new(0.5, 0, 0, 20),
		Position = UDim2.new(1, -14, 0, 12),
		AnchorPoint = Vector2.new(1, 0),
		Text = "Follow us for new codes!",
		FontFace = F.Body,
		TextXAlignment = Enum.TextXAlignment.Right,
		Stroke = 1.5,
		MaxTextSize = 16,
		ZIndex = 3,
		Parent = codes,
	})
	codeBox = Kit.new("Frame", {
		Name = "CodeBox",
		Size = UDim2.new(1, -196, 0, 48),
		Position = UDim2.new(0, 14, 1, -58),
		BackgroundColor3 = C.White,
		ZIndex = 3,
		Parent = codes,
	}, { Kit.Corner(12), Kit.Gradient("Paper") })
	codeStroke = Kit.Stroke(4)
	codeStroke.Parent = codeBox
	codeInput = Kit.new("TextBox", {
		Name = "Input",
		Size = UDim2.new(1, -24, 1, -8),
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundTransparency = 1,
		FontFace = F.Title,
		Text = "",
		PlaceholderText = "ENTER CODE...",
		PlaceholderColor3 = Color3.fromRGB(170, 150, 170),
		TextColor3 = C.Ink,
		TextSize = 26,
		TextXAlignment = Enum.TextXAlignment.Left,
		ClearTextOnFocus = false,
		ZIndex = 4,
		Parent = codeBox,
	})
	codeInput.Focused:Connect(function()
		Kit.Tween(codeStroke, 0.2, { Color = C.Cyan:Lerp(C.Ink, 0.3), Thickness = 5 })
	end)
	codeInput.FocusLost:Connect(function(enter)
		Kit.Tween(codeStroke, 0.2, { Color = C.Ink, Thickness = 4 })
		if enter then
			task.spawn(redeem)
		end
	end)
	local redeemSlot = Kit.new("Frame", {
		Size = UDim2.fromOffset(164, 58),
		Position = UDim2.new(1, -96, 1, -34),
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundTransparency = 1,
		ZIndex = 5,
		Parent = codes,
	})
	redeemButton = Kit.Button({
		Name = "Redeem",
		Text = "REDEEM",
		Color = "Gold",
		Size = UDim2.new(1, 0, 1, -6),
		Position = UDim2.new(0.5, 0, 0.5, -3),
		AnchorPoint = Vector2.new(0.5, 0.5),
		MaxTextSize = 26,
		OnClick = function()
			redeem()
		end,
		Parent = redeemSlot,
	})

	-- Groupe
	local groupHolder, group = panelRow(content, 322, 76, 0.6, "Purple")
	groupPanel = groupHolder
	iconBadge(group, "👥", "Gold", 50)
	titleAndSub(group, "JOIN THE GROUP", "Members get 💎 100 + a Cash Potion", 74)
	local slot = Kit.new("Frame", {
		Size = UDim2.fromOffset(170, 54),
		Position = UDim2.new(1, -98, 0.5, 0),
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundTransparency = 1,
		ZIndex = 5,
		Parent = group,
	})
	groupSlot = slot
	groupButton = Kit.Button({
		Name = "Group",
		Text = "CLAIM",
		Color = "Radioactive",
		Size = UDim2.new(1, 0, 1, -6),
		Position = UDim2.new(0.5, 0, 0.5, -3),
		AnchorPoint = Vector2.new(0.5, 0.5),
		MaxTextSize = 22,
		OnClick = function()
			claimGroup()
		end,
		Parent = slot,
	})
	groupChip = Kit.Chip({
		Text = "CLAIMED ✓",
		Color = C.RadioactiveDark,
		Size = UDim2.fromOffset(150, 36),
		Position = UDim2.new(1, -98, 0.5, 0),
		AnchorPoint = Vector2.new(0.5, 0.5),
		ZIndex = 5,
		Parent = group,
	})
	groupChip.Rotation = -4

	-- Crédits
	Kit.Text({
		Size = UDim2.new(1, 0, 0, 20),
		Position = UDim2.new(0.5, 0, 1, -12),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Text = "STEAL A KAIJU · " .. VERSION .. " · Made with 💚 and way too many meteors",
		FontFace = F.Body,
		TextColor3 = C.InkSoft,
		Stroke = false,
		MaxTextSize = 15,
		Parent = content,
	})

	State.Observe("Settings", function(s)
		if type(s) ~= "table" then
			return
		end
		for key, t in toggles do
			if not busy[key] then
				t.Set(s[key] == true, not window.IsOpen)
			end
		end
	end)
	State.Changed("GroupClaimed"):Connect(refreshGroup)
	for key, t in toggles do
		t.Set(currentSettings()[key] == true, true)
	end
	refreshGroup()
end

function Settings.Open(_args: any?)
	refreshGroup()
	window:Open()
	for i, holder in rows do
		local s = Kit.ScaleOf(holder)
		s.Scale = 0
		task.delay(0.04 + i * 0.06, function()
			Kit.Pop(holder, 0.3, 0.45)
		end)
	end
end

function Settings.Close()
	window:Close()
end

return Settings
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="78">
              <Properties>
                <string name="Name">Shop</string>
                <string name="Source"><![CDATA[--!nonstrict
-- Boutique « KAIJU MART » : passes, gemmes, cash, boosts & potions, améliorations.
-- Chaque onglet est reconstruit à la sélection (apparition en cascade) ; les
-- changements d'état ne font que rafraîchir les cartes via des « updaters ».

local MarketplaceService = game:GetService("MarketplaceService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Monetization = require(Shared.Config.Monetization)
local Theme = require(Shared.Config.Theme)
local Economy = require(Shared.Config.Economy)
local Rarities = require(Shared.Config.Rarities)
local Events = require(Shared.Config.Events)
local Mutations = require(Shared.Config.Mutations)
local Format = require(Shared.Logic.Format)
local Roll = require(Shared.Logic.Roll)

local Kit = require(script.Parent.Parent.Kit)
local State = require(script.Parent.Parent.Parent.Controllers.State)
local Remote = require(script.Parent.Parent.Parent.Controllers.Remote)
local Audio = require(script.Parent.Parent.Parent.Controllers.Audio)
local UIRegistry = require(script.Parent.Parent.Parent.Controllers.UIRegistry)

local C = Kit.Colors
local F = Kit.Fonts

local Shop = {}

local TABS = {
	{ Id = "Passes", Text = "PASSES", Icon = "🎫", Width = 150 },
	{ Id = "Gems", Text = "GEMS", Icon = "💎", Width = 140 },
	{ Id = "Cash", Text = "CASH", Icon = "💵", Width = 140 },
	{ Id = "Boosts", Text = "BOOSTS", Icon = "⚡", Width = 150 },
	{ Id = "Upgrades", Text = "UPGRADES", Icon = "⬆️", Width = 170 },
}

local POTION_COLORS = { Luck = "Radioactive", Growth = "Gold", Cash = "Magma" }
local STARTER_ITEMS = {
	{ Text = "🥚 Legendary Egg", Color = Color3.fromRGB(255, 176, 32) },
	{ Text = "💎 150 Gems", Color = Color3.fromRGB(60, 160, 255) },
	{ Text = "🍀 2 Luck Potions", Color = Color3.fromRGB(40, 170, 60) },
}

local window
local content: Frame
local tabBar: Frame
local selectTab: (string) -> ()
local scroll: CanvasGroup? = nil
local currentTab = "Passes"
local updaters: { () -> () } = {}
local tickers: { () -> () } = {}
local popCount = 0
local loopToken = 0
local busy: { [string]: any } = {}
local priceCache: { [string]: number } = {}

----------------------------------------------------------------------------
-- Aides locales
----------------------------------------------------------------------------

local function now(): number
	return Workspace:GetServerTimeNow()
end

local function restricted(): boolean
	return State.Get("RandomRestricted") == true
end

local function allowed(item: any): boolean
	return not (item.Random == true and restricted())
end

local function robux(key: string, fallback: number): string
	return "R$ " .. Format.Comma(priceCache[key] or fallback)
end

-- Apparition élastique en cascade (l'élément doit être centré sur son ancre).
local function popIn(inst: GuiObject)
	popCount += 1
	local s = Kit.ScaleOf(inst)
	s.Scale = 0
	task.delay(0.04 + popCount * 0.045, function()
		if inst.Parent then
			Kit.Pop(inst, 0.25, 0.5)
		end
	end)
end

local function cell(parent: Instance, size: UDim2, order: number): Frame
	return Kit.new("Frame", { Name = "Cell", Size = size, BackgroundTransparency = 1, LayoutOrder = order, Parent = parent })
end

-- Carte BD centrée dans sa cellule.
local function card(parent: Instance, props: { [string]: any }): (Frame, Frame)
	return Kit.Panel({
		Name = props.Name or "Card",
		Size = props.Size or UDim2.new(1, -12, 1, -12),
		Position = UDim2.new(0.5, -3, 0.5, -3),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Rotation = props.Rotation or 0,
		Gradient = props.Gradient,
		Clip = props.Clip,
		Parent = parent,
	})
end

local function text(parent: Instance, props: { [string]: any }): TextLabel
	props.Parent = parent
	return Kit.Text(props)
end

-- Bouton dans un emplacement : l'emplacement suit le layout, le « souffle »
-- et le survol partent du centre.
local function slotButton(parent: Instance, props: { [string]: any }): (Frame, TextButton, Frame)
	local slot = Kit.new("Frame", {
		Name = (props.Name or "Button") .. "Slot",
		Size = props.Size or UDim2.fromOffset(160, 50),
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or Vector2.zero,
		LayoutOrder = props.LayoutOrder or 0,
		BackgroundTransparency = 1,
		ZIndex = props.ZIndex or 5,
		Parent = parent,
	})
	local breather = Kit.new("Frame", {
		Name = "Breather",
		Size = UDim2.fromScale(1, 1),
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundTransparency = 1,
		ZIndex = props.ZIndex or 5,
		Parent = slot,
	})
	local bp = table.clone(props)
	bp.Size = UDim2.new(1, 0, 1, -6)
	bp.Position = UDim2.new(0.5, 0, 0.5, -3)
	bp.AnchorPoint = Vector2.new(0.5, 0.5)
	bp.LayoutOrder = nil
	bp.Parent = breather
	local button = Kit.Button(bp)
	return slot, button, breather
end

local function setBreathe(inst: GuiObject, on: boolean)
	if (inst:GetAttribute("Breathing") == true) == on then
		return
	end
	inst:SetAttribute("Breathing", on)
	if on then
		Kit.Breathe(inst, 0.06, 0.7)
	else
		Kit.Tween(Kit.ScaleOf(inst), 0.2, { Scale = 1 })
	end
end

local function styleButton(button: GuiObject, color: string, disabled: boolean?)
	Kit.SetDisabled(button, false)
	Kit.SetButtonColor(button, color)
	if disabled then
		Kit.SetDisabled(button, true)
	end
end

local function chip(parent: Instance, props: { [string]: any }): Frame
	props.Parent = parent
	return Kit.Chip(props)
end

-- Titre de section : ruban incliné + rayures de danger.
local function section(parent: Instance, title: string, color: string, order: number): Frame
	local row = cell(parent, UDim2.new(1, 0, 0, 50), order)
	Kit.Hazard({ Size = UDim2.new(1, -40, 0, 10), Position = UDim2.new(0, 30, 0.5, 0), AnchorPoint = Vector2.new(0, 0.5), Parent = row })
	Kit.Ribbon({
		Text = title,
		Color = color,
		Size = UDim2.fromOffset(math.max(200, #title * 17 + 40), 42),
		Position = UDim2.fromOffset(8, 2),
		AnchorPoint = Vector2.zero,
		Rotation = -2,
		ZIndex = 4,
		Parent = row,
	})
	return row
end

local function grid(parent: Instance, cellSize: UDim2, order: number): Frame
	local g = Kit.new("Frame", {
		Name = "Grid",
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		LayoutOrder = order,
		Parent = parent,
	})
	Kit.Grid(cellSize, 14).Parent = g
	return g
end

-- Bandeau coloré avec icône en haut d'une carte.
local function band(body: Frame, color: Color3, icon: string, height: number): Frame
	local b = Kit.new("Frame", {
		Name = "Band",
		Size = UDim2.new(1, -14, 0, height),
		Position = UDim2.fromOffset(7, 7),
		BackgroundColor3 = C.White,
		ZIndex = 2,
		ClipsDescendants = true,
		Parent = body,
	}, { Kit.Corner(10), Kit.Stroke(3), Kit.Gradient({ color:Lerp(C.White, 0.35), color:Lerp(C.Ink, 0.12) }) })
	-- points de trame BD
	for i = 0, 5 do
		Kit.new("Frame", {
			Size = UDim2.fromOffset(18, 18),
			Position = UDim2.new(0.08 + i * 0.17, 0, 0.18 + (i % 2) * 0.55, 0),
			BackgroundColor3 = C.White,
			BackgroundTransparency = 0.78,
			ZIndex = 2,
			Parent = b,
		}, { Kit.Round() })
	end
	local iconLabel = text(b, {
		Name = "Icon",
		Size = UDim2.new(1, 0, 0.9, 0),
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Text = icon,
		FontFace = F.Body,
		Stroke = false,
		MaxTextSize = 64,
		ZIndex = 3,
	})
	Kit.Wobble(iconLabel, 5, 1.6 + math.random() * 0.6)
	return b
end

local function title(parent: Instance, str: string, y: number, h: number?, color: Color3?): TextLabel
	return text(parent, {
		Name = "Name",
		Size = UDim2.new(1, -16, 0, h or 28),
		Position = UDim2.fromOffset(8, y),
		Text = str,
		TextColor3 = color or C.White,
		Stroke = 2.5,
		MaxTextSize = 26,
		ZIndex = 3,
	})
end

local function body(parent: Instance, str: string, y: number, h: number, color: Color3?): TextLabel
	return text(parent, {
		Name = "Desc",
		Size = UDim2.new(1, -20, 0, h),
		Position = UDim2.fromOffset(10, y),
		Text = str,
		FontFace = F.Body,
		TextColor3 = color or C.InkSoft,
		TextWrapped = true,
		Stroke = false,
		MaxTextSize = 17,
		ZIndex = 3,
	})
end

-- Achat Robux (pass ou produit).
local function buyRobux(kind: string, key: string)
	if busy[key] then
		return
	end
	busy[key] = true
	local r = Remote.Call("Buy", { Kind = kind, Key = key })
	busy[key] = nil
	if r.ok and r.msg then
		Audio.Play("purchase")
		UIRegistry.Toast(r.msg, "Good")
	end
end

local function emptyState(parent: Instance, msg: string, order: number)
	local c = cell(parent, UDim2.new(1, 0, 0, 180), order)
	local box, b = card(c, { Rotation = -1 })
	text(b, { Size = UDim2.new(1, -40, 0, 70), Position = UDim2.fromOffset(20, 30), Text = "🌍", FontFace = F.Body, Stroke = false, MaxTextSize = 60 })
	text(b, { Size = UDim2.new(1, -40, 0, 40), Position = UDim2.fromOffset(20, 104), Text = msg, TextColor3 = C.Ink, Stroke = false, MaxTextSize = 28 })
	popIn(box)
end

-- Rayons « aura » derrière une carte (la cellule passe sous ses voisines).
local function aura(c: Frame, color: Color3, size: number)
	c.ZIndex = 0
	Kit.Starburst({ Size = UDim2.fromOffset(size, size), Position = UDim2.fromScale(0.5, 0.5), Color = color, Transparency = 0.35, ZIndex = 0, Parent = c })
end

-- Œuf BD dessiné en frames : coque, taches, reflet.
local function drawEgg(parent: Instance, color: Color3, height: number, pos: UDim2): Frame
	local egg = Kit.new("Frame", {
		Name = "Egg",
		Size = UDim2.fromOffset(math.floor(height * 0.78), height),
		Position = pos,
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = C.White,
		ZIndex = 4,
		Parent = parent,
	}, {
		Kit.new("UICorner", { CornerRadius = UDim.new(0.5, 0) }),
		Kit.Stroke(4),
		Kit.Gradient({ color:Lerp(C.White, 0.45), color:Lerp(C.Ink, 0.1) }),
	})
	for i, spot in { { 0.3, 0.55, 0.2 }, { 0.68, 0.4, 0.16 }, { 0.55, 0.75, 0.13 } } do
		Kit.new("Frame", {
			Name = "Spot" .. i,
			Size = UDim2.fromScale(spot[3] * 1.3, spot[3]),
			Position = UDim2.fromScale(spot[1], spot[2]),
			AnchorPoint = Vector2.new(0.5, 0.5),
			BackgroundColor3 = color:Lerp(C.White, 0.7),
			ZIndex = 5,
			Parent = egg,
		}, { Kit.Round(), Kit.Stroke(2) })
	end
	Kit.new("Frame", {
		Size = UDim2.fromScale(0.22, 0.14),
		Position = UDim2.fromScale(0.3, 0.2),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Rotation = -30,
		BackgroundColor3 = C.White,
		BackgroundTransparency = 0.25,
		ZIndex = 5,
		Parent = egg,
	}, { Kit.Round() })
	text(egg, {
		Size = UDim2.fromScale(0.5, 0.3),
		Position = UDim2.fromScale(0.5, 0.42),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Text = "?",
		Stroke = 2.5,
		MaxTextSize = 40,
		ZIndex = 6,
	})
	return egg
end

----------------------------------------------------------------------------
-- Onglet PASSES
----------------------------------------------------------------------------

local function passOwned(key: string): boolean
	local passes = State.Get("Passes")
	return passes ~= nil and passes[key] == true
end

local function featuredPass(parent: Instance, pass: any, order: number, index: number)
	local c = cell(parent, UDim2.new(0.5, -8, 1, 0), order)
	local accent = pass.Color
	local box, b = card(c, {
		Rotation = if index % 2 == 1 then -1.5 else 1.2,
		Gradient = { accent:Lerp(C.White, 0.3), accent:Lerp(C.Ink, 0.25) },
	})
	-- (pas de ClipsDescendants : la fenêtre est inclinée, donc rayons à la taille de la carte)
	Kit.Starburst({ Size = UDim2.fromOffset(190, 190), Position = UDim2.new(0.21, 0, 0.5, 0), Color = C.White, Transparency = 0.6, Rays = 12, Period = 14, Parent = b })
	local icon = text(b, {
		Size = UDim2.fromOffset(120, 120),
		Position = UDim2.new(0.21, 0, 0.5, 0),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Text = pass.Icon,
		FontFace = F.Body,
		Stroke = false,
		MaxTextSize = 96,
		ZIndex = 3,
	})
	Kit.Wobble(icon, 7, 1.4)
	local tag = chip(b, {
		Text = if pass.Key == "VIP" then "★ FEATURED" else "★ BEST SELLER",
		Color = C.Red,
		Size = UDim2.fromOffset(150, 28),
		Position = UDim2.fromOffset(10, 10),
		ZIndex = 4,
	})
	tag.Rotation = -8
	text(b, {
		Size = UDim2.new(0.56, 0, 0, 46),
		Position = UDim2.new(0.42, 0, 0, 16),
		Text = string.upper(pass.Name),
		TextXAlignment = Enum.TextXAlignment.Left,
		Stroke = 3,
		MaxTextSize = 42,
		ZIndex = 3,
	})
	text(b, {
		Size = UDim2.new(0.55, 0, 0, 58),
		Position = UDim2.new(0.42, 0, 0, 64),
		Text = pass.Description,
		FontFace = F.Body,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		Stroke = 1.8,
		MaxTextSize = 18,
		ZIndex = 3,
	})
	Kit.Hazard({ Size = UDim2.new(1, 0, 0, 10), Position = UDim2.new(0, 0, 1, -10), ZIndex = 2, Parent = b })
	local slot, button, breather = slotButton(b, {
		Name = "Buy",
		Text = robux(pass.Key, pass.Robux),
		Color = if pass.Key == "VIP" then "Pink" else "Radioactive",
		Size = UDim2.fromOffset(190, 58),
		Position = UDim2.new(0.42, 0, 1, -76),
		MaxTextSize = 28,
		ZIndex = 6,
		OnClick = function()
			buyRobux("Pass", pass.Key)
		end,
	})
	local owned = chip(b, {
		Text = "OWNED ✓",
		Color = C.RadioactiveDark,
		Size = UDim2.fromOffset(170, 40),
		Position = UDim2.new(0.42, 0, 1, -70),
		ZIndex = 6,
	})
	local was: boolean? = nil
	table.insert(updaters, function()
		local has = passOwned(pass.Key)
		slot.Visible = not has
		owned.Visible = has
		setBreathe(breather, not has)
		Kit.SetButtonText(button, robux(pass.Key, pass.Robux))
		if was == false and has then
			Kit.Punch(box, 0.12)
			Audio.Play("purchase")
		end
		was = has
	end)
	popIn(box)
end

local function passCard(parent: Instance, pass: any, order: number)
	local c = cell(parent, UDim2.fromOffset(190, 244), order)
	local box, b = card(c, { Rotation = if order % 2 == 0 then 1.2 else -1.2 })
	band(b, pass.Color, pass.Icon, 84)
	title(b, pass.Name, 98, 28, C.White)
	body(b, pass.Description, 128, 50)
	local slot, button = slotButton(b, {
		Name = "Buy",
		Text = robux(pass.Key, pass.Robux),
		Color = "Radioactive",
		Size = UDim2.new(1, -24, 0, 50),
		Position = UDim2.new(0.5, 0, 1, -60),
		AnchorPoint = Vector2.new(0.5, 0),
		MaxTextSize = 24,
		OnClick = function()
			buyRobux("Pass", pass.Key)
		end,
	})
	local owned = chip(b, {
		Text = "OWNED ✓",
		Color = C.RadioactiveDark,
		Size = UDim2.new(1, -40, 0, 36),
		Position = UDim2.new(0.5, 0, 1, -54),
		AnchorPoint = Vector2.new(0.5, 0),
		ZIndex = 6,
	})
	local was: boolean? = nil
	table.insert(updaters, function()
		local has = passOwned(pass.Key)
		slot.Visible = not has
		owned.Visible = has
		Kit.SetButtonText(button, robux(pass.Key, pass.Robux))
		if was == false and has then
			Kit.Punch(box, 0.15)
		end
		was = has
	end)
	popIn(box)
end

local function buildPasses(list: ScrollingFrame)
	local featured = Kit.new("Frame", { Name = "Featured", Size = UDim2.new(1, 0, 0, 218), BackgroundTransparency = 1, LayoutOrder = 1, Parent = list }, {
		Kit.List(Enum.FillDirection.Horizontal, 12, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Center),
	})
	local i = 0
	for _, pass in Monetization.Passes do
		if pass.Featured and allowed(pass) then
			i += 1
			featuredPass(featured, pass, i, i)
		end
	end
	section(list, "ALL PASSES", "Purple", 2)
	local g = grid(list, UDim2.fromOffset(190, 244), 3)
	local n = 0
	for _, pass in Monetization.Passes do
		if not pass.Featured and allowed(pass) then
			n += 1
			passCard(g, pass, n)
		end
	end
end

