local function gemCard(parent: Instance, product: any, order: number, total: number)
	local c = cell(parent, UDim2.fromOffset(190, 268), order)
	local best = order == total
	if best then
		aura(c, C.Gold, 330)
	end
	local box, b = card(c, { Rotation = if order % 2 == 0 then 1.4 else -1.4 })
	local b2 = band(b, product.Color, string.rep("💎", math.min(order, 3)), 92)
	local iconLabel = b2:FindFirstChild("Icon") :: TextLabel?
	if iconLabel then
		iconLabel.Size = UDim2.new(1, -10, 0.4 + order * 0.12, 0)
	end
	local amount = text(b, {
		Size = UDim2.new(1, -16, 0, 50),
		Position = UDim2.fromOffset(8, 104),
		Text = Format.Comma(product.Amount or 0),
		FontFace = F.Impact,
		TextColor3 = C.Gem,
		Stroke = 3,
		MaxTextSize = 50,
		ZIndex = 3,
	})
	text(b, { Size = UDim2.new(1, -16, 0, 22), Position = UDim2.fromOffset(8, 152), Text = "GEMS", TextColor3 = C.Ink, Stroke = false, MaxTextSize = 20, ZIndex = 3 })
	if product.Description ~= "" then
		local tag = chip(b, {
			Text = product.Description,
			Color = if best then C.Red else C.Purple,
			Size = UDim2.new(1, -30, 0, 26),
			Position = UDim2.new(0.5, 0, 0, 178),
			AnchorPoint = Vector2.new(0.5, 0),
			ZIndex = 4,
		})
		tag.Rotation = -3
	end
	local _, button, breather = slotButton(b, {
		Name = "Buy",
		Text = robux(product.Key, product.Robux),
		Color = "Cyan",
		Size = UDim2.new(1, -24, 0, 50),
		Position = UDim2.new(0.5, 0, 1, -60),
		AnchorPoint = Vector2.new(0.5, 0),
		MaxTextSize = 24,
		OnClick = function()
			buyRobux("Product", product.Key)
		end,
	})
	if best then
		setBreathe(breather, true)
	end
	table.insert(updaters, function()
		Kit.SetButtonText(button, robux(product.Key, product.Robux))
	end)
	popIn(box)
	task.delay(0.3 + order * 0.08, function()
		if amount.Parent then
			Kit.Punch(amount, 0.3)
		end
	end)
end

local function buildGems(list: ScrollingFrame)
	local items = {}
	for _, p in Monetization.Products do
		if p.Category == "Gems" and allowed(p) then
			table.insert(items, p)
		end
	end
	if #items == 0 then
		emptyState(list, "Gem packs aren't available in your region", 1)
		return
	end
	section(list, "GEM PACKS", "Cyan", 1)
	local g = grid(list, UDim2.fromOffset(190, 268), 2)
	for i, p in items do
		gemCard(g, p, i, #items)
	end
	text(list, {
		Size = UDim2.new(1, -20, 0, 26),
		LayoutOrder = 3,
		Text = "Gems buy potions, spins and more!",
		FontFace = F.Body,
		TextColor3 = C.InkSoft,
		Stroke = false,
		MaxTextSize = 18,
	})
end

local function cashAmount(product: any): number
	local income = State.Get("Income") or 0
	return math.max(1000, math.floor(income * (product.Amount or 600)))
end

local function cashCard(parent: Instance, product: any, order: number)
	local c = cell(parent, UDim2.fromOffset(250, 290), order)
	if order == 3 then
		aura(c, C.Cash, 380)
	end
	local box, b = card(c, { Rotation = if order == 2 then 0.8 else -1.2 })
	band(b, product.Color, product.Icon, 100)
	title(b, string.upper(product.Name), 112, 28, C.White)
	local amount = text(b, {
		Name = "Amount",
		Size = UDim2.new(1, -16, 0, 50),
		Position = UDim2.fromOffset(8, 142),
		Text = Format.Cash(cashAmount(product)),
		FontFace = F.Impact,
		TextColor3 = C.Cash,
		Stroke = 3,
		MaxTextSize = 50,
		ZIndex = 3,
	})
	body(b, product.Description, 192, 24)
	slotButton(b, {
		Name = "Buy",
		Text = robux(product.Key, product.Robux),
		Color = "Radioactive",
		Size = UDim2.new(1, -30, 0, 54),
		Position = UDim2.new(0.5, 0, 1, -64),
		AnchorPoint = Vector2.new(0.5, 0),
		MaxTextSize = 26,
		OnClick = function()
			buyRobux("Product", product.Key)
		end,
	})
	local last = cashAmount(product)
	table.insert(updaters, function()
		local v = cashAmount(product)
		if v ~= last then
			last = v
			Kit.CountTo(amount, v, Format.Cash, 0.6)
			Kit.Punch(amount, 0.12)
		end
	end)
	popIn(box)
end

local function buildCash(list: ScrollingFrame)
	local items = {}
	for _, p in Monetization.Products do
		if p.Category == "Cash" and allowed(p) then
			table.insert(items, p)
		end
	end
	if #items == 0 then
		emptyState(list, "Cash packs aren't available in your region", 1)
		return
	end
	section(list, "INSTANT CASH", "Radioactive", 1)
	local g = grid(list, UDim2.fromOffset(250, 290), 2)
	for i, p in items do
		cashCard(g, p, i)
	end
	text(list, {
		Size = UDim2.new(1, -20, 0, 26),
		LayoutOrder = 3,
		Text = "Amounts grow with your income ($/s)!",
		FontFace = F.Body,
		TextColor3 = C.InkSoft,
		Stroke = false,
		MaxTextSize = 18,
	})
end

----------------------------------------------------------------------------
-- Onglet BOOSTS
----------------------------------------------------------------------------

local function rarePlus(odds: { [string]: number }, minOrder: number): number
	local sum = 0
	for _, r in Rarities.List do
		if r.Order >= minOrder then
			sum += odds[r.Id] or 0
		end
	end
	return sum
end

-- Explique numériquement l'effet d'un produit serveur (avant / après).
local function showServerOdds(key: string)
	local crater = tonumber(Workspace:GetAttribute("CraterLuck")) or 1
	local serverLuck = math.max(1, tonumber(Workspace:GetAttribute("ServerLuck")) or 1)
	local eventLuck = crater / serverLuck
	local after = crater
	local heading = ""
	local rows = {}
	if key == "ServerLuck" then
		after = eventLuck * math.max(serverLuck, 2)
		heading = "Server Luck x2 · 15 min · everyone"
	elseif key == "MeteorShower" then
		local e = Events.ById.MeteorShower
		after = serverLuck * e.Luck
		heading = string.format("Meteor Shower · x%g meteors · %s", e.MeteorRate, Format.Duration(e.Duration))
	elseif key == "BloodMoon" then
		local e = Events.ById.BloodMoon
		after = serverLuck * e.Luck
		heading = string.format("Blood Moon · %s", Format.Duration(e.Duration))
		local blood = Mutations.Get("Blood")
		table.insert(rows, {
			Label = string.format("Blood mutation on hatch (x%g cash)", if blood then blood.Mult else 4),
			Chance = e.MutationChance or 0,
			Color = if blood then blood.TextColor else C.Red,
		})
	end
	local before = Roll.RarityOdds(crater)
	local boosted = Roll.RarityOdds(after)
	table.insert(rows, { Label = "Rare+ meteor odds · now", Chance = rarePlus(before, 2) })
	table.insert(rows, { Label = "Rare+ meteor odds · boosted", Chance = rarePlus(boosted, 2), Color = C.RadioactiveDark })
	for _, id in { "Epic", "Legendary", "Mythic", "Celestial" } do
		local r = Rarities.Get(id)
		table.insert(rows, { Label = id .. " · now", Chance = before[id] or 0 })
		table.insert(rows, { Label = id .. " · boosted", Chance = boosted[id] or 0, Color = r.Color })
	end
	UIRegistry.ShowOdds(heading, rows)
end

local function starterBanner(list: ScrollingFrame, order: number)
	local c = cell(list, UDim2.new(1, 0, 0, 200), order)
	aura(c, C.Gold, 520)
	local box, b = card(c, { Rotation = -1, Gradient = "Pink" })
	Kit.Starburst({ Size = UDim2.fromOffset(186, 186), Position = UDim2.new(0, 120, 0.5, 0), Color = C.Gold, Transparency = 0.3, Parent = b })
	Kit.Hazard({ Size = UDim2.new(1, 0, 0, 12), Position = UDim2.fromOffset(0, 0), ZIndex = 2, Parent = b })
	Kit.Hazard({ Size = UDim2.new(1, 0, 0, 12), Position = UDim2.new(0, 0, 1, -12), ZIndex = 2, Parent = b })
	-- œuf dessiné (pas de ViewportFrame dans un CanvasGroup)
	local egg = drawEgg(b, Rarities.Get("Legendary").Color, 130, UDim2.new(0, 120, 0.5, 0))
	Kit.Wobble(egg, 7, 0.9)
	text(b, {
		Size = UDim2.new(0.5, 0, 0, 54),
		Position = UDim2.fromOffset(240, 22),
		Text = "STARTER PACK",
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = C.Gold,
		Stroke = 3.5,
		MaxTextSize = 50,
		ZIndex = 4,
	})
	local items = Kit.new("Frame", {
		Size = UDim2.new(0, 330, 0, 90),
		Position = UDim2.fromOffset(240, 82),
		BackgroundTransparency = 1,
		ZIndex = 4,
		Parent = b,
	}, { Kit.List(Enum.FillDirection.Vertical, 6, Enum.HorizontalAlignment.Left) })
	for i, item in STARTER_ITEMS do
		local ch = chip(items, { Text = item.Text, Color = item.Color, AutoWidth = true, Size = UDim2.fromOffset(0, 26), TextSize = 18, LayoutOrder = i, ZIndex = 4 })
		ch.Rotation = (i % 2 == 0) and 1.5 or -1.5
	end
	local stamp = chip(b, {
		Text = "ONE TIME ONLY!",
		Color = C.Red,
		Size = UDim2.fromOffset(180, 32),
		Position = UDim2.new(1, -120, 0, 40),
		AnchorPoint = Vector2.new(0.5, 0.5),
		ZIndex = 5,
	})
	stamp.Rotation = 8
	Kit.Wobble(stamp, 3, 0.8)
	local product = Monetization.ProductByKey.StarterPack
	local _, button, breather = slotButton(b, {
		Name = "BuyStarter",
		Text = robux("StarterPack", product.Robux),
		Color = "Gold",
		Size = UDim2.fromOffset(200, 64),
		Position = UDim2.new(1, -120, 1, -66),
		AnchorPoint = Vector2.new(0.5, 0.5),
		MaxTextSize = 30,
		ZIndex = 6,
		OnClick = function()
			buyRobux("Product", "StarterPack")
		end,
	})
	setBreathe(breather, true)
	table.insert(updaters, function()
		Kit.SetButtonText(button, robux("StarterPack", product.Robux))
	end)
	popIn(box)
end

local function productCard(parent: Instance, product: any, order: number, withOdds: boolean)
	local c = cell(parent, UDim2.fromOffset(250, 246), order)
	local box, b = card(c, { Rotation = if order % 2 == 0 then 1 else -1.3 })
	band(b, product.Color, product.Icon, 82)
	title(b, string.upper(product.Name), 94, 26, C.White)
	body(b, product.Description, 122, 48)
	local row = Kit.new("Frame", {
		Size = UDim2.new(1, -20, 0, 54),
		Position = UDim2.new(0.5, 0, 1, -62),
		AnchorPoint = Vector2.new(0.5, 0),
		BackgroundTransparency = 1,
		ZIndex = 5,
		Parent = b,
	}, { Kit.List(Enum.FillDirection.Horizontal, 8, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Center) })
	if withOdds then
		slotButton(row, {
			Name = "Details",
			Text = "ODDS",
			Icon = "🎲",
			IconSize = 22,
			TextSize = 18,
			Color = "Cyan",
			Size = UDim2.new(0.42, 0, 1, 0),
			LayoutOrder = 1,
			OnClick = function()
				showServerOdds(product.Key)
			end,
		})
	end
	local _, button = slotButton(row, {
		Name = "Buy",
		Text = robux(product.Key, product.Robux),
		Color = if product.Category == "Server" then "Magma" else "Radioactive",
		Size = UDim2.new(if withOdds then 0.55 else 0.9, 0, 1, 0),
		LayoutOrder = 2,
		MaxTextSize = 24,
		OnClick = function()
			buyRobux("Product", product.Key)
		end,
	})
	table.insert(updaters, function()
		Kit.SetButtonText(button, robux(product.Key, product.Robux))
	end)
	popIn(box)
end

local function potionCard(parent: Instance, potion: any, order: number)
	local c = cell(parent, UDim2.fromOffset(250, 300), order)
	local colorName = POTION_COLORS[potion.Id] or "Radioactive"
	local box, b = card(c, { Rotation = if order % 2 == 0 then 1.2 else -1 })
	band(b, Theme.Gradients[colorName][2], potion.Icon, 78)
	title(b, string.upper(potion.Name), 90, 26, C.White)
	body(b, potion.Description, 116, 22)
	local count = chip(b, {
		Name = "Count",
		Text = "OWNED x0",
		Color = C.Ink,
		Size = UDim2.fromOffset(130, 28),
		Position = UDim2.new(0.5, 0, 0, 144),
		AnchorPoint = Vector2.new(0.5, 0),
		ZIndex = 4,
	})
	local bar, setBar = Kit.ProgressBar({
		Size = UDim2.new(1, -40, 0, 16),
		Position = UDim2.new(0.5, 0, 0, 182),
		AnchorPoint = Vector2.new(0.5, 0),
		Color = colorName,
		ZIndex = 4,
		Parent = b,
	})
	local timer = text(b, {
		Size = UDim2.new(1, -20, 0, 22),
		Position = UDim2.fromOffset(10, 202),
		Text = "NOT ACTIVE",
		TextColor3 = C.InkSoft,
		Stroke = false,
		MaxTextSize = 18,
		ZIndex = 4,
	})
	local row = Kit.new("Frame", {
		Size = UDim2.new(1, -20, 0, 54),
		Position = UDim2.new(0.5, 0, 1, -62),
		AnchorPoint = Vector2.new(0.5, 0),
		BackgroundTransparency = 1,
		ZIndex = 5,
		Parent = b,
	}, { Kit.List(Enum.FillDirection.Horizontal, 8, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Center) })
	local _, buyButton = slotButton(row, {
		Name = "Buy",
		Text = potion.GemPrice .. " 💎",
		Color = "Cyan",
		Size = UDim2.new(0.5, -4, 1, 0),
		LayoutOrder = 1,
		MaxTextSize = 24,
		OnClick = function()
			local key = "potion_buy_" .. potion.Id
			if busy[key] then
				return
			end
			busy[key] = true
			local r = Remote.Call("BuyPotion", { Id = potion.Id })
			busy[key] = nil
			if r.ok then
				Audio.Play("purchase")
				Kit.Punch(count, 0.3)
			end
		end,
	})
	local _, useButton, useBreather = slotButton(row, {
		Name = "Use",
		Text = "USE",
		Color = "Radioactive",
		Size = UDim2.new(0.5, -4, 1, 0),
		LayoutOrder = 2,
		MaxTextSize = 24,
		OnClick = function()
			local key = "potion_use_" .. potion.Id
			if busy[key] then
				return
			end
			busy[key] = true
			local r = Remote.Call("UsePotion", { Id = potion.Id })
			busy[key] = nil
			if r.ok then
				Audio.Play("reward_claim")
				Kit.Punch(box, 0.08)
				Kit.Punch(timer, 0.4)
			end
		end,
	})
	local lastOwned: number? = nil
	table.insert(updaters, function()
		local owned = (State.Get("Potions") or {})[potion.Id] or 0
		local gems = State.Get("Gems") or 0
		local label = count:FindFirstChild("Text") :: TextLabel?
		if label then
			label.Text = "OWNED x" .. owned
		end
		if lastOwned and owned ~= lastOwned then
			Kit.Punch(count, 0.25)
		end
		lastOwned = owned
		styleButton(buyButton, if gems >= potion.GemPrice then "Cyan" else "Grey")
		styleButton(useButton, "Radioactive", owned <= 0)
		setBreathe(useBreather, owned > 0)
	end)
	table.insert(tickers, function()
		local ends = (State.Get("Boosts") or {})[potion.Id] or 0
		local left = ends - now()
		if left > 0 then
			timer.Text = "⏱ ACTIVE " .. Format.Clock(left)
			timer.TextColor3 = C.RadioactiveDark
			setBar(math.min(1, left / potion.Duration), true)
			bar.Visible = true
		else
			timer.Text = "NOT ACTIVE"
			timer.TextColor3 = C.InkSoft
			bar.Visible = false
		end
	end)
	popIn(box)
end

local function buildBoosts(list: ScrollingFrame)
	local order = 0
	local function nextOrder(): number
		order += 1
		return order
	end
	if State.Get("StarterPack") ~= true and allowed(Monetization.ProductByKey.StarterPack) then
		starterBanner(list, nextOrder())
	end
	local servers = {}
	for _, key in { "ServerLuck", "MeteorShower", "BloodMoon" } do
		local p = Monetization.ProductByKey[key]
		if p and allowed(p) then
			table.insert(servers, p)
		end
	end
	if #servers > 0 then
		section(list, "SERVER BOOSTS", "Magma", nextOrder())
		local g = grid(list, UDim2.fromOffset(250, 246), nextOrder())
		for i, p in servers do
			productCard(g, p, i, true)
		end
	end
	local kaiju = {}
	for _, key in { "InstantHatch", "ShieldNow", "Spins3" } do
		local p = Monetization.ProductByKey[key]
		if p and allowed(p) then
			table.insert(kaiju, p)
		end
	end
	if #kaiju > 0 then
		section(list, "KAIJU BOOSTS", "Radioactive", nextOrder())
		local g = grid(list, UDim2.fromOffset(250, 246), nextOrder())
		for i, p in kaiju do
			productCard(g, p, i, false)
		end
	end
	section(list, "POTIONS", "Purple", nextOrder())
	local wallet = chip(list, { Text = "💎 0", Color = C.Ink, AutoWidth = true, Size = UDim2.fromOffset(0, 30), TextSize = 20, LayoutOrder = nextOrder() })
	local walletLabel = wallet:FindFirstChild("Text") :: TextLabel
	table.insert(updaters, function()
		Kit.CountTo(walletLabel, State.Get("Gems") or 0, function(v)
			return "YOU HAVE 💎 " .. Format.Comma(v)
		end, 0.5)
	end)
	local g = grid(list, UDim2.fromOffset(250, 300), nextOrder())
	for i, potion in Economy.Potions do
		potionCard(g, potion, i)
	end
end

----------------------------------------------------------------------------
-- Onglet UPGRADES
----------------------------------------------------------------------------

local function effectText(u: any, level: number): string
	local v = u.PerLevel * level
	if u.Id == "Shield" then
		return string.format("+%ds shield", v)
	elseif u.Id == "Sneakers" then
		return string.format("+%d speed", v)
	elseif u.Id == "Muscles" then
		return string.format("+%d%% carry speed", math.floor(v * 100 + 0.5))
	elseif u.Id == "Bonker" then
		return string.format("+%g bonk range", v)
	elseif u.Id == "Reactor" then
		return string.format("+%d%% cash", math.floor(v * 100 + 0.5))
	end
	return "+" .. tostring(v)
end

-- Rangée de pastilles de niveau ; renvoie une fonction set(niveau).
local function pips(parent: Instance, count: number, props: { [string]: any }): (number) -> ()
	local holder = Kit.new("Frame", {
		Name = "Pips",
		Size = props.Size,
		Position = props.Position,
		BackgroundTransparency = 1,
		ZIndex = 4,
		Parent = parent,
	}, { Kit.List(Enum.FillDirection.Horizontal, 5, Enum.HorizontalAlignment.Left, Enum.VerticalAlignment.Center) })
	local list = {}
	for i = 1, count do
		local slot = Kit.new("Frame", { Size = UDim2.fromOffset(20, 20), BackgroundTransparency = 1, LayoutOrder = i, Parent = holder })
		list[i] = Kit.new("Frame", {
			Size = UDim2.fromScale(1, 1),
			Position = UDim2.fromScale(0.5, 0.5),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Rotation = 45,
			BackgroundColor3 = C.PaperDark,
			ZIndex = 4,
			Parent = slot,
		}, { Kit.Corner(4), Kit.Stroke(2.5) })
	end
	local last: number? = nil
	return function(level: number)
		for i, pip in list do
			local on = i <= level
			pip.BackgroundColor3 = if on then (props.Color or C.Radioactive) else C.PaperDark
			if on and last ~= nil and i > last then
				task.delay((i - last - 1) * 0.08, function()
					Kit.Pop(pip, 2.2, 0.5)
				end)
			end
		end
		last = level
	end
end

local function upgradeRow(list: Instance, u: any, order: number)
	local c = cell(list, UDim2.new(1, 0, 0, 104), order)
	local box, b = card(c, { Rotation = if order % 2 == 0 then 0.5 else -0.5 })
	local badge = Kit.new("Frame", {
		Size = UDim2.fromOffset(74, 74),
		Position = UDim2.new(0, 14, 0.5, 0),
		AnchorPoint = Vector2.new(0, 0.5),
		BackgroundColor3 = C.White,
		ZIndex = 3,
		Parent = b,
	}, { Kit.Round(), Kit.Stroke(3), Kit.Gradient("Magma") })
	text(badge, { Size = UDim2.fromScale(0.7, 0.7), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), Text = u.Icon, FontFace = F.Body, Stroke = false, MaxTextSize = 44, ZIndex = 4 })
	text(b, {
		Size = UDim2.new(0, 330, 0, 30),
		Position = UDim2.fromOffset(102, 10),
		Text = string.upper(u.Name),
		TextXAlignment = Enum.TextXAlignment.Left,
		Stroke = 2.5,
		MaxTextSize = 26,
		ZIndex = 3,
	})
	local levelLabel = text(b, {
		Size = UDim2.new(0, 90, 0, 26),
		Position = UDim2.fromOffset(372, 12),
		Text = "LV 0",
		FontFace = F.Impact,
		TextColor3 = C.Magma,
		Stroke = 2,
		MaxTextSize = 26,
		ZIndex = 3,
	})
	text(b, {
		Size = UDim2.new(0, 360, 0, 20),
		Position = UDim2.fromOffset(102, 40),
		Text = u.Description,
		FontFace = F.Body,
		TextColor3 = C.InkSoft,
		TextXAlignment = Enum.TextXAlignment.Left,
		Stroke = false,
		MaxTextSize = 17,
		ZIndex = 3,
	})
	local setPips = pips(b, u.MaxLevel, { Size = UDim2.fromOffset(260, 26), Position = UDim2.fromOffset(104, 64) })
	local effect = text(b, {
		Size = UDim2.new(0, 200, 0, 22),
		Position = UDim2.new(1, -412, 0, 66),
		Text = "",
		FontFace = F.Body,
		TextColor3 = C.RadioactiveDark,
		TextXAlignment = Enum.TextXAlignment.Right,
		Stroke = false,
		MaxTextSize = 17,
		ZIndex = 3,
	})
	local slot, button, breather = slotButton(b, {
		Name = "Buy",
		Text = "$0",
		Color = "Radioactive",
		Size = UDim2.fromOffset(180, 60),
		Position = UDim2.new(1, -110, 0.5, 0),
		AnchorPoint = Vector2.new(0.5, 0.5),
		MaxTextSize = 28,
		OnClick = function()
			local key = "upgrade_" .. u.Id
			if busy[key] then
				return
			end
			busy[key] = true
			local r = Remote.Call("BuyUpgrade", { Id = u.Id })
			busy[key] = nil
			if r.ok then
				Audio.Play("purchase")
				Kit.Punch(box, 0.06)
			end
		end,
	})
	local maxed = chip(b, {
		Text = "MAXED ★",
		Color = C.Gold,
		TextColor = C.White,
		Size = UDim2.fromOffset(150, 40),
		Position = UDim2.new(1, -110, 0.5, 0),
		AnchorPoint = Vector2.new(0.5, 0.5),
		ZIndex = 5,
	})
	local lastLevel: number? = nil
	table.insert(updaters, function()
		local level = (State.Get("Upgrades") or {})[u.Id] or 0
		local cash = State.Get("Cash") or 0
		setPips(level)
		levelLabel.Text = string.format("LV %d/%d", level, u.MaxLevel)
		if lastLevel and level ~= lastLevel then
			Kit.Punch(levelLabel, 0.5)
			Kit.Punch(effect, 0.3)
		end
		lastLevel = level
		local isMax = level >= u.MaxLevel
		slot.Visible = not isMax
		maxed.Visible = isMax
		if isMax then
			effect.Text = effectText(u, level)
			setBreathe(breather, false)
		else
			local price = Economy.UpgradePrice(u.Id, level)
			effect.Text = (if level > 0 then effectText(u, level) .. "  →  " else "") .. effectText(u, level + 1)
			Kit.SetButtonText(button, Format.Cash(price))
			local can = cash >= price
			styleButton(button, if can then "Radioactive" else "Grey")
			setBreathe(breather, can)
		end
	end)
	popIn(box)
end

local function nestRow(list: Instance, order: number)
	local c = cell(list, UDim2.new(1, 0, 0, 104), order)
	local box, b = card(c, { Rotation = -0.6, Gradient = "Gold" })
	local badge = Kit.new("Frame", {
		Size = UDim2.fromOffset(74, 74),
		Position = UDim2.new(0, 14, 0.5, 0),
		AnchorPoint = Vector2.new(0, 0.5),
		BackgroundColor3 = C.White,
		ZIndex = 3,
		Parent = b,
	}, { Kit.Round(), Kit.Stroke(3), Kit.Gradient("Radioactive") })
	local icon = text(badge, { Size = UDim2.fromScale(0.7, 0.7), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), Text = "🪺", FontFace = F.Body, Stroke = false, MaxTextSize = 44, ZIndex = 4 })
	Kit.Wobble(icon, 6, 1.1)
	text(b, {
		Size = UDim2.new(0, 330, 0, 30),
		Position = UDim2.fromOffset(102, 10),
		Text = "UNLOCK NEST",
		TextXAlignment = Enum.TextXAlignment.Left,
		Stroke = 2.5,
		MaxTextSize = 26,
		ZIndex = 3,
	})
	local countLabel = text(b, {
		Size = UDim2.new(0, 110, 0, 26),
		Position = UDim2.fromOffset(352, 12),
		Text = "",
		FontFace = F.Impact,
		TextColor3 = C.Ink,
		Stroke = false,
		MaxTextSize = 26,
		ZIndex = 3,
	})
	text(b, {
		Size = UDim2.new(0, 360, 0, 20),
		Position = UDim2.fromOffset(102, 40),
		Text = "More nests = more kaijus = more cash!",
		FontFace = F.Body,
		TextColor3 = C.InkSoft,
		TextXAlignment = Enum.TextXAlignment.Left,
		Stroke = false,
		MaxTextSize = 17,
		ZIndex = 3,
	})
	local setPips = pips(b, Economy.MaxNests - Economy.StartNests, { Size = UDim2.fromOffset(300, 26), Position = UDim2.fromOffset(104, 64), Color = C.Magma })
	local slot, button, breather = slotButton(b, {
		Name = "BuyNest",
		Text = "$0",
		Color = "Radioactive",
		Size = UDim2.fromOffset(180, 60),
		Position = UDim2.new(1, -110, 0.5, 0),
		AnchorPoint = Vector2.new(0.5, 0.5),
		MaxTextSize = 28,
		OnClick = function()
			if busy.nest then
				return
			end
			busy.nest = true
			local r = Remote.Call("BuyNest")
			busy.nest = nil
			if r.ok then
				Audio.Play("purchase")
				Kit.Punch(box, 0.08)
				Kit.Punch(countLabel, 0.5)
			end
		end,
	})
	local maxed = chip(b, {
		Text = "ALL UNLOCKED ★",
		Color = C.RadioactiveDark,
		Size = UDim2.fromOffset(180, 40),
		Position = UDim2.new(1, -110, 0.5, 0),
		AnchorPoint = Vector2.new(0.5, 0.5),
		ZIndex = 5,
	})
	table.insert(updaters, function()
		local nests = State.Get("Nests") or Economy.StartNests
		local cash = State.Get("Cash") or 0
		setPips(nests - Economy.StartNests)
		countLabel.Text = string.format("%d / %d", nests, Economy.MaxNests)
		local isMax = nests >= Economy.MaxNests
		slot.Visible = not isMax
		maxed.Visible = isMax
		if isMax then
			setBreathe(breather, false)
		else
			local price = Economy.NestPrice(nests)
			Kit.SetButtonText(button, Format.Cash(price))
			local can = cash >= price
			styleButton(button, if can then "Radioactive" else "Grey")
			setBreathe(breather, can)
		end
	end)
	popIn(box)
end

local function buildUpgrades(list: ScrollingFrame)
	local head = cell(list, UDim2.new(1, 0, 0, 50), 1)
	Kit.Ribbon({ Text = "UPGRADES", Color = "Magma", Size = UDim2.fromOffset(230, 42), Position = UDim2.fromOffset(8, 2), AnchorPoint = Vector2.zero, Rotation = -2, ZIndex = 4, Parent = head })
	local wallet = chip(head, {
		Text = "$0",
		Color = C.RadioactiveDark,
		Size = UDim2.fromOffset(220, 34),
		Position = UDim2.new(1, -10, 0.5, 0),
		AnchorPoint = Vector2.new(1, 0.5),
		TextSize = 22,
	})
	local walletLabel = wallet:FindFirstChild("Text") :: TextLabel
	table.insert(updaters, function()
		Kit.CountTo(walletLabel, State.Get("Cash") or 0, function(v)
			return "💵 " .. Format.Cash(v)
		end, 0.5)
	end)
	nestRow(list, 2)
	for i, u in Economy.Upgrades do
		upgradeRow(list, u, 2 + i)
	end
end

----------------------------------------------------------------------------
-- Onglets & cycle de vie
----------------------------------------------------------------------------

local BUILDERS: { [string]: (ScrollingFrame) -> () } = {
	Passes = buildPasses,
	Gems = buildGems,
	Cash = buildCash,
	Boosts = buildBoosts,
	Upgrades = buildUpgrades,
}

local function runUpdaters()
	for _, fn in updaters do
		task.spawn(fn)
	end
	for _, fn in tickers do
		task.spawn(fn)
	end
end

-- Onglets Gems / Cash entièrement « hasard payant » : masqués si restreints.
local function tabVisible(id: string): boolean
	if id == "Gems" or id == "Cash" then
		for _, p in Monetization.Products do
			if p.Category == id and allowed(p) then
				return true
			end
		end
		return false
	end
	return true
end

local function refreshTabs()
	for _, tab in TABS do
		local button = tabBar:FindFirstChild(tab.Id) :: GuiObject?
		if button then
			button.Visible = tabVisible(tab.Id)
		end
	end
end

local function showPage(id: string)
	if not BUILDERS[id] or not tabVisible(id) then
		id = "Passes"
	end
	currentTab = id
	updaters = {}
	tickers = {}
	popCount = 0
	if scroll then
		scroll:Destroy()
	end
	-- CanvasGroup : seul moyen de découper proprement sous une fenêtre inclinée
	local clip = Kit.new("CanvasGroup", {
		Name = "PageClip",
		Size = UDim2.new(1, 0, 1, -62),
		Position = UDim2.fromOffset(0, 62),
		BackgroundTransparency = 1,
		ZIndex = 5,
		Parent = content,
	})
	local list = Kit.Scroll({ Name = "Page", Size = UDim2.fromScale(1, 1), ZIndex = 5, Parent = clip })
	Kit.new("UIPadding", {
		PaddingLeft = UDim.new(0, 6),
		PaddingRight = UDim.new(0, 18),
		PaddingTop = UDim.new(0, 6),
		PaddingBottom = UDim.new(0, 16),
		Parent = list,
	})
	Kit.List(Enum.FillDirection.Vertical, 12).Parent = list
	scroll = clip
	BUILDERS[id](list)
	runUpdaters()
	-- glissement d'entrée de la page (découpé par le CanvasGroup)
	list.Position = UDim2.fromOffset(60, 0)
	Kit.Tween(list, 0.4, { Position = UDim2.fromOffset(0, 0) }, Enum.EasingStyle.Quint)
end

local function startLoop()
	loopToken += 1
	local token = loopToken
	task.spawn(function()
		while window.IsOpen and token == loopToken do
			for _, fn in tickers do
				fn()
			end
			task.wait(0.25)
		end
	end)
end

-- Prix réels (si les identifiants sont configurés), en arrière-plan.
local function fetchPrices()
	task.spawn(function()
		for _, pass in Monetization.Passes do
			if pass.Id ~= 0 then
				local ok, info = pcall(function()
					return MarketplaceService:GetProductInfo(pass.Id, Enum.InfoType.GamePass)
				end)
				if ok and info and info.PriceInRobux then
					priceCache[pass.Key] = info.PriceInRobux
				end
			end
		end
		for _, product in Monetization.Products do
			if product.Id ~= 0 then
				local ok, info = pcall(function()
					return MarketplaceService:GetProductInfo(product.Id, Enum.InfoType.Product)
				end)
				if ok and info and info.PriceInRobux then
					priceCache[product.Key] = info.PriceInRobux
				end
			end
		end
		if window and window.IsOpen then
			runUpdaters()
		end
	end)
end

function Shop.Init()
	window = Kit.Window({ Name = "Shop", Title = "KAIJU MART", Icon = "🛒", Color = "Magma", Size = UDim2.fromOffset(900, 580), RibbonWidth = 360 })
	content = window.Frame
	local bar, select = Kit.Tabs({
		Tabs = TABS,
		ActiveColor = "Magma",
		Size = UDim2.new(1, 0, 0, 54),
		OnSelect = function(id)
			if window.IsOpen then
				showPage(id)
			else
				currentTab = id
			end
		end,
		Parent = content,
	})
	tabBar = bar
	selectTab = select
	refreshTabs()

	-- Rafraîchissements ciblés
	for _, key in { "Cash", "Gems", "Passes", "Potions", "Boosts", "Upgrades", "Nests", "Income" } do
		State.Changed(key):Connect(function()
			if window.IsOpen then
				runUpdaters()
			end
		end)
	end
	-- Changements structurels : reconstruction de la page
	for _, key in { "RandomRestricted", "StarterPack" } do
		State.Changed(key):Connect(function()
			refreshTabs()
			if window.IsOpen then
				selectTab(if tabVisible(currentTab) then currentTab else "Passes")
			end
		end)
	end

	window.Opened:Connect(startLoop)
	window.Closed:Connect(function()
		loopToken += 1
	end)
	fetchPrices()
end

function Shop.Open(args: any?)
	local tab = if type(args) == "string" then args else currentTab
	if not BUILDERS[tab] then
		tab = "Passes"
	end
	refreshTabs()
	window:Open()
	selectTab(tab)
end

function Shop.Close()
	window:Close()
end

return Shop
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="79">
              <Properties>
                <string name="Name">Spin</string>
                <string name="Source"><![CDATA[--!nonstrict
-- Roue « KAIJU WHEEL » façon rouleau CS:GO : une bande de cartes glisse sous
-- un repère et ralentit (Quint) jusqu'à la carte choisie par le serveur.
-- Les probabilités sont TOUJOURS affichées (règle Roblox sur le hasard payant).

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Rewards = require(Shared.Config.Rewards)
local Economy = require(Shared.Config.Economy)
local Monetization = require(Shared.Config.Monetization)
local Rarities = require(Shared.Config.Rarities)
local Format = require(Shared.Logic.Format)
local Roll = require(Shared.Logic.Roll)

local Kit = require(script.Parent.Parent.Kit)
local State = require(script.Parent.Parent.Parent.Controllers.State)
local Remote = require(script.Parent.Parent.Parent.Controllers.Remote)
local Audio = require(script.Parent.Parent.Parent.Controllers.Audio)
local UIRegistry = require(script.Parent.Parent.Parent.Controllers.UIRegistry)

local C = Kit.Colors
local F = Kit.Fonts

local Spin = {}

-- Géométrie du rouleau
local REEL_W, REEL_H = 848, 190
local CARD_W, CARD_H = 132, 150
local STEP = CARD_W + 12
local COUNT = 44
local WIN = 38
local IDLE = 4 -- carte centrée au repos
local DURATION = 4

local window
local reelBody: CanvasGroup
local reelBox: Frame
local strip: Frame
local needleTop: Frame
local needleBottom: Frame
local winBurst: Frame
local resultLabel: TextLabel
local cards: { any } = {}
local weights: { number } = {}
local totalWeight = 0

local buttons: any = {}
local spinning = false
local needsReset = false
local conn: RBXScriptConnection? = nil
local finishSpin: (() -> ())? = nil
local loopToken = 0

----------------------------------------------------------------------------
-- Aides
----------------------------------------------------------------------------

local function now(): number
	return Workspace:GetServerTimeNow()
end

local function restricted(): boolean
	return State.Get("RandomRestricted") == true
end

local function slotIcon(slot: any): string
	local r = slot.Reward
	if r.Kind == "Cash" then
		return if (r.Amount or 0) >= 1000 then "💰" else "💵"
	elseif r.Kind == "Gems" then
		return "💎"
	elseif r.Kind == "Potion" then
		local p = Economy.PotionsById[r.Id or "Luck"]
		return if p then p.Icon else "🧪"
	elseif r.Kind == "Egg" then
		return "🥚"
	elseif r.Kind == "Spins" then
		return "🎡"
	end
	return "🎁"
end

-- Les tranches rares (faible poids) ont un liseré doré et une étoile.
local function isJackpot(slot: any): boolean
	return slot.Weight / totalWeight < 0.06
end

local function stripX(index: number, offset: number): number
	return REEL_W / 2 - ((index - 1) * STEP + CARD_W / 2) - offset
end

local function stripY(): number
	return (REEL_H - CARD_H) / 2
end

local function setBreathe(inst: GuiObject, on: boolean)
	if (inst:GetAttribute("Breathing") == true) == on then
		return
	end
	inst:SetAttribute("Breathing", on)
	if on then
		Kit.Breathe(inst, 0.05, 0.7)
	else
		Kit.Tween(Kit.ScaleOf(inst), 0.2, { Scale = 1 })
	end
end

local function styleButton(button: GuiObject, color: string, disabled: boolean)
	Kit.SetDisabled(button, false)
	Kit.SetButtonColor(button, color)
	if disabled then
		Kit.SetDisabled(button, true)
	end
end

local function slotButton(parent: Instance, props: { [string]: any }): (Frame, TextButton, Frame)
	local slot = Kit.new("Frame", {
		Name = (props.Name or "Button") .. "Slot",
		Size = props.Size,
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or Vector2.zero,
		LayoutOrder = props.LayoutOrder or 0,
		BackgroundTransparency = 1,
		ZIndex = 6,
		Parent = parent,
	})
	local breather = Kit.new("Frame", {
		Size = UDim2.fromScale(1, 1),
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundTransparency = 1,
		ZIndex = 6,
		Parent = slot,
	})
	local bp = table.clone(props)
	bp.Size = UDim2.new(1, 0, 1, -6)
	bp.Position = UDim2.new(0.5, 0, 0.5, -3)
	bp.AnchorPoint = Vector2.new(0.5, 0.5)
	bp.LayoutOrder = nil
	bp.ZIndex = 6
	bp.Parent = breather
	return slot, Kit.Button(bp), breather
end

----------------------------------------------------------------------------
-- Cartes du rouleau (créées une fois, recolorées à chaque tirage)
----------------------------------------------------------------------------

local function buildCard(k: number): any
	local frame = Kit.new("Frame", {
		Name = "Card" .. k,
		Size = UDim2.fromOffset(CARD_W, CARD_H),
		Position = UDim2.fromOffset((k - 1) * STEP + CARD_W / 2, CARD_H / 2),
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = C.White,
		ZIndex = 3,
		Parent = strip,
	}, { Kit.Corner(12) })
	local gradient = Kit.Gradient({ C.White, C.White }, 90)
	gradient.Parent = frame
	local stroke = Kit.Stroke(3)
	stroke.Parent = frame
	-- reflet
	Kit.new("Frame", {
		Size = UDim2.new(1, -14, 0.3, 0),
		Position = UDim2.fromOffset(7, 6),
		BackgroundColor3 = C.White,
		BackgroundTransparency = 0.72,
		ZIndex = 3,
		Parent = frame,
	}, { Kit.Corner(8) })
	local icon = Kit.Text({
		Size = UDim2.new(1, 0, 0, 70),
		Position = UDim2.new(0.5, 0, 0, 14),
		AnchorPoint = Vector2.new(0.5, 0),
		Text = "",
		FontFace = F.Body,
		Stroke = false,
		MaxTextSize = 58,
		ZIndex = 4,
		Parent = frame,
	})
	local label = Kit.Text({
		Size = UDim2.new(1, -12, 0, 34),
		Position = UDim2.new(0.5, 0, 1, -44),
		AnchorPoint = Vector2.new(0.5, 0),
		Text = "",
		Stroke = 2.5,
		MaxTextSize = 22,
		ZIndex = 4,
		Parent = frame,
	})
	local bar = Kit.new("Frame", {
		Size = UDim2.new(1, -16, 0, 6),
		Position = UDim2.new(0.5, 0, 1, -8),
		AnchorPoint = Vector2.new(0.5, 0),
		BackgroundColor3 = C.White,
		ZIndex = 4,
		Parent = frame,
	}, { Kit.Round() })
	local star = Kit.Text({
		Size = UDim2.fromOffset(30, 30),
		Position = UDim2.fromOffset(6, 4),
		Text = "★",
		FontFace = F.Body,
		TextColor3 = C.Gold,
		Stroke = 2,
		MaxTextSize = 26,
		ZIndex = 5,
		Visible = false,
		Parent = frame,
	})
	local dim = Kit.new("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = C.Ink,
		BackgroundTransparency = 0.45,
		ZIndex = 6,
		Visible = false,
		Parent = frame,
	}, { Kit.Corner(12) })
	return { Frame = frame, Gradient = gradient, Stroke = stroke, Icon = icon, Label = label, Bar = bar, Star = star, Dim = dim, Slot = 1 }
end

local function setCard(card: any, slotIndex: number)
	local slot = Rewards.Wheel[slotIndex]
	card.Slot = slotIndex
	local color = slot.Color
	card.Gradient.Color = ColorSequence.new(color:Lerp(C.White, 0.3), color:Lerp(C.Ink, 0.3))
	card.Icon.Text = slotIcon(slot)
	card.Label.Text = string.upper(slot.Label)
	local jackpot = isJackpot(slot)
	card.Star.Visible = jackpot
	card.Stroke.Color = if jackpot then C.Gold else C.Ink
	card.Stroke.Thickness = if jackpot then 4 else 3
	local r = slot.Reward
	card.Bar.BackgroundColor3 = if r.Kind == "Egg" then Rarities.Get(r.Rarity or "Common").Color else C.White
end

local function randomSlot(): number
	return Roll.Weighted(weights)
end

-- Remet la carte gagnante au centre, en position « repos » (transition invisible).
local function resetStrip()
	if needsReset then
		needsReset = false
		for k = 1, 7 do
			local src = WIN - IDLE + k
			setCard(cards[k], cards[src].Slot)
		end
	end
	for k, card in cards do
		card.Dim.Visible = false
		card.Frame.ZIndex = 3
		if k > 7 then
			setCard(card, randomSlot())
		end
	end
	winBurst.Visible = false
	strip.Position = UDim2.fromOffset(stripX(IDLE, 0), stripY())
end

----------------------------------------------------------------------------
-- Boutons
----------------------------------------------------------------------------

function Spin.CanFreeSpin(): boolean
	return (State.Get("FreeSpinAt") or 0) <= now()
end

local function refreshButtons()
	if not window then
		return
	end
	local canFree = Spin.CanFreeSpin()
	local spins = State.Get("Spins") or 0
	local gems = State.Get("Gems") or 0
	local limited = restricted()

	if canFree then
		Kit.SetButtonText(buttons.Free, "FREE SPIN!")
	else
		Kit.SetButtonText(buttons.Free, "FREE IN " .. Format.Clock((State.Get("FreeSpinAt") or 0) - now()))
	end
	styleButton(buttons.Free, "Radioactive", spinning or not canFree)
	setBreathe(buttons.FreeBreather, canFree and not spinning)

	Kit.SetButtonText(buttons.Spins, string.format("SPIN (x%d)", spins))
	styleButton(buttons.Spins, "Magma", spinning or spins <= 0)
	setBreathe(buttons.SpinsBreather, spins > 0 and not canFree and not spinning)

	buttons.GemsSlot.Visible = not limited
	buttons.BuySlot.Visible = not limited
	styleButton(buttons.Gems, if gems >= Economy.SpinGemPrice then "Cyan" else "Grey", spinning)
	styleButton(buttons.Buy, "Gold", spinning)
end

----------------------------------------------------------------------------
-- Animation du tirage
----------------------------------------------------------------------------

local function land(silent: boolean?)
	local card = cards[WIN]
	local slot = Rewards.Wheel[card.Slot]
	needsReset = true
	-- met la gagnante en avant, assombrit les autres
	for k, c in cards do
		c.Dim.Visible = k ~= WIN
	end
	card.Frame.ZIndex = 5
	winBurst.Position = card.Frame.Position
	winBurst.Visible = true
	resultLabel.Text = "YOU WON: " .. string.upper(slot.Label) .. "!"
	resultLabel.TextColor3 = slot.Color
	if silent then
		strip.Position = UDim2.fromOffset(stripX(WIN, 0), stripY())
		return
	end
	-- recentrage élastique sur la carte gagnante
	Kit.Tween(strip, 0.45, { Position = UDim2.fromOffset(stripX(WIN, 0), stripY()) }, Enum.EasingStyle.Back)
	Kit.Pop(winBurst, 0.2, 0.6)
	Kit.Punch(card.Frame, 0.25)
	Kit.Shake(reelBox, 5, 0.3)
	Kit.Pop(resultLabel, 0.3, 0.5)
	Audio.Play("spin_win")
	if isJackpot(slot) then
		UIRegistry.Announce("JACKPOT! " .. string.upper(slot.Label), slot.Color)
	end
end

local function animateTo(offset: number)
	local from = strip.Position.X.Offset
	local to = stripX(WIN, offset)
	local y = stripY()
	local t0 = os.clock()
	local lastIndex = math.floor((REEL_W / 2 - from) / STEP)
	local done = false
	local function finish(silent: boolean?)
		if done then
			return
		end
		done = true
		if conn then
			conn:Disconnect()
			conn = nil
		end
		finishSpin = nil
		needleTop.Rotation = 45
		needleBottom.Rotation = 45
		strip.Position = UDim2.fromOffset(to, y)
		land(silent)
		-- la récompense est accordée par le serveur (~4,2 s après l'appel)
		task.delay(if silent then 0 else 0.6, function()
			spinning = false
			refreshButtons()
		end)
	end
	finishSpin = function()
		finish(true)
	end
	conn = RunService.RenderStepped:Connect(function()
		local a = math.clamp((os.clock() - t0) / DURATION, 0, 1)
		-- Quint sortant : démarrage fulgurant, fin très lente
		local eased = 1 - (1 - a) ^ 5
		local x = from + (to - from) * eased
		strip.Position = UDim2.fromOffset(x, y)
		local travelled = REEL_W / 2 - x
		local index = math.floor(travelled / STEP)
		if index ~= lastIndex then
			lastIndex = index
			Audio.Play("spin_tick", { Cooldown = 0.03, Pitch = 0.9 + 0.4 * (1 - eased), NoVary = true })
		end
		-- le repère « claque » au passage de chaque carte
		local frac = (travelled % STEP) / STEP
		local kick = math.max(0, 1 - frac * 3) * 16 * (1 - eased * 0.5)
		needleTop.Rotation = 45 - kick
		needleBottom.Rotation = 45 + kick
		if a >= 1 then
			finish(false)
		end
	end)
end

local function doSpin(useGems: boolean)
	if spinning then
		return
	end
	spinning = true
	refreshButtons()
	resetStrip()
	resultLabel.Text = "SPINNING..."
	resultLabel.TextColor3 = C.Ink
	local r = Remote.Call("Spin", { UseGems = useGems })
	if not r.ok or type(r.index) ~= "number" or not Rewards.Wheel[r.index] or not window.IsOpen then
		spinning = false
		resultLabel.Text = "Spin to win!"
		refreshButtons()
		return
	end
	setCard(cards[WIN], r.index)
	Audio.Play("whoosh")
	local margin = CARD_W / 2 - 14
	animateTo((math.random() * 2 - 1) * margin)
end

----------------------------------------------------------------------------
-- Tableau des probabilités
----------------------------------------------------------------------------

local function buildOdds(parent: Instance)
	local box, body = Kit.Panel({
		Name = "Odds",
		Size = UDim2.new(0, 410, 1, -10),
		Position = UDim2.new(1, -8, 0, 4),
		AnchorPoint = Vector2.new(1, 0),
		Rotation = 0.8,
		Parent = parent,
	})
	Kit.Text({
		Size = UDim2.new(1, -20, 0, 28),
		Position = UDim2.fromOffset(10, 6),
		Text = "🎲 ODDS PER SPIN",
		TextColor3 = C.Ink,
		Stroke = false,
		MaxTextSize = 24,
		ZIndex = 3,
		Parent = body,
	})
	local list = Kit.new("Frame", {
		Size = UDim2.new(1, -20, 1, -44),
		Position = UDim2.fromOffset(10, 38),
		BackgroundTransparency = 1,
		ZIndex = 3,
		Parent = body,
	}, { Kit.List(Enum.FillDirection.Vertical, 2) })
	local rowH = math.floor((238 - 44) / #Rewards.Wheel) - 2
	for i, slot in Rewards.Wheel do
		local chance = slot.Weight / totalWeight
		local row = Kit.new("Frame", {
			Size = UDim2.new(1, 0, 0, rowH),
			BackgroundColor3 = C.Ink,
			BackgroundTransparency = if i % 2 == 0 then 0.92 else 0.85,
			LayoutOrder = i,
			ZIndex = 3,
			Parent = list,
		}, { Kit.Corner(6) })
		Kit.new("Frame", {
			Size = UDim2.fromOffset(rowH - 6, rowH - 6),
			Position = UDim2.new(0, 4, 0.5, 0),
			AnchorPoint = Vector2.new(0, 0.5),
			BackgroundColor3 = slot.Color,
			ZIndex = 4,
			Parent = row,
		}, { Kit.Corner(4), Kit.Stroke(2) })
		Kit.Text({
			Size = UDim2.new(0.55, -rowH, 1, -4),
			Position = UDim2.new(0, rowH + 4, 0.5, 0),
			AnchorPoint = Vector2.new(0, 0.5),
			Text = slotIcon(slot) .. " " .. slot.Label,
			FontFace = F.Body,
			TextColor3 = C.Ink,
			TextXAlignment = Enum.TextXAlignment.Left,
			Stroke = false,
			MaxTextSize = 17,
			ZIndex = 4,
			Parent = row,
		})
		-- barre proportionnelle à la chance
		local track = Kit.new("Frame", {
			Size = UDim2.new(0.25, 0, 0, 8),
			Position = UDim2.new(0.58, 0, 0.5, 0),
			AnchorPoint = Vector2.new(0, 0.5),
			BackgroundColor3 = C.PaperDark,
			ZIndex = 4,
			Parent = row,
		}, { Kit.Round() })
		Kit.new("Frame", {
			Size = UDim2.fromScale(math.max(0.03, chance / 0.3), 1),
			BackgroundColor3 = slot.Color,
			ZIndex = 5,
			Parent = track,
		}, { Kit.Round() })
		Kit.Text({
			Size = UDim2.new(0.16, 0, 1, -4),
			Position = UDim2.new(1, -4, 0.5, 0),
			AnchorPoint = Vector2.new(1, 0.5),
			Text = Format.Percent(chance),
			FontFace = F.Title,
			TextColor3 = C.Ink,
			TextXAlignment = Enum.TextXAlignment.Right,
			Stroke = false,
			MaxTextSize = 17,
			ZIndex = 4,
			Parent = row,
		})
	end
	return box
end

----------------------------------------------------------------------------
-- Interface publique
----------------------------------------------------------------------------

function Spin.Init()
	for i, slot in Rewards.Wheel do
		weights[i] = slot.Weight
		totalWeight += slot.Weight
	end

	window = Kit.Window({ Name = "Spin", Title = "KAIJU WHEEL", Icon = "🎡", Color = "Gold", Size = UDim2.fromOffset(900, 580), RibbonWidth = 380 })
	local content = window.Frame

	-- Rouleau
	local box, body = Kit.Panel({
		Name = "Reel",
		Size = UDim2.fromOffset(REEL_W, REEL_H),
		Position = UDim2.new(0.5, -3, 0, 4),
		AnchorPoint = Vector2.new(0.5, 0),
		Rotation = -0.6,
		Gradient = "Ink",
		Parent = content,
	})
	reelBox = box
	-- CanvasGroup : la fenêtre est inclinée, ClipsDescendants serait ignoré
	reelBody = Kit.new("CanvasGroup", {
		Name = "ReelClip",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		ZIndex = 2,
		Parent = body,
	}, { Kit.Corner() })
	strip = Kit.new("Frame", {
		Name = "Strip",
		Size = UDim2.fromOffset(COUNT * STEP, CARD_H),
		Position = UDim2.fromOffset(stripX(IDLE, 0), stripY()),
		BackgroundTransparency = 1,
		ZIndex = 3,
		Parent = reelBody,
	})
	winBurst = Kit.Starburst({ Size = UDim2.fromOffset(340, 340), Color = C.Gold, Transparency = 0.2, Rays = 16, Period = 6, ZIndex = 4, Parent = strip })
	winBurst.Visible = false
	for k = 1, COUNT do
		cards[k] = buildCard(k)
	end
	-- fondu sur les bords
	for _, side in { 0, 1 } do
		Kit.new("Frame", {
			Size = UDim2.new(0, 150, 1, 0),
			Position = UDim2.fromScale(side, 0),
			AnchorPoint = Vector2.new(side, 0),
			BackgroundColor3 = C.Ink,
			BorderSizePixel = 0,
			ZIndex = 8,
			Parent = reelBody,
		}, {
			Kit.new("UIGradient", {
				Transparency = NumberSequence.new(if side == 0 then 0 else 1, if side == 0 then 1 else 0),
			}),
		})
	end
	Kit.Hazard({ Size = UDim2.new(1, -24, 0, 8), Position = UDim2.fromOffset(12, 4), ZIndex = 9, Parent = body })
	Kit.Hazard({ Size = UDim2.new(1, -24, 0, 8), Position = UDim2.new(0, 12, 1, -12), ZIndex = 9, Parent = body })
	-- repère central : ligne (dans le rouleau) + deux losanges épinglés sur le cadre
	Kit.new("Frame", {
		Size = UDim2.new(0, 4, 1, 0),
		Position = UDim2.fromScale(0.5, 0),
		AnchorPoint = Vector2.new(0.5, 0),
		BackgroundColor3 = C.Gold,
		BackgroundTransparency = 0.25,
		BorderSizePixel = 0,
		ZIndex = 9,
		Parent = reelBody,
	})
	needleTop = Kit.new("Frame", {
		Size = UDim2.fromOffset(34, 34),
		Position = UDim2.new(0.5, 0, 0, 2),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Rotation = 45,
		BackgroundColor3 = C.Red,
		ZIndex = 10,
		Parent = body,
	}, { Kit.Corner(4), Kit.Stroke(3) })
	needleBottom = Kit.new("Frame", {
		Size = UDim2.fromOffset(34, 34),
		Position = UDim2.new(0.5, 0, 1, -2),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Rotation = 45,
		BackgroundColor3 = C.Red,
		ZIndex = 10,
		Parent = body,
	}, { Kit.Corner(4), Kit.Stroke(3) })

	resultLabel = Kit.Text({
		Size = UDim2.new(0.8, 0, 0, 40),
		Position = UDim2.new(0.5, 0, 0, REEL_H + 30),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Text = "Spin to win!",
		TextColor3 = C.Ink,
		Stroke = false,
		MaxTextSize = 34,
		Parent = content,
	})

	-- Zone basse : boutons à gauche, probabilités à droite
	local bottom = Kit.new("Frame", {
		Name = "Bottom",
		Size = UDim2.new(1, 0, 0, 248),
		Position = UDim2.new(0, 0, 1, -248),
		BackgroundTransparency = 1,
		Parent = content,
	})
	local left = Kit.new("Frame", {
		Size = UDim2.new(1, -440, 1, 0),
		BackgroundTransparency = 1,
		Parent = bottom,
	})
	local freeSlot, freeButton, freeBreather = slotButton(left, {
		Name = "Free",
		Text = "FREE SPIN!",
		Color = "Radioactive",
		Size = UDim2.new(1, -20, 0, 72),
		Position = UDim2.new(0.5, 0, 0, 44),
		AnchorPoint = Vector2.new(0.5, 0.5),
		MaxTextSize = 34,
		Sound = "ui_click",
		OnClick = function()
			doSpin(false)
		end,
	})
	local spinsSlot, spinsButton, spinsBreather = slotButton(left, {
		Name = "Spins",
		Text = "SPIN (x0)",
		Color = "Magma",
		Size = UDim2.new(1, -20, 0, 62),
		Position = UDim2.new(0.5, 0, 0, 118),
		AnchorPoint = Vector2.new(0.5, 0.5),
		MaxTextSize = 30,
		OnClick = function()
			doSpin(false)
		end,
	})
	local gemsSlot, gemsButton = slotButton(left, {
		Name = "Gems",
		Text = "SPIN " .. Economy.SpinGemPrice .. " 💎",
		Color = "Cyan",
		Size = UDim2.new(0.5, -14, 0, 58),
		Position = UDim2.new(0.25, 2, 0, 190),
		AnchorPoint = Vector2.new(0.5, 0.5),
		MaxTextSize = 24,
		OnClick = function()
			doSpin(true)
		end,
	})
	local product = Monetization.ProductByKey.Spins3
	local buySlot, buyButton = slotButton(left, {
		Name = "Buy3",
		Text = "3 SPINS · R$ " .. (if product then product.Robux else 79),
		Color = "Gold",
		Size = UDim2.new(0.5, -14, 0, 58),
		Position = UDim2.new(0.75, -2, 0, 190),
		AnchorPoint = Vector2.new(0.5, 0.5),
		MaxTextSize = 22,
		OnClick = function()
			if buttons.Buying then
				return
			end
			buttons.Buying = true
			local r = Remote.Call("Buy", { Kind = "Product", Key = "Spins3" })
			buttons.Buying = false
			if r.ok and r.msg then
				Audio.Play("purchase")
				UIRegistry.Toast(r.msg, "Good")
			end
		end,
	})
	buttons = {
		Free = freeButton,
		FreeSlot = freeSlot,
		FreeBreather = freeBreather,
		Spins = spinsButton,
		SpinsSlot = spinsSlot,
		SpinsBreather = spinsBreather,
		Gems = gemsButton,
		GemsSlot = gemsSlot,
		Buy = buyButton,
		BuySlot = buySlot,
		Buying = false,
	}
	buildOdds(bottom)

	for _, card in cards do
		setCard(card, randomSlot())
	end

	for _, key in { "FreeSpinAt", "Spins", "Gems", "RandomRestricted" } do
		State.Changed(key):Connect(function()
			if window.IsOpen then
				refreshButtons()
			end
		end)
	end

	window.Opened:Connect(function()
		loopToken += 1
		local token = loopToken
		task.spawn(function()
			while window.IsOpen and token == loopToken do
				refreshButtons()
				task.wait(1)
			end
		end)
	end)
	window.Closed:Connect(function()
		loopToken += 1
		-- fermeture en plein tirage : on coupe la boucle et on pose le résultat
		if finishSpin then
			finishSpin()
		end
	end)
end

function Spin.Open(_args: any?)
	window:Open()
	if not spinning then
		resetStrip()
		resultLabel.Text = "Spin to win!"
		resultLabel.TextColor3 = C.Ink
	end
	refreshButtons()
	-- les cartes visibles surgissent en cascade
	for k = 1, 7 do
		local frame = cards[k].Frame
		local s = Kit.ScaleOf(frame)
		s.Scale = 0
		task.delay(0.05 + k * 0.05, function()
			Kit.Pop(frame, 0.2, 0.45)
		end)
	end
	Kit.Pop(buttons.FreeSlot, 0.4, 0.5)
	Kit.Pop(buttons.SpinsSlot, 0.4, 0.55)
end

function Spin.Close()
	window:Close()
end

return Spin
]]></string>
              </Properties>
            </Item>
          </Item>
          <Item class="ModuleScript" referent="80">
            <Properties>
              <string name="Name">Viewport</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Aperçu 3D d'un kaiju (ou d'un œuf) dans l'interface, avec rotation lente.
--   local vp = Viewport.new({ Species = "Toastzilla", Mutation = nil, Parent = frame })
--   vp:Set("Rexplosion", "Gold") ; vp:SetSilhouette(true) ; vp:Destroy()

local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local KaijuBuilder = require(Shared.KaijuBuilder)
local Theme = require(Shared.Config.Theme)

local Viewport = {}
Viewport.__index = Viewport

local active: { [any]: boolean } = {}

function Viewport.new(props: { [string]: any })
	local frame = Instance.new("ViewportFrame")
	frame.Name = props.Name or "Viewport"
	frame.Size = props.Size or UDim2.fromScale(1, 1)
	frame.Position = props.Position or UDim2.new()
	frame.AnchorPoint = props.AnchorPoint or Vector2.zero
	frame.BackgroundTransparency = 1
	frame.Ambient = Color3.fromRGB(170, 160, 190)
	frame.LightColor = Color3.fromRGB(255, 250, 240)
	frame.LightDirection = Vector3.new(-0.6, -1, -0.5)
	frame.ZIndex = props.ZIndex or 5
	frame.LayoutOrder = props.LayoutOrder or 0
	local camera = Instance.new("Camera")
	camera.FieldOfView = 30
	camera.Parent = frame
	frame.CurrentCamera = camera
	local world = Instance.new("WorldModel")
	world.Parent = frame
	frame.Parent = props.Parent

	local self = setmetatable({
		Frame = frame,
		Camera = camera,
		World = world,
		Model = nil :: Model?,
		Angle = props.Angle or 0.6,
		Spin = props.Spin ~= false,
		Speed = props.Speed or 0.6,
		Distance = 1,
		Center = Vector3.zero,
		Silhouette = false,
	}, Viewport)
	if props.Egg then
		self:SetEgg(props.Egg)
	elseif props.Species then
		self:Set(props.Species, props.Mutation)
	end
	if props.Silhouette then
		self:SetSilhouette(true)
	end
	active[self] = true
	return self
end

function Viewport:_frame(model: Model)
	local cf, size = model:GetBoundingBox()
	self.Center = cf.Position
	local radius = size.Magnitude / 2
	self.Distance = radius / math.tan(math.rad(self.Camera.FieldOfView / 2)) * 1.05
	self:_update()
end

function Viewport:_update()
	local dir = Vector3.new(math.sin(self.Angle), 0.35, -math.cos(self.Angle)).Unit
	self.Camera.CFrame = CFrame.lookAt(self.Center + dir * self.Distance, self.Center)
end

function Viewport:_replace(model: Model)
	if self.Model then
		self.Model:Destroy()
	end
	self.Model = model
	model.Parent = self.World
	self:_frame(model)
	if self.Silhouette then
		self:SetSilhouette(true)
	end
end

function Viewport:Set(species: string, mutation: string?)
	self:_replace(KaijuBuilder.Build(species, mutation, 1))
end

function Viewport:SetEgg(rarity: string)
	self:_replace(KaijuBuilder.BuildEgg(rarity, 1))
end

-- Silhouette noire (kaiju pas encore découvert).
function Viewport:SetSilhouette(on: boolean)
	self.Silhouette = on
	if on then
		self.Frame.ImageColor3 = Theme.Colors.Ink
		self.Frame.Ambient = Color3.new(0, 0, 0)
		self.Frame.LightColor = Color3.new(0, 0, 0)
	else
		self.Frame.ImageColor3 = Color3.new(1, 1, 1)
		self.Frame.Ambient = Color3.fromRGB(170, 160, 190)
		self.Frame.LightColor = Color3.fromRGB(255, 250, 240)
	end
end

function Viewport:Destroy()
	active[self] = nil
	self.Frame:Destroy()
end

RunService.RenderStepped:Connect(function(dt)
	for vp in active do
		local frame = vp.Frame
		if not frame.Parent then
			active[vp] = nil
		elseif vp.Spin and frame.Visible then
			vp.Angle += dt * vp.Speed
			vp:_update()
		end
	end
end)

return Viewport
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="Folder" referent="81">
          <Properties>
            <string name="Name">World</string>
          </Properties>
          <Item class="ModuleScript" referent="82">
            <Properties>
              <string name="Name">CharacterFx</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Personnages : le Bonker (coup + animation), recul comique quand on se fait
-- bonker (étoiles, « BONK! »), effets des autres joueurs, rayon d'évolution.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Theme = require(Shared.Config.Theme)

local Controllers = script.Parent.Parent.Controllers
local Remote = require(Controllers.Remote)
local Audio = require(Controllers.Audio)
local FxBus = require(Controllers.FxBus)
local CameraFx = require(Controllers.CameraFx)
local UIRegistry = require(Controllers.UIRegistry)
local Effects = require(script.Parent.Effects)

local C = Theme.Colors
local player = Players.LocalPlayer

local CharacterFx = {}

local BONK_WORDS = { "BONK!", "WHAM!", "BOP!", "POW!", "BONK!!" }

local function rootOf(p: Player?): BasePart?
	local character = p and p.Character
	return character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
end

local function hookTool(tool: Tool)
	if tool.Name ~= "Bonker" or tool:GetAttribute("Hooked") then
		return
	end
	tool:SetAttribute("Hooked", true)
	local last = 0
	tool.Activated:Connect(function()
		if os.clock() - last < 0.35 then
			return
		end
		last = os.clock()
		-- animation « toolslash » du script Animate par défaut
		local anim = Instance.new("StringValue")
		anim.Name = "toolanim"
		anim.Value = "Slash"
		anim.Parent = tool
		task.delay(0.3, function()
			anim:Destroy()
		end)
		Audio.Play("knockback_whoosh", { Volume = 0.6 })
		Remote.Input("Bonk")
		CameraFx.FovPunch(2, 0.25)
	end)
end

local function watchCharacter(character: Model)
	for _, child in character:GetChildren() do
		if child:IsA("Tool") then
			hookTool(child)
		end
	end
	character.ChildAdded:Connect(function(child)
		if child:IsA("Tool") then
			hookTool(child)
		end
	end)
end

-- Étoiles qui tournent autour de la tête.
local function dizzy(character: Model, duration: number)
	local head = character:FindFirstChild("Head") :: BasePart?
	if not head then
		return
	end
	local stars = {}
	for i = 1, 3 do
		local gui = Instance.new("BillboardGui")
		gui.Size = UDim2.fromOffset(30, 30)
		gui.AlwaysOnTop = true
		gui.LightInfluence = 0
		gui.Adornee = head
		local t = Instance.new("TextLabel")
		t.BackgroundTransparency = 1
		t.Size = UDim2.fromScale(1, 1)
		t.Text = "⭐"
		t.TextScaled = true
		t.Parent = gui
		gui.Parent = head
		stars[i] = gui
	end
	local t0 = os.clock()
	local conn
	conn = RunService.RenderStepped:Connect(function()
		local t = os.clock() - t0
		if t > duration or not head.Parent then
			conn:Disconnect()
			for _, s in stars do
				s:Destroy()
			end
			return
		end
		for i, s in stars do
			local a = t * 6 + i * (math.pi * 2 / 3)
			s.StudsOffsetWorldSpace = Vector3.new(math.cos(a) * 1.6, 1.4, math.sin(a) * 1.6)
		end
	end)
end

function CharacterFx.Init()
	if player.Character then
		watchCharacter(player.Character)
	end
	player.CharacterAdded:Connect(watchCharacter)

	FxBus.On("Knockback", function(args)
		local character = player.Character
		local root = rootOf(player)
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if not root or not humanoid then
			return
		end
		humanoid:ChangeState(Enum.HumanoidStateType.FallingDown)
		root.AssemblyLinearVelocity = args.Velocity or Vector3.new(0, 50, 0)
		root.AssemblyAngularVelocity = Vector3.new(math.random(-8, 8), math.random(-8, 8), math.random(-8, 8))
		Audio.Play("bonk")
		CameraFx.Shake(1, 0.4)
		dizzy(character, 1.6)
		task.delay(0.9, function()
			if humanoid.Parent then
				humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
			end
		end)
		if args.From then
			UIRegistry.Toast(("%s bonked you! 😵"):format(args.From), "Bad")
		end
	end)

	FxBus.On("BonkHit", function(args)
		local pos = args.Position
		if typeof(pos) ~= "Vector3" then
			return
		end
		Effects.FloatingText(pos + Vector3.new(0, 4, 0), BONK_WORDS[math.random(1, #BONK_WORDS)], C.Gold, 1.2)
		Effects.Burst(pos + Vector3.new(0, 2, 0), C.Gold, 18, 1.6)
		if args.UserId ~= player.UserId then
			Audio.Play("bonk", { Parent = rootOf(Players:GetPlayerByUserId(args.UserId)) })
		end
	end)

	FxBus.On("BonkSwing", function(args)
		if args.UserId == player.UserId then
			return
		end
		local root = rootOf(Players:GetPlayerByUserId(args.UserId or 0))
		if root then
			Audio.Play("knockback_whoosh", { Parent = root, Volume = 0.5 })
		end
	end)

	FxBus.On("Rebirth", function(args)
		local root = rootOf(Players:GetPlayerByUserId(args.UserId or 0))
		if root then
			Effects.Pillar(root.Position, C.Radioactive, 3)
			Effects.Burst(root.Position, C.Radioactive, 60, 3)
		end
	end)
end

return CharacterFx
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="83">
            <Properties>
              <string name="Name">Effects</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Effets visuels 3D réutilisables (tout est local et nettoyé automatiquement).

local Debris = game:GetService("Debris")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Theme = require(Shared.Config.Theme)

local Effects = {}

local TEX = {
	Sparkle = "rbxasset://textures/particles/sparkles_main.dds",
	Fire = "rbxasset://textures/particles/fire_main.dds",
	Smoke = "rbxasset://textures/particles/smoke_main.dds",
	Spark = "rbxasset://textures/particles/fire_sparks_main.dds",
	Glow = "rbxasset://textures/particles/forcefield_glow_main.dds",
	Shock = "rbxasset://textures/particles/explosion01_shockwave_main.dds",
	Core = "rbxasset://textures/particles/explosion01_core_main.dds",
}
Effects.Textures = TEX

local folder: Folder

local function getFolder(): Folder
	if not folder or not folder.Parent then
		local f = Instance.new("Folder")
		f.Name = "ClientFx"
		f.Parent = Workspace
		folder = f
	end
	return folder
end

local function anchorPart(pos: Vector3, size: Vector3?): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Transparency = 1
	p.Size = size or Vector3.new(1, 1, 1)
	p.CFrame = CFrame.new(pos)
	p.Parent = getFolder()
	return p
end

local function tween(inst: Instance, time: number, props: { [string]: any }, style: Enum.EasingStyle?)
	local t = TweenService:Create(inst, TweenInfo.new(time, style or Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props)
	t:Play()
	return t
end

-- Explosion de particules colorées.
function Effects.Burst(pos: Vector3, color: Color3, count: number?, size: number?)
	local p = anchorPart(pos)
	local s = size or 2
	local e = Instance.new("ParticleEmitter")
	e.Texture = TEX.Sparkle
	e.Color = ColorSequence.new(color, Color3.new(1, 1, 1))
	e.LightEmission = 1
	e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, s * 0.7), NumberSequenceKeypoint.new(1, 0) })
	e.Speed = NumberRange.new(s * 6, s * 14)
	e.SpreadAngle = Vector2.new(180, 180)
	e.Lifetime = NumberRange.new(0.5, 1.1)
	e.Drag = 3
	e.Rotation = NumberRange.new(0, 360)
	e.RotSpeed = NumberRange.new(-200, 200)
	e.Enabled = false
	e.Parent = p
	e:Emit(count or 30)
	local light = Instance.new("PointLight")
	light.Color = color
	light.Range = s * 8
	light.Brightness = 4
	light.Parent = p
	tween(light, 0.6, { Brightness = 0 })
	Debris:AddItem(p, 1.6)
end

-- Anneau d'onde de choc au sol.
function Effects.Shockwave(pos: Vector3, color: Color3, radius: number, duration: number?)
	local ring = Instance.new("Part")
	ring.Shape = Enum.PartType.Cylinder
	ring.Anchored = true
	ring.CanCollide = false
	ring.CanQuery = false
	ring.CanTouch = false
	ring.CastShadow = false
	ring.Material = Enum.Material.Neon
	ring.Color = color
	ring.Transparency = 0.2
	ring.Size = Vector3.new(0.4, 2, 2)
	ring.CFrame = CFrame.new(pos + Vector3.new(0, 0.3, 0)) * CFrame.Angles(0, 0, math.rad(90))
	ring.Parent = getFolder()
	local d = duration or 0.6
	tween(ring, d, { Size = Vector3.new(0.2, radius * 2, radius * 2), Transparency = 1 }, Enum.EasingStyle.Quint)
	Debris:AddItem(ring, d + 0.1)
end

-- Nuage de fumée « pouf ».
function Effects.Poof(pos: Vector3, size: number?)
	local p = anchorPart(pos)
	local s = size or 3
	local e = Instance.new("ParticleEmitter")
	e.Texture = TEX.Smoke
	e.Color = ColorSequence.new(Color3.fromRGB(240, 235, 245))
	e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, s), NumberSequenceKeypoint.new(1, s * 2.5) })
	e.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.2), NumberSequenceKeypoint.new(1, 1) })
	e.Speed = NumberRange.new(s * 2, s * 4)
	e.SpreadAngle = Vector2.new(180, 180)
	e.Lifetime = NumberRange.new(0.5, 0.9)
	e.Drag = 4
	e.Enabled = false
	e.Parent = p
	e:Emit(14)
	Debris:AddItem(p, 1.2)
end

-- Poussière au sol (atterrissage).
function Effects.Dust(pos: Vector3, size: number?)
	local p = anchorPart(pos + Vector3.new(0, 0.5, 0))
	local s = size or 3
	local e = Instance.new("ParticleEmitter")
	e.Texture = TEX.Smoke
	e.Color = ColorSequence.new(Color3.fromRGB(210, 190, 160))
	e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, s * 0.6), NumberSequenceKeypoint.new(1, s * 1.6) })
	e.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.4), NumberSequenceKeypoint.new(1, 1) })
	e.Speed = NumberRange.new(s * 3, s * 5)
	e.SpreadAngle = Vector2.new(5, 180)
	e.EmissionDirection = Enum.NormalId.Top
	e.Lifetime = NumberRange.new(0.6, 1)
	e.Drag = 5
	e.Acceleration = Vector3.new(0, -2, 0)
	e.Enabled = false
	e.Parent = p
	e:Emit(16)
	Debris:AddItem(p, 1.3)
end

-- Pilier de lumière vertical (éclosions rares, mutations, alarmes).
function Effects.Pillar(pos: Vector3, color: Color3, duration: number?)
	local pillar = Instance.new("Part")
	pillar.Shape = Enum.PartType.Cylinder
	pillar.Anchored = true
	pillar.CanCollide = false
	pillar.CanQuery = false
	pillar.CanTouch = false
	pillar.CastShadow = false
	pillar.Material = Enum.Material.Neon
	pillar.Color = color
	pillar.Transparency = 0.35
	pillar.Size = Vector3.new(220, 1, 1)
	pillar.CFrame = CFrame.new(pos + Vector3.new(0, 110, 0)) * CFrame.Angles(0, 0, math.rad(90))
	pillar.Parent = getFolder()
	local d = duration or 2
	tween(pillar, 0.3, { Size = Vector3.new(220, 7, 7) }, Enum.EasingStyle.Back)
	task.delay(d, function()
		tween(pillar, 0.5, { Size = Vector3.new(220, 0.2, 0.2), Transparency = 1 })
	end)
	Debris:AddItem(pillar, d + 0.6)
end

-- Texte BD flottant dans le monde (« BONK! », « TITAN! »…).
function Effects.FloatingText(pos: Vector3, text: string, color: Color3?, size: number?)
	local p = anchorPart(pos)
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromOffset(260 * (size or 1), 80 * (size or 1))
	gui.AlwaysOnTop = true
	gui.LightInfluence = 0
	gui.MaxDistance = 250
	gui.Parent = p
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.FontFace = Theme.Fonts.Impact
	label.TextScaled = true
	label.Text = text
	label.TextColor3 = color or Theme.Colors.Gold
	label.Rotation = math.random(-12, 12)
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 4
	stroke.Color = Theme.Colors.Ink
	stroke.Parent = label
	local scale = Instance.new("UIScale")
	scale.Scale = 0.2
	scale.Parent = label
	label.Parent = gui
	tween(scale, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
	tween(p, 1.4, { CFrame = CFrame.new(pos + Vector3.new(0, 5, 0)) })
	task.delay(0.9, function()
		tween(label, 0.4, { TextTransparency = 1 })
		tween(stroke, 0.4, { Transparency = 1 })
	end)
	Debris:AddItem(p, 1.5)
end

-- Étincelles permanentes attachées à une pièce.
function Effects.Sparkles(part: BasePart?, color: Color3, rate: number?): ParticleEmitter?
	if not part then
		return nil
	end
	local e = Instance.new("ParticleEmitter")
	e.Texture = TEX.Sparkle
	e.Color = ColorSequence.new(color)
	e.LightEmission = 1
	e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.6), NumberSequenceKeypoint.new(1, 0) })
	e.Speed = NumberRange.new(1, 3)
	e.SpreadAngle = Vector2.new(180, 180)
	e.Lifetime = NumberRange.new(0.8, 1.4)
	e.Rate = rate or 6
	e.Parent = part
	return e
end

-- Émetteur propre à chaque mutation.
function Effects.MutationEmitter(part: BasePart?, mutation: any, scale: number)
	if not part or not mutation then
		return
	end
	local s = scale
	local e = Instance.new("ParticleEmitter")
	e.LightEmission = 0.8
	e.Rate = 8
	e.SpreadAngle = Vector2.new(180, 180)
	e.Lifetime = NumberRange.new(1, 1.8)
	e.Speed = NumberRange.new(0.5 * s, 2 * s)
	e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.5 * s), NumberSequenceKeypoint.new(1, 0) })
	e.Color = ColorSequence.new(mutation.Color)
	e.Texture = TEX.Sparkle
	local kind = mutation.Particles
	if kind == "Drip" then
		e.Texture = TEX.Glow
		e.Acceleration = Vector3.new(0, -12, 0)
		e.Speed = NumberRange.new(0, 0.5)
		e.Size = NumberSequence.new(0.35 * s)
		e.Rate = 10
	elseif kind == "Toxic" then
		e.Texture = TEX.Smoke
		e.Acceleration = Vector3.new(0, 3, 0)
		e.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.5), NumberSequenceKeypoint.new(1, 1) })
		e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.8 * s), NumberSequenceKeypoint.new(1, 2 * s) })
		e.Rate = 6
	elseif kind == "Void" then
		e.Texture = TEX.Smoke
		e.LightEmission = 0
		e.Color = ColorSequence.new(Color3.fromRGB(40, 10, 60), Color3.fromRGB(120, 60, 200))
		e.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.3), NumberSequenceKeypoint.new(1, 1) })
		e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1 * s), NumberSequenceKeypoint.new(1, 2.5 * s) })
	elseif kind == "Rainbow" then
		e.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 80, 80)),
			ColorSequenceKeypoint.new(0.33, Color3.fromRGB(255, 240, 80)),
			ColorSequenceKeypoint.new(0.66, Color3.fromRGB(80, 220, 255)),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(220, 90, 255)),
		})
		e.Rate = 14
	elseif kind == "Stars" then
		e.Color = ColorSequence.new(Color3.fromRGB(200, 180, 255), Color3.fromRGB(255, 255, 255))
		e.Rate = 12
		e.Speed = NumberRange.new(0.2, 1)
	elseif kind == "Shine" then
		e.Rate = 5
		e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.5, 0.9 * s), NumberSequenceKeypoint.new(1, 0) })
	end
	e.Parent = part
end

-- Traînée de météore (feu + étincelles + trail).
function Effects.MeteorTrail(part: BasePart, color: Color3, width: number)
	local a0 = Instance.new("Attachment")
	a0.Position = Vector3.new(0, width * 0.4, 0)
	a0.Parent = part
	local a1 = Instance.new("Attachment")
	a1.Position = Vector3.new(0, -width * 0.4, 0)
	a1.Parent = part
	local trail = Instance.new("Trail")
	trail.Attachment0 = a0
	trail.Attachment1 = a1
	trail.Lifetime = 0.6
	trail.LightEmission = 1
	trail.FaceCamera = true
	trail.Color = ColorSequence.new(Color3.new(1, 1, 1), color)
	trail.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1) })
	trail.WidthScale = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, 0) })
	trail.Parent = part
	local fire = Instance.new("ParticleEmitter")
	fire.Texture = TEX.Fire
	fire.Color = ColorSequence.new(Color3.fromRGB(255, 240, 200), color)
	fire.LightEmission = 1
	fire.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, width * 0.9), NumberSequenceKeypoint.new(1, 0) })
	fire.Speed = NumberRange.new(1, 3)
	fire.Lifetime = NumberRange.new(0.3, 0.6)
	fire.Rate = 60
	fire.SpreadAngle = Vector2.new(20, 20)
	fire.Parent = part
	local sparks = Instance.new("ParticleEmitter")
	sparks.Texture = TEX.Spark
	sparks.Color = ColorSequence.new(color)
	sparks.LightEmission = 1
	sparks.Size = NumberSequence.new(0.5)
	sparks.Speed = NumberRange.new(4, 10)
	sparks.Lifetime = NumberRange.new(0.4, 0.8)
	sparks.Rate = 40
	sparks.SpreadAngle = Vector2.new(60, 60)
	sparks.Parent = part
	local light = Instance.new("PointLight")
	light.Color = color
	light.Range = 30
	light.Brightness = 3
	light.Parent = part
end

-- Explosion d'impact de météore.
function Effects.Impact(pos: Vector3, color: Color3, power: number)
	Effects.Shockwave(pos, color, 14 + power * 4, 0.7)
	Effects.Shockwave(pos, Color3.new(1, 1, 1), 8 + power * 2, 0.4)
	Effects.Burst(pos + Vector3.new(0, 2, 0), color, 30 + power * 6, 2 + power * 0.3)
	Effects.Dust(pos, 4 + power)
	local p = anchorPart(pos + Vector3.new(0, 1, 0))
	local e = Instance.new("ParticleEmitter")
	e.Texture = TEX.Spark
	e.Color = ColorSequence.new(Color3.fromRGB(255, 180, 90))
	e.LightEmission = 1
	e.Size = NumberSequence.new(0.6)
	e.Speed = NumberRange.new(20, 45)
	e.SpreadAngle = Vector2.new(70, 70)
	e.EmissionDirection = Enum.NormalId.Top
	e.Acceleration = Vector3.new(0, -60, 0)
	e.Lifetime = NumberRange.new(0.8, 1.4)
	e.Enabled = false
	e.Parent = p
	e:Emit(40 + power * 5)
	Debris:AddItem(p, 1.6)
end

return Effects
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="84">
            <Properties>
              <string name="Name">EventVisuals</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Ambiance des événements mondiaux (éclairage, météo, musique, annonces),
-- rendu du Colosse (boss) avec barre de vie, orbes de la Stampede.

local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Events = require(Shared.Config.Events)
local KaijuBuilder = require(Shared.KaijuBuilder)
local Theme = require(Shared.Config.Theme)
local Format = require(Shared.Logic.Format)

local Controllers = script.Parent.Parent.Controllers
local State = require(Controllers.State)
local Remote = require(Controllers.Remote)
local Audio = require(Controllers.Audio)
local FxBus = require(Controllers.FxBus)
local CameraFx = require(Controllers.CameraFx)
local UIRegistry = require(Controllers.UIRegistry)
local Effects = require(script.Parent.Effects)
local Kit = require(script.Parent.Parent.UI.Kit)

local C = Theme.Colors
local player = Players.LocalPlayer

local EventVisuals = {}

local DEFAULT = {
	ClockTime = 15.2,
	Ambient = Color3.fromRGB(70, 60, 90),
	Tint = Color3.fromRGB(255, 248, 240),
	FogColor = Color3.fromRGB(200, 220, 255),
	FogEnd = 4000,
}

local weather: Part
local emitters: { ParticleEmitter } = {}
local skyParts: { BasePart } = {}
local currentId: string? = nil

----------------------------------------------------------------------------
-- Éclairage et météo
----------------------------------------------------------------------------

local function applyLighting(cfg)
	local info = TweenInfo.new(3, Enum.EasingStyle.Sine)
	TweenService:Create(Lighting, info, {
		ClockTime = cfg.ClockTime or DEFAULT.ClockTime,
		Ambient = cfg.Ambient or DEFAULT.Ambient,
		FogColor = cfg.FogColor or DEFAULT.FogColor,
		FogEnd = cfg.FogEnd or DEFAULT.FogEnd,
	}):Play()
	local grade = Lighting:FindFirstChild("Grade")
	if grade then
		TweenService:Create(grade, info, { TintColor = cfg.Tint or DEFAULT.Tint }):Play()
	end
end

local function clearWeather()
	for _, e in emitters do
		e.Enabled = false
		task.delay(3, function()
			e:Destroy()
		end)
	end
	table.clear(emitters)
	for _, p in skyParts do
		TweenService:Create(p, TweenInfo.new(2), { Transparency = 1 }):Play()
		task.delay(2.1, function()
			p:Destroy()
		end)
	end
	table.clear(skyParts)
end

local function addEmitter(props): ParticleEmitter
	local e = Instance.new("ParticleEmitter")
	for k, v in props do
		e[k] = v
	end
	e.Parent = weather
	table.insert(emitters, e)
	return e
end

local function lowFx(): boolean
	local s = State.Get("Settings")
	return s ~= nil and s.LowFx == true
end

local function startWeather(id: string)
	clearWeather()
	if lowFx() then
		return
	end
	local sparkle = Effects.Textures.Sparkle
	if id == "BloodMoon" then
		addEmitter({ Texture = Effects.Textures.Spark, Color = ColorSequence.new(Color3.fromRGB(255, 60, 60)), LightEmission = 1, Rate = 60, Lifetime = NumberRange.new(4, 6), Speed = NumberRange.new(4, 8), EmissionDirection = Enum.NormalId.Bottom, Size = NumberSequence.new(0.5), SpreadAngle = Vector2.new(30, 30) })
		-- lune de sang géante
		local moon = Instance.new("Part")
		moon.Shape = Enum.PartType.Ball
		moon.Size = Vector3.new(160, 160, 160)
		moon.Anchored = true
		moon.CanCollide = false
		moon.CanQuery = false
		moon.CanTouch = false
		moon.Material = Enum.Material.Neon
		moon.Color = Color3.fromRGB(220, 30, 40)
		moon.Transparency = 1
		moon.CFrame = CFrame.new(400, 520, -900)
		moon.Parent = Workspace
		TweenService:Create(moon, TweenInfo.new(3), { Transparency = 0.1 }):Play()
		table.insert(skyParts, moon)
	elseif id == "Radioactive" then
		addEmitter({ Texture = Effects.Textures.Glow, Color = ColorSequence.new(Color3.fromRGB(120, 255, 80)), LightEmission = 0.6, Rate = 220, Lifetime = NumberRange.new(1.2, 1.6), Speed = NumberRange.new(60, 80), EmissionDirection = Enum.NormalId.Bottom, Size = NumberSequence.new(0.25), SpreadAngle = Vector2.new(8, 8), Transparency = NumberSequence.new(0.3) })
		addEmitter({ Texture = Effects.Textures.Smoke, Color = ColorSequence.new(Color3.fromRGB(80, 200, 60)), Rate = 4, Lifetime = NumberRange.new(6, 8), Speed = NumberRange.new(2, 4), Size = NumberSequence.new(30), Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.85), NumberSequenceKeypoint.new(1, 1) }) })
	elseif id == "Aurora" then
		addEmitter({ Texture = sparkle, Color = ColorSequence.new(Color3.fromRGB(150, 120, 255), Color3.fromRGB(80, 255, 230)), LightEmission = 1, Rate = 40, Lifetime = NumberRange.new(4, 6), Speed = NumberRange.new(1, 3), Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.5, 0.8), NumberSequenceKeypoint.new(1, 0) }), SpreadAngle = Vector2.new(180, 180) })
		for i = 1, 6 do
			local band = Instance.new("Part")
			band.Anchored = true
			band.CanCollide = false
			band.CanQuery = false
			band.CanTouch = false
			band.Material = Enum.Material.Neon
			band.Color = Color3.fromHSV(0.45 + i * 0.05, 0.7, 1)
			band.Transparency = 1
			band.Size = Vector3.new(900, 60, 2)
			band.CFrame = CFrame.new(0, 420 + i * 25, -300 + i * 90) * CFrame.Angles(math.rad(70), math.rad(i * 12), 0)
			band.Parent = Workspace
			TweenService:Create(band, TweenInfo.new(4), { Transparency = 0.7 }):Play()
			table.insert(skyParts, band)
		end
	elseif id == "GoldenHour" then
		addEmitter({ Texture = sparkle, Color = ColorSequence.new(Color3.fromRGB(255, 220, 90)), LightEmission = 1, Rate = 50, Lifetime = NumberRange.new(3, 5), Speed = NumberRange.new(1, 3), Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.5, 0.6), NumberSequenceKeypoint.new(1, 0) }), SpreadAngle = Vector2.new(180, 180) })
	elseif id == "MeteorShower" then
		addEmitter({ Texture = Effects.Textures.Spark, Color = ColorSequence.new(Color3.fromRGB(255, 200, 120)), LightEmission = 1, Rate = 12, Lifetime = NumberRange.new(1, 1.5), Speed = NumberRange.new(120, 180), EmissionDirection = Enum.NormalId.Bottom, Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 2), NumberSequenceKeypoint.new(1, 0) }), SpreadAngle = Vector2.new(40, 40), Orientation = Enum.ParticleOrientation.VelocityParallel })
	end
end

local function onEventChanged()
	local id = Workspace:GetAttribute("EventId")
	if id == currentId then
		return
	end
	currentId = id
	local event = id and Events.ById[id]
	if event then
		applyLighting(event.Lighting)
		startWeather(event.Id)
		Audio.Music(event.Music or "music_main")
	else
		applyLighting(DEFAULT)
		clearWeather()
		Audio.Music("music_main")
	end
end

----------------------------------------------------------------------------
-- Boss
----------------------------------------------------------------------------

local boss: Model? = nil
local bossAnchor: BasePart? = nil
local bossBar: Frame? = nil
local setBossBar: ((number, boolean?) -> ())? = nil
local bossJump = 0
local bossSpawnAt = 0

local function buildBossBar()
	local layer = Kit.Layer("BossBar", 8)
	local holder = Kit.new("Frame", {
		Size = UDim2.fromOffset(620, 70),
		Position = UDim2.new(0.5, 0, 0, 130),
		AnchorPoint = Vector2.new(0.5, 0),
		BackgroundTransparency = 1,
		Visible = false,
		Parent = layer,
	})
	Kit.AutoScale(holder)
	Kit.Text({ Name = "Title", Size = UDim2.new(1, 0, 0, 32), Text = "👹 THE COLOSSUS", FontFace = Kit.Fonts.Impact, TextColor3 = C.Pink, Stroke = 3, Parent = holder })
	local _, set = Kit.ProgressBar({ Size = UDim2.new(1, 0, 0, 26), Position = UDim2.fromOffset(0, 38), Color = "Red", Parent = holder })
	Kit.Text({ Name = "HP", Size = UDim2.new(1, 0, 0, 22), Position = UDim2.fromOffset(0, 40), Text = "", FontFace = Kit.Fonts.Title, ZIndex = 20, Parent = holder })
	bossBar = holder
	setBossBar = set
end

local function trackBoss(anchor: BasePart)
	bossAnchor = anchor
	local model = KaijuBuilder.Build(anchor:GetAttribute("Species") or "KingKaiju", anchor:GetAttribute("Mutation"), anchor:GetAttribute("Scale") or 7)
	model.Name = "BossModel"
	model.Parent = Workspace
	boss = model
	-- entrée dramatique : sort du sol
	model:PivotTo(anchor.CFrame * CFrame.new(0, -40, 0))
	bossSpawnAt = os.clock()
	Audio.Play("roar_big", { Volume = 1.5 })
	CameraFx.Shake(1.5, 2)
	if bossBar then
		bossBar.Visible = true
		Kit.Pop(bossBar)
	end
end

local function untrackBoss()
	if boss then
		local model = boss
		boss = nil
		local pos = model:GetPivot().Position
		Effects.Impact(pos, C.Pink, 10)
		model:Destroy()
	end
	bossAnchor = nil
	if bossBar then
		bossBar.Visible = false
	end
end

----------------------------------------------------------------------------
-- Orbes
----------------------------------------------------------------------------

local orbs: { [BasePart]: BasePart } = {}
local grabbed: { [string]: boolean } = {}

local function trackOrb(anchor: BasePart)
	local orb = Instance.new("Part")
	orb.Shape = Enum.PartType.Ball
	orb.Size = Vector3.new(2.6, 2.6, 2.6)
	orb.Material = Enum.Material.Neon
	orb.Color = C.Cash
	orb.Anchored = true
	orb.CanCollide = false
	orb.CanQuery = false
	orb.CanTouch = false
	orb.CFrame = anchor.CFrame
	orb.Parent = Workspace
	local light = Instance.new("PointLight")
	light.Color = C.Cash
	light.Range = 10
	light.Parent = orb
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromOffset(60, 60)
	gui.LightInfluence = 0
	gui.MaxDistance = 120
	gui.Parent = orb
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Text = "💵"
	label.TextScaled = true
	label.Parent = gui
	Effects.Sparkles(orb, C.Cash, 6)
	orbs[anchor] = orb
end

local function untrackOrb(anchor: Instance)
	local orb = orbs[anchor :: BasePart]
	if orb then
		orbs[anchor :: BasePart] = nil
		Effects.Burst(orb.Position, C.Cash, 12, 1.5)
		orb:Destroy()
	end
end

----------------------------------------------------------------------------

function EventVisuals.Init()
	weather = Instance.new("Part")
	weather.Name = "Weather"
	weather.Anchored = true
	weather.CanCollide = false
	weather.CanQuery = false
	weather.CanTouch = false
	weather.Transparency = 1
	weather.Size = Vector3.new(180, 1, 180)
	weather.Parent = Workspace

	buildBossBar()

	Workspace:GetAttributeChangedSignal("EventId"):Connect(onEventChanged)
	onEventChanged()
	if not Workspace:GetAttribute("EventId") then
		Audio.Music("music_main")
	end

	FxBus.On("EventStart", function(args)
		local event = Events.ById[args.Id or ""]
		if event then
			Audio.Play("event_horn")
			UIRegistry.Announce(event.Icon .. " " .. event.Name, event.Color, event.Tagline)
			CameraFx.Shake(0.5, 1)
		end
	end)
	FxBus.On("EventEnd", function(args)
		local event = Events.ById[args.Id or ""]
		if event then
			UIRegistry.Toast(event.Name .. " is over!", "Info")
		end
	end)

	local effects = Workspace:WaitForChild("Effects")
	effects.ChildAdded:Connect(function(child)
		if child.Name == "Boss" and child:IsA("BasePart") then
			task.wait()
			trackBoss(child)
		end
	end)
	effects.ChildRemoved:Connect(function(child)
		if child == bossAnchor then
			untrackBoss()
		end
	end)
	local existing = effects:FindFirstChild("Boss")
	if existing and existing:IsA("BasePart") then
		trackBoss(existing)
	end

	FxBus.On("BossHit", function(args)
		if boss then
			local pos = boss:GetPivot().Position + Vector3.new(math.random(-12, 12), math.random(4, 18), math.random(-12, 12))
			Effects.FloatingText(pos, "-" .. Format.Short(args.Damage or 0), if args.UserId == player.UserId then C.Gold else C.Paper, 0.7)
			if args.UserId == player.UserId then
				Effects.Burst(pos, C.Pink, 10, 2)
			end
		end
	end)
	FxBus.On("BossStomp", function()
		bossJump = os.clock()
		task.delay(0.8, function()
			if boss then
				local pos = boss:GetPivot().Position
				Effects.Shockwave(pos, C.Pink, 50, 0.8)
				Effects.Dust(pos, 12)
				Audio.Play("boss_stomp", { Volume = 1.3 })
				CameraFx.ShakeAt(pos, 2, 220, 0.7)
			end
		end)
	end)
	FxBus.On("BossSpawn", function()
		UIRegistry.Announce("👹 THE COLOSSUS AWAKENS!", C.Pink, "Everyone to the crater — BONK IT!", "roar_big")
	end)
	FxBus.On("BossEnd", function(args)
		if args.Defeated then
			UIRegistry.Announce("COLOSSUS DEFEATED!", C.Gold, "Rewards sent to all fighters!", "heist_success")
		end
	end)

	RunService.RenderStepped:Connect(function()
		local camera = Workspace.CurrentCamera
		if camera then
			weather.CFrame = CFrame.new(camera.CFrame.Position + Vector3.new(0, 60, 0))
		end
		if boss and bossAnchor then
			local t = os.clock()
			local jump = t - bossJump
			local y = 0
			if jump < 0.8 then
				y = math.sin(jump / 0.8 * math.pi) * 14
			end
			local rise = math.clamp((t - bossSpawnAt) / 2.5, 0, 1)
			if rise < 1 then
				y = -40 * (1 - rise) ^ 2
			end
			-- regarde le joueur le plus proche (le local, pour le frisson)
			local character = player.Character
			local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
			local look = if root then Vector3.new(root.Position.X, 0, root.Position.Z) else Vector3.new(0, 0, -1)
			local base = bossAnchor.Position
			local cf = CFrame.lookAt(base, Vector3.new(look.X, base.Y, look.Z) + Vector3.new(0.01, 0, 0))
			boss:PivotTo(cf * CFrame.new(0, y + math.sin(t * 1.5) * 0.6, 0) * CFrame.Angles(0, 0, math.sin(t * 0.8) * 0.03))
			local hp = bossAnchor:GetAttribute("HP") or 0
			local maxHp = bossAnchor:GetAttribute("MaxHP") or 1
			if setBossBar then
				setBossBar(hp / maxHp, true)
			end
			if bossBar then
				local label = bossBar:FindFirstChild("HP") :: TextLabel?
				if label then
					label.Text = ("%s / %s"):format(Format.Short(hp), Format.Short(maxHp))
				end
			end
		end
		-- orbes : animation + ramassage par proximité
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
		for anchor, orb in orbs do
			local t = os.clock()
			orb.CFrame = anchor.CFrame * CFrame.new(0, math.sin(t * 3 + anchor.Position.X) * 0.6, 0)
			if root and (root.Position - orb.Position).Magnitude < 7 then
				local id = anchor:GetAttribute("Id")
				if id and not grabbed[id] then
					grabbed[id] = true
					Remote.Input("Orb", { Id = id })
					Audio.Play("coin_tick", { Pitch = 1.2 })
				end
			end
		end
	end)

	local orbFolder = Workspace:WaitForChild("Orbs")
	orbFolder.ChildAdded:Connect(function(child)
		if child:IsA("BasePart") then
			trackOrb(child)
		end
	end)
	orbFolder.ChildRemoved:Connect(untrackOrb)
	FxBus.On("StampedeWave", function()
		Audio.Play("roar_small", { Pitch = 0.8 })
	end)
end

return EventVisuals
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="85">
            <Properties>
              <string name="Name">Guide</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Guide : chevrons lumineux au sol du joueur vers une cible + gros marqueur
-- rebondissant au-dessus de la cible. Utilisé par le tutoriel et pendant un vol.
--   local g = Guide.new(color) ; g:Point(targetPositionOrPart) ; g:Hide()

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Theme = require(Shared.Config.Theme)

local Guide = {}
Guide.__index = Guide

local CHEVRONS = 7
local player = Players.LocalPlayer

local function chevron(color: Color3, parent: Instance): Model
	local model = Instance.new("Model")
	for _, side in { -1, 1 } do
		local p = Instance.new("Part")
		p.Anchored = true
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
		p.CastShadow = false
		p.Material = Enum.Material.Neon
		p.Color = color
		p.Size = Vector3.new(0.6, 0.3, 2.4)
		p:SetAttribute("Side", side)
		p.Parent = model
	end
	model.Parent = parent
	return model
end

function Guide.new(color: Color3?)
	local folder = Instance.new("Folder")
	folder.Name = "Guide"
	folder.Parent = Workspace
	local self = setmetatable({
		Folder = folder,
		Color = color or Theme.Colors.Radioactive,
		Target = nil :: any,
		Chevrons = {},
		Marker = nil :: BillboardGui?,
		MarkerPart = nil :: BasePart?,
		Conn = nil :: RBXScriptConnection?,
	}, Guide)
	for i = 1, CHEVRONS do
		self.Chevrons[i] = chevron(self.Color, folder)
	end
	local markerPart = Instance.new("Part")
	markerPart.Anchored = true
	markerPart.CanCollide = false
	markerPart.CanQuery = false
	markerPart.CanTouch = false
	markerPart.Transparency = 1
	markerPart.Size = Vector3.new(1, 1, 1)
	markerPart.Parent = folder
	local marker = Instance.new("BillboardGui")
	marker.Size = UDim2.fromOffset(90, 90)
	marker.AlwaysOnTop = true
	marker.LightInfluence = 0
	marker.Parent = markerPart
	local arrow = Instance.new("TextLabel")
	arrow.BackgroundTransparency = 1
	arrow.Size = UDim2.fromScale(1, 1)
	arrow.Text = "⬇️"
	arrow.TextScaled = true
	arrow.Parent = marker
	self.Marker = marker
	self.MarkerPart = markerPart
	self:Hide()
	return self
end

local function targetPosition(target: any): Vector3?
	if typeof(target) == "Vector3" then
		return target
	elseif typeof(target) == "Instance" then
		if target:IsA("BasePart") then
			return target.Position
		elseif target:IsA("Model") then
			return target:GetPivot().Position
		end
	end
	return nil
end

function Guide:Point(target: any)
	self.Target = target
	self.Folder.Parent = Workspace
	if self.Conn then
		return
	end
	self.Conn = RunService.RenderStepped:Connect(function()
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
		local goal = targetPosition(self.Target)
		if not root or not goal then
			for _, c in self.Chevrons do
				for _, p in c:GetChildren() do
					p.Transparency = 1
				end
			end
			return
		end
		local t = os.clock()
		local from = Vector3.new(root.Position.X, root.Position.Y - 2.6, root.Position.Z)
		local to = Vector3.new(goal.X, from.Y, goal.Z)
		local delta = to - from
		local dist = delta.Magnitude
		local dir = if dist > 0.1 then delta.Unit else Vector3.new(0, 0, -1)
		local span = math.min(dist - 3, 40)
		for i, c in self.Chevrons do
			local a = ((i - 1) / CHEVRONS + t * 0.6) % 1
			local pos = from + dir * (3 + a * math.max(span, 0))
			local fade = math.sin(a * math.pi)
			local base = CFrame.lookAt(pos, pos + dir)
			for _, p in c:GetChildren() do
				local side = p:GetAttribute("Side")
				p.CFrame = base * CFrame.new(side * 0.7, 0, 0) * CFrame.Angles(0, math.rad(40 * side), 0)
				p.Transparency = if dist < 6 then 1 else 1 - fade * 0.85
			end
		end
		self.MarkerPart.CFrame = CFrame.new(goal + Vector3.new(0, 9 + math.sin(t * 5) * 1.2, 0))
	end)
end

function Guide:Hide()
	self.Target = nil
	if self.Conn then
		self.Conn:Disconnect()
		self.Conn = nil
	end
	self.Folder.Parent = nil
end

return Guide
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="86">
            <Properties>
              <string name="Name">KaijuRenderer</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Rendu local des kaijus à partir des ancres serveur (workspace.Kaijus).
-- Construit le modèle 3D, l'anime (respiration, tête, queue, ailes…),
-- l'affiche porté au-dessus des voleurs, gère étiquettes, auras de rareté,
-- effets de mutation et les prompts (Voler / Aider / Gérer).

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local KaijuBuilder = require(Shared.KaijuBuilder)
local Kaijus = require(Shared.Config.Kaijus)
local Rarities = require(Shared.Config.Rarities)
local Mutations = require(Shared.Config.Mutations)
local Growth = require(Shared.Config.Growth)
local Theme = require(Shared.Config.Theme)
local Format = require(Shared.Logic.Format)

local Controllers = script.Parent.Parent.Controllers
local State = require(Controllers.State)
local Remote = require(Controllers.Remote)
local Audio = require(Controllers.Audio)
local FxBus = require(Controllers.FxBus)
local CameraFx = require(Controllers.CameraFx)
local UIRegistry = require(Controllers.UIRegistry)
local Effects = require(script.Parent.Effects)

local C = Theme.Colors
local player = Players.LocalPlayer

local KaijuRenderer = {}

type Entry = {
	Anchor: BasePart,
	Model: Model?,
	Parts: { BasePart },
	Offsets: { CFrame },
	Roles: { string },
	Phases: { number },
	Pivots: { [string]: Vector3 },
	RainbowParts: { BasePart },
	Key: string,
	Scale: number,
	Height: number,
	Label: BillboardGui?,
	Prompt: ProximityPrompt?,
	PromptAttachment: Attachment?,
	Current: CFrame?,
	FlyFrom: CFrame?,
	FlyStart: number,
	WasCarried: boolean,
	Phase: number,
	LastStage: number,
	WasEgg: boolean,
	Aura: BasePart?,
	Parked: CFrame?,
}

local entries: { [BasePart]: Entry } = {}
local byUid: { [string]: Entry } = {}
local folder: Folder
local ANIM_DISTANCE = 170

local function now(): number
	return Workspace:GetServerTimeNow()
end

local function characterOf(userId: number): Model?
	local p = Players:GetPlayerByUserId(userId)
	return p and p.Character
end

local function plotShielded(plotIndex: number): boolean
	local map = Workspace:FindFirstChild("Map")
	local plot = map and map:FindFirstChild("Plot" .. plotIndex)
	if not plot then
		return false
	end
	local t = now()
	return (plot:GetAttribute("ShieldUntil") or 0) > t or (plot:GetAttribute("ProtectedUntil") or 0) > t
end

----------------------------------------------------------------------------
-- Construction
----------------------------------------------------------------------------

local function keyOf(anchor: BasePart): string
	return table.concat({
		tostring(anchor:GetAttribute("Egg")),
		anchor:GetAttribute("Rarity") or "",
		anchor:GetAttribute("Species") or "",
		anchor:GetAttribute("Mutation") or "",
		tostring(anchor:GetAttribute("Stage") or 1),
	}, "|")
end

local function lowFx(): boolean
	local s = State.Get("Settings")
	return s ~= nil and s.LowFx == true
end

local function addAura(entry: Entry, rarity: Rarities.Rarity, scale: number)
	if entry.Aura then
		entry.Aura:Destroy()
		entry.Aura = nil
	end
	if rarity.Order < 4 or not entry.Model then
		return
	end
	local ring = Instance.new("Part")
	ring.Name = "Aura"
	ring.Shape = Enum.PartType.Cylinder
	ring.Anchored = true
	ring.CanCollide = false
	ring.CanQuery = false
	ring.CanTouch = false
	ring.CastShadow = false
	ring.Material = Enum.Material.Neon
	ring.Color = rarity.Color
	ring.Transparency = 0.7
	ring.Size = Vector3.new(0.15, 4.2 + 2.2 * scale, 4.2 + 2.2 * scale)
	ring.Parent = entry.Model
	entry.Aura = ring
	if rarity.Order >= 6 and not lowFx() then
		local pillar = Instance.new("Part")
		pillar.Name = "Pillar"
		pillar.Shape = Enum.PartType.Cylinder
		pillar.Anchored = true
		pillar.CanCollide = false
		pillar.CanQuery = false
		pillar.CanTouch = false
		pillar.CastShadow = false
		pillar.Material = Enum.Material.Neon
		pillar.Color = rarity.Glow
		pillar.Transparency = 0.82
		pillar.Size = Vector3.new(80, 3 * scale, 3 * scale)
		pillar.Parent = ring
		pillar:SetAttribute("Pillar", true)
	end
end

local function buildLabel(entry: Entry)
	if entry.Label then
		entry.Label:Destroy()
	end
	local anchor = entry.Anchor
	local gui = Instance.new("BillboardGui")
	gui.Name = "KaijuLabel"
	gui.Size = UDim2.fromOffset(220, 74)
	gui.MaxDistance = 75
	gui.LightInfluence = 0
	gui.AlwaysOnTop = false
	gui.StudsOffsetWorldSpace = Vector3.new(0, entry.Height + 1.5, 0)
	gui.Adornee = anchor
	local function text(name: string, y: number, h: number, font: Font, color: Color3, stroke: number): TextLabel
		local t = Instance.new("TextLabel")
		t.Name = name
		t.BackgroundTransparency = 1
		t.Size = UDim2.new(1, 0, 0, h)
		t.Position = UDim2.fromOffset(0, y)
		t.FontFace = font
		t.TextScaled = true
		t.RichText = true
		t.TextColor3 = color
		t.Text = ""
		local s = Instance.new("UIStroke")
		s.Thickness = stroke
		s.Color = C.Ink
		s.Parent = t
		t.Parent = gui
		return t
	end
	text("Name", 0, 30, Theme.Fonts.Title, C.White, 2.5)
	text("Info", 30, 22, Theme.Fonts.Body, C.Cash, 2)
	local bar = Instance.new("Frame")
	bar.Name = "Bar"
	bar.Size = UDim2.new(0.7, 0, 0, 9)
	bar.Position = UDim2.new(0.15, 0, 0, 57)
	bar.BackgroundColor3 = C.Ink
	bar.BorderSizePixel = 0
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(1, 0)
	corner.Parent = bar
	local fill = Instance.new("Frame")
	fill.Name = "Fill"
	fill.Size = UDim2.fromScale(0.5, 1)
	fill.BackgroundColor3 = C.Radioactive
	fill.BorderSizePixel = 0
	corner:Clone().Parent = fill
	fill.Parent = bar
	bar.Parent = gui
	gui.Parent = folder
	entry.Label = gui
end

local function rebuild(entry: Entry)
	local anchor = entry.Anchor
	if entry.Model then
		entry.Model:Destroy()
	end
	local isEgg = anchor:GetAttribute("Egg") == true
	local stage = anchor:GetAttribute("Stage") or 1
	local scale = if isEgg then 1 else Growth.Get(stage).Scale
	local model
	if isEgg then
		model = KaijuBuilder.BuildEgg(anchor:GetAttribute("Rarity") or "Common", 1)
		entry.Height = 2.8
	else
		local species = anchor:GetAttribute("Species") or "Toastzilla"
		local mutation = anchor:GetAttribute("Mutation")
		model = KaijuBuilder.Build(species, if mutation ~= "" then mutation else nil, scale)
		entry.Height = KaijuBuilder.Height(species) * scale
	end
	entry.Scale = scale
	entry.Model = model
	entry.Parts = {}
	entry.Offsets = {}
	entry.Roles = {}
	entry.Phases = {}
	entry.RainbowParts = {}
	local sums: { [string]: Vector3 } = {}
	local counts: { [string]: number } = {}
	for _, p in model:GetDescendants() do
		if p:IsA("BasePart") and p.Name ~= "Root" then
			table.insert(entry.Parts, p)
			table.insert(entry.Offsets, p.CFrame)
			local role = p:GetAttribute("Role") or ""
			table.insert(entry.Roles, role)
			table.insert(entry.Phases, p:GetAttribute("Phase") or 0)
			if role ~= "" then
				sums[role] = (sums[role] or Vector3.zero) + p.Position
				counts[role] = (counts[role] or 0) + 1
			end
			if p:GetAttribute("Rainbow") then
				table.insert(entry.RainbowParts, p)
			end
		end
	end
	entry.Pivots = {}
	for role, sum in sums do
		entry.Pivots[role] = sum / counts[role]
	end
	-- pivots explicites (ailes)
	for _, p in model:GetDescendants() do
		local pv = p:GetAttribute("Pivot")
		if typeof(pv) == "Vector3" then
			entry.Pivots[p:GetAttribute("Role")] = pv * scale
		end
	end
	if entry.Pivots.Tail then
		-- la queue pivote depuis son attache (le point le plus proche du corps)
		local best = nil
		for i, p in entry.Parts do
			if entry.Roles[i] == "Tail" and (not best or p.Position.Z < best.Z) then
				best = p.Position
			end
		end
		entry.Pivots.Tail = best
	end
	model.Parent = folder
	entry.Key = keyOf(anchor)
	entry.Parked = nil

	if not isEgg then
		local rarity = Rarities.Get(anchor:GetAttribute("Rarity") or "Common")
		addAura(entry, rarity, scale)
		local mutation = Mutations.Get(anchor:GetAttribute("Mutation"))
		if mutation and mutation.Particles and not lowFx() then
			Effects.MutationEmitter(model.PrimaryPart, mutation, scale)
		end
		if model:GetAttribute("FxStars") and not lowFx() then
			Effects.MutationEmitter(model.PrimaryPart, Mutations.Get("Galaxy") :: any, scale)
		end
	else
		local rarity = Rarities.Get(anchor:GetAttribute("Rarity") or "Common")
		if rarity.Order >= 3 and not lowFx() then
			Effects.Sparkles(model.PrimaryPart, rarity.Glow, 3 + rarity.Order)
		end
	end
	buildLabel(entry)
	if entry.PromptAttachment then
		entry.PromptAttachment.Position = Vector3.new(0, math.max(2.5, entry.Height * 0.55), 0)
	end
end

----------------------------------------------------------------------------
-- Prompts
----------------------------------------------------------------------------

local function refreshPrompt(entry: Entry)
	local prompt = entry.Prompt
	if not prompt then
		return
	end
	local anchor = entry.Anchor
	local owner = anchor:GetAttribute("Owner") or 0
	local isEgg = anchor:GetAttribute("Egg") == true
	local carriedBy = anchor:GetAttribute("CarriedBy") or 0
	local stage = anchor:GetAttribute("Stage") or 1
	local species = Kaijus.Get(anchor:GetAttribute("Species") or "")
	prompt.ObjectText = if isEgg then (Rarities.Get(anchor:GetAttribute("Rarity") or "Common").Name .. " Egg") elseif species then species.Name else ""
	prompt.MaxActivationDistance = 9 + Growth.Get(stage).Scale * 3
	if owner == player.UserId then
		prompt.ActionText = if isEgg then "Egg info" else "Manage"
		prompt.HoldDuration = 0
		prompt.Enabled = carriedBy == 0
		prompt:SetAttribute("Kind", "Manage")
		prompt:SetAttribute("Color", "Cyan")
	else
		if anchor:GetAttribute("Lifting") and carriedBy ~= player.UserId and (anchor:GetAttribute("Helper") or 0) == 0 then
			prompt.ActionText = "HELP LIFT 🤝"
			prompt.HoldDuration = 0
			prompt.Enabled = true
			prompt.MaxActivationDistance = 24
			prompt:SetAttribute("Kind", "Help")
			prompt:SetAttribute("Color", "Gold")
		elseif carriedBy ~= 0 or isEgg then
			prompt.Enabled = false
		else
			local shielded = plotShielded(anchor:GetAttribute("Plot") or 0)
			prompt.ActionText = if shielded then "🛡️ SHIELDED" else (if Growth.Get(stage).Carriers > 1 then "STEAL (2 players)" else "STEAL")
			prompt.HoldDuration = if shielded then 0 else 0.5 + stage * 0.15
			prompt.Enabled = true
			prompt:SetAttribute("Kind", if shielded then "Blocked" else "Steal")
			prompt:SetAttribute("Color", if shielded then "Grey" else "Red")
		end
	end
end

local function makePrompt(entry: Entry)
	local attachment = Instance.new("Attachment")
	attachment.Name = "PromptPoint"
	attachment.Position = Vector3.new(0, math.max(2.5, entry.Height * 0.55), 0)
	attachment.Parent = entry.Anchor
	local prompt = Instance.new("ProximityPrompt")
	prompt.Style = Enum.ProximityPromptStyle.Custom
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.RequiresLineOfSight = false
	prompt.Parent = attachment
	entry.Prompt = prompt
	entry.PromptAttachment = attachment
	prompt.Triggered:Connect(function()
		local kind = prompt:GetAttribute("Kind")
		local uid = entry.Anchor:GetAttribute("Uid")
		if kind == "Manage" then
			UIRegistry.OpenKaiju(uid)
		elseif kind == "Steal" then
			Remote.Call("Steal", { Uid = uid })
		elseif kind == "Help" then
			Remote.Call("Help", { Uid = uid })
		elseif kind == "Blocked" then
			Audio.Play("shield_zap")
			UIRegistry.Toast("This base is shielded! Wait for it to drop 🛡️", "Bad")
		end
	end)
	refreshPrompt(entry)
end

----------------------------------------------------------------------------
-- Cycle de vie des ancres
----------------------------------------------------------------------------

local function track(anchor: BasePart)
	if entries[anchor] then
		return
	end
	local entry: Entry = {
		Anchor = anchor,
		Model = nil,
		Parts = {},
		Offsets = {},
		Roles = {},
		Phases = {},
		Pivots = {},
		RainbowParts = {},
		Key = "",
		Scale = 1,
		Height = 4,
		Label = nil,
		Prompt = nil,
		PromptAttachment = nil,
		Current = nil,
		FlyFrom = nil,
		FlyStart = 0,
		WasCarried = false,
		Phase = math.random() * 10,
		LastStage = anchor:GetAttribute("Stage") or 1,
		WasEgg = anchor:GetAttribute("Egg") == true,
		Aura = nil,
		Parked = nil,
	}
	entries[anchor] = entry
	byUid[anchor:GetAttribute("Uid") or anchor.Name] = entry
	rebuild(entry)
	makePrompt(entry)
	-- apparition : petit pop
	entry.FlyFrom = anchor.CFrame * CFrame.new(0, 12, 0)
	entry.FlyStart = os.clock()

	anchor.AttributeChanged:Connect(function(attr)
		if attr == "Egg" or attr == "Species" or attr == "Mutation" or attr == "Stage" or attr == "Rarity" then
			if keyOf(anchor) ~= entry.Key then
				local wasEgg = entry.WasEgg
				local stage = anchor:GetAttribute("Stage") or 1
				rebuild(entry)
				local pos = anchor.Position + Vector3.new(0, entry.Height / 2, 0)
				if wasEgg and not anchor:GetAttribute("Egg") then
					local rarity = Rarities.Get(anchor:GetAttribute("Rarity") or "Common")
					Effects.Burst(pos, rarity.Glow, 30 + rarity.Order * 10, entry.Scale * 3)
					Effects.Shockwave(anchor.Position, rarity.Color, 16, 0.6)
					Audio.Play("egg_crack", { Parent = anchor })
				elseif stage > entry.LastStage then
					Effects.Burst(pos, C.Radioactive, 40, entry.Scale * 3)
					Effects.Shockwave(anchor.Position, C.Radioactive, 10 + entry.Scale * 6, 0.7)
					Effects.FloatingText(pos + Vector3.new(0, entry.Height / 2 + 2, 0), string.upper(Growth.Get(stage).Name) .. "!", C.Radioactive)
					Audio.Play("stage_up", { Parent = anchor })
					if stage >= 4 then
						Audio.Play("roar_big", { Parent = anchor, MaxDistance = 400 })
						CameraFx.ShakeAt(anchor.Position, 1.2, 160, 0.8)
					else
						Audio.Play("roar_small", { Parent = anchor })
					end
				elseif attr == "Mutation" then
					local mutation = Mutations.Get(anchor:GetAttribute("Mutation"))
					if mutation then
						Effects.Burst(pos, mutation.Color, 60, entry.Scale * 3)
						Effects.FloatingText(pos + Vector3.new(0, entry.Height / 2 + 2, 0), string.upper(mutation.Name) .. "!", mutation.Color)
					end
				end
				entry.WasEgg = anchor:GetAttribute("Egg") == true
				entry.LastStage = stage
			end
		end
		if attr == "CarriedBy" then
			local carried = (anchor:GetAttribute("CarriedBy") or 0) ~= 0
			if entry.WasCarried and not carried and entry.Current then
				-- retour à la maison en vol plané
				entry.FlyFrom = entry.Current
				entry.FlyStart = os.clock()
			end
			entry.WasCarried = carried
		end
		refreshPrompt(entry)
	end)
end

local function untrack(anchor: BasePart)
	local entry = entries[anchor]
	if not entry then
		return
	end
	entries[anchor] = nil
	for uid, e in byUid do
		if e == entry then
			byUid[uid] = nil
		end
	end
	if entry.Model then
		local model = entry.Model
		-- disparition : on laisse l'effet se jouer
		local pos = if entry.Current then entry.Current.Position else anchor.Position
		Effects.Poof(pos + Vector3.new(0, entry.Height / 2, 0), entry.Scale * 3)
		model:Destroy()
	end
	if entry.Label then
		entry.Label:Destroy()
	end
end

function KaijuRenderer.ByUid(uid: string): any
	return byUid[uid]
end

----------------------------------------------------------------------------
-- Boucle d'animation
----------------------------------------------------------------------------

local function placement(entry: Entry, t: number): CFrame
	local anchor = entry.Anchor
	local carriedBy = anchor:GetAttribute("CarriedBy") or 0
	if carriedBy ~= 0 then
		local lead = characterOf(carriedBy)
		local head = lead and lead:FindFirstChild("Head") :: BasePart?
		if head then
			local helperId = anchor:GetAttribute("Helper") or 0
			local helper = if helperId ~= 0 then characterOf(helperId) else nil
			local helperHead = helper and helper:FindFirstChild("Head") :: BasePart?
			if anchor:GetAttribute("Lifting") then
				-- trop lourd : il tangue au sol à côté du voleur
				local root = lead:FindFirstChild("HumanoidRootPart") :: BasePart?
				local base = if root then root.CFrame * CFrame.new(0, -3, -4 - entry.Scale) else head.CFrame
				return CFrame.new(base.Position) * CFrame.Angles(math.sin(t * 9) * 0.08, 0, math.sin(t * 7) * 0.1)
			end
			local pos = head.Position
			if helperHead then
				pos = (pos + helperHead.Position) / 2
			end
			local yaw = select(2, head.CFrame:ToEulerAnglesYXZ())
			local lift = 1.2 + math.sin(t * 10) * 0.25
			return CFrame.new(pos + Vector3.new(0, lift, 0)) * CFrame.Angles(0, yaw, 0) * CFrame.Angles(0, 0, math.sin(t * 6) * 0.12)
		end
	end
	return anchor.CFrame
end

local function animate(entry: Entry, dt: number, t: number, camPos: Vector3)
	local model = entry.Model
	if not model then
		return
	end
	local target = placement(entry, t)
	-- vol plané (apparition, retour)
	if entry.FlyFrom then
		local a = math.clamp((os.clock() - entry.FlyStart) / 0.9, 0, 1)
		local e = 1 - (1 - a) ^ 3
		local p = entry.FlyFrom.Position:Lerp(target.Position, e) + Vector3.new(0, math.sin(a * math.pi) * 10, 0)
		target = CFrame.new(p) * target.Rotation
		if a >= 1 then
			entry.FlyFrom = nil
			if (entry.Anchor:GetAttribute("CarriedBy") or 0) == 0 and not entry.WasEgg then
				Effects.Dust(entry.Anchor.Position, entry.Scale * 3)
			end
		end
	end
	entry.Current = target
	if entry.PromptAttachment then
		-- le prompt suit le kaiju (utile pour « aider à soulever »)
		entry.PromptAttachment.WorldPosition = target.Position + Vector3.new(0, math.max(2.5, entry.Height * 0.55), 0)
	end
	local far = (target.Position - camPos).Magnitude > ANIM_DISTANCE
	-- Loin et immobile : déjà en place, rien à recalculer (grosse économie sur mobile)
	if far and entry.Parked == target then
		return
	end
	entry.Parked = if far then target else nil
	local phase = entry.Phase
	local s = entry.Scale
	local breathe = math.sin(t * 2.2 + phase)
	local root = target * CFrame.new(0, if far then 0 else (breathe + 1) * 0.06 * s, 0) * CFrame.Angles(0, if far then 0 else math.sin(t * 0.7 + phase) * 0.06, 0)
	local cfs = table.create(#entry.Parts)
	local pivots = entry.Pivots
	for i, offset in entry.Offsets do
		local role = entry.Roles[i]
		local cf
		if far or role == "" then
			cf = root * offset
		elseif role == "Head" then
			local pv = pivots.Head
			cf = root * CFrame.new(pv) * CFrame.Angles(math.sin(t * 1.7 + phase) * 0.06, math.sin(t * 0.9 + phase) * 0.12, 0) * CFrame.new(-pv) * offset
		elseif role == "Tail" then
			local pv = pivots.Tail
			local k = 1 + entry.Phases[i] * 0.6
			cf = root * CFrame.new(pv) * CFrame.Angles(0, math.sin(t * 3 + phase) * 0.18 * k, 0) * CFrame.new(-pv) * offset
		elseif role == "WingL" or role == "WingR" then
			local pv = pivots[role]
			local dir = if role == "WingL" then 1 else -1
			cf = root * CFrame.new(pv) * CFrame.Angles(0, 0, math.sin(t * 8 + phase) * 0.35 * dir) * CFrame.new(-pv) * offset
		elseif role == "Wave" then
			local ph = entry.Phases[i]
			cf = root * CFrame.new(math.sin(t * 3 + ph * 0.9) * 0.12 * s, math.sin(t * 4 + ph) * 0.1 * s, 0) * offset
		elseif role == "Halo" then
			local pv = pivots.Halo
			cf = root * CFrame.new(pv) * CFrame.Angles(0, t * 1.5, 0) * CFrame.new(0, math.sin(t * 2) * 0.1 * s, 0) * CFrame.new(-pv) * offset
		elseif role == "Squash" then
			cf = root * CFrame.new(0, breathe * 0.05 * s, 0) * offset
		else
			cf = root * offset
		end
		cfs[i] = cf
	end
	Workspace:BulkMoveTo(entry.Parts, cfs, Enum.BulkMoveMode.FireCFrameChanged)
	if model.PrimaryPart then
		model.PrimaryPart.CFrame = root
	end
	if entry.Aura then
		entry.Aura.CFrame = target * CFrame.new(0, 0.12, 0) * CFrame.Angles(0, 0, math.rad(90))
		entry.Aura.Transparency = 0.68 + math.sin(t * 3 + phase) * 0.12
		local pillar = entry.Aura:FindFirstChild("Pillar") :: BasePart?
		if pillar then
			pillar.CFrame = target * CFrame.new(0, 40, 0) * CFrame.Angles(0, 0, math.rad(90))
		end
	end
	if not far and #entry.RainbowParts > 0 then
		for i, p in entry.RainbowParts do
			p.Color = Color3.fromHSV((t * 0.25 + i * 0.04) % 1, 0.65, 1)
		end
	end
	-- étiquette
	local label = entry.Label
	if label and not far then
		label.StudsOffsetWorldSpace = Vector3.new(0, entry.Height + 1.5, 0) + (target.Position - entry.Anchor.Position)
	end
end

local function updateLabel(entry: Entry)
	local label = entry.Label
	if not label then
		return
	end
	local anchor = entry.Anchor
	local nameLabel = label:FindFirstChild("Name") :: TextLabel
	local info = label:FindFirstChild("Info") :: TextLabel
	local bar = label:FindFirstChild("Bar") :: Frame
	local fill = bar:FindFirstChild("Fill") :: Frame
	local rarity = Rarities.Get(anchor:GetAttribute("Rarity") or "Common")
	local t = now()
	if anchor:GetAttribute("Egg") then
		nameLabel.Text = ("🥚 %s EGG"):format(string.upper(rarity.Name))
		nameLabel.TextColor3 = rarity.Color
		local left = (anchor:GetAttribute("HatchAt") or 0) - t
		info.Text = if left > 0 then ("Hatching in %s"):format(Format.Clock(left)) else "Hatching..."
		info.TextColor3 = C.Paper
		bar.Visible = false
		return
	end
	local species = Kaijus.Get(anchor:GetAttribute("Species") or "")
	local mutation = Mutations.Get(anchor:GetAttribute("Mutation"))
	local stage = anchor:GetAttribute("Stage") or 1
	local mutText = if mutation then ('<font color="#%s">%s</font> '):format(mutation.TextColor:ToHex(), string.upper(mutation.Name)) else ""
	nameLabel.Text = mutText .. (if species then species.Name else "?")
	nameLabel.TextColor3 = if rarity.Id == "Secret" then C.White else rarity.Color
	local carried = (anchor:GetAttribute("CarriedBy") or 0) ~= 0
	if carried then
		info.Text = "🚨 BEING STOLEN!"
		info.TextColor3 = C.Red
	else
		info.Text = ("%s • %s/s"):format(string.upper(Growth.Get(stage).Name), Format.Cash(anchor:GetAttribute("Income") or 0))
		info.TextColor3 = C.Cash
	end
	if stage < Growth.MaxStage and species then
		local growth = (anchor:GetAttribute("Growth") or 0) + (t - (anchor:GetAttribute("GrowthStamp") or t)) * (anchor:GetAttribute("GrowthRate") or 1)
		bar.Visible = true
		fill.Size = UDim2.fromScale(Growth.Progress(growth, species.Rarity), 1)
	else
		bar.Visible = false
	end
end

----------------------------------------------------------------------------

function KaijuRenderer.Init()
	folder = Instance.new("Folder")
	folder.Name = "ClientKaijus"
	folder.Parent = Workspace

	local anchors = Workspace:WaitForChild("Kaijus")
	local function watchOwner(ownerFolder: Instance)
		for _, a in ownerFolder:GetChildren() do
			if a:IsA("BasePart") then
				task.spawn(track, a)
			end
		end
		ownerFolder.ChildAdded:Connect(function(a)
			if a:IsA("BasePart") then
				-- attend les attributs
				task.wait()
				track(a)
			end
		end)
		ownerFolder.ChildRemoved:Connect(function(a)
			if a:IsA("BasePart") then
				untrack(a)
			end
		end)
	end
	for _, f in anchors:GetChildren() do
		watchOwner(f)
	end
	anchors.ChildAdded:Connect(watchOwner)

	RunService.RenderStepped:Connect(function(dt)
		local camera = Workspace.CurrentCamera
		local camPos = if camera then camera.CFrame.Position else Vector3.zero
		local t = os.clock()
		for _, entry in entries do
			animate(entry, dt, t, camPos)
		end
	end)

	-- Étiquettes et prompts : 5 fois par seconde suffit
	task.spawn(function()
		while true do
			for _, entry in entries do
				updateLabel(entry)
				refreshPrompt(entry)
			end
			task.wait(0.2)
		end
	end)

	FxBus.On("Fed", function(args)
		local entry = byUid[args.Uid or ""]
		if entry and entry.Current then
			local pos = entry.Current.Position + Vector3.new(0, entry.Height * 0.7, 0)
			local icons = { Snack = "🍖", Feast = "🍗", Steak = "🥩" }
			Effects.FloatingText(pos, (icons[args.Food] or "🍖") .. " NOM!", C.Gold)
			Effects.Burst(pos, C.Gold, 12, entry.Scale * 2)
			Audio.Play("roar_small", { Parent = entry.Anchor, Pitch = 1.3 })
		end
	end)
	FxBus.On("KaijuReturned", function(args)
		local entry = byUid[args.Uid or ""]
		if entry and entry.Current then
			Effects.Poof(entry.Current.Position, entry.Scale * 3)
			Audio.Play("drop", { Parent = entry.Anchor })
		end
	end)
	FxBus.On("HatchWorld", function(args)
		local entry = byUid[args.Uid or ""]
		if entry then
			local rarity = Rarities.Get(args.Rarity or "Common")
			if rarity.Order >= 4 then
				Effects.Pillar(entry.Anchor.Position, rarity.Color, 3)
			end
		end
	end)
	FxBus.On("Infected", function(args)
		local entry = byUid[args.Uid or ""]
		if entry then
			local mutation = Mutations.Get(args.Mutation)
			Effects.Pillar(entry.Anchor.Position, if mutation then mutation.Color else C.Radioactive, 2)
		end
	end)
	FxBus.On("Alarm", function(args)
		local entry = byUid[args.Uid or ""]
		if entry then
			Effects.Pillar(entry.Anchor.Position, C.Red, 2)
		end
	end)
end

return KaijuRenderer
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="87">
            <Properties>
              <string name="Name">MeteorRenderer</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Météores : chute depuis le ciel avec traînée de feu, impact, œuf posé sur
-- sa plateforme avec prix et minuteur, achat, envol vers la base.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local KaijuBuilder = require(Shared.KaijuBuilder)
local Rarities = require(Shared.Config.Rarities)
local Economy = require(Shared.Config.Economy)
local Theme = require(Shared.Config.Theme)
local Format = require(Shared.Logic.Format)

local Controllers = script.Parent.Parent.Controllers
local State = require(Controllers.State)
local Remote = require(Controllers.Remote)
local Audio = require(Controllers.Audio)
local FxBus = require(Controllers.FxBus)
local CameraFx = require(Controllers.CameraFx)
local Effects = require(script.Parent.Effects)

local C = Theme.Colors
local player = Players.LocalPlayer

local MeteorRenderer = {}

type Entry = {
	Anchor: BasePart,
	Rock: BasePart?,
	Egg: Model?,
	Label: BillboardGui?,
	Prompt: ProximityPrompt?,
	Landed: boolean,
	From: Vector3,
	Whistle: Sound?,
	Removed: boolean,
}

local entries: { [string]: Entry } = {}
local recent: { [string]: Entry } = {} -- entrées retirées, gardées un instant pour les animations
local folder: Folder

local function now(): number
	return Workspace:GetServerTimeNow()
end

local function isFreeForMe(): boolean
	local stats = State.Get("Stats")
	return stats ~= nil and stats.EggsBought == 0
end

local function buildLabel(entry: Entry)
	local anchor = entry.Anchor
	local rarity = Rarities.Get(anchor:GetAttribute("Rarity") or "Common")
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromOffset(200, 86)
	gui.StudsOffsetWorldSpace = Vector3.new(0, 6.5, 0)
	gui.MaxDistance = 140
	gui.LightInfluence = 0
	gui.Adornee = anchor
	local function line(name: string, y: number, h: number, font: Font, color: Color3, text: string)
		local t = Instance.new("TextLabel")
		t.Name = name
		t.BackgroundTransparency = 1
		t.Position = UDim2.fromOffset(0, y)
		t.Size = UDim2.new(1, 0, 0, h)
		t.FontFace = font
		t.TextScaled = true
		t.TextColor3 = color
		t.Text = text
		local s = Instance.new("UIStroke")
		s.Thickness = 2.5
		s.Color = C.Ink
		s.Parent = t
		t.Parent = gui
		return t
	end
	local owner = anchor:GetAttribute("Owner") or 0
	local title = string.upper(rarity.Name) .. " EGG"
	if owner == player.UserId then
		title = "⭐ YOUR METEOR ⭐"
	end
	line("Title", 0, 28, Theme.Fonts.Title, if rarity.Id == "Secret" then C.White else rarity.Color, title)
	line("Price", 28, 30, Theme.Fonts.Impact, C.Cash, Format.Cash(anchor:GetAttribute("Price") or 0))
	local bar = Instance.new("Frame")
	bar.Name = "Bar"
	bar.Size = UDim2.new(0.7, 0, 0, 10)
	bar.Position = UDim2.new(0.15, 0, 0, 64)
	bar.BackgroundColor3 = C.Ink
	bar.BorderSizePixel = 0
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(1, 0)
	corner.Parent = bar
	local fill = Instance.new("Frame")
	fill.Name = "Fill"
	fill.Size = UDim2.fromScale(1, 1)
	fill.BackgroundColor3 = rarity.Color
	fill.BorderSizePixel = 0
	corner:Clone().Parent = fill
	fill.Parent = bar
	bar.Parent = gui
	gui.Parent = folder
	entry.Label = gui
end

local function buildPrompt(entry: Entry)
	local anchor = entry.Anchor
	local owner = anchor:GetAttribute("Owner") or 0
	if owner ~= 0 and owner ~= player.UserId then
		return
	end
	local attachment = Instance.new("Attachment")
	attachment.Position = Vector3.new(0, 2.5, 0)
	attachment.Parent = anchor
	local prompt = Instance.new("ProximityPrompt")
	prompt.Style = Enum.ProximityPromptStyle.Custom
	prompt.ActionText = "BUY " .. Format.Cash(anchor:GetAttribute("Price") or 0)
	prompt.ObjectText = Rarities.Get(anchor:GetAttribute("Rarity") or "Common").Name .. " Egg"
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 14
	prompt.RequiresLineOfSight = false
	prompt.Enabled = false
	prompt:SetAttribute("Color", "Radioactive")
	prompt.Parent = attachment
	prompt.Triggered:Connect(function()
		local r = Remote.Call("BuyMeteor", { Id = anchor:GetAttribute("Id") })
		if r.ok then
			Audio.Play("purchase")
			if r.free then
				Effects.FloatingText(anchor.Position + Vector3.new(0, 6, 0), "FREE!", C.Radioactive)
			end
		end
	end)
	entry.Prompt = prompt
end

local function spawnEgg(entry: Entry)
	local anchor = entry.Anchor
	local egg = KaijuBuilder.BuildEgg(anchor:GetAttribute("Rarity") or "Common", 1, anchor.CFrame * CFrame.new(0, -1.2, 0))
	egg.Parent = folder
	entry.Egg = egg
end

local function land(entry: Entry)
	entry.Landed = true
	local anchor = entry.Anchor
	local rarity = Rarities.Get(anchor:GetAttribute("Rarity") or "Common")
	if entry.Rock then
		entry.Rock:Destroy()
		entry.Rock = nil
	end
	if entry.Whistle then
		entry.Whistle:Destroy()
		entry.Whistle = nil
	end
	local pos = anchor.Position - Vector3.new(0, 1, 0)
	Effects.Impact(pos, rarity.Color, rarity.Order)
	Audio.Play("meteor_impact", { Parent = anchor, MaxDistance = 400 })
	CameraFx.ShakeAt(pos, 0.6 + rarity.Order * 0.2, 120, 0.5)
	if rarity.Order >= 4 then
		Effects.Pillar(pos, rarity.Color, 2.5)
	end
	spawnEgg(entry)
	buildLabel(entry)
	if entry.Prompt then
		entry.Prompt.Enabled = true
	end
end

local function track(anchor: BasePart)
	local id = anchor:GetAttribute("Id") or anchor.Name
	if entries[id] then
		return
	end
	local rarity = Rarities.Get(anchor:GetAttribute("Rarity") or "Common")
	local angle = math.random() * math.pi * 2
	local from = anchor.Position + Vector3.new(math.cos(angle) * 140, 320, math.sin(angle) * 140)
	local entry: Entry = { Anchor = anchor, Rock = nil, Egg = nil, Label = nil, Prompt = nil, Landed = false, From = from, Whistle = nil, Removed = false }
	entries[id] = entry
	buildPrompt(entry)

	local landAt = anchor:GetAttribute("LandAt") or 0
	if landAt <= now() then
		-- déjà tombé (on vient d'arriver)
		entry.Landed = true
		spawnEgg(entry)
		buildLabel(entry)
		if entry.Prompt then
			entry.Prompt.Enabled = true
		end
		return
	end
	local rock = Instance.new("Part")
	rock.Name = "Meteor"
	rock.Shape = Enum.PartType.Ball
	rock.Size = Vector3.new(1, 1, 1) * (4 + rarity.Order * 0.6)
	rock.Material = Enum.Material.Slate
	rock.Color = Color3.fromRGB(70, 50, 50)
	rock.Anchored = true
	rock.CanCollide = false
	rock.CanQuery = false
	rock.CanTouch = false
	rock.CFrame = CFrame.new(from)
	rock.Parent = folder
	local core = Instance.new("Part")
	core.Shape = Enum.PartType.Ball
	core.Size = rock.Size * 0.8
	core.Material = Enum.Material.Neon
	core.Color = rarity.Color
	core.Anchored = true
	core.CanCollide = false
	core.CanQuery = false
	core.CanTouch = false
	core.Transparency = 0.3
	core.CFrame = rock.CFrame
	core.Parent = rock
	Effects.MeteorTrail(rock, rarity.Color, rarity.TrailWidth)
	entry.Rock = rock
	entry.Whistle = Audio.Play("meteor_whistle", { Parent = rock, MaxDistance = 500, NoVary = true })
end

local function untrack(id: string)
	local entry = entries[id]
	if not entry then
		return
	end
	entries[id] = nil
	recent[id] = entry
	task.delay(2, function()
		if recent[id] == entry then
			recent[id] = nil
		end
	end)
	entry.Removed = true
	for _, inst in { entry.Rock, entry.Label } do
		if inst then
			inst:Destroy()
		end
	end
	if entry.Whistle then
		entry.Whistle:Destroy()
	end
	-- l'œuf est géré par MeteorBought / MeteorExpired (animations), sinon supprimé
	task.delay(0.6, function()
		if entry.Egg and entry.Egg.Parent and not entry.Egg:GetAttribute("Animating") then
			entry.Egg:Destroy()
		end
	end)
end

local function flyEggTo(egg: Model, target: Vector3)
	egg:SetAttribute("Animating", true)
	local start = egg:GetPivot()
	local t0 = os.clock()
	local conn
	conn = RunService.RenderStepped:Connect(function()
		local a = math.clamp((os.clock() - t0) / 1.1, 0, 1)
		local e = a * a * (3 - 2 * a)
		local p = start.Position:Lerp(target, e) + Vector3.new(0, math.sin(a * math.pi) * 60, 0)
		egg:PivotTo(CFrame.new(p) * CFrame.Angles(a * 8, a * 5, 0))
		if a >= 1 then
			conn:Disconnect()
			Effects.Dust(target, 3)
			egg:Destroy()
		end
	end)
end

function MeteorRenderer.Init()
	folder = Instance.new("Folder")
	folder.Name = "ClientMeteors"
	folder.Parent = Workspace

	local meteors = Workspace:WaitForChild("Meteors")
	for _, m in meteors:GetChildren() do
		if m:IsA("BasePart") then
			task.spawn(track, m)
		end
	end
	meteors.ChildAdded:Connect(function(m)
		if m:IsA("BasePart") then
			task.wait()
			track(m)
		end
	end)
	meteors.ChildRemoved:Connect(function(m)
		untrack(m:GetAttribute("Id") or m.Name)
	end)

	RunService.RenderStepped:Connect(function()
		local t = now()
		for _, entry in entries do
			local anchor = entry.Anchor
			if not entry.Landed then
				local landAt = anchor:GetAttribute("LandAt") or t
				local fall = 2.6
				local a = math.clamp(1 - (landAt - t) / fall, 0, 1)
				local e = a * a
				if entry.Rock then
					entry.Rock.CFrame = CFrame.new(entry.From:Lerp(anchor.Position, e)) * CFrame.Angles(a * 6, a * 4, 0)
					local core = entry.Rock:FindFirstChildWhichIsA("BasePart")
					if core then
						core.CFrame = entry.Rock.CFrame
					end
				end
				if a >= 1 then
					land(entry)
				end
			else
				if entry.Egg then
					local bob = math.sin(os.clock() * 2.5) * 0.3
					entry.Egg:PivotTo(anchor.CFrame * CFrame.new(0, -1 + bob, 0) * CFrame.Angles(0, os.clock() * 0.8, math.sin(os.clock() * 5) * 0.05))
				end
				local label = entry.Label
				if label then
					local expire = anchor:GetAttribute("ExpireAt") or t
					local land_ = anchor:GetAttribute("LandAt") or t
					local fill = label:FindFirstChild("Bar") and label.Bar:FindFirstChild("Fill")
					if fill then
						fill.Size = UDim2.fromScale(math.clamp((expire - t) / math.max(1, expire - land_), 0, 1), 1)
					end
				end
			end
		end
	end)

	-- Prix « GRATUIT » pour le tout premier œuf
	task.spawn(function()
		while true do
			task.wait(0.5)
			local free = isFreeForMe()
			for _, entry in entries do
				local price = entry.Anchor:GetAttribute("Price") or 0
				local order = Rarities.Get(entry.Anchor:GetAttribute("Rarity") or "Common").Order
				local text = if free and order <= Economy.FreeFirstEggMaxOrder then "FREE!" else Format.Cash(price)
				if entry.Label then
					local p = entry.Label:FindFirstChild("Price") :: TextLabel?
					if p then
						p.Text = text
						p.TextColor3 = if (State.Get("Cash") or 0) >= price or text == "FREE!" then C.Cash else C.Red
					end
				end
				if entry.Prompt then
					entry.Prompt.ActionText = if text == "FREE!" then "GRAB FREE" else "BUY " .. text
				end
			end
		end
	end)

	FxBus.On("MeteorBought", function(args)
		local entry = entries[args.Id or ""] or recent[args.Id or ""]
		local egg = entry and entry.Egg
		local buyer = Players:GetPlayerByUserId(args.Buyer or 0)
		local plotIndex = buyer and buyer:GetAttribute("Plot")
		local map = Workspace:FindFirstChild("Map")
		local plot = plotIndex and map and map:FindFirstChild("Plot" .. plotIndex)
		if egg and plot then
			local floor = plot:FindFirstChild("Floor") :: BasePart?
			flyEggTo(egg, if floor then floor.Position + Vector3.new(0, 4, 0) else egg:GetPivot().Position)
			Audio.Play("whoosh")
		elseif egg then
			egg:Destroy()
		end
	end)
	FxBus.On("MeteorExpired", function(args)
		local entry = entries[args.Id or ""] or recent[args.Id or ""]
		if entry and entry.Egg then
			local egg = entry.Egg
			egg:SetAttribute("Animating", true)
			Effects.Poof(egg:GetPivot().Position, 3)
			Audio.Play("egg_crack", { Pitch = 0.8 })
			egg:Destroy()
		end
	end)
end

return MeteorRenderer
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="88">
            <Properties>
              <string name="Name">PlotVisuals</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Visuels des îles : dôme de bouclier, laser de porte, minuteur du bouclier,
-- nids verrouillés (et achat du suivant), réacteur qui pulse selon le cash
-- en attente, flèche « COLLECT ».

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Layout = require(Shared.Config.Layout)
local Economy = require(Shared.Config.Economy)
local Theme = require(Shared.Config.Theme)
local Format = require(Shared.Logic.Format)

local Controllers = script.Parent.Parent.Controllers
local State = require(Controllers.State)
local Remote = require(Controllers.Remote)
local Audio = require(Controllers.Audio)
local FxBus = require(Controllers.FxBus)
local Effects = require(script.Parent.Effects)

local C = Theme.Colors
local player = Players.LocalPlayer

local PlotVisuals = {}

type PlotEntry = {
	Model: Model,
	Dome: BasePart,
	Timer: BillboardGui,
	Gate: BasePart?,
	Active: boolean,
	NestLocks: { [number]: BillboardGui },
}

local plots: { PlotEntry } = {}
local folder: Folder
local nestPrompt: ProximityPrompt? = nil

local function now(): number
	return Workspace:GetServerTimeNow()
end

local function makeDome(model: Model): BasePart
	local index = model:GetAttribute("Index") or 1
	local cf = Layout.PlotCFrame(index)
	local dome = Instance.new("Part")
	dome.Name = "ShieldDome"
	dome.Shape = Enum.PartType.Ball
	dome.Size = Vector3.new(1, 1, 1) * (Layout.PlotDepth * 1.35)
	dome.CFrame = cf
	dome.Anchored = true
	dome.CanCollide = false
	dome.CanQuery = false
	dome.CanTouch = false
	dome.CastShadow = false
	dome.Material = Enum.Material.ForceField
	dome.Color = C.Cyan
	dome.Transparency = 1
	dome.Parent = folder
	return dome
end

local function makeTimer(model: Model): BillboardGui
	local gate = model:FindFirstChild("Gate") :: BasePart?
	local gui = Instance.new("BillboardGui")
	gui.Name = "ShieldTimer"
	gui.Size = UDim2.fromOffset(200, 50)
	gui.StudsOffsetWorldSpace = Vector3.new(0, 9, 0)
	gui.MaxDistance = 260
	gui.LightInfluence = 0
	gui.Adornee = gate
	gui.Enabled = false
	local label = Instance.new("TextLabel")
	label.Name = "Text"
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.FontFace = Theme.Fonts.Impact
	label.TextScaled = true
	label.TextColor3 = C.Cyan
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 3
	stroke.Color = C.Ink
	stroke.Parent = label
	label.Parent = gui
	gui.Parent = folder
	return gui
end

local function nestLockLabel(model: Model, slot: number): BillboardGui?
	local nest = model:FindFirstChild("Nest" .. slot) :: BasePart?
	if not nest then
		return nil
	end
	local gui = Instance.new("BillboardGui")
	gui.Name = "NestLock"
	gui.Size = UDim2.fromOffset(150, 44)
	gui.StudsOffsetWorldSpace = Vector3.new(0, 3, 0)
	gui.MaxDistance = 60
	gui.LightInfluence = 0
	gui.Adornee = nest
	local label = Instance.new("TextLabel")
	label.Name = "Text"
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.FontFace = Theme.Fonts.Title
	label.TextScaled = true
	label.TextColor3 = C.Paper
	label.Text = "🔒"
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 2.5
	stroke.Color = C.Ink
	stroke.Parent = label
	label.Parent = gui
	gui.Parent = folder
	return gui
end

-- Nids verrouillés sur MON île : grisés, cadenas, et prompt d'achat sur le suivant.
local function refreshMyNests()
	local myIndex = player:GetAttribute("Plot")
	for _, entry in plots do
		local model = entry.Model
		local mine = model:GetAttribute("Index") == myIndex
		local unlocked = model:GetAttribute("Nests") or 0
		for slot = 1, #Layout.Nests do
			local ring = nil
			local nest = model:FindFirstChild("Nest" .. slot) :: BasePart?
			if nest then
				for _, child in model:GetChildren() do
					if child.Name == "NestRing" and child:IsA("BasePart") and (child.Position - nest.Position).Magnitude < 1 then
						ring = child
					end
				end
			end
			local locked = slot > unlocked
			if ring then
				ring.Transparency = if locked then 0.85 else 0.5
			end
			if nest then
				nest.Transparency = if locked and mine then 0.55 else 0
			end
			local lock = entry.NestLocks[slot]
			if mine and locked then
				if not lock then
					lock = nestLockLabel(model, slot)
					entry.NestLocks[slot] = lock :: any
				end
				local text = (lock :: any).Text :: TextLabel
				if slot == unlocked + 1 and unlocked < Economy.MaxNests then
					text.Text = "🔒 " .. Format.Cash(Economy.NestPrice(State.Get("Nests") or Economy.StartNests))
					text.TextColor3 = if (State.Get("Cash") or 0) >= Economy.NestPrice(State.Get("Nests") or 6) then C.Cash else C.Paper
				else
					text.Text = "🔒"
					text.TextColor3 = C.Paper
				end
			elseif lock then
				lock:Destroy()
				entry.NestLocks[slot] = nil
			end
		end
		-- prompt d'achat sur le prochain nid
		if mine then
			local nextSlot = unlocked + 1
			local nest = model:FindFirstChild("Nest" .. nextSlot) :: BasePart?
			if nestPrompt and (not nest or nestPrompt.Parent ~= nest or unlocked >= Economy.MaxNests) then
				nestPrompt:Destroy()
				nestPrompt = nil
			end
			if nest and not nestPrompt and unlocked < Economy.MaxNests then
				local prompt = Instance.new("ProximityPrompt")
				prompt.Style = Enum.ProximityPromptStyle.Custom
				prompt.ActionText = "UNLOCK NEST"
				prompt.ObjectText = "New nest"
				prompt.HoldDuration = 0
				prompt.MaxActivationDistance = 12
				prompt.RequiresLineOfSight = false
				prompt:SetAttribute("Color", "Gold")
				prompt.Triggered:Connect(function()
					local r = Remote.Call("BuyNest")
					if r.ok then
						Effects.Burst(nest.Position + Vector3.new(0, 2, 0), C.Gold, 40, 3)
						Effects.Shockwave(nest.Position, C.Gold, 12, 0.6)
						Audio.Play("purchase")
					end
				end)
				prompt.Parent = nest
				nestPrompt = prompt
			end
		end
	end
end

function PlotVisuals.Init()
	folder = Instance.new("Folder")
	folder.Name = "ClientPlots"
	folder.Parent = Workspace

	local map = Workspace:WaitForChild("Map")
	for i = 1, Layout.PlotCount do
		local model = map:WaitForChild("Plot" .. i) :: Model
		local entry: PlotEntry = {
			Model = model,
			Dome = makeDome(model),
			Timer = makeTimer(model),
			Gate = model:FindFirstChild("Gate") :: BasePart?,
			Active = false,
			NestLocks = {},
		}
		table.insert(plots, entry)
		model.AttributeChanged:Connect(function(attr)
			if attr == "Nests" or attr == "OwnerId" then
				refreshMyNests()
			end
		end)
	end
	player:GetAttributeChangedSignal("Plot"):Connect(refreshMyNests)
	State.Observe("Nests", refreshMyNests)
	State.Changed("Cash"):Connect(function()
		-- rafraîchit la couleur du prix (léger)
		refreshMyNests()
	end)
	refreshMyNests()

	RunService.Heartbeat:Connect(function()
		local t = now()
		local pulse = (math.sin(os.clock() * 3) + 1) / 2
		for _, entry in plots do
			local model = entry.Model
			local shield = (model:GetAttribute("ShieldUntil") or 0) - t
			local protected = (model:GetAttribute("ProtectedUntil") or 0) - t
			local active = model:GetAttribute("OwnerId") ~= nil and (shield > 0 or protected > 0)
			if active ~= entry.Active then
				entry.Active = active
				if active then
					Effects.Shockwave(entry.Dome.Position, C.Cyan, Layout.PlotDepth * 0.7, 0.8)
				end
			end
			if active then
				entry.Dome.Color = if shield > 0 then C.Cyan else C.Radioactive
				entry.Dome.Transparency = 0.25 + pulse * 0.15
				if entry.Gate then
					entry.Gate.LocalTransparencyModifier = 0
					entry.Gate.Transparency = 0.2 + pulse * 0.2
				end
				entry.Timer.Enabled = true
				local label = entry.Timer:FindFirstChild("Text") :: TextLabel
				label.Text = if shield > 0 then ("🛡️ %ds"):format(math.ceil(shield)) else ("🌱 SAFE %ds"):format(math.ceil(protected))
				label.TextColor3 = if shield > 0 then C.Cyan else C.Radioactive
			else
				entry.Dome.Transparency = 1
				if entry.Gate then
					entry.Gate.Transparency = 1
				end
				entry.Timer.Enabled = false
			end
			-- réacteur : lumière selon le cash stocké
			local core = model:FindFirstChild("Core") :: BasePart?
			if core then
				local stored = model:GetAttribute("Stored") or 0
				local glow = math.clamp(math.log10(stored + 1) / 7, 0.1, 1)
				local light = core:FindFirstChildOfClass("PointLight")
				if light then
					light.Brightness = 0.6 + glow * 2.5 + pulse * glow
				end
			end
		end
	end)

	FxBus.On("ShieldUp", function(args)
		local entry = plots[args.Plot or 0]
		if entry then
			Audio.Play("shield_on", { Parent = entry.Dome, MaxDistance = 400 })
			Effects.Shockwave(entry.Dome.Position, C.Cyan, Layout.PlotDepth * 0.8, 0.9)
		end
	end)
	FxBus.On("ShieldZap", function(args)
		Audio.Play("shield_zap")
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
		if root then
			Effects.Burst(root.Position, C.Cyan, 30, 2)
			Effects.FloatingText(root.Position + Vector3.new(0, 4, 0), if args.Protected then "NEW PLAYER!" else "ZAP!", C.Cyan)
		end
	end)
end

return PlotVisuals
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="89">
            <Properties>
              <string name="Name">Tutorial</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Tutoriel guidé (5 étapes) + guidage automatique pendant un vol.
--   0 : ton œuf éclôt       -> quand un kaiju est éclos
--   1 : collecte ton cash    -> après une collecte
--   2 : achète un œuf        -> après un achat
--   3 : verrouille ta base   -> après un verrouillage (ou 25 s)
--   4 : va voler !           -> 12 s puis terminé (5)

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Layout = require(Shared.Config.Layout)
local Rarities = require(Shared.Config.Rarities)
local Economy = require(Shared.Config.Economy)
local Theme = require(Shared.Config.Theme)

local Controllers = script.Parent.Parent.Controllers
local State = require(Controllers.State)
local Remote = require(Controllers.Remote)
local Audio = require(Controllers.Audio)
local FxBus = require(Controllers.FxBus)
local Kit = require(script.Parent.Parent.UI.Kit)
local Guide = require(script.Parent.Guide)

local C = Theme.Colors
local player = Players.LocalPlayer

local Tutorial = {}

local STEPS = {
	[0] = { Icon = "🥚", Text = "Your first egg is hatching! Watch it on your island." },
	[1] = { Icon = "⚛️", Text = "Your kaiju makes cash! Step on the Cash Reactor to collect." },
	[2] = { Icon = "☄️", Text = "Meteors drop eggs in the crater. Buy one — it's FREE!" },
	[3] = { Icon = "🛡️", Text = "Thieves are coming! Press LOCK BASE to raise your shield." },
	[4] = { Icon = "🦹", Text = "Now go STEAL kaijus from other islands! Big ones need 2 thieves." },
}

local hint: Frame
local hintText: TextLabel
local hintIcon: TextLabel
local guide
local carryGuide
local step = -1
local stepStarted = 0

local function myPlot(): Model?
	local index = player:GetAttribute("Plot")
	local map = Workspace:FindFirstChild("Map")
	return if index and map then map:FindFirstChild("Plot" .. index) :: Model else nil
end

local function myFirstKaijuAnchor(): BasePart?
	local folder = Workspace:FindFirstChild("Kaijus")
	local mine = folder and folder:FindFirstChild(tostring(player.UserId))
	return mine and mine:FindFirstChildWhichIsA("BasePart")
end

local function nearestMeteor(): BasePart?
	local folder = Workspace:FindFirstChild("Meteors")
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not folder or not root then
		return nil
	end
	local best, bestD = nil, math.huge
	for _, m in folder:GetChildren() do
		if m:IsA("BasePart") and (m:GetAttribute("Owner") or 0) == 0 or m:GetAttribute("Owner") == player.UserId then
			local d = (m.Position - root.Position).Magnitude
			if d < bestD and Rarities.Get(m:GetAttribute("Rarity") or "Common").Order <= Economy.FreeFirstEggMaxOrder then
				best, bestD = m, d
			end
		end
	end
	return best
end

local function setStep(n: number)
	if n == step then
		return
	end
	step = n
	stepStarted = os.clock()
	local def = STEPS[n]
	if not def then
		hint.Visible = false
		guide:Hide()
		return
	end
	hint.Visible = true
	hintIcon.Text = def.Icon
	hintText.Text = def.Text
	Kit.Pop(hint, 0.5)
	Audio.Play("quest_complete", { Volume = 0.6 })
end

local function advance(to: number)
	if to > (State.Get("Tutorial") or 0) then
		Remote.Call("Tutorial", { Step = to }, true)
	end
	setStep(to)
end

function Tutorial.Init()
	local layer = Kit.Layer("Tutorial", 9)
	hint = Kit.new("Frame", {
		Size = UDim2.fromOffset(620, 74),
		Position = UDim2.new(0.5, 0, 0, 196),
		AnchorPoint = Vector2.new(0.5, 0),
		BackgroundTransparency = 1,
		Visible = false,
		Parent = layer,
	})
	Kit.AutoScale(hint)
	local _, body = Kit.Panel({ Size = UDim2.fromScale(1, 1), Rotation = -1, Gradient = "Gold", Parent = hint })
	hintIcon = Kit.Text({ Size = UDim2.fromOffset(60, 60), Position = UDim2.fromOffset(8, 7), Text = "🥚", FontFace = Kit.Fonts.Body, Stroke = false, ZIndex = 4, Parent = body })
	Kit.Wobble(hintIcon, 8, 0.7)
	hintText = Kit.Text({ Size = UDim2.new(1, -86, 1, -14), Position = UDim2.fromOffset(74, 7), Text = "", FontFace = Kit.Fonts.Body, TextColor3 = C.Ink, Stroke = false, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 4, Parent = body })

	guide = Guide.new(C.Radioactive)
	carryGuide = Guide.new(C.Gold)

	local saved = State.Get("Tutorial") or 0
	if saved < 5 then
		setStep(saved)
	end

	FxBus.On("Hatch", function()
		if step == 0 then
			task.delay(4, function()
				advance(1)
			end)
		end
	end)
	FxBus.On("Collect", function()
		if step == 1 then
			advance(2)
		end
	end)
	State.Changed("Stats"):Connect(function(stats)
		if step == 2 and stats.EggsBought > 0 then
			advance(3)
		elseif step == 3 and (stats.Locks or 0) > 0 then
			advance(4)
		end
	end)
	State.Changed("Kaijus"):Connect(function(list)
		if step == 0 then
			for _, rec in list do
				if not rec.Egg then
					advance(1)
					break
				end
			end
		end
	end)

	RunService.Heartbeat:Connect(function()
		-- étapes chronométrées
		if step == 3 and os.clock() - stepStarted > 25 then
			advance(4)
		elseif step == 4 and os.clock() - stepStarted > 12 then
			advance(5)
		end
		-- cible du guide
		local plot = myPlot()
		if step == 0 then
			guide:Point(myFirstKaijuAnchor())
		elseif step == 1 and plot then
			guide:Point(plot:FindFirstChild("CollectorPad"))
		elseif step == 2 then
			local m = nearestMeteor()
			if m then
				guide:Point(m)
			else
				guide:Hide()
			end
		elseif step == 3 then
			guide:Hide()
		elseif step == 4 then
			local index = player:GetAttribute("Plot") or 1
			local other = (index % Layout.PlotCount) + 1
			local map = Workspace:FindFirstChild("Map")
			local target = map and map:FindFirstChild("Plot" .. other)
			if target and target:GetAttribute("OwnerId") then
				guide:Point(target:FindFirstChild("Floor"))
			else
				guide:Hide()
			end
		else
			guide:Hide()
		end
		-- le bandeau s'efface pendant un vol (le panneau de portage prend sa place)
		local carrying = (player:GetAttribute("Carrying") or "") ~= ""
		hint.Visible = STEPS[step] ~= nil and not carrying
		-- pendant un vol : flèches dorées vers sa propre île
		if carrying and plot then
			carryGuide:Point(plot:FindFirstChild("Floor"))
		else
			carryGuide:Hide()
		end
	end)
end

return Tutorial
]]></string>
            </Properties>
          </Item>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="Workspace" referent="90">
    <Properties>
      <string name="Name">Workspace</string>
      <float name="Gravity">196.2</float>
      <bool name="NeedsPivotMigration">false</bool>
    </Properties>
  </Item>
</roblox>