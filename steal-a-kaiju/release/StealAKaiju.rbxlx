        <Item class="ModuleScript" referent="7">
          <Properties>
            <string name="Name">Economy</string>
            <string name="Source"><![CDATA[--!strict
-- Tous les réglages chiffrés de l'économie, en un seul endroit.

local Economy = {}

Economy.StartCash = 100
Economy.StartGems = 10

-- Nids --------------------------------------------------------------------
Economy.StartNests = 6
Economy.MaxNests = 16 -- hors gamepass
Economy.PassBonusNests = 3
Economy.NestBasePrice = 400
Economy.NestPriceGrowth = 3.2

function Economy.NestPrice(currentNests: number): number
	local bought = currentNests - Economy.StartNests
	return math.floor(Economy.NestBasePrice * Economy.NestPriceGrowth ^ bought)
end

-- Améliorations (achetées en cash) ----------------------------------------
export type Upgrade = {
	Id: string,
	Name: string,
	Description: string,
	Icon: string,
	MaxLevel: number,
	BasePrice: number,
	Growth: number,
	PerLevel: number,
}

Economy.Upgrades = {
	{ Id = "Shield", Name = "Shield Generator", Description = "+10s base shield duration", Icon = "🛡️", MaxLevel = 6, BasePrice = 900, Growth = 4.5, PerLevel = 10 },
	{ Id = "Sneakers", Name = "Rocket Sneakers", Description = "+2 walk speed", Icon = "👟", MaxLevel = 6, BasePrice = 600, Growth = 4, PerLevel = 2 },
	{ Id = "Muscles", Name = "Kaiju Muscles", Description = "+8% speed while carrying", Icon = "💪", MaxLevel = 6, BasePrice = 1200, Growth = 4.2, PerLevel = 0.08 },
	{ Id = "Bonker", Name = "Mega Bonker", Description = "+1.5 bonk range, faster swings", Icon = "🔨", MaxLevel = 6, BasePrice = 1000, Growth = 4, PerLevel = 1.5 },
	{ Id = "Reactor", Name = "Cash Reactor", Description = "+10% cash from all kaijus", Icon = "⚛️", MaxLevel = 10, BasePrice = 2500, Growth = 3.6, PerLevel = 0.1 },
} :: { Upgrade }

Economy.UpgradesById = {} :: { [string]: Upgrade }
for _, u in Economy.Upgrades do
	Economy.UpgradesById[u.Id] = u
end

function Economy.UpgradePrice(id: string, level: number): number
	local u = Economy.UpgradesById[id]
	return math.floor(u.BasePrice * u.Growth ^ level)
end

-- Bouclier ------------------------------------------------------------------
Economy.ShieldBase = 50
Economy.ShieldCooldown = 20 -- après la fin du bouclier avant de pouvoir le réactiver
Economy.NewPlayerProtection = 150 -- secondes de protection à l'arrivée

-- Vol -----------------------------------------------------------------------
Economy.StealMaxCarryTime = 75 -- au-delà, le kaiju rentre chez lui
Economy.HelperMaxDistance = 22 -- porteurs d'un Titan trop éloignés = il tombe
Economy.LiftWaitTime = 12 -- temps pour qu'un deuxième voleur aide à soulever
Economy.HelperCut = 0.2 -- part (en secondes de revenu x 60) donnée à l'aide
Economy.StealCooldown = 3

-- Bonk ----------------------------------------------------------------------
Economy.BonkRange = 9
Economy.BonkCooldown = 0.9
Economy.BonkKnockback = 70

-- Météores ------------------------------------------------------------------
Economy.MeteorInterval = 14 -- secondes entre deux météores dans le cratère
Economy.MeteorLifetime = 45 -- durée de vie d'un œuf non acheté
Economy.MeteorPads = 6
Economy.PersonalMeteorInterval = 150 -- météore perso sur ton île
Economy.PersonalMeteorLifetime = 60
Economy.FreeFirstEggMaxOrder = 2 -- le tout premier œuf acheté est offert s'il est Commun ou Rare

-- Collecteur ----------------------------------------------------------------
Economy.OfflineMaxHours = 3
Economy.OfflineMaxHoursPass = 8
Economy.OfflineRate = 0.5

-- Nourriture : saute une partie (Cut) du temps restant du stade.
-- Prix = revenu/s actuel x secondes sautées x Ratio (moins cher en gros).
export type Food = { Id: string, Name: string, Icon: string, Ratio: number, Cut: number, MinPrice: number }
Economy.Foods = {
	{ Id = "Snack", Name = "Kaiju Snack", Icon = "🍖", Ratio = 1, Cut = 0.15, MinPrice = 40 },
	{ Id = "Feast", Name = "Monster Feast", Icon = "🍗", Ratio = 0.9, Cut = 0.4, MinPrice = 250 },
	{ Id = "Steak", Name = "Meteor Steak", Icon = "🥩", Ratio = 0.8, Cut = 1, MinPrice = 1200 },
} :: { Food }

Economy.FoodsById = {} :: { [string]: Food }
for _, f in Economy.Foods do
	Economy.FoodsById[f.Id] = f
end

-- Vente -------------------------------------------------------------------
Economy.SellBase = 0.6 -- x prix d'achat (ou revenu x 250 pour les Secrets)

-- Rebirth (Évolution) -------------------------------------------------------
export type Rebirth = { Cost: number, NeedRarity: string, Mult: number, Luck: number, Gems: number, EggRarity: string }
Economy.Rebirths = {} :: { Rebirth }
do
	local needs = { "Epic", "Epic", "Legendary", "Legendary", "Legendary", "Mythic", "Mythic", "Mythic", "Celestial", "Celestial" }
	local eggs = { "Rare", "Epic", "Epic", "Legendary", "Legendary", "Legendary", "Mythic", "Mythic", "Mythic", "Celestial" }
	for i = 1, 25 do
		table.insert(Economy.Rebirths, {
			Cost = math.floor(8000000 * 6 ^ (i - 1)),
			NeedRarity = needs[math.min(i, #needs)],
			Mult = 1 + 0.5 * i, -- multiplicateur cumulé après ce rebirth
			Luck = 1 + 0.1 * i,
			Gems = 25 * i,
			EggRarity = eggs[math.min(i, #eggs)],
		})
	end
end

-- Chance & multiplicateurs -------------------------------------------------
Economy.FriendBoostPer = 0.1
Economy.FriendBoostMax = 0.4
Economy.PremiumBoost = 0.1
Economy.GroupBoost = 0.05
Economy.IndexBoostPerSpecies = 0.01

-- Potions (achetées en gemmes) -------------------------------------------
export type Potion = { Id: string, Name: string, Icon: string, Duration: number, GemPrice: number, Description: string }
Economy.Potions = {
	{ Id = "Luck", Name = "Luck Potion", Icon = "🍀", Duration = 600, GemPrice = 15, Description = "x2 personal luck for 10 min" },
	{ Id = "Growth", Name = "Growth Potion", Icon = "🌱", Duration = 600, GemPrice = 20, Description = "x2 growth speed for 10 min" },
	{ Id = "Cash", Name = "Cash Potion", Icon = "💸", Duration = 600, GemPrice = 25, Description = "x2 cash for 10 min" },
} :: { Potion }
Economy.PotionsById = {} :: { [string]: Potion }
for _, p in Economy.Potions do
	Economy.PotionsById[p.Id] = p
end

-- Roue ----------------------------------------------------------------------
Economy.FreeSpinCooldown = 4 * 3600
Economy.SpinGemPrice = 12

return Economy
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="8">
          <Properties>
            <string name="Name">Events</string>
            <string name="Source"><![CDATA[--!strict
-- Événements mondiaux : ils changent l'ambiance de toute la map et
-- les règles du jeu pendant quelques minutes.

export type WorldEvent = {
	Id: string,
	Name: string,
	Tagline: string,
	Icon: string,
	Color: Color3,
	Duration: number,
	Weight: number, -- poids de tirage dans la rotation automatique
	MeteorRate: number, -- multiplicateur de fréquence des météores
	Luck: number, -- chance serveur (météores du cratère)
	CashMult: number,
	Mutation: string?, -- mutation offerte par l'événement
	MutationChance: number?, -- chance à l'éclosion pendant l'événement
	InfectChance: number?, -- chance/10s qu'un kaiju en base soit touché
	Music: string?,
	Lighting: { [string]: any },
}

local rgb = Color3.fromRGB

local Events = {}

Events.FirstDelay = 150 -- premier événement après le démarrage du serveur
Events.Gap = { 330, 480 } -- pause aléatoire entre deux événements

Events.List = {
	{
		Id = "MeteorShower",
		Name = "METEOR SHOWER",
		Tagline = "The sky is falling! x3 meteors & x2 luck",
		Icon = "🌠",
		Color = rgb(255, 106, 31),
		Duration = 150,
		Weight = 30,
		MeteorRate = 3,
		Luck = 2,
		CashMult = 1,
		Music = "music_event",
		Lighting = { ClockTime = 20.5, Ambient = rgb(90, 50, 60), Tint = rgb(255, 200, 170), FogColor = rgb(80, 40, 60), FogEnd = 1400 },
	},
	{
		Id = "BloodMoon",
		Name = "BLOOD MOON",
		Tagline = "Blood mutations appear on hatch and in bases",
		Icon = "🌕",
		Color = rgb(220, 30, 50),
		Duration = 150,
		Weight = 18,
		MeteorRate = 1.5,
		Luck = 1.3,
		CashMult = 1,
		Mutation = "Blood",
		MutationChance = 0.25,
		InfectChance = 0.012,
		Music = "music_event",
		Lighting = { ClockTime = 0.2, Ambient = rgb(120, 20, 30), Tint = rgb(255, 150, 150), FogColor = rgb(90, 0, 10), FogEnd = 900 },
	},
	{
		Id = "Radioactive",
		Name = "RADIOACTIVE STORM",
		Tagline = "Toxic rain! Radioactive mutations (x6)",
		Icon = "☢️",
		Color = rgb(110, 255, 60),
		Duration = 120,
		Weight = 12,
		MeteorRate = 1.3,
		Luck = 1.2,
		CashMult = 1,
		Mutation = "Radioactive",
		MutationChance = 0.18,
		InfectChance = 0.008,
		Music = "music_event",
		Lighting = { ClockTime = 17.8, Ambient = rgb(40, 110, 30), Tint = rgb(200, 255, 170), FogColor = rgb(40, 90, 20), FogEnd = 700 },
	},
	{
		Id = "GoldenHour",
		Name = "GOLDEN HOUR",
		Tagline = "x2 cash for everyone!",
		Icon = "🌅",
		Color = rgb(255, 196, 40),
		Duration = 180,
		Weight = 22,
		MeteorRate = 1,
		Luck = 1,
		CashMult = 2,
		Mutation = "Gold",
		MutationChance = 0.12,
		Lighting = { ClockTime = 17.6, Ambient = rgb(140, 100, 40), Tint = rgb(255, 220, 160), FogColor = rgb(255, 190, 120), FogEnd = 2500 },
	},
	{
		Id = "Aurora",
		Name = "COSMIC AURORA",
		Tagline = "Galaxy mutations (x8) rain from the sky",
		Icon = "🌌",
		Color = rgb(120, 60, 255),
		Duration = 120,
		Weight = 8,
		MeteorRate = 1.5,
		Luck = 1.5,
		CashMult = 1,
		Mutation = "Galaxy",
		MutationChance = 0.12,
		InfectChance = 0.005,
		Music = "music_event",
		Lighting = { ClockTime = 23.5, Ambient = rgb(60, 40, 140), Tint = rgb(200, 180, 255), FogColor = rgb(30, 10, 70), FogEnd = 1600 },
	},
	{
		Id = "Stampede",
		Name = "CASH STAMPEDE",
		Tagline = "Grab the orbs dropped in the crater!",
		Icon = "🦖",
		Color = rgb(90, 220, 110),
		Duration = 90,
		Weight = 18,
		MeteorRate = 1,
		Luck = 1,
		CashMult = 1,
		Lighting = { ClockTime = 13, Ambient = rgb(100, 120, 90), Tint = rgb(230, 255, 220), FogColor = rgb(200, 230, 200), FogEnd = 3000 },
	},
	{
		Id = "BossRaid",
		Name = "COLOSSAL RAID",
		Tagline = "A giant kaiju attacks! Bonk it together!",
		Icon = "👹",
		Color = rgb(255, 45, 110),
		Duration = 180,
		Weight = 10,
		MeteorRate = 0,
		Luck = 1,
		CashMult = 1,
		Music = "music_boss",
		Lighting = { ClockTime = 19, Ambient = rgb(90, 30, 60), Tint = rgb(255, 190, 210), FogColor = rgb(60, 10, 40), FogEnd = 1200 },
	},
} :: { WorldEvent }

Events.ById = {} :: { [string]: WorldEvent }
for _, e in Events.List do
	Events.ById[e.Id] = e
end

-- Raid de boss
Events.Boss = {
	Health = 400, -- PV par joueur présent (mis à l'échelle au lancement)
	MinHealth = 600,
	DamagePerBonk = 10,
	RewardGems = 30,
	TopEggRarity = "Mythic",
	EggChance = 0.25, -- chance d'œuf Légendaire pour chaque participant
}

-- Orbes de la Stampede
Events.Stampede = {
	OrbsPerWave = 14,
	WaveEvery = 6,
	OrbCashSeconds = 12, -- secondes de revenu par orbe
	OrbMinCash = 25,
}

return Events
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="9">
          <Properties>
            <string name="Name">Growth</string>
            <string name="Source"><![CDATA[--!strict
-- Croissance : 5 stades. La taille grandit physiquement, les revenus aussi,
-- mais plus un kaiju est gros, plus il est lent (et difficile) à voler.

export type Stage = {
	Index: number,
	Name: string,
	Scale: number, -- échelle du modèle
	IncomeMult: number,
	Carriers: number, -- joueurs nécessaires pour le porter
	CarrySpeed: number, -- multiplicateur de vitesse du porteur
	ToNext: number, -- secondes (à vitesse x1, rareté Commune) pour passer au stade suivant
	SellMult: number,
}

local Growth = {}

Growth.Stages = {
	{ Index = 1, Name = "Baby", Scale = 1, IncomeMult = 1, Carriers = 1, CarrySpeed = 0.85, ToNext = 60, SellMult = 0.5 },
	{ Index = 2, Name = "Teen", Scale = 1.45, IncomeMult = 2.5, Carriers = 1, CarrySpeed = 0.72, ToNext = 180, SellMult = 1.1 },
	{ Index = 3, Name = "Adult", Scale = 2.05, IncomeMult = 6, Carriers = 1, CarrySpeed = 0.58, ToNext = 600, SellMult = 2.4 },
	{ Index = 4, Name = "Titan", Scale = 2.9, IncomeMult = 15, Carriers = 2, CarrySpeed = 0.5, ToNext = 1800, SellMult = 5.5 },
	{ Index = 5, Name = "Colossus", Scale = 4, IncomeMult = 40, Carriers = 2, CarrySpeed = 0.42, ToNext = math.huge, SellMult = 13 },
} :: { Stage }

-- Les raretés élevées grandissent plus lentement.
Growth.RarityTimeMult = {
	Common = 1,
	Rare = 1.3,
	Epic = 1.7,
	Legendary = 2.2,
	Mythic = 3,
	Celestial = 4,
	Secret = 5,
} :: { [string]: number }

Growth.MaxStage = #Growth.Stages

function Growth.Get(stage: number): Stage
	return Growth.Stages[math.clamp(stage, 1, Growth.MaxStage)]
end

-- Secondes de croissance cumulées nécessaires pour atteindre `stage`.
function Growth.Threshold(stage: number, rarity: string): number
	local mult = Growth.RarityTimeMult[rarity] or 1
	local total = 0
	for i = 1, stage - 1 do
		total += Growth.Stages[i].ToNext * mult
	end
	return total
end

-- Stade atteint pour `growth` secondes cumulées.
function Growth.StageFor(growth: number, rarity: string): number
	local stage = 1
	for i = 2, Growth.MaxStage do
		if growth >= Growth.Threshold(i, rarity) then
			stage = i
		else
			break
		end
	end
	return stage
end

-- Progression 0..1 vers le prochain stade.
function Growth.Progress(growth: number, rarity: string): number
	local stage = Growth.StageFor(growth, rarity)
	if stage >= Growth.MaxStage then
		return 1
	end
	local a = Growth.Threshold(stage, rarity)
	local b = Growth.Threshold(stage + 1, rarity)
	return math.clamp((growth - a) / (b - a), 0, 1)
end

-- Secondes restantes avant le prochain stade (à vitesse x1).
function Growth.Remaining(growth: number, rarity: string): number
	local stage = Growth.StageFor(growth, rarity)
	if stage >= Growth.MaxStage then
		return 0
	end
	return math.max(0, Growth.Threshold(stage + 1, rarity) - growth)
end

return Growth
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="10">
          <Properties>
            <string name="Name">Kaijus</string>
            <string name="Source"><![CDATA[--!strict
-- Roster des kaijus. Chaque espèce est décrite par des données : le KaijuBuilder
-- (partagé client/serveur) en fabrique le modèle 3D à partir de l'archétype,
-- des couleurs et des accessoires.

export type Species = {
	Id: string,
	Name: string,
	Rarity: string,
	Income: number, -- $/s au stade Bébé, sans multiplicateurs
	Price: number, -- prix du météore (0 = non achetable)
	Archetype: string, -- Rex | Quad | Serpent | Bird | Blob | Crab | Food | Mech | Squid
	Shape: string?, -- variante pour Food (Toast, Croissant, Kebab, Pizza, Donut, Sushi)
	Primary: Color3,
	Secondary: Color3,
	Accent: Color3,
	Accessories: { string },
	Flavor: string,
	Recipe: { string }?, -- pour les Secrets : les deux espèces à fusionner
	Hint: string?,
}

local rgb = Color3.fromRGB

local function S(
	id: string,
	name: string,
	rarity: string,
	income: number,
	payback: number,
	archetype: string,
	primary: Color3,
	secondary: Color3,
	accent: Color3,
	accessories: { string },
	flavor: string,
	shape: string?
): Species
	return {
		Id = id,
		Name = name,
		Rarity = rarity,
		Income = income,
		Price = math.floor(income * payback),
		Archetype = archetype,
		Shape = shape,
		Primary = primary,
		Secondary = secondary,
		Accent = accent,
		Accessories = accessories,
		Flavor = flavor,
	}
end

local List: { Species } = {
	-- COMMON ---------------------------------------------------------------
	S("Toastzilla", "Toastzilla", "Common", 1, 30, "Food", rgb(222, 164, 92), rgb(250, 226, 170), rgb(120, 70, 40), {}, "Slightly burnt. Extremely angry.", "Toast"),
	S("Gloop", "Gloop", "Common", 1.5, 30, "Blob", rgb(120, 230, 120), rgb(200, 255, 190), rgb(40, 120, 60), { "Antenna" }, "Eats everything. Mostly socks."),
	S("Pinchy", "Pinchy", "Common", 2, 30, "Crab", rgb(255, 110, 80), rgb(255, 190, 150), rgb(160, 40, 30), {}, "Pinches first, asks never."),
	S("DinoNugget", "Dino Nugget", "Common", 2.5, 30, "Rex", rgb(230, 170, 70), rgb(250, 215, 130), rgb(170, 100, 30), {}, "Crispy outside, fierce inside."),
	S("Wormzy", "Wormzy", "Common", 3, 30, "Serpent", rgb(255, 140, 190), rgb(255, 210, 230), rgb(200, 70, 120), { "Antenna" }, "Wiggles menacingly."),
	S("Pigeonator", "Pigeonator", "Common", 3.5, 30, "Bird", rgb(150, 160, 180), rgb(200, 205, 220), rgb(90, 200, 150), {}, "Has seen things on the rooftops."),

	-- RARE -----------------------------------------------------------------
	S("Sharkapillar", "Sharkapillar", "Rare", 6, 60, "Serpent", rgb(90, 130, 170), rgb(230, 235, 240), rgb(40, 60, 90), { "Fin", "Teeth" }, "Half shark. Half caterpillar. All bite."),
	S("Croissantosaurus", "Croissantosaurus", "Rare", 7, 60, "Food", rgb(230, 160, 60), rgb(250, 210, 120), rgb(150, 90, 30), { "Spikes" }, "Flaky. Buttery. Apex predator.", "Croissant"),
	S("Frostodon", "Frostodon", "Rare", 8, 60, "Quad", rgb(150, 220, 255), rgb(235, 250, 255), rgb(60, 140, 220), { "Spikes", "Horn" }, "Leaves a trail of tiny snowflakes."),
	S("ThunderSquid", "Thunder Squid", "Rare", 9, 60, "Squid", rgb(255, 225, 60), rgb(255, 245, 170), rgb(120, 90, 255), { "Bolt" }, "Charges up during storms."),
	S("Kebabzilla", "Kebabzilla", "Rare", 10, 60, "Food", rgb(190, 110, 60), rgb(240, 220, 170), rgb(80, 170, 60), {}, "Spins on its own axis. Constantly.", "Kebab"),
	S("BeepBoop", "Beep Boop", "Rare", 12, 60, "Mech", rgb(200, 205, 215), rgb(120, 130, 150), rgb(60, 220, 255), { "Antenna", "Visor" }, "Runs on vibes and AA batteries."),

	-- EPIC -----------------------------------------------------------------
	S("SushiRex", "Sushi Rex", "Epic", 30, 120, "Rex", rgb(250, 250, 245), rgb(255, 120, 80), rgb(30, 60, 40), { "Nori" }, "Fresh catch of the day. Bites back."),
	S("Robotank", "Robotank", "Epic", 35, 120, "Mech", rgb(90, 120, 80), rgb(60, 70, 60), rgb(255, 80, 60), { "Cannon", "Visor" }, "Treads? Legs? Why not both."),
	S("Magmadillo", "Magmadillo", "Epic", 40, 120, "Quad", rgb(60, 40, 40), rgb(255, 110, 30), rgb(255, 200, 60), { "Shell", "Glow" }, "Warm hugs. Very warm. Too warm."),
	S("Bananadon", "Bananadon", "Epic", 45, 120, "Rex", rgb(255, 225, 70), rgb(255, 245, 180), rgb(110, 80, 30), { "Spikes" }, "Slippery when defeated."),
	S("Crabzooka", "Crabzooka", "Epic", 50, 120, "Crab", rgb(80, 90, 110), rgb(255, 150, 60), rgb(255, 60, 60), { "Cannon" }, "Fires bubbles at 300 km/h."),
	S("Pizzapocalypse", "Pizzapocalypse", "Epic", 60, 120, "Food", rgb(255, 190, 70), rgb(255, 240, 150), rgb(210, 50, 40), { "Cheese" }, "The final slice.", "Pizza"),

	-- LEGENDARY ------------------------------------------------------------
	S("Rexplosion", "Rexplosion", "Legendary", 180, 240, "Rex", rgb(60, 110, 70), rgb(120, 170, 110), rgb(90, 255, 200), { "Spikes", "Glow" }, "Its roar has been measured on the Richter scale."),
	S("KawaiiKraken", "Kawaii Kraken", "Legendary", 200, 240, "Squid", rgb(255, 150, 210), rgb(255, 220, 240), rgb(255, 90, 160), { "Bow", "Blush" }, "Adorable. Has sunk 400 ships."),
	S("ThunderGoose", "Thunder Goose", "Legendary", 220, 240, "Bird", rgb(250, 250, 255), rgb(255, 170, 40), rgb(80, 180, 255), { "Bolt", "Glow" }, "HONK. (Thunder sounds.)"),
	S("Donutron", "Donutron", "Legendary", 250, 240, "Food", rgb(210, 140, 80), rgb(255, 120, 190), rgb(120, 230, 255), { "Sprinkles", "Visor" }, "Part donut, part war machine.", "Donut"),
	S("Drakonda", "Drakonda", "Legendary", 280, 240, "Serpent", rgb(170, 30, 50), rgb(255, 190, 80), rgb(255, 120, 30), { "Wings", "Horn", "Glow" }, "A dragon that refused to grow legs."),

	-- MYTHIC ---------------------------------------------------------------
	S("Kaijumbo", "Kaijumbo", "Mythic", 1000, 480, "Quad", rgb(140, 150, 200), rgb(200, 210, 240), rgb(255, 230, 120), { "Tusks", "Crown" }, "Never forgets who stole from it."),
	S("Nebulodon", "Nebulodon", "Mythic", 1200, 480, "Rex", rgb(40, 30, 90), rgb(120, 80, 220), rgb(255, 255, 255), { "Spikes", "Glow", "Stars" }, "Made of 30% dinosaur, 70% space."),
	S("Hydroblob", "Hydroblob", "Mythic", 1400, 480, "Blob", rgb(40, 170, 255), rgb(170, 230, 255), rgb(0, 90, 200), { "Crown", "Glow" }, "Three blobs in a trench coat."),
	S("Crabageddon", "Crabageddon", "Mythic", 1600, 480, "Crab", rgb(40, 20, 30), rgb(255, 60, 60), rgb(255, 200, 40), { "Spikes", "Glow", "Crown" }, "The end is near. And pinchy."),

	-- CELESTIAL ------------------------------------------------------------
	S("SolarisRex", "Solaris Rex", "Celestial", 7000, 900, "Rex", rgb(255, 170, 30), rgb(255, 240, 150), rgb(255, 90, 20), { "Halo", "Glow", "Spikes" }, "It rises in the east every morning."),
	S("LunarSquid", "Lunar Squid", "Celestial", 8000, 900, "Squid", rgb(200, 210, 255), rgb(250, 250, 255), rgb(120, 140, 255), { "Halo", "Glow", "Stars" }, "Controls the tides. And your wifi."),
	S("CosmoGoose", "Cosmo Goose", "Celestial", 9000, 900, "Bird", rgb(30, 20, 60), rgb(90, 60, 200), rgb(80, 255, 230), { "Halo", "Glow", "Stars", "Wings" }, "Honks in 11 dimensions."),
}

-- SECRETS : uniquement par fusion (recette) ----------------------------------
local function Secret(
	id: string,
	name: string,
	income: number,
	archetype: string,
	primary: Color3,
	secondary: Color3,
	accent: Color3,
	accessories: { string },
	flavor: string,
	recipe: { string },
	hint: string,
	shape: string?
)
	local s = S(id, name, "Secret", income, 250, archetype, primary, secondary, accent, accessories, flavor, shape)
	s.Price = 0
	s.Recipe = recipe
	s.Hint = hint
	table.insert(List, s)
end

Secret("SharktoastSupreme", "Sharktoast Supreme", 40000, "Food", rgb(90, 130, 170), rgb(222, 164, 92), rgb(255, 255, 255), { "Fin", "Teeth", "Glow" }, "Breakfast has teeth now.", { "Toastzilla", "Sharkapillar" }, "Fuse bread with a fin.", "Toast")
Secret("CroissantKraken", "Croissant Kraken", 50000, "Squid", rgb(230, 160, 60), rgb(250, 210, 120), rgb(255, 90, 160), { "Crown", "Glow" }, "Unleash the pastry.", { "Croissantosaurus", "KawaiiKraken" }, "A flaky friend meets the deep.")
Secret("NuclearPigeon", "Nuclear Pigeon", 60000, "Bird", rgb(90, 255, 90), rgb(40, 80, 40), rgb(255, 255, 80), { "Glow", "Bolt", "Crown" }, "Do NOT feed it bread.", { "Pigeonator", "ThunderGoose" }, "Two birds, one storm.")
Secret("OmegaSushiMech", "Omega Sushi Mech", 70000, "Mech", rgb(250, 250, 245), rgb(255, 120, 80), rgb(60, 220, 255), { "Cannon", "Visor", "Nori", "Glow" }, "Sashimi-grade firepower.", { "SushiRex", "Robotank" }, "Raw fish, heavy metal.")
Secret("InfiniteBlob", "The Infinite Blob", 80000, "Blob", rgb(255, 255, 255), rgb(200, 120, 255), rgb(80, 255, 230), { "Halo", "Glow", "Stars" }, "It's blobs all the way down.", { "Gloop", "Hydroblob" }, "The smallest and the biggest goo.")
Secret("KingKaiju", "KING KAIJU", 120000, "Rex", rgb(20, 20, 30), rgb(255, 200, 40), rgb(255, 60, 60), { "Crown", "Spikes", "Glow", "Halo" }, "Bow before the king.", { "Rexplosion", "SolarisRex" }, "Two tyrants. One throne.")

local ById: { [string]: Species } = {}
local ByRarity: { [string]: { Species } } = {}
for index, s in List do
	assert(ById[s.Id] == nil, "Kaiju en double : " .. s.Id)
	ById[s.Id] = s
	ByRarity[s.Rarity] = ByRarity[s.Rarity] or {}
	table.insert(ByRarity[s.Rarity], s)
	;(s :: any).Index = index
end

local Kaijus = {
	List = List,
	ById = ById,
	ByRarity = ByRarity,
}

function Kaijus.Get(id: string): Species?
	return ById[id]
end

-- Renvoie l'espèce secrète produite par la fusion de a et b (dans n'importe quel ordre).
function Kaijus.FindRecipe(a: string, b: string): Species?
	for _, s in List do
		local r = s.Recipe
		if r and ((r[1] == a and r[2] == b) or (r[1] == b and r[2] == a)) then
			return s
		end
	end
	return nil
end

return Kaijus
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="11">
          <Properties>
            <string name="Name">Layout</string>
            <string name="Source"><![CDATA[--!strict
-- Géométrie de la carte (partagée : le serveur construit, le client s'en sert
-- pour les flèches, le dôme de bouclier, etc.).
--
-- Le cratère est au centre (0,0,0). Les 8 îles sont en cercle ; l'avant de
-- chaque île (-Z local) regarde le cratère.

local Layout = {}

Layout.PlotCount = 8
Layout.PlotRadius = 250
Layout.PlotWidth = 100
Layout.PlotDepth = 116
Layout.GroundY = 0
Layout.CraterRadius = 74
Layout.BridgeWidth = 22

-- CFrame du centre de l'île i (1..8), au niveau du sol, face au cratère.
function Layout.PlotCFrame(i: number): CFrame
	local angle = (i - 1) / Layout.PlotCount * math.pi * 2
	local pos = Vector3.new(math.sin(angle) * Layout.PlotRadius, Layout.GroundY, math.cos(angle) * Layout.PlotRadius)
	return CFrame.lookAt(pos, Vector3.new(0, Layout.GroundY, 0))
end

-- Nids : 5 colonnes x 4 rangées, remplis de l'arrière (plus sûr) vers l'avant.
Layout.Nests = {} :: { Vector3 }
do
	local rows = { 34, 14, -6, -26 }
	local cols = { -36, -18, 0, 18, 36 }
	-- ordre : centre d'abord, puis vers l'extérieur
	local colOrder = { 3, 2, 4, 1, 5 }
	for _, z in rows do
		for _, c in colOrder do
			table.insert(Layout.Nests, Vector3.new(cols[c], 0, z))
		end
	end
end

Layout.Collector = Vector3.new(0, 0, 50)
Layout.LockButton = Vector3.new(-30, 0, 50)
Layout.PersonalPad = Vector3.new(30, 0, 50)
Layout.Spawn = Vector3.new(0, 3, 43)
Layout.Gate = Vector3.new(0, 0, -Layout.PlotDepth / 2)
Layout.Sign = Vector3.new(0, 0, -Layout.PlotDepth / 2 - 4)

-- Plateformes des météores dans le cratère.
function Layout.MeteorPad(i: number, count: number): Vector3
	local angle = (i - 0.5) / count * math.pi * 2
	return Vector3.new(math.sin(angle) * 38, Layout.GroundY, math.cos(angle) * 38)
end

-- Vrai si la position monde est sur l'île (rectangle local, marge incluse).
function Layout.InPlot(plotCf: CFrame, worldPos: Vector3, margin: number?): boolean
	local p = plotCf:PointToObjectSpace(worldPos)
	local m = margin or 0
	return math.abs(p.X) <= Layout.PlotWidth / 2 + m and math.abs(p.Z) <= Layout.PlotDepth / 2 + m and p.Y > -10 and p.Y < 160
end

return Layout
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="12">
          <Properties>
            <string name="Name">Monetization</string>
            <string name="Source"><![CDATA[--!strict
-- Boutique Premium (Robux).
--
-- ⚠️ À CONFIGURER : crée chaque Game Pass et Developer Product sur le Creator Hub,
-- puis colle son identifiant dans le champ `Id`. Tant que `Id = 0`, l'achat est
-- simulé gratuitement DANS STUDIO UNIQUEMENT (pour les playtests) et désactivé
-- en ligne.

export type Pass = {
	Key: string,
	Id: number,
	Name: string,
	Description: string,
	Icon: string,
	Robux: number, -- prix conseillé (affiché si le prix réel n'est pas disponible)
	Color: Color3,
	Featured: boolean?,
	Random: boolean?, -- lié au hasard payant : masqué si ArePaidRandomItemsRestricted
}

export type Product = {
	Key: string,
	Id: number,
	Name: string,
	Description: string,
	Icon: string,
	Robux: number,
	Category: string, -- Cash | Gems | Boost | Kaiju | Server | Pack
	Amount: number?,
	Color: Color3,
	OneTime: boolean?,
	Random: boolean?,
}

local rgb = Color3.fromRGB

local Monetization = {}

Monetization.Passes = {
	{ Key = "VIP", Id = 0, Name = "VIP", Description = "+20% cash, VIP tag, golden name, +1 free spin per day", Icon = "👑", Robux = 399, Color = rgb(255, 196, 40), Featured = true },
	{ Key = "DoubleCash", Id = 0, Name = "2x Cash", Description = "Double ALL cash, forever", Icon = "💰", Robux = 499, Color = rgb(90, 220, 110), Featured = true },
	{ Key = "AutoCollect", Id = 0, Name = "Auto Collect", Description = "Cash goes straight to your wallet", Icon = "🧲", Robux = 249, Color = rgb(80, 200, 255) },
	{ Key = "ExtraNests", Id = 0, Name = "+3 Nests", Description = "Three extra nest slots on your island", Icon = "🪺", Robux = 299, Color = rgb(255, 150, 60) },
	{ Key = "LuckyAura", Id = 0, Name = "Lucky Aura", Description = "x2 personal luck: better personal meteors and mutations", Icon = "🍀", Robux = 349, Color = rgb(120, 255, 140), Random = true },
	{ Key = "FastGrowth", Id = 0, Name = "Fast Growth", Description = "Your kaijus grow 50% faster", Icon = "🌱", Robux = 349, Color = rgb(190, 255, 90) },
	{ Key = "SuperBonk", Id = 0, Name = "Super Bonk", Description = "Golden bonker: bigger range and knockback", Icon = "🔨", Robux = 199, Color = rgb(255, 120, 60) },
	{ Key = "MegaShield", Id = 0, Name = "Mega Shield", Description = "Your base shield lasts twice as long", Icon = "🛡️", Robux = 199, Color = rgb(120, 140, 255) },
	{ Key = "Offline", Id = 0, Name = "Night Shift", Description = "Earn offline for up to 8 hours", Icon = "🌙", Robux = 149, Color = rgb(150, 120, 255) },
} :: { Pass }

Monetization.Products = {
	{ Key = "StarterPack", Id = 0, Name = "Starter Pack", Description = "Legendary egg + 150 gems + 2 Luck potions. Once per player!", Icon = "🎁", Robux = 99, Category = "Pack", Color = rgb(255, 90, 170), OneTime = true, Random = true },
	{ Key = "CashS", Id = 0, Name = "Pile of Cash", Description = "10 minutes of your income", Icon = "💵", Robux = 29, Category = "Cash", Amount = 600, Color = rgb(90, 220, 110), Random = true },
	{ Key = "CashM", Id = 0, Name = "Bag of Cash", Description = "1 hour of your income", Icon = "💰", Robux = 99, Category = "Cash", Amount = 3600, Color = rgb(60, 200, 90), Random = true },
	{ Key = "CashL", Id = 0, Name = "Vault of Cash", Description = "6 hours of your income", Icon = "🏦", Robux = 399, Category = "Cash", Amount = 21600, Color = rgb(30, 170, 70), Random = true },
	{ Key = "Gems100", Id = 0, Name = "100 Gems", Description = "", Icon = "💎", Robux = 49, Category = "Gems", Amount = 100, Color = rgb(80, 200, 255), Random = true },
	{ Key = "Gems550", Id = 0, Name = "550 Gems", Description = "+10% bonus", Icon = "💎", Robux = 199, Category = "Gems", Amount = 550, Color = rgb(60, 160, 255), Random = true },
	{ Key = "Gems1400", Id = 0, Name = "1,400 Gems", Description = "+40% bonus", Icon = "💎", Robux = 449, Category = "Gems", Amount = 1400, Color = rgb(60, 110, 255), Random = true },
	{ Key = "Gems3500", Id = 0, Name = "3,500 Gems", Description = "BEST VALUE", Icon = "💎", Robux = 999, Category = "Gems", Amount = 3500, Color = rgb(130, 80, 255), Random = true },
	{ Key = "InstantGrow", Id = 0, Name = "Instant Grow", Description = "Selected kaiju grows to its next stage", Icon = "⚡", Robux = 25, Category = "Kaiju", Color = rgb(190, 255, 90) },
	{ Key = "InstantHatch", Id = 0, Name = "Instant Hatch", Description = "Hatch all your eggs right now", Icon = "🥚", Robux = 19, Category = "Kaiju", Color = rgb(255, 225, 120) },
	{ Key = "ShieldNow", Id = 0, Name = "Emergency Shield", Description = "3 minute shield, no cooldown", Icon = "🛡️", Robux = 29, Category = "Boost", Color = rgb(120, 140, 255) },
	{ Key = "Spins3", Id = 0, Name = "3 Spins", Description = "Spin the Kaiju Wheel 3 times", Icon = "🎡", Robux = 79, Category = "Boost", Amount = 3, Color = rgb(255, 176, 32), Random = true },
	{ Key = "ServerLuck", Id = 0, Name = "Server Luck x2", Description = "EVERYONE gets x2 meteor luck for 15 min", Icon = "🍀", Robux = 199, Category = "Server", Color = rgb(120, 255, 140), Random = true },
	{ Key = "MeteorShower", Id = 0, Name = "Meteor Shower", Description = "Start a Meteor Shower for the whole server!", Icon = "🌠", Robux = 299, Category = "Server", Color = rgb(255, 106, 31), Random = true },
	{ Key = "BloodMoon", Id = 0, Name = "Blood Moon", Description = "Summon a Blood Moon: Blood mutations for all!", Icon = "🌕", Robux = 399, Category = "Server", Color = rgb(200, 20, 40), Random = true },
} :: { Product }

Monetization.PassByKey = {} :: { [string]: Pass }
Monetization.PassById = {} :: { [number]: Pass }
for _, p in Monetization.Passes do
	Monetization.PassByKey[p.Key] = p
	if p.Id ~= 0 then
		Monetization.PassById[p.Id] = p
	end
end

Monetization.ProductByKey = {} :: { [string]: Product }
Monetization.ProductById = {} :: { [number]: Product }
for _, p in Monetization.Products do
	Monetization.ProductByKey[p.Key] = p
	if p.Id ~= 0 then
		Monetization.ProductById[p.Id] = p
	end
end

return Monetization
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="13">
          <Properties>
            <string name="Name">Mutations</string>
            <string name="Source"><![CDATA[--!strict
-- Mutations : tirées à l'éclosion (chances de base, boostées par la chance et
-- les événements), ou appliquées par les événements mondiaux.

export type Mutation = {
	Id: string,
	Name: string,
	Mult: number,
	Chance: number, -- chance de base à l'éclosion (0..1), 0 = uniquement événement/fusion
	Color: Color3,
	TextColor: Color3,
	Material: Enum.Material?,
	Tint: Color3?, -- teinte appliquée à tout le modèle
	Reflectance: number?,
	Particles: string?, -- clé d'effet visuel côté client
	Order: number,
}

local rgb = Color3.fromRGB

local List: { Mutation } = {
	{ Id = "Gold", Name = "Gold", Mult = 2, Chance = 0.04, Color = rgb(255, 200, 40), TextColor = rgb(255, 225, 90), Material = Enum.Material.Foil, Tint = rgb(255, 196, 40), Reflectance = 0.25, Particles = "Sparkle", Order = 1 },
	{ Id = "Diamond", Name = "Diamond", Mult = 3, Chance = 0.012, Color = rgb(120, 230, 255), TextColor = rgb(170, 245, 255), Material = Enum.Material.Glass, Tint = rgb(150, 235, 255), Reflectance = 0.3, Particles = "Shine", Order = 2 },
	{ Id = "Blood", Name = "Blood Moon", Mult = 4, Chance = 0, Color = rgb(200, 20, 40), TextColor = rgb(255, 70, 80), Material = Enum.Material.SmoothPlastic, Tint = rgb(150, 15, 30), Particles = "Drip", Order = 3 },
	{ Id = "Rainbow", Name = "Rainbow", Mult = 5, Chance = 0.004, Color = rgb(255, 90, 200), TextColor = rgb(255, 255, 255), Material = Enum.Material.SmoothPlastic, Particles = "Rainbow", Order = 4 },
	{ Id = "Radioactive", Name = "Radioactive", Mult = 6, Chance = 0, Color = rgb(110, 255, 60), TextColor = rgb(160, 255, 110), Material = Enum.Material.Neon, Tint = rgb(90, 255, 60), Particles = "Toxic", Order = 5 },
	{ Id = "Galaxy", Name = "Galaxy", Mult = 8, Chance = 0, Color = rgb(120, 60, 255), TextColor = rgb(200, 170, 255), Material = Enum.Material.SmoothPlastic, Tint = rgb(45, 25, 110), Particles = "Stars", Order = 6 },
	{ Id = "Shadow", Name = "Shadow", Mult = 10, Chance = 0, Color = rgb(30, 10, 50), TextColor = rgb(190, 120, 255), Material = Enum.Material.SmoothPlastic, Tint = rgb(18, 12, 28), Particles = "Void", Order = 7 },
}

local ById: { [string]: Mutation } = {}
for _, m in List do
	ById[m.Id] = m
end

local Mutations = {
	List = List,
	ById = ById,
}

function Mutations.Get(id: string?): Mutation?
	if id == nil or id == "" then
		return nil
	end
	return ById[id]
end

function Mutations.Mult(id: string?): number
	local m = Mutations.Get(id)
	return if m then m.Mult else 1
end

return Mutations
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="14">
          <Properties>
            <string name="Name">Rarities</string>
            <string name="Source"><![CDATA[--!strict
-- Raretés des kaijus : ordre, couleurs, poids de tirage des météores, temps d'éclosion.

export type Rarity = {
	Id: string,
	Name: string,
	Order: number,
	Color: Color3,
	Glow: Color3,
	Weight: number, -- poids de tirage d'un météore (0 = introuvable dans le ciel)
	HatchTime: number, -- secondes
	PriceMult: number,
	TrailWidth: number,
	Announce: boolean, -- annonce serveur à l'apparition
}

local Rarities = {}

Rarities.List = {
	{
		Id = "Common",
		Name = "Common",
		Order = 1,
		Color = Color3.fromRGB(188, 196, 206),
		Glow = Color3.fromRGB(235, 240, 245),
		Weight = 600,
		HatchTime = 8,
		PriceMult = 1,
		TrailWidth = 3,
		Announce = false,
	},
	{
		Id = "Rare",
		Name = "Rare",
		Order = 2,
		Color = Color3.fromRGB(61, 170, 255),
		Glow = Color3.fromRGB(140, 210, 255),
		Weight = 260,
		HatchTime = 15,
		PriceMult = 1,
		TrailWidth = 4,
		Announce = false,
	},
	{
		Id = "Epic",
		Name = "Epic",
		Order = 3,
		Color = Color3.fromRGB(176, 76, 255),
		Glow = Color3.fromRGB(214, 160, 255),
		Weight = 100,
		HatchTime = 25,
		PriceMult = 1,
		TrailWidth = 5,
		Announce = false,
	},
	{
		Id = "Legendary",
		Name = "Legendary",
		Order = 4,
		Color = Color3.fromRGB(255, 176, 32),
		Glow = Color3.fromRGB(255, 225, 120),
		Weight = 30,
		HatchTime = 40,
		PriceMult = 1,
		TrailWidth = 7,
		Announce = true,
	},
	{
		Id = "Mythic",
		Name = "Mythic",
		Order = 5,
		Color = Color3.fromRGB(255, 45, 110),
		Glow = Color3.fromRGB(255, 140, 180),
		Weight = 8,
		HatchTime = 60,
		PriceMult = 1,
		TrailWidth = 9,
		Announce = true,
	},
	{
		Id = "Celestial",
		Name = "Celestial",
		Order = 6,
		Color = Color3.fromRGB(80, 255, 230),
		Glow = Color3.fromRGB(200, 255, 250),
		Weight = 1.2,
		HatchTime = 90,
		PriceMult = 1,
		TrailWidth = 12,
		Announce = true,
	},
	{
		Id = "Secret",
		Name = "SECRET",
		Order = 7,
		Color = Color3.fromRGB(20, 20, 24),
		Glow = Color3.fromRGB(255, 255, 255),
		Weight = 0, -- uniquement par fusion
		HatchTime = 120,
		PriceMult = 1,
		TrailWidth = 14,
		Announce = true,
	},
} :: { Rarity }

Rarities.ById = {} :: { [string]: Rarity }
for _, r in Rarities.List do
	Rarities.ById[r.Id] = r
end

function Rarities.Get(id: string): Rarity
	return Rarities.ById[id] or Rarities.ById.Common
end

function Rarities.Next(id: string): Rarity?
	local r = Rarities.Get(id)
	for _, other in Rarities.List do
		if other.Order == r.Order + 1 and other.Weight > 0 then
			return other
		end
	end
	return nil
end

return Rarities
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="15">
          <Properties>
            <string name="Name">Rewards</string>
            <string name="Source"><![CDATA[--!strict
-- Récompenses : quotidiennes, temps de jeu, roue, quêtes, codes, groupe.
-- Une récompense est une table { Kind, Amount?, Id?, Rarity? } :
--   Cash (Amount = secondes de revenu, min MinCash) | Gems | Potion (Id) | Egg (Rarity) | Spins

export type Reward = {
	Kind: string,
	Amount: number?,
	Id: string?,
	Rarity: string?,
	MinCash: number?,
}

local Rewards = {}

-- Série quotidienne (7 jours, en boucle ; l'œuf du jour 7 monte en rareté à chaque cycle)
Rewards.Daily = {
	{ Kind = "Cash", Amount = 120, MinCash = 250 },
	{ Kind = "Gems", Amount = 15 },
	{ Kind = "Potion", Id = "Luck", Amount = 1 },
	{ Kind = "Gems", Amount = 30 },
	{ Kind = "Potion", Id = "Growth", Amount = 2 },
	{ Kind = "Cash", Amount = 900, MinCash = 3000 },
	{ Kind = "Egg", Rarity = "Epic" },
} :: { Reward }
Rewards.DailyEggByCycle = { "Epic", "Legendary", "Legendary", "Mythic" }

-- Cadeaux de temps de jeu (minutes de session)
Rewards.Playtime = {
	{ Minutes = 1, Reward = { Kind = "Cash", Amount = 60, MinCash = 100 } },
	{ Minutes = 3, Reward = { Kind = "Gems", Amount = 5 } },
	{ Minutes = 6, Reward = { Kind = "Potion", Id = "Growth", Amount = 1 } },
	{ Minutes = 10, Reward = { Kind = "Cash", Amount = 300, MinCash = 800 } },
	{ Minutes = 15, Reward = { Kind = "Gems", Amount = 15 } },
	{ Minutes = 20, Reward = { Kind = "Potion", Id = "Luck", Amount = 1 } },
	{ Minutes = 30, Reward = { Kind = "Egg", Rarity = "Epic" } },
	{ Minutes = 40, Reward = { Kind = "Spins", Amount = 2 } },
	{ Minutes = 50, Reward = { Kind = "Gems", Amount = 40 } },
	{ Minutes = 60, Reward = { Kind = "Egg", Rarity = "Legendary" } },
} :: { { Minutes: number, Reward: Reward } }

-- Roue de la fortune : Weight = poids (les chances sont affichées en jeu)
Rewards.Wheel = {
	{ Weight = 26, Label = "Cash", Color = Color3.fromRGB(90, 220, 110), Reward = { Kind = "Cash", Amount = 300, MinCash = 500 } },
	{ Weight = 20, Label = "10 Gems", Color = Color3.fromRGB(80, 200, 255), Reward = { Kind = "Gems", Amount = 10 } },
	{ Weight = 14, Label = "Luck", Color = Color3.fromRGB(120, 255, 140), Reward = { Kind = "Potion", Id = "Luck", Amount = 1 } },
	{ Weight = 14, Label = "Growth", Color = Color3.fromRGB(190, 255, 90), Reward = { Kind = "Potion", Id = "Growth", Amount = 1 } },
	{ Weight = 10, Label = "Big Cash", Color = Color3.fromRGB(40, 180, 70), Reward = { Kind = "Cash", Amount = 1500, MinCash = 4000 } },
	{ Weight = 8, Label = "40 Gems", Color = Color3.fromRGB(60, 120, 255), Reward = { Kind = "Gems", Amount = 40 } },
	{ Weight = 5, Label = "Legendary Egg", Color = Color3.fromRGB(255, 176, 32), Reward = { Kind = "Egg", Rarity = "Legendary" } },
	{ Weight = 2.4, Label = "Mythic Egg", Color = Color3.fromRGB(255, 45, 110), Reward = { Kind = "Egg", Rarity = "Mythic" } },
	{ Weight = 0.6, Label = "CELESTIAL", Color = Color3.fromRGB(80, 255, 230), Reward = { Kind = "Egg", Rarity = "Celestial" } },
} :: { { Weight: number, Label: string, Color: Color3, Reward: Reward } }

-- Quêtes quotidiennes : 3 tirées chaque jour dans ce pool
export type QuestDef = { Id: string, Text: string, Stat: string, Goal: number, Reward: Reward }
Rewards.Quests = {
	{ Id = "Buy3", Text = "Buy %d meteor eggs", Stat = "EggsBought", Goal = 3, Reward = { Kind = "Gems", Amount = 10 } },
	{ Id = "Buy8", Text = "Buy %d meteor eggs", Stat = "EggsBought", Goal = 8, Reward = { Kind = "Gems", Amount = 25 } },
	{ Id = "Steal1", Text = "Steal %d kaiju", Stat = "Steals", Goal = 1, Reward = { Kind = "Gems", Amount = 15 } },
	{ Id = "Steal3", Text = "Steal %d kaijus", Stat = "Steals", Goal = 3, Reward = { Kind = "Gems", Amount = 35 } },
	{ Id = "Bonk5", Text = "Bonk %d players", Stat = "Bonks", Goal = 5, Reward = { Kind = "Potion", Id = "Luck", Amount = 1 } },
	{ Id = "Save2", Text = "Stop %d thieves", Stat = "Saves", Goal = 2, Reward = { Kind = "Gems", Amount = 20 } },
	{ Id = "Feed5", Text = "Feed your kaijus %d times", Stat = "Feeds", Goal = 5, Reward = { Kind = "Potion", Id = "Growth", Amount = 1 } },
	{ Id = "Grow3", Text = "Grow kaijus %d stages", Stat = "StageUps", Goal = 3, Reward = { Kind = "Gems", Amount = 15 } },
	{ Id = "Fuse1", Text = "Fuse %d kaijus", Stat = "Fusions", Goal = 1, Reward = { Kind = "Gems", Amount = 25 } },
	{ Id = "Collect", Text = "Collect cash %d times", Stat = "Collects", Goal = 10, Reward = { Kind = "Cash", Amount = 600, MinCash = 1500 } },
	{ Id = "Orbs", Text = "Grab %d stampede orbs", Stat = "Orbs", Goal = 10, Reward = { Kind = "Gems", Amount = 15 } },
	{ Id = "Hatch", Text = "Hatch %d eggs", Stat = "Hatches", Goal = 5, Reward = { Kind = "Spins", Amount = 1 } },
} :: { QuestDef }
Rewards.QuestsPerDay = 3
Rewards.AllQuestsBonus = { Kind = "Egg", Rarity = "Legendary" } :: Reward

-- Codes (à mettre à jour à chaque mise à jour du jeu)
Rewards.Codes = {
	RELEASE = { { Kind = "Gems", Amount = 50 } },
	KAIJU = { { Kind = "Potion", Id = "Luck", Amount = 2 } },
	STOMP = { { Kind = "Cash", Amount = 600, MinCash = 2000 } },
	METEOR = { { Kind = "Egg", Rarity = "Epic" } },
} :: { [string]: { Reward } }

-- Groupe Roblox (0 = désactivé)
Rewards.GroupId = 0
Rewards.GroupReward = { { Kind = "Gems", Amount = 100 }, { Kind = "Potion", Id = "Cash", Amount = 1 } } :: { Reward }

return Rewards
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="16">
          <Properties>
            <string name="Name">Sounds</string>
            <string name="Source"><![CDATA[--!strict
-- Sons du jeu.
--   Default  : son public de la bibliothèque Roblox (fonctionne tout de suite).
--   Uploaded : identifiant de la version ORIGINALE du pack assets/audio/ une fois
--              uploadée dans ton compte (prioritaire si ≠ 0).
-- Volume/PlaybackSpeed : réglages de base ; le client ajoute une légère
-- variation de hauteur pour éviter la répétition.

export type SoundDef = {
	Default: string,
	Uploaded: number,
	Volume: number,
	Speed: number?,
	Looped: boolean?,
}

local function D(id: number | string, volume: number, speed: number?, looped: boolean?): SoundDef
	local default = if typeof(id) == "number" then "rbxassetid://" .. id else id
	return { Default = default :: string, Uploaded = 0, Volume = volume, Speed = speed, Looped = looped }
end

local Sounds: { [string]: SoundDef } = {
	-- UI
	ui_click = D(15675059323, 0.5),
	ui_hover = D(17208339919, 0.25),
	ui_open = D(15675028888, 0.45),
	ui_close = D(15674975792, 0.4, 1.15),
	ui_error = D(17208214688, 0.5),
	ui_tab = D(15675032796, 0.45),
	-- Économie
	cash_collect = D(9113849492, 0.6),
	coin_tick = D(127645268874265, 0.35, 1.3),
	purchase = D(9113728049, 0.6),
	sell = D(9113726510, 0.55),
	-- Météores
	meteor_whistle = D(12222095, 0.7, 0.6),
	meteor_impact = D("rbxasset://sounds/impact_explosion_03.mp3", 0.8),
	meteor_rare_alarm = D(9126073001, 0.8),
	-- Œufs / kaijus
	egg_wobble = D(15675055424, 0.5, 0.8),
	egg_crack = D(9113263649, 0.6),
	hatch_common = D(9125640290, 0.7),
	hatch_epic = D(9116384485, 0.8),
	hatch_legendary = D(1836473422, 0.8),
	hatch_secret = D(1845411858, 0.9),
	stage_up = D(9116395089, 0.7),
	roar_small = D(9113985604, 0.5, 1.4),
	roar_big = D(9113980319, 0.8),
	-- Vol / défense
	steal_grab = D(17208319162, 0.6),
	alarm = D(9119162409, 0.55, 1, true),
	bonk = D(12222046, 0.8, 0.8),
	knockback_whoosh = D(15675012262, 0.6),
	shield_on = D(17208327798, 0.7),
	shield_zap = D(9113085801, 0.5, 1.6),
	drop = D("rbxasset://sounds/action_jump_land.mp3", 0.8),
	heist_success = D(1844584698, 0.8),
	-- Progression
	rebirth = D(9041812129, 0.9),
	fusion_charge = D(17208327798, 0.8, 0.6),
	fusion_boom = D(9126102254, 0.8),
	reward_claim = D(17208380755, 0.7),
	quest_complete = D(12222253, 0.7),
	level_jingle = D(12222253, 0.6, 1.1),
	spin_tick = D(15675032796, 0.35, 1.4),
	spin_win = D(1836301731, 0.8),
	event_horn = D(9119162409, 0.8, 0.7),
	countdown_beep = D(17208361335, 0.6),
	boss_stomp = D(9114224354, 0.9),
	whoosh = D(15675028888, 0.5),
	-- Musique
	music_main = D(9043821805, 0.32, 1, true),
	music_event = D(1842174239, 0.34, 1, true),
	music_boss = D(9046119816, 0.36, 1, true),
	music_lobby_calm = D(9043887091, 0.3, 1, true),
}

return Sounds
]]></string>
