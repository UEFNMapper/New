	---------------------------------------------------------------- stats
	local stats = Kit.new("Frame", {
		Name = "Stats",
		Size = UDim2.new(1, -8, 0, 60),
		Position = UDim2.fromOffset(2, 210),
		BackgroundTransparency = 1,
		ZIndex = 5,
		Parent = right,
	})
	ui.Stats = stats
	local function statBox(name: string, title: string, gradient: string, x: number, rot: number): TextLabel
		local holder, body = Kit.Panel({
			Name = name,
			Size = UDim2.new(0.5, -6, 1, 0),
			Position = UDim2.new(x, if x > 0 then 6 else 0, 0, 0),
			Rotation = rot,
			Gradient = gradient,
			ShadowOffset = 5,
			Parent = stats,
		})
		ui[name .. "Holder"] = holder
		Kit.Text({
			Size = UDim2.new(1, -16, 0, 18),
			Position = UDim2.fromOffset(10, 5),
			Text = title,
			TextXAlignment = Enum.TextXAlignment.Left,
			FontFace = F.Title,
			MaxTextSize = 16,
			Stroke = 2,
			ZIndex = 6,
			Parent = body,
		})
		return Kit.Text({
			Name = "Value",
			Size = UDim2.new(1, -16, 0, 30),
			Position = UDim2.fromOffset(10, 24),
			Text = "$0",
			TextXAlignment = Enum.TextXAlignment.Left,
			MaxTextSize = 30,
			Stroke = 3,
			ZIndex = 6,
			Parent = body,
		})
	end
	ui.Income = statBox("IncomeBox", "💵 INCOME", "Radioactive", 0, -1)
	ui.Sell = statBox("SellBox", "🏷️ SELL VALUE", "Gold", 0.5, 1)

	----------------------------------------------------------------- nourriture
	local foods = Kit.new("Frame", {
		Name = "Foods",
		Size = UDim2.new(1, -8, 0, 78),
		Position = UDim2.fromOffset(2, 284),
		BackgroundTransparency = 1,
		ZIndex = 5,
		Parent = right,
	}, { Kit.List(Enum.FillDirection.Horizontal, 10, Enum.HorizontalAlignment.Left, Enum.VerticalAlignment.Top) })
	ui.Foods = foods
	ui.FoodButtons = {}
	for i, food in Economy.Foods do
		local slot = Kit.new("Frame", {
			Name = food.Id,
			Size = UDim2.fromOffset(154, 78),
			BackgroundTransparency = 1,
			LayoutOrder = i,
			ZIndex = 5,
			Parent = foods,
		})
		local button = Kit.Button({
			Name = "Button",
			Icon = food.Icon,
			IconSize = 30,
			Text = "$0",
			TextSize = 24,
			Color = "Magma",
			Size = UDim2.fromOffset(150, 48),
			Sound = "ui_click",
			ZIndex = 6,
			Parent = slot,
			OnClick = function()
				KaijuPanel._Feed(food.Id)
			end,
		})
		local effect = if food.Cut >= 1 then "next stage NOW" else ("-%d%% wait"):format(math.floor(food.Cut * 100 + 0.5))
		inkText({
			Name = "Caption",
			Size = UDim2.new(1, 0, 0, 18),
			Position = UDim2.fromOffset(0, 58),
			Text = ("<b>%s</b> · %s"):format(food.Name, effect),
			TextXAlignment = Enum.TextXAlignment.Center,
			ZIndex = 6,
			Parent = slot,
		})
		ui.FoodButtons[food.Id] = button
	end

	------------------------------------------------------------------- œuf
	local eggHolder, eggBody = Kit.Panel({
		Name = "EggPanel",
		Size = UDim2.new(1, -8, 0, 176),
		Position = UDim2.fromOffset(2, 96),
		Rotation = 0.8,
		Gradient = "Ink",
		Parent = right,
	})
	ui.EggPanel = eggHolder
	Kit.Text({
		Size = UDim2.new(1, -20, 0, 26),
		Position = UDim2.fromOffset(10, 12),
		Text = "HATCHES IN",
		TextColor3 = C.Paper,
		MaxTextSize = 24,
		ZIndex = 6,
		Parent = eggBody,
	})
	ui.EggTime = Kit.Text({
		Name = "Countdown",
		Size = UDim2.new(1, -20, 0, 64),
		Position = UDim2.fromOffset(10, 40),
		Text = "0:00",
		TextColor3 = C.Gold,
		FontFace = F.Impact,
		MaxTextSize = 64,
		Stroke = 4,
		ZIndex = 6,
		Parent = eggBody,
	})
	local eggBar, setEgg = Kit.ProgressBar({
		Name = "HatchBar",
		Size = UDim2.new(1, -40, 0, 20),
		Position = UDim2.fromOffset(20, 112),
		Color = "Gold",
		ZIndex = 6,
		Parent = eggBody,
	})
	ui.EggBar = eggBar
	ui.SetEgg = setEgg
	ui.EggHint = Kit.Text({
		Size = UDim2.new(1, -20, 0, 20),
		Position = UDim2.fromOffset(10, 142),
		Text = "Something big is wiggling inside...",
		FontFace = F.Body,
		TextColor3 = C.Paper,
		Stroke = false,
		MaxTextSize = 18,
		ZIndex = 6,
		Parent = eggBody,
	})

	------------------------------------------------------------------- actions
	local actions = Kit.new("Frame", {
		Name = "Actions",
		Size = UDim2.new(1, -8, 0, 62),
		Position = UDim2.fromOffset(2, 380),
		BackgroundTransparency = 1,
		ZIndex = 5,
		Parent = right,
	}, { Kit.List(Enum.FillDirection.Horizontal, 12, Enum.HorizontalAlignment.Left, Enum.VerticalAlignment.Top) })
	ui.Actions = actions
	ui.SellButton = Kit.Button({
		Name = "Sell",
		Text = "SELL",
		Color = "Gold",
		Size = UDim2.fromOffset(172, 56),
		LayoutOrder = 1,
		Sound = "ui_click",
		ZIndex = 6,
		Parent = actions,
		OnClick = function()
			KaijuPanel._Sell()
		end,
	})
	local growProduct = Monetization.ProductByKey.InstantGrow
	ui.GrowButton = Kit.Button({
		Name = "Grow",
		Text = "INSTANT GROW",
		Color = "Radioactive",
		Size = UDim2.fromOffset(182, 56),
		LayoutOrder = 2,
		ZIndex = 6,
		Parent = actions,
		OnClick = function()
			if currentUid then
				Remote.Call("Buy", { Kind = "Product", Key = "InstantGrow", Target = currentUid })
			end
		end,
	})
	priceTag(ui.GrowButton, "R$" .. (if growProduct then growProduct.Robux else 25))
	ui.FuseButton = Kit.Button({
		Name = "Fuse",
		Text = "FUSE",
		Icon = "🧪",
		IconSize = 26,
		TextSize = 24,
		Color = "Purple",
		Size = UDim2.fromOffset(112, 56),
		LayoutOrder = 3,
		ZIndex = 6,
		Parent = actions,
		OnClick = function()
			local uid = currentUid
			if not uid then
				return
			end
			win:Close(true)
			local fusion = (UIRegistry.Screens :: any).Fusion
			if fusion then
				fusion.Open({ A = uid })
			end
		end,
	})
	local hatchProduct = Monetization.ProductByKey.InstantHatch
	ui.HatchButton = Kit.Button({
		Name = "Hatch",
		Text = "INSTANT HATCH",
		Icon = "🥚",
		IconSize = 30,
		TextSize = 26,
		Color = "Gold",
		Size = UDim2.fromOffset(300, 56),
		LayoutOrder = 4,
		ZIndex = 6,
		Parent = actions,
		OnClick = function()
			Remote.Call("Buy", { Kind = "Product", Key = "InstantHatch" })
		end,
	})
	priceTag(ui.HatchButton, "R$" .. (if hatchProduct then hatchProduct.Robux else 19))
end

----------------------------------------------------------------------------
-- Rendu
----------------------------------------------------------------------------

local function setChip(chip: any, text: string, color: Color3, secret: boolean?)
	chip.BackgroundColor3 = color
	local label = chip:FindFirstChild("Text")
	if label then
		label.Text = text
	end
	if secret then
		rainbow(chip, 2)
	else
		clearRainbow(chip)
	end
end

local function disarmSell()
	sellArmed = false
	sellToken += 1
	Kit.SetButtonColor(ui.SellButton, "Gold")
	shown.Sell = -1 -- force la remise à jour du texte
end

local function setPips(stage: number, animate: boolean)
	for i, pip in ui.Pips do
		local done = i <= stage
		pip.BackgroundColor3 = if i == stage then C.Gold elseif done then C.Radioactive else C.Paper
		local num = pip:FindFirstChild("Num")
		if num then
			num.TextColor3 = if done then C.White else C.InkSoft
		end
		if i == stage then
			if animate then
				Kit.Pop(pip, 2.2, 0.6)
			end
		else
			Kit.Tween(Kit.ScaleOf(pip), 0.2, { Scale = if done then 1 else 0.85 })
		end
	end
	local alpha = (stage - 1) / (Growth.MaxStage - 1)
	Kit.Tween(ui.PipLine, if animate then 0.5 else 0, { Size = UDim2.new(alpha, -30 * alpha, 0, 6) }, Enum.EasingStyle.Back)
end

-- Rendu « statique » : appelé à l'ouverture et quand le record change.
local function renderStatic(rec: any, fresh: boolean)
	local isEgg = rec.Egg == true or rec.Species == nil
	local rarity = Rarities.Get(rec.Rarity)
	local secret = rec.Rarity == "Secret"
	local species = if rec.Species then Kaijus.Get(rec.Species) else nil
	local mutation = Mutations.Get(rec.Mutation)

	-- aperçu 3D (reconstruit uniquement si nécessaire)
	local key = if isEgg then "Egg:" .. rec.Rarity else (rec.Species or "") .. ":" .. (rec.Mutation or "")
	if key ~= vpKey then
		vpKey = key
		if not vp then
			vp = Viewport.new({ Parent = ui.VpHolder, ZIndex = 5, Speed = 0.7 })
		end
		if isEgg then
			vp:SetEgg(rec.Rarity)
		elseif rec.Species then
			vp:Set(rec.Species, rec.Mutation)
		end
		Kit.Pop(vp.Frame, 0.3, 0.55)
		if not fresh and shown.Egg == true and not isEgg then
			-- l'œuf vient d'éclore sous nos yeux
			Audio.Play("egg_crack")
			safeShake(ui.CardHolder, 10, 0.4)
			Kit.Punch(ui.Name, 0.4)
		end
	end
	vp.Spin = true

	-- couleurs de la carte selon la rareté
	local base = if secret then C.InkSoft else rarity.Color
	ui.CardGradient.Color = ColorSequence.new(base:Lerp(C.White, 0.45), base:Lerp(C.Ink, 0.2))
	for _, ray in ui.Burst:GetChildren() do
		if ray:IsA("Frame") then
			ray.BackgroundColor3 = if secret then C.Gold else rarity.Glow
		end
	end

	-- nom + pastilles
	if isEgg then
		ui.Name.Text = rarityText(rec.Rarity) .. " EGG"
	else
		ui.Name.Text = if species then species.Name else "???"
	end
	ui.Name.TextColor3 = if secret then C.White else rarity.Color:Lerp(C.White, 0.25)
	if secret then
		rainbow(ui.Name, 2.5)
	else
		clearRainbow(ui.Name)
	end
	setChip(ui.RarityChip, rarityText(rec.Rarity), if secret then C.Ink else rarity.Color, secret)
	if mutation and not isEgg then
		ui.MutChip.Visible = true
		setChip(ui.MutChip, ("%s  x%s"):format(string.upper(mutation.Name), tostring(mutation.Mult)), mutation.Color, mutation.Id == "Rainbow")
		local label = ui.MutChip:FindFirstChild("Text")
		if label then
			label.TextColor3 = C.White
		end
	else
		ui.MutChip.Visible = false
	end
	setChip(ui.NestChip, "NEST " .. tostring(rec.Nest or "?"), C.InkSoft)

	-- mode œuf / kaiju
	local mode = if isEgg then "Egg" else "Kaiju"
	ui.StagePanel.Visible = not isEgg
	ui.Stats.Visible = not isEgg
	ui.Foods.Visible = not isEgg
	ui.EggPanel.Visible = isEgg
	ui.Plate.Visible = not isEgg
	ui.SellButton.Visible = not isEgg
	ui.GrowButton.Visible = not isEgg
	ui.FuseButton.Visible = not isEgg
	ui.HatchButton.Visible = isEgg
	if isEgg then
		setBreathing(ui.HatchButton, true)
	end
	shown.Egg = isEgg

	if fresh or mode ~= shown.Mode then
		shown.Mode = mode
		shown.Stage = 0
		shown.Income = -1
		shown.Sell = -1
		shown.Remain = ""
		shown.PricesDirty = true
		disarmSell()
		-- apparition en cascade
		local items = if isEgg
			then { ui.Name, ui.EggPanel, ui.HatchButton }
			else { ui.Name, ui.StagePanel, ui.IncomeBoxHolder, ui.SellBoxHolder, ui.SellButton, ui.GrowButton, ui.FuseButton }
		for i, item in items do
			popIn(item, 0.04 * i)
		end
		if not isEgg then
			for i, food in Economy.Foods do
				popIn(ui.FoodButtons[food.Id], 0.22 + 0.06 * i)
			end
		end
	end
end

-- Mise à jour des prix de nourriture (dépendent du stade).
local function refreshFoods(rec: any, growth: number, stage: number)
	local cash = State.Get("Cash") or 0
	local live = { Uid = rec.Uid, Species = rec.Species, Rarity = rec.Rarity, Mutation = rec.Mutation, Growth = growth, Nest = rec.Nest }
	for _, food in Economy.Foods do
		local b = ui.FoodButtons[food.Id]
		if stage >= Growth.MaxStage then
			Kit.SetButtonText(b, "MAX")
			Kit.SetDisabled(b, true)
		else
			local price = Calc.FoodPrice(live :: any, food.Id)
			Kit.SetButtonText(b, Format.Cash(price))
			Kit.SetDisabled(b, false)
			local label = b:FindFirstChild("Label", true)
			if label then
				label.TextColor3 = if cash >= price then C.White else Color3.fromRGB(255, 190, 190)
			end
		end
	end
end

-- Mise à jour à chaque image (valeurs vivantes).
local function step()
	local uid = currentUid
	local rec = lastRec
	if not uid or not rec then
		return
	end
	local anchor = anchorOf(uid)
	local now = Workspace:GetServerTimeNow()

	-- vol en cours
	local stolen = anchor ~= nil and (anchor:GetAttribute("CarriedBy") or 0) ~= 0
	if stolen ~= shown.Stolen then
		shown.Stolen = stolen
		ui.Stolen.Visible = stolen
		if stolen then
			Kit.Pop(ui.Stolen, 1.8, 0.4)
			task.delay(0.4, function()
				if shown.Stolen then
					Kit.Breathe(ui.Stolen, 0.08, 0.35)
				end
			end)
			Audio.Play("ui_error")
		end
	end

	if rec.Egg or not rec.Species then
		local hatchAt = (anchor and anchor:GetAttribute("HatchAt")) or rec.HatchAt or now
		local left = math.max(0, hatchAt - now)
		local total = Rarities.Get(rec.Rarity).HatchTime
		local text = if left <= 0 then "HATCHING!" else Format.Clock(math.ceil(left))
		if text ~= shown.Remain then
			shown.Remain = text
			ui.EggTime.Text = text
			if left <= 5 then
				Kit.Punch(ui.EggTime, 0.2)
			end
		end
		ui.SetEgg(1 - left / math.max(1, total), true)
		return
	end

	local growth, rate = liveGrowth(rec, anchor)
	local stage = Growth.StageFor(growth, rec.Rarity)
	if anchor then
		stage = math.max(stage, anchor:GetAttribute("Stage") or 1)
	end
	stage = math.clamp(stage, 1, Growth.MaxStage)

	if stage ~= shown.Stage then
		local grew = shown.Stage > 0 and stage > shown.Stage
		shown.Stage = stage
		local st = Growth.Get(stage)
		ui.StageName.Text = string.upper(st.Name)
		ui.PlateTitle.Text = string.upper(st.Name)
		ui.PlateSub.Text = ("STAGE %d / %d"):format(stage, Growth.MaxStage)
		setPips(stage, grew)
		shown.PricesDirty = true
		Kit.SetDisabled(ui.GrowButton, stage >= Growth.MaxStage)
		Kit.SetDisabled(ui.FuseButton, stage < 3)
		if grew then
			Audio.Play("stage_up")
			Kit.Punch(ui.StageName, 0.5)
			Kit.Punch(ui.Plate, 0.35)
			safeShake(ui.CardHolder, 8, 0.35)
			Kit.Pop(vp.Frame, 0.5, 0.6)
		end
	end

	if shown.PricesDirty then
		shown.PricesDirty = false
		refreshFoods(rec, growth, stage)
	end

	-- barre de croissance
	if stage >= Growth.MaxStage then
		ui.SetGrowth(1, true)
		if shown.Remain ~= "MAX" then
			shown.Remain = "MAX"
			ui.GrowthText.Text = "<b>MAX SIZE!</b> This kaiju is a full COLOSSUS."
		end
	else
		ui.SetGrowth(Growth.Progress(growth, rec.Rarity), true)
		local left = Growth.Remaining(growth, rec.Rarity) / math.max(rate, 0.01)
		local nextName = string.upper(Growth.Get(stage + 1).Name)
		local text = if shown.Stolen
			then ("Growth paused while stolen · next: <b>%s</b>"):format(nextName)
			else ("Next stage <b>%s</b> in <b>%s</b>"):format(nextName, Format.Duration(math.ceil(left)))
		if text ~= shown.Remain then
			shown.Remain = text
			ui.GrowthText.Text = text
		end
	end

	-- revenus / valeur de revente
	local income = if anchor then anchor:GetAttribute("Income") or 0 else Calc.BaseIncome(rec)
	if income ~= shown.Income then
		local first = shown.Income < 0
		shown.Income = income
		if first then
			ui.Income.Text = Format.Cash(income) .. "/s"
		else
			Kit.CountTo(ui.Income, income, function(v)
				return Format.Cash(v) .. "/s"
			end, 0.6)
			Kit.Punch(ui.Income, 0.25)
		end
	end
	local sell = if anchor then anchor:GetAttribute("SellValue") or 0 else Calc.SellValue(rec)
	if sell ~= shown.Sell then
		local first = shown.Sell < 0
		shown.Sell = sell
		ui.Sell.Text = Format.Cash(sell)
		if not first then
			Kit.Punch(ui.Sell, 0.25)
		end
		if not sellArmed then
			Kit.SetButtonText(ui.SellButton, "SELL " .. Format.Cash(sell))
		end
	end
end

local function startLoop()
	if renderConn then
		return
	end
	renderConn = RunService.RenderStepped:Connect(step)
end

local function stopLoop()
	if renderConn then
		renderConn:Disconnect()
		renderConn = nil
	end
end

----------------------------------------------------------------------------
-- Actions
----------------------------------------------------------------------------

function KaijuPanel._Feed(foodId: string)
	local uid = currentUid
	if not uid or busy then
		return
	end
	busy = true
	local res = Remote.Call("Feed", { Uid = uid, Food = foodId })
	busy = false
	if res.ok then
		local food = Economy.FoodsById[foodId]
		Audio.Play("purchase")
		Kit.Punch(ui.GrowthBar, 0.12)
		Kit.Punch(ui.FoodButtons[foodId], 0.2)
		Kit.Pop(vp.Frame, 0.8, 0.4)
		if food then
			UIRegistry.Toast(("%s %s devoured! Growing faster!"):format(food.Icon, food.Name), "Good")
		end
		shown.PricesDirty = true
	end
end

function KaijuPanel._Sell()
	local uid = currentUid
	if not uid or busy then
		return
	end
	if not sellArmed then
		sellArmed = true
		sellToken += 1
		local token = sellToken
		Kit.SetButtonColor(ui.SellButton, "Red")
		Kit.SetButtonText(ui.SellButton, "SURE? " .. Format.Cash(math.max(shown.Sell, 0)))
		Kit.Punch(ui.SellButton, 0.2)
		task.delay(3, function()
			if sellArmed and sellToken == token then
				disarmSell()
			end
		end)
		return
	end
	busy = true
	local res = Remote.Call("Sell", { Uid = uid })
	busy = false
	disarmSell()
	if res.ok then
		Audio.Play("sell")
		UIRegistry.Toast("Sold for " .. Format.Cash(res.amount or shown.Sell) .. "!", "Cash")
		KaijuPanel.Close()
	end
end

----------------------------------------------------------------------------
-- Interface publique
----------------------------------------------------------------------------

function KaijuPanel.Init()
	build()
	UIRegistry.OpenKaiju = function(uid: string)
		KaijuPanel.Open({ Uid = uid })
	end

	win.Opened:Connect(startLoop)
	win.Closed:Connect(function()
		stopLoop()
		if vp then
			vp.Spin = false
		end
		disarmSell()
	end)

	-- Suit le record : fermeture s'il disparaît (vendu / volé / fusionné)
	State.Changed("Kaijus"):Connect(function()
		if not win.IsOpen or not currentUid then
			return
		end
		local rec = findRecord(currentUid)
		if not rec then
			KaijuPanel.Close()
			return
		end
		lastRec = rec
		renderStatic(rec, false)
	end)
	State.Changed("Cash"):Connect(function()
		if win.IsOpen and lastRec and not lastRec.Egg then
			shown.PricesDirty = true -- recolore les prix abordables
		end
	end)
end

function KaijuPanel.Open(args: any?)
	if args == KaijuPanel then
		args = nil
	end
	local uid = if type(args) == "table" then args.Uid else nil
	uid = uid or currentUid
	local rec = findRecord(uid)
	if not rec then
		return
	end
	currentUid = uid
	lastRec = rec
	shown.Stolen = false
	ui.Stolen.Visible = false
	renderStatic(rec, true)
	win:Open()
	startLoop()
	step()
	Kit.Pop(ui.CardHolder, 0.6, 0.5)
end

function KaijuPanel.Close()
	if win then
		win:Close()
	end
end

return KaijuPanel
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="74">
              <Properties>
                <string name="Name">Playtime</string>
                <string name="Source"><![CDATA[--!nonstrict
-- Cadeaux de temps de jeu : 10 boîtes dessinées en code, compte à rebours en
-- direct, boîtes prêtes qui gigotent, couvercle qui saute à l'ouverture.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Rewards = require(Shared.Config.Rewards)
local Rarities = require(Shared.Config.Rarities)
local Economy = require(Shared.Config.Economy)
local Theme = require(Shared.Config.Theme)
local Format = require(Shared.Logic.Format)
local Calc = require(Shared.Logic.Calc)

local Kit = require(script.Parent.Parent.Kit)
local State = require(script.Parent.Parent.Parent.Controllers.State)
local Remote = require(script.Parent.Parent.Parent.Controllers.Remote)
local Audio = require(script.Parent.Parent.Parent.Controllers.Audio)
local UIRegistry = require(script.Parent.Parent.Parent.Controllers.UIRegistry)

local C = Kit.Colors
local F = Kit.Fonts

local Playtime = {}

local BOX_COLORS = { "Pink", "Cyan", "Gold", "Purple", "Radioactive", "Magma" }

local window
local gifts: { any } = {}
local sessionChip: Frame
local nextLabel: TextLabel
local loopToken = 0
local busy: { [number]: any } = {}

----------------------------------------------------------------------------
-- Logique
----------------------------------------------------------------------------

local function elapsed(): number?
	local start = State.Get("SessionStart")
	if type(start) ~= "number" then
		return nil
	end
	return Workspace:GetServerTimeNow() - start
end

-- Les tables à clés numériques creuses peuvent arriver avec des clés texte.
local function isClaimed(i: number): boolean
	local claimed = State.Get("PlaytimeClaimed")
	if type(claimed) ~= "table" then
		return false
	end
	return claimed[i] == true or claimed[tostring(i)] == true
end

local function remaining(i: number): number
	local e = elapsed()
	if not e then
		return math.huge
	end
	return Rewards.Playtime[i].Minutes * 60 - e
end

local function isReady(i: number): boolean
	return not isClaimed(i) and remaining(i) <= 0
end

local function rewardInfo(r: any): (string, string, Color3)
	if r.Kind == "Cash" then
		local amount = Calc.CashReward(r.Amount or 60, State.Get("Income") or 0, r.MinCash)
		return "💵", Format.Cash(amount), C.Cash
	elseif r.Kind == "Gems" then
		return "💎", tostring(r.Amount or 0) .. " GEMS", C.Gem
	elseif r.Kind == "Potion" then
		local p = Economy.PotionsById[r.Id or "Luck"]
		local name = if p then string.upper(p.Id) else "POTION"
		return if p then p.Icon else "🧪", string.format("%dx %s", r.Amount or 1, name), C.Radioactive
	elseif r.Kind == "Egg" then
		local rarity = Rarities.Get(r.Rarity or "Common")
		return "🥚", string.upper(rarity.Id) .. " EGG", rarity.Color
	elseif r.Kind == "Spins" then
		return "🎡", tostring(r.Amount or 1) .. " SPINS", C.Gold
	end
	return "🎁", "GIFT", C.White
end

----------------------------------------------------------------------------
-- Construction d'une boîte cadeau
----------------------------------------------------------------------------

local function giftBox(parent: Instance, colorName: string): (Frame, Frame)
	local colors = Theme.Gradients[colorName]
	local area = Kit.new("Frame", {
		Name = "Gift",
		Size = UDim2.fromOffset(104, 92),
		Position = UDim2.new(0.5, 0, 0, 58),
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundTransparency = 1,
		ZIndex = 4,
		Parent = parent,
	})
	local box = Kit.new("Frame", {
		Name = "Box",
		Size = UDim2.new(0.74, 0, 0, 50),
		Position = UDim2.new(0.5, 0, 1, -4),
		AnchorPoint = Vector2.new(0.5, 1),
		BackgroundColor3 = C.White,
		ZIndex = 4,
		Parent = area,
	}, { Kit.Corner(6), Kit.Stroke(3), Kit.Gradient(colors) })
	Kit.new("Frame", {
		Size = UDim2.new(0, 14, 1, 0),
		Position = UDim2.fromScale(0.5, 0),
		AnchorPoint = Vector2.new(0.5, 0),
		BackgroundColor3 = C.Gold,
		BorderSizePixel = 0,
		ZIndex = 5,
		Parent = box,
	})
	-- couvercle + nœud (tout ensemble pour s'envoler)
	local lid = Kit.new("Frame", {
		Name = "Lid",
		Size = UDim2.new(0.88, 0, 0, 20),
		Position = UDim2.new(0.5, 0, 1, -52),
		AnchorPoint = Vector2.new(0.5, 1),
		BackgroundColor3 = C.White,
		ZIndex = 6,
		Parent = area,
	}, { Kit.Corner(6), Kit.Stroke(3), Kit.Gradient({ colors[1], colors[2]:Lerp(C.Ink, 0.15) }) })
	Kit.new("Frame", {
		Size = UDim2.new(0, 14, 1, 0),
		Position = UDim2.fromScale(0.5, 0),
		AnchorPoint = Vector2.new(0.5, 0),
		BackgroundColor3 = C.Gold,
		BorderSizePixel = 0,
		ZIndex = 7,
		Parent = lid,
	})
	for _, side in { -1, 1 } do
		Kit.new("Frame", {
			Size = UDim2.fromOffset(24, 16),
			Position = UDim2.new(0.5, side * 12, 0, -8),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Rotation = side * 25,
			BackgroundColor3 = C.Gold,
			ZIndex = 7,
			Parent = lid,
		}, { Kit.Corner(8), Kit.Stroke(2.5) })
	end
	Kit.new("Frame", {
		Size = UDim2.fromOffset(12, 12),
		Position = UDim2.new(0.5, 0, 0, -6),
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = C.Gold,
		ZIndex = 8,
		Parent = lid,
	}, { Kit.Round(), Kit.Stroke(2.5) })
	return area, lid
end

local function buildGift(parent: Instance, i: number, pos: UDim2, size: UDim2)
	local entry = Rewards.Playtime[i]
	local big = entry.Reward.Kind == "Egg"
	local holder = Kit.new("Frame", {
		Name = "Gift" .. i,
		Size = size,
		Position = pos,
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundTransparency = 1,
		ZIndex = 5,
		Parent = parent,
	})
	local burst = Kit.Starburst({ Size = UDim2.fromOffset(210, 210), Position = UDim2.new(0.5, 0, 0, 62), Color = C.Gold, Transparency = 0.35, ZIndex = 0, Parent = holder })
	burst.Visible = false
	local box, body = Kit.Panel({
		Size = UDim2.new(1, -8, 1, -8),
		Position = UDim2.new(0.5, -3, 0.5, -3),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Rotation = if i % 2 == 0 then 1.4 else -1.4,
		Gradient = if big then "Gold" else "Paper",
		Parent = holder,
	})
	box.ZIndex = 2
	local minutes = Kit.Chip({
		Text = entry.Minutes .. " MIN",
		Color = C.Ink,
		Size = UDim2.fromOffset(74, 24),
		Position = UDim2.fromOffset(4, 4),
		TextSize = 16,
		ZIndex = 9,
		Parent = body,
	})
	minutes.Rotation = -6
	local area, lid = giftBox(body, BOX_COLORS[(i - 1) % #BOX_COLORS + 1])
	local lidHome = lid.Position
	local icon, label, color = rewardInfo(entry.Reward)
	-- icône de la récompense, visible une fois la boîte ouverte
	local reveal = Kit.Text({
		Size = UDim2.fromOffset(56, 56),
		Position = UDim2.new(0.5, 0, 1, -58),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Text = icon,
		FontFace = F.Body,
		Stroke = false,
		MaxTextSize = 44,
		ZIndex = 5,
		Visible = false,
		Parent = area,
	})
	local rewardLabel = Kit.Text({
		Name = "Reward",
		Size = UDim2.new(1, -10, 0, 28),
		Position = UDim2.fromOffset(5, 106),
		Text = icon .. " " .. label,
		FontFace = F.Impact,
		TextColor3 = color,
		Stroke = 2.5,
		MaxTextSize = 24,
		ZIndex = 4,
		Parent = body,
	})
	-- zone d'état : compte à rebours / bouton / réclamé
	local timerBox = Kit.new("Frame", {
		Size = UDim2.new(1, -20, 0, 36),
		Position = UDim2.new(0.5, 0, 1, -44),
		AnchorPoint = Vector2.new(0.5, 0),
		BackgroundTransparency = 1,
		ZIndex = 4,
		Parent = body,
	})
	local timerText = Kit.Text({
		Size = UDim2.new(1, 0, 0, 22),
		Text = "0:00",
		FontFace = F.Title,
		TextColor3 = C.Ink,
		Stroke = false,
		MaxTextSize = 22,
		ZIndex = 4,
		Parent = timerBox,
	})
	local _, setBar = Kit.ProgressBar({
		Size = UDim2.new(1, 0, 0, 12),
		Position = UDim2.fromOffset(0, 24),
		Color = BOX_COLORS[(i - 1) % #BOX_COLORS + 1],
		ZIndex = 4,
		Parent = timerBox,
	})
	local claimSlot = Kit.new("Frame", {
		Size = UDim2.new(1, -16, 0, 46),
		Position = UDim2.new(0.5, 0, 1, -30),
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundTransparency = 1,
		ZIndex = 6,
		Visible = false,
		Parent = body,
	})
	local claimBreather = Kit.new("Frame", {
		Size = UDim2.fromScale(1, 1),
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundTransparency = 1,
		ZIndex = 6,
		Parent = claimSlot,
	})
	local g
	local claimButton = Kit.Button({
		Name = "Claim",
		Text = "CLAIM!",
		Color = "Radioactive",
		Size = UDim2.new(1, 0, 1, -6),
		Position = UDim2.new(0.5, 0, 0.5, -3),
		AnchorPoint = Vector2.new(0.5, 0.5),
		MaxTextSize = 24,
		ZIndex = 6,
		OnClick = function()
			if g then
				g.Claim()
			end
		end,
		Parent = claimBreather,
	})
	local done = Kit.Chip({
		Text = "CLAIMED ✓",
		Color = C.RadioactiveDark,
		Size = UDim2.new(1, -24, 0, 30),
		Position = UDim2.new(0.5, 0, 1, -28),
		AnchorPoint = Vector2.new(0.5, 0.5),
		ZIndex = 9,
		Parent = body,
	})
	done.Visible = false
	local dim = Kit.new("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = C.Ink,
		BackgroundTransparency = 0.6,
		ZIndex = 8,
		Visible = false,
		Parent = body,
	}, { Kit.Corner() })

	g = {
		Index = i,
		Holder = holder,
		Box = box,
		Body = body,
		Burst = burst,
		Area = area,
		Lid = lid,
		LidHome = lidHome,
		Reveal = reveal,
		RewardLabel = rewardLabel,
		TimerBox = timerBox,
		TimerText = timerText,
		SetBar = setBar,
		ClaimSlot = claimSlot,
		ClaimBreather = claimBreather,
		ClaimButton = claimButton,
		Done = done,
		Dim = dim,
		Status = "",
		Popping = false,
		Claiming = false,
		Claim = nil :: any,
	}
	return g
end

----------------------------------------------------------------------------
-- États & animations
----------------------------------------------------------------------------

local function applyStatus(g: any, status: string)
	if g.Status == status then
		return
	end
	local previous = g.Status
	g.Status = status
	g.TimerBox.Visible = status == "waiting"
	g.ClaimSlot.Visible = status == "ready"
	g.Done.Visible = status == "claimed"
	g.Dim.Visible = status == "claimed"
	g.Burst.Visible = status == "ready"
	g.Lid.Visible = status ~= "claimed"
	g.Reveal.Visible = status == "claimed"
	if status ~= "claimed" then
		g.Lid.Position = g.LidHome
		g.Lid.Rotation = 0
	end
	g.Holder.ZIndex = if status == "ready" then 6 else 5
	if status == "ready" then
		Kit.Wobble(g.Area, 9, 0.28)
		Kit.Breathe(g.ClaimBreather, 0.07, 0.6)
		if not g.Popping then
			Kit.Breathe(g.Holder, 0.03, 0.8)
		end
		if previous == "waiting" then
			Audio.Play("quest_complete", { Volume = 0.6 })
			Kit.Pop(g.ClaimSlot, 0.3, 0.5)
		end
	elseif previous == "ready" then
		Kit.Tween(g.Area, 0.2, { Rotation = 0 })
		Kit.Tween(Kit.ScaleOf(g.ClaimBreather), 0.2, { Scale = 1 })
		if not g.Popping then
			Kit.Tween(Kit.ScaleOf(g.Holder), 0.2, { Scale = 1 })
		end
	end
end

local function tick()
	local e = elapsed()
	for i, g in gifts do
		local status
		if g.Claiming then
			status = g.Status
		elseif isClaimed(i) then
			status = "claimed"
		elseif isReady(i) then
			status = "ready"
		else
			status = "waiting"
		end
		applyStatus(g, status)
		if status == "waiting" then
			local total = Rewards.Playtime[i].Minutes * 60
			g.TimerText.Text = Format.Clock(remaining(i))
			g.SetBar(if e then e / total else 0, true)
		end
	end
	if e then
		local chipLabel = sessionChip:FindFirstChild("Text") :: TextLabel?
		if chipLabel then
			chipLabel.Text = "⏱ PLAYED " .. Format.Clock(e)
		end
	end
	local nextIn = Playtime.NextReadyIn()
	if nextIn == 0 then
		local n = Playtime.ClaimableCount()
		nextLabel.Text = if n > 1 then n .. " gifts are ready!" else "A gift is ready!"
		nextLabel.TextColor3 = C.RadioactiveDark
	elseif nextIn < 0 then
		nextLabel.Text = "All gifts claimed. See you next session!"
		nextLabel.TextColor3 = C.InkSoft
	else
		nextLabel.Text = "Next gift in " .. Format.Clock(nextIn)
		nextLabel.TextColor3 = C.InkSoft
	end
end

-- Confettis encrés (créés une fois par ouverture, pas à chaque image).
local function confetti(parent: Instance, origin: UDim2)
	local palette = { C.Pink, C.Cyan, C.Gold, C.Radioactive, C.Magma, C.Purple }
	for n = 1, 12 do
		local piece = Kit.new("Frame", {
			Size = UDim2.fromOffset(math.random(8, 13), math.random(8, 13)),
			Position = origin,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Rotation = math.random(0, 90),
			BackgroundColor3 = palette[(n - 1) % #palette + 1],
			ZIndex = 20,
			Parent = parent,
		}, { Kit.Corner(3), Kit.Stroke(2) })
		local angle = math.rad(n / 12 * 360 + math.random(-12, 12))
		local dist = math.random(60, 110)
		Kit.Tween(piece, 0.7, {
			Position = origin + UDim2.fromOffset(math.cos(angle) * dist, math.sin(angle) * dist - 30),
			Rotation = piece.Rotation + math.random(-360, 360),
			BackgroundTransparency = 1,
		}, Enum.EasingStyle.Quint)
		local stroke = piece:FindFirstChildOfClass("UIStroke")
		if stroke then
			Kit.Tween(stroke, 0.7, { Transparency = 1 }, Enum.EasingStyle.Quint)
		end
		task.delay(0.75, function()
			piece:Destroy()
		end)
	end
end

local function claim(g: any)
	local i = g.Index
	if busy[i] or not isReady(i) then
		return
	end
	busy[i] = true
	g.Claiming = true
	Kit.SetDisabled(g.ClaimButton, true)
	local r = Remote.Call("ClaimPlaytime", { Index = i })
	busy[i] = nil
	Kit.SetDisabled(g.ClaimButton, false)
	if not r.ok then
		g.Claiming = false
		return
	end
	Audio.Play("reward_claim")
	UIRegistry.Toast("Gift: " .. tostring(r.text or "claimed!"), "Good")
	-- le couvercle s'envole, confettis, révélation
	local lid = g.Lid
	Kit.Tween(lid, 0.45, { Position = g.LidHome + UDim2.fromOffset(math.random(-30, 30), -70), Rotation = math.random(-60, 60) }, Enum.EasingStyle.Quad)
	confetti(g.Holder, UDim2.new(0.5, 0, 0, 58))
	Kit.Shake(g.Box, 5, 0.3)
	Kit.Punch(g.RewardLabel, 0.4)
	g.Reveal.Visible = true
	Kit.Pop(g.Reveal, 0.2, 0.5)
	task.delay(0.45, function()
		g.Claiming = false
		applyStatus(g, "claimed")
	end)
end

----------------------------------------------------------------------------
-- Interface publique
----------------------------------------------------------------------------

-- Secondes avant le prochain cadeau (0 = un cadeau est prêt, -1 = tout pris).
function Playtime.NextReadyIn(): number
	if elapsed() == nil then
		return -1
	end
	local best = math.huge
	for i = 1, #Rewards.Playtime do
		if not isClaimed(i) then
			local left = remaining(i)
			if left <= 0 then
				return 0
			end
			best = math.min(best, left)
		end
	end
	return if best == math.huge then -1 else math.ceil(best)
end

function Playtime.ClaimableCount(): number
	local n = 0
	for i = 1, #Rewards.Playtime do
		if isReady(i) then
			n += 1
		end
	end
	return n
end

function Playtime.Init()
	window = Kit.Window({ Name = "Playtime", Title = "FREE GIFTS", Icon = "🎁", Color = "Pink", Size = UDim2.fromOffset(860, 540), RibbonWidth = 360 })
	local content = window.Frame

	sessionChip = Kit.Chip({
		Text = "⏱ PLAYED 0:00",
		Color = C.Pink,
		Size = UDim2.fromOffset(220, 36),
		Position = UDim2.fromOffset(4, 6),
		TextSize = 22,
		Parent = content,
	})
	sessionChip.Rotation = -2
	nextLabel = Kit.Text({
		Size = UDim2.new(1, -250, 0, 30),
		Position = UDim2.new(1, -4, 0, 9),
		AnchorPoint = Vector2.new(1, 0),
		Text = "",
		FontFace = F.Body,
		TextColor3 = C.InkSoft,
		TextXAlignment = Enum.TextXAlignment.Right,
		Stroke = false,
		MaxTextSize = 22,
		Parent = content,
	})

	local area = Kit.new("Frame", {
		Name = "Gifts",
		Size = UDim2.new(1, 0, 1, -56),
		Position = UDim2.fromOffset(0, 56),
		BackgroundTransparency = 1,
		Parent = content,
	})
	local cw, ch, gap = 152, 190, 11
	local cols = 5
	local width = cols * cw + (cols - 1) * gap
	for i = 1, #Rewards.Playtime do
		local col = (i - 1) % cols
		local row = (i - 1) // cols
		local g = buildGift(area, i, UDim2.new(0.5, -width / 2 + col * (cw + gap) + cw / 2, 0, row * (ch + gap) + ch / 2 + 4), UDim2.fromOffset(cw, ch))
		g.Claim = function()
			task.spawn(claim, g)
		end
		gifts[i] = g
	end

	State.Changed("PlaytimeClaimed"):Connect(function()
		if window.IsOpen then
			tick()
		end
	end)
	State.Changed("Income"):Connect(function()
		if not window.IsOpen then
			return
		end
		for i, g in gifts do
			local icon, label = rewardInfo(Rewards.Playtime[i].Reward)
			g.RewardLabel.Text = icon .. " " .. label
		end
	end)

	window.Opened:Connect(function()
		loopToken += 1
		local token = loopToken
		task.spawn(function()
			while window.IsOpen and token == loopToken do
				tick()
				task.wait(0.2)
			end
		end)
	end)
	window.Closed:Connect(function()
		loopToken += 1
	end)
end

function Playtime.Open(_args: any?)
	if window.IsOpen then
		return
	end
	for i, g in gifts do
		local icon, label = rewardInfo(Rewards.Playtime[i].Reward)
		g.RewardLabel.Text = icon .. " " .. label
		g.Status = ""
		g.Popping = true
		local s = Kit.ScaleOf(g.Holder)
		s.Scale = 0
		task.delay(0.04 + i * 0.05, function()
			Kit.Pop(g.Holder, 0.2, 0.5)
			-- les cadeaux prêts reprennent leur respiration après l'apparition
			task.delay(0.5, function()
				g.Popping = false
				if g.Status == "ready" then
					Kit.Breathe(g.Holder, 0.03, 0.8)
				end
			end)
		end)
	end
	window:Open()
end

function Playtime.Close()
	window:Close()
end

return Playtime
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="75">
              <Properties>
                <string name="Name">Quests</string>
                <string name="Source"><![CDATA[--!nonstrict
-- Quêtes du jour : barres de progression, tampons « fait », coffre bonus
-- quand tout est réclamé, compte à rebours jusqu'au renouvellement (minuit UTC).

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Rewards = require(Shared.Config.Rewards)
local Rarities = require(Shared.Config.Rarities)
local Economy = require(Shared.Config.Economy)
local Format = require(Shared.Logic.Format)
local Progress = require(Shared.Logic.Progress)
local Calc = require(Shared.Logic.Calc)

local Kit = require(script.Parent.Parent.Kit)
local Viewport = require(script.Parent.Parent.Viewport)
local State = require(script.Parent.Parent.Parent.Controllers.State)
local Remote = require(script.Parent.Parent.Parent.Controllers.Remote)
local Audio = require(script.Parent.Parent.Parent.Controllers.Audio)
local UIRegistry = require(script.Parent.Parent.Parent.Controllers.UIRegistry)

local C = Kit.Colors
local F = Kit.Fonts

local Quests = {}

local DAY = 86400
local STAT_ICONS = {
	EggsBought = "🥚",
	Steals = "🦹",
	Bonks = "🔨",
	Saves = "🛡️",
	Feeds = "🍖",
	StageUps = "🌱",
	Fusions = "🧬",
	Collects = "💵",
	Orbs = "🔮",
	Hatches = "🐣",
}
local ROW_COLORS = { "Cyan", "Pink", "Gold", "Purple", "Magma" }

local window
local listFrame: Frame
local rows: { any } = {}
local rowKey = ""
local doneChip: Frame
local resetLabel: TextLabel
local chest: any = {}
local loopToken = 0
local busy: { [string]: any } = {}

----------------------------------------------------------------------------
-- Aides
----------------------------------------------------------------------------

local function now(): number
	return Workspace:GetServerTimeNow()
end

local function questData(): any
	return State.Get("Quests") or { Day = 0, List = {}, BonusClaimed = false }
end

local function isComplete(q: any): boolean
	local def = Progress.QuestDef(q.Id)
	return def ~= nil and (q.Progress or 0) >= def.Goal
end

local function allClaimed(data: any): boolean
	if #data.List == 0 then
		return false
	end
	for _, q in data.List do
		if not q.Claimed then
			return false
		end
	end
	return true
end

local function rewardInfo(r: any): (string, string, Color3)
	if r.Kind == "Cash" then
		local amount = Calc.CashReward(r.Amount or 60, State.Get("Income") or 0, r.MinCash)
		return "💵", Format.Cash(amount), C.Cash
	elseif r.Kind == "Gems" then
		return "💎", tostring(r.Amount or 0) .. " GEMS", C.Gem
	elseif r.Kind == "Potion" then
		local p = Economy.PotionsById[r.Id or "Luck"]
		local name = if p then string.upper(p.Id) else "POTION"
		return if p then p.Icon else "🧪", string.format("%dx %s", r.Amount or 1, name), C.Radioactive
	elseif r.Kind == "Egg" then
		local rarity = Rarities.Get(r.Rarity or "Common")
		return "🥚", string.upper(rarity.Id) .. " EGG", rarity.Color
	elseif r.Kind == "Spins" then
		return "🎡", tostring(r.Amount or 1) .. " SPINS", C.Gold
	end
	return "🎁", "GIFT", C.White
end

local function setBreathe(inst: GuiObject, on: boolean)
	if (inst:GetAttribute("Breathing") == true) == on then
		return
	end
	inst:SetAttribute("Breathing", on)
	if on then
		Kit.Breathe(inst, 0.06, 0.7)
	else
		Kit.Tween(Kit.ScaleOf(inst), 0.2, { Scale = 1 })
	end
end

-- Bouton centré avec un cadre qui peut « respirer ».
local function breathingButton(parent: Instance, props: { [string]: any }): (Frame, TextButton, Frame)
	local slot = Kit.new("Frame", {
		Name = (props.Name or "Button") .. "Slot",
		Size = props.Size,
		Position = props.Position,
		AnchorPoint = props.AnchorPoint or Vector2.new(0.5, 0.5),
		BackgroundTransparency = 1,
		ZIndex = 6,
		Parent = parent,
	})
	local breather = Kit.new("Frame", {
		Size = UDim2.fromScale(1, 1),
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundTransparency = 1,
		ZIndex = 6,
		Parent = slot,
	})
	local bp = table.clone(props)
	bp.Size = UDim2.new(1, 0, 1, -6)
	bp.Position = UDim2.new(0.5, 0, 0.5, -3)
	bp.AnchorPoint = Vector2.new(0.5, 0.5)
	bp.ZIndex = 6
	bp.Parent = breather
	return slot, Kit.Button(bp), breather
end

local function flyText(parent: Instance, str: string, color: Color3, origin: UDim2)
	local label = Kit.Text({
		Size = UDim2.fromOffset(260, 40),
		Position = origin,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Text = "+" .. str,
		FontFace = F.Impact,
		TextColor3 = color,
		Stroke = 3,
		MaxTextSize = 40,
		ZIndex = 30,
		Parent = parent,
	})
	Kit.Pop(label, 0.3, 0.4)
	Kit.Tween(label, 1.1, { Position = origin - UDim2.fromOffset(0, 70) }, Enum.EasingStyle.Quint)
	task.delay(0.75, function()
		Kit.Tween(label, 0.35, { TextTransparency = 1 })
		local stroke = label:FindFirstChildOfClass("UIStroke")
		if stroke then
			Kit.Tween(stroke, 0.35, { Transparency = 1 })
		end
	end)
	task.delay(1.2, function()
		label:Destroy()
	end)
end

local function slamStamp(stamp: GuiObject)
	stamp.Visible = true
	local s = Kit.ScaleOf(stamp)
	s.Scale = 3
	stamp.Rotation = -40
	Kit.Tween(s, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
	Kit.Tween(stamp, 0.35, { Rotation = -10 }, Enum.EasingStyle.Back)
end

----------------------------------------------------------------------------
-- Lignes de quête
----------------------------------------------------------------------------

local claimQuest: (any) -> ()

local function buildRow(i: number, q: any): any
	local def = Progress.QuestDef(q.Id)
	local holder = Kit.new("Frame", {
		Name = "Quest" .. i,
		Size = UDim2.new(1, 0, 0, 118),
		Position = UDim2.new(0.5, 0, 0, (i - 1) * 128 + 59),
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundTransparency = 1,
		ZIndex = 5,
		Parent = listFrame,
	})
	local box, body = Kit.Panel({
		Size = UDim2.new(1, -10, 1, -10),
		Position = UDim2.new(0.5, -3, 0.5, -3),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Rotation = if i % 2 == 0 then 0.7 else -0.7,
		Parent = holder,
	})
	local colorName = ROW_COLORS[(i - 1) % #ROW_COLORS + 1]
	local badge = Kit.new("Frame", {
		Size = UDim2.fromOffset(74, 74),
		Position = UDim2.new(0, 14, 0.5, 0),
		AnchorPoint = Vector2.new(0, 0.5),
		BackgroundColor3 = C.White,
		ZIndex = 3,
		Parent = body,
	}, { Kit.Round(), Kit.Stroke(3), Kit.Gradient(colorName) })
	local icon = Kit.Text({
		Size = UDim2.fromScale(0.68, 0.68),
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Text = if def then (STAT_ICONS[def.Stat] or "⭐") else "⭐",
		FontFace = F.Body,
		Stroke = false,
		MaxTextSize = 44,
		ZIndex = 4,
		Parent = badge,
	})
	Kit.Wobble(icon, 6, 1.3 + i * 0.2)
	Kit.Text({
		Size = UDim2.new(1, -270, 0, 32),
		Position = UDim2.fromOffset(100, 10),
		Text = if def then string.upper(def.Text:format(def.Goal)) else "???",
		TextXAlignment = Enum.TextXAlignment.Left,
		Stroke = 2.5,
		MaxTextSize = 26,
		ZIndex = 3,
		Parent = body,
	})
	local rIcon, rLabel, rColor = rewardInfo(if def then def.Reward else { Kind = "Gems", Amount = 0 })
	local rewardChip = Kit.Chip({
		Text = "REWARD: " .. rIcon .. " " .. rLabel,
		Color = C.Ink,
		AutoWidth = true,
		Size = UDim2.fromOffset(0, 26),
		Position = UDim2.fromOffset(100, 46),
		TextSize = 16,
		ZIndex = 3,
		Parent = body,
	})
	rewardChip.Rotation = -1.5
	local bar, setBar = Kit.ProgressBar({
		Size = UDim2.new(1, -290, 0, 22),
		Position = UDim2.fromOffset(102, 80),
		Color = "Radioactive",
		ZIndex = 3,
		Parent = body,
	})
	local count = Kit.Text({
		Size = UDim2.new(1, 0, 1, 4),
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Text = "0 / 0",
		FontFace = F.Impact,
		Stroke = 2,
		MaxTextSize = 22,
		ZIndex = 10,
		Parent = bar,
	})
	local slot, button, breather = breathingButton(body, {
		Name = "Claim",
		Text = "CLAIM!",
		Color = "Radioactive",
		Size = UDim2.fromOffset(150, 62),
		Position = UDim2.new(1, -90, 0.5, 0),
		MaxTextSize = 28,
		OnClick = function()
			claimQuest(q.Id)
		end,
	})
	local pending = Kit.Chip({
		Text = "IN PROGRESS",
		Color = C.InkSoft,
		Size = UDim2.fromOffset(150, 32),
		Position = UDim2.new(1, -90, 0.5, 0),
		AnchorPoint = Vector2.new(0.5, 0.5),
		TextSize = 16,
		ZIndex = 5,
		Parent = body,
	})
	local dim = Kit.new("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = C.Paper,
		BackgroundTransparency = 0.4,
		ZIndex = 8,
		Visible = false,
		Parent = body,
	}, { Kit.Corner() })
	local stamp = Kit.new("Frame", {
		Size = UDim2.fromOffset(130, 52),
		Position = UDim2.new(1, -90, 0.5, 0),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Rotation = -10,
		BackgroundColor3 = C.White,
		ZIndex = 9,
		Visible = false,
		Parent = body,
	}, { Kit.Corner(10), Kit.Stroke(4, C.RadioactiveDark), Kit.Gradient({ C.White, C.Paper }) })
	Kit.Text({
		Size = UDim2.new(1, -10, 1, -10),
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Text = "DONE ✓",
		TextColor3 = C.RadioactiveDark,
		Stroke = false,
		MaxTextSize = 30,
		ZIndex = 10,
		Parent = stamp,
	})
	return {
		Id = q.Id,
		Def = def,
		Holder = holder,
		Box = box,
		Body = body,
		SetBar = setBar,
		Count = count,
		Slot = slot,
		Button = button,
		Breather = breather,
		Pending = pending,
		Dim = dim,
		Stamp = stamp,
		RewardColor = rColor,
		RewardChip = rewardChip,
		LastProgress = nil :: number?,
		Status = "",
		Claiming = false,
	}
end

local function rebuildRows(data: any)
	for _, r in rows do
		r.Holder:Destroy()
	end
	rows = {}
	local ids = {}
	for i, q in data.List do
		rows[i] = buildRow(i, q)
		table.insert(ids, q.Id)
	end
	rowKey = table.concat(ids, ",")
end

----------------------------------------------------------------------------
-- Coffre bonus
----------------------------------------------------------------------------

local function buildChest(parent: Instance)
	local box, body = Kit.Panel({
		Name = "Bonus",
		Size = UDim2.new(1, -10, 1, -10),
		Position = UDim2.new(0.5, -3, 0.5, -3),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Rotation = 1.2,
		Gradient = "Ink",
		Parent = parent,
	})
	-- CanvasGroup : découpe fiable même sous une fenêtre inclinée
	local clip = Kit.new("CanvasGroup", {
		Name = "Clip",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		ZIndex = 2,
		Parent = body,
	}, { Kit.Corner() })
	local burst = Kit.Starburst({ Size = UDim2.fromOffset(520, 520), Position = UDim2.new(0.5, 0, 0.45, 0), Color = C.Gold, Transparency = 0.35, ZIndex = 2, Parent = clip })
	burst.Visible = false
	Kit.Hazard({ Size = UDim2.new(1, 0, 0, 12), Position = UDim2.fromOffset(0, 0), ZIndex = 3, Parent = body })
	Kit.Text({
		Size = UDim2.new(1, -20, 0, 34),
		Position = UDim2.fromOffset(10, 20),
		Text = "ALL-DONE BONUS",
		TextColor3 = C.Gold,
		Stroke = 3,
		MaxTextSize = 28,
		ZIndex = 4,
		Parent = body,
	})
	local _, label, color = rewardInfo(Rewards.AllQuestsBonus)
	local rewardLabel = Kit.Text({
		Size = UDim2.new(1, -20, 0, 28),
		Position = UDim2.fromOffset(10, 54),
		Text = label,
		FontFace = F.Impact,
		TextColor3 = color,
		Stroke = 2.5,
		MaxTextSize = 28,
		ZIndex = 4,
		Parent = body,
	})
	-- œuf qui flotte au-dessus du coffre
	local eggHolder = Kit.new("Frame", {
		Size = UDim2.fromOffset(110, 110),
		Position = UDim2.new(0.5, 0, 0, 140),
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundTransparency = 1,
		ZIndex = 4,
		Parent = body,
	})
	local egg = Viewport.new({ Egg = Rewards.AllQuestsBonus.Rarity or "Legendary", Size = UDim2.fromScale(1, 1), ZIndex = 4, Speed = 1.3, Parent = eggHolder })
	Kit.Tween(eggHolder, 1.1, { Position = UDim2.new(0.5, 0, 0, 128) }, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true)
	-- coffre dessiné
	local chestFrame = Kit.new("Frame", {
		Size = UDim2.fromOffset(150, 96),
		Position = UDim2.new(0.5, 0, 0, 236),
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundTransparency = 1,
		ZIndex = 5,
		Parent = body,
	})
	local base = Kit.new("Frame", {
		Size = UDim2.new(1, 0, 0, 64),
		Position = UDim2.new(0.5, 0, 1, 0),
		AnchorPoint = Vector2.new(0.5, 1),
		BackgroundColor3 = C.White,
		ZIndex = 5,
		Parent = chestFrame,
	}, { Kit.Corner(8), Kit.Stroke(4), Kit.Gradient({ Color3.fromRGB(190, 110, 50), Color3.fromRGB(120, 60, 25) }) })
	for _, x in { 0.18, 0.82 } do
		Kit.new("Frame", {
			Size = UDim2.new(0, 12, 1, 0),
			Position = UDim2.fromScale(x, 0),
			AnchorPoint = Vector2.new(0.5, 0),
			BackgroundColor3 = C.Gold,
			BorderSizePixel = 0,
			ZIndex = 6,
			Parent = base,
		})
	end
	local lid = Kit.new("Frame", {
		Size = UDim2.new(1, 8, 0, 44),
		Position = UDim2.new(0.5, 0, 1, -62),
		AnchorPoint = Vector2.new(0.5, 1),
		BackgroundColor3 = C.White,
		ZIndex = 7,
		Parent = chestFrame,
	}, { Kit.Corner(14), Kit.Stroke(4), Kit.Gradient({ Color3.fromRGB(215, 135, 65), Color3.fromRGB(150, 80, 35) }) })
	local lidHome = lid.Position
	local lock = Kit.new("Frame", {
		Size = UDim2.fromOffset(30, 34),
		Position = UDim2.new(0.5, 0, 1, -44),
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = C.Gold,
		ZIndex = 8,
		Parent = chestFrame,
	}, { Kit.Corner(6), Kit.Stroke(3) })
	local progress = Kit.Chip({
		Text = "0 / 3 CLAIMED",
		Color = C.InkSoft,
		Size = UDim2.new(1, -40, 0, 30),
		Position = UDim2.new(0.5, 0, 1, -96),
		AnchorPoint = Vector2.new(0.5, 0.5),
		TextSize = 18,
		ZIndex = 6,
		Parent = body,
	})
	local slot, button, breather = breathingButton(body, {
		Name = "ClaimBonus",
		Text = "OPEN!",
		Color = "Gold",
		Size = UDim2.new(1, -40, 0, 60),
		Position = UDim2.new(0.5, 0, 1, -44),
		MaxTextSize = 30,
	})
	local claimed = Kit.Chip({
		Text = "CLAIMED ✓",
		Color = C.RadioactiveDark,
		Size = UDim2.new(1, -60, 0, 36),
		Position = UDim2.new(0.5, 0, 1, -44),
		AnchorPoint = Vector2.new(0.5, 0.5),
		TextSize = 20,
		ZIndex = 6,
		Parent = body,
	})
	chest = {
		Box = box,
		Body = body,
		Burst = burst,
		RewardLabel = rewardLabel,
		Egg = egg,
		EggHolder = eggHolder,
		Chest = chestFrame,
		Lid = lid,
		LidHome = lidHome,
		Lock = lock,
		Progress = progress,
		Slot = slot,
		Button = button,
		Breather = breather,
		Claimed = claimed,
		Status = "",
	}
end

----------------------------------------------------------------------------
-- Rafraîchissement
----------------------------------------------------------------------------

local function refresh()
	if not window then
		return
	end
	local data = questData()
	local ids = {}
	for _, q in data.List do
		table.insert(ids, q.Id)
	end
	if table.concat(ids, ",") ~= rowKey then
		rebuildRows(data)
	end
	local claimedCount = 0
	for i, q in data.List do
		local r = rows[i]
		if r and r.Def then
			local goal = r.Def.Goal
			local p = math.min(q.Progress or 0, goal)
			r.SetBar(p / goal, r.LastProgress == nil)
			r.Count.Text = string.format("%d / %d", p, goal)
			if r.LastProgress ~= nil and p ~= r.LastProgress then
				Kit.Punch(r.Count, 0.35)
			end
			r.LastProgress = p
			if r.Def.Reward.Kind == "Cash" then
				local chipLabel = r.RewardChip:FindFirstChild("Text") :: TextLabel?
				local rIcon, rLabel = rewardInfo(r.Def.Reward)
				if chipLabel then
					chipLabel.Text = "REWARD: " .. rIcon .. " " .. rLabel
				end
			end
			local status = if q.Claimed then "claimed" elseif p >= goal then "ready" else "progress"
			if q.Claimed then
				claimedCount += 1
			end
			if status ~= r.Status and not r.Claiming then
				local previous = r.Status
				r.Status = status
				r.Slot.Visible = status == "ready"
				r.Pending.Visible = status == "progress"
				r.Dim.Visible = status == "claimed"
				r.Stamp.Visible = status == "claimed"
				setBreathe(r.Breather, status == "ready")
				if status == "ready" and previous == "progress" then
					Audio.Play("quest_complete")
					Kit.Punch(r.Box, 0.08)
					Kit.Pop(r.Slot, 0.3, 0.5)
				end
			end
		end
	end
	-- coffre
	local total = #data.List
	local progressLabel = chest.Progress:FindFirstChild("Text") :: TextLabel?
	if progressLabel then
		progressLabel.Text = string.format("%d / %d CLAIMED", claimedCount, total)
	end
	local chestStatus = if data.BonusClaimed then "claimed" elseif allClaimed(data) then "ready" else "locked"
	if chestStatus ~= chest.Status then
		chest.Status = chestStatus
		chest.Slot.Visible = chestStatus ~= "claimed"
		chest.Claimed.Visible = chestStatus == "claimed"
		chest.Burst.Visible = chestStatus ~= "locked"
		chest.Lock.Visible = chestStatus ~= "claimed"
		chest.Lid.Position = if chestStatus == "claimed" then chest.LidHome - UDim2.fromOffset(0, 26) else chest.LidHome
		chest.Lid.Rotation = if chestStatus == "claimed" then -18 else 0
		Kit.SetButtonText(chest.Button, if chestStatus == "ready" then "OPEN!" else "LOCKED 🔒")
		Kit.SetDisabled(chest.Button, false)
		Kit.SetButtonColor(chest.Button, "Gold")
		Kit.SetDisabled(chest.Button, chestStatus ~= "ready")
		setBreathe(chest.Breather, chestStatus == "ready")
		if chestStatus == "ready" then
			Kit.Wobble(chest.Chest, 4, 0.25)
		else
			Kit.Tween(chest.Chest, 0.2, { Rotation = 0 })
		end
	end
	local doneLabel = doneChip:FindFirstChild("Text") :: TextLabel?
	if doneLabel then
		doneLabel.Text = string.format("✔ %d / %d DONE", claimedCount, total)
	end
end

local function tick()
	local t = now()
	local data = questData()
	if data.Day ~= 0 and data.Day < Progress.DayNumber(t) then
		resetLabel.Text = "New quests are ready!"
		resetLabel.TextColor3 = C.RadioactiveDark
	else
		resetLabel.Text = "New quests in " .. Format.Clock(DAY - (t % DAY))
		resetLabel.TextColor3 = C.InkSoft
	end
end

----------------------------------------------------------------------------
-- Réclamations
----------------------------------------------------------------------------

claimQuest = function(id: string)
	if busy[id] then
		return
	end
	local row
	for _, r in rows do
		if r.Id == id then
			row = r
		end
	end
	busy[id] = true
	if row then
		row.Claiming = true
		Kit.SetDisabled(row.Button, true)
	end
	local r = Remote.Call("ClaimQuest", { Id = id })
	busy[id] = nil
	if row then
		row.Claiming = false
		Kit.SetDisabled(row.Button, false)
	end
	if not r.ok then
		refresh()
		return
	end
	Audio.Play("reward_claim")
	UIRegistry.Toast("Quest reward: " .. tostring(r.text or ""), "Good")
	if row and row.Holder.Parent then
		row.Status = "claimed"
		row.Slot.Visible = false
		row.Pending.Visible = false
		row.Dim.Visible = true
		setBreathe(row.Breather, false)
		slamStamp(row.Stamp)
		Kit.Shake(row.Box, 5, 0.3)
		flyText(row.Holder, tostring(r.text or ""), row.RewardColor, UDim2.new(1, -90, 0.3, 0))
	end
	refresh()
end

local function claimBonus()
	if busy.bonus then
		return
	end
	busy.bonus = true
	local r = Remote.Call("ClaimQuestBonus")
	busy.bonus = nil
	if not r.ok then
		refresh()
		return
	end
	Audio.Play("spin_win")
	UIRegistry.Toast("Bonus: " .. tostring(r.text or ""), "Good")
	-- le couvercle saute, l'œuf jaillit
	chest.Status = "claimed"
	chest.Slot.Visible = false
	chest.Claimed.Visible = true
	chest.Lock.Visible = false
	Kit.Tween(chest.Chest, 0.15, { Rotation = 0 })
	Kit.Tween(chest.Lid, 0.4, { Position = chest.LidHome - UDim2.fromOffset(0, 26), Rotation = -18 }, Enum.EasingStyle.Back)
	Kit.Shake(chest.Box, 7, 0.35)
	Kit.Punch(chest.EggHolder, 0.6)
	Kit.Pop(chest.Claimed, 0.3, 0.5)
	flyText(chest.Body, tostring(r.text or ""), C.Gold, UDim2.new(0.5, 0, 0, 120))
	refresh()
end

----------------------------------------------------------------------------
-- Interface publique
----------------------------------------------------------------------------

function Quests.ClaimableCount(): number
	local data = State.Get("Quests")
	if type(data) ~= "table" or type(data.List) ~= "table" then
		return 0
	end
	if data.Day ~= 0 and data.Day < Progress.DayNumber(now()) then
		return 0
	end
	local n = 0
	for _, q in data.List do
		if not q.Claimed and isComplete(q) then
			n += 1
		end
	end
	if not data.BonusClaimed and allClaimed(data) then
		n += 1
	end
	return n
end

function Quests.Init()
	window = Kit.Window({ Name = "Quests", Title = "DAILY QUESTS", Icon = "📜", Color = "Radioactive", Size = UDim2.fromOffset(860, 540), RibbonWidth = 400 })
	local content = window.Frame

	doneChip = Kit.Chip({
		Text = "✔ 0 / 3 DONE",
		Color = C.RadioactiveDark,
		Size = UDim2.fromOffset(200, 36),
		Position = UDim2.fromOffset(4, 6),
		TextSize = 22,
		Parent = content,
	})
	doneChip.Rotation = -2
	resetLabel = Kit.Text({
		Size = UDim2.new(1, -230, 0, 30),
		Position = UDim2.new(1, -4, 0, 9),
		AnchorPoint = Vector2.new(1, 0),
		Text = "",
		FontFace = F.Body,
		TextColor3 = C.InkSoft,
		TextXAlignment = Enum.TextXAlignment.Right,
		Stroke = false,
		MaxTextSize = 22,
		Parent = content,
	})

	listFrame = Kit.new("Frame", {
		Name = "List",
		Size = UDim2.new(1, -290, 1, -56),
		Position = UDim2.fromOffset(0, 56),
		BackgroundTransparency = 1,
		Parent = content,
	})
	local chestHolder = Kit.new("Frame", {
		Name = "ChestHolder",
		Size = UDim2.new(0, 280, 1, -60),
		Position = UDim2.new(1, -140, 0.5, 28),
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundTransparency = 1,
		Parent = content,
	})
	buildChest(chestHolder)
	chest.Holder = chestHolder
	chest.Button.Activated:Connect(function()
		if chest.Status == "ready" then
			task.spawn(claimBonus)
		end
	end)

	for _, key in { "Quests", "Income" } do
		State.Changed(key):Connect(function()
			if window.IsOpen then
				refresh()
			end
		end)
	end

	window.Opened:Connect(function()
		loopToken += 1
		local token = loopToken
		task.spawn(function()
			while window.IsOpen and token == loopToken do
				tick()
				task.wait(1)
			end
		end)
	end)
	window.Closed:Connect(function()
		loopToken += 1
	end)
end

function Quests.Open(_args: any?)
	window:Open()
	rowKey = "" -- reconstruit pour rejouer l'apparition
	for _, r in rows do
		r.Holder:Destroy()
	end
	rows = {}
	chest.Status = ""
	refresh()
	for i, r in rows do
		local s = Kit.ScaleOf(r.Holder)
		s.Scale = 0
		task.delay(0.05 + i * 0.08, function()
			if r.Holder.Parent then
				Kit.Pop(r.Holder, 0.2, 0.5)
			end
		end)
	end
	Kit.Pop(chest.Holder, 0.3, 0.6)
end

function Quests.Close()
	window:Close()
end

return Quests
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="76">
              <Properties>
                <string name="Name">Rebirth</string>
                <string name="Source"><![CDATA[--!nonstrict
-- ÉVOLUTION (rebirth) : niveau actuel, conditions en direct (cash + kaiju ADULTE
-- sacrifié), récompenses, avertissement de remise à zéro, gros bouton EVOLVE et
-- célébration animée après succès.

