local r = require("@lune/roblox")
local function try(name, fn)
	local ok, err = pcall(fn)
	print((ok and "OK  " or "FAIL") .. " " .. name .. (ok and "" or (" : " .. tostring(err))))
end
try("UDim2.fromScale", function() return r.UDim2.fromScale(1, 1) end)
try("UDim2.fromOffset", function() return r.UDim2.fromOffset(1, 1) end)
try("UDim2 +", function() return r.UDim2.new(0, 1, 0, 1) + r.UDim2.fromOffset(2, 2) end)
try("UDim2 -", function() return r.UDim2.new(0, 1, 0, 1) - r.UDim2.fromOffset(2, 2) end)
try("Vector2:Lerp", function() return r.Vector2.new(0, 0):Lerp(r.Vector2.new(1, 1), 0.5) end)
try("Vector2 ops", function() return r.Vector2.new(1, 1) / 2 + r.Vector2.new(1,1) end)
try("Color3:Lerp", function() return r.Color3.new(1, 0, 0):Lerp(r.Color3.new(0, 0, 1), 0.5) end)
try("Color3:ToHex", function() return r.Color3.new(1, 0, 0):ToHex() end)
try("Color3.fromHSV", function() return r.Color3.fromHSV(0.5, 0.5, 0.5) end)
try("CFrame:ToEulerAnglesYXZ", function() return r.CFrame.new():ToEulerAnglesYXZ() end)
try("CFrame:VectorToWorldSpace", function() return r.CFrame.new():VectorToWorldSpace(r.Vector3.new(1,0,0)) end)
try("CFrame:ToObjectSpace", function() return r.CFrame.new():ToObjectSpace(r.CFrame.new()) end)
try("CFrame.Rotation", function() return r.CFrame.new().Rotation end)
try("NumberSequence.new(n)", function() return r.NumberSequence.new(0.5) end)
try("ColorSequence.new(c,c)", function() return r.ColorSequence.new(r.Color3.new(), r.Color3.new(1,1,1)) end)
try("NumberRange.new(a,b)", function() return r.NumberRange.new(1, 2) end)
try("Font.fromEnum", function() return r.Font.fromEnum(r.Enum.Font.FredokaOne) end)
try("Enum.ProximityPromptStyle.Custom", function() return r.Enum.ProximityPromptStyle.Custom end)
try("Enum.BulkMoveMode", function() return r.Enum.BulkMoveMode.FireCFrameChanged end)
try("Enum.ReceiptType", function() return r.Enum.ProductPurchaseDecision.PurchaseGranted end)
try("TweenInfo", function() return r.TweenInfo end)
try("typeof UDim2", function() assert(typeof(r.UDim2.new()) == "UDim2") end)
try("Vector3 * number", function() return r.Vector3.new(1,2,3) * 2 end)
try("Vector3:Cross/Dot", function() return r.Vector3.new(1,0,0):Cross(r.Vector3.new(0,1,0)) end)
try("math.noise", function() return math.noise(1.5, 2.5) end)
